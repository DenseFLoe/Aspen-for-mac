<?xml version='1.0' encoding='utf-8'?>
<local:MMDialog x:Class="AspenTech.AspenPlus.MMDialogs.ResolveConflictsDlg" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:AspenTech.AspenPlus.MMDialogs" xmlns:lp="clr-namespace:AspenTech.AspenPlus.Localization;assembly=AspenTech.AspenPlus.Localization" xmlns:mm="http://schemas.aspentech.com/xaml/presentation/aspenplus" xmlns:atSupport="http://schemas.aspentech.com/xaml/presentation/visualisation/support" x:Name="dlg" x:Uid="dlg" ResizeMode="NoResize" SizeToContent="WidthAndHeight" ShowInTaskbar="False" Title="{x:Static lp:WpfMMDialogResources.ResolveConflicts_Title}" Style="{StaticResource MMDialogStyle}">
  <mm:MMHelp.HelpFile>
    <Binding Path="HelpFile" />
  </mm:MMHelp.HelpFile>
  <mm:MMHelp.HelpId>
    <Binding Path="HelpId" />
  </mm:MMHelp.HelpId>
  <FrameworkElement.Resources>
    <ResourceDictionary x:Uid="ResourceDictionary_1">
      <ResourceDictionary.MergedDictionaries>
        <atSupport:AspenCommonResources />
        <atSupport:AspenCommonProperties x:Uid="atSupport_AspenCommonProperties_1" />
        <atSupport:AspenCommonStyles />
        <atSupport:AspenDefaultStyles />
      </ResourceDictionary.MergedDictionaries>
      <local:NameI18nConvertor x:Key="nameConvertor" x:Uid="local_NameI18nConvertor_1" />
      <DataTemplate x:Key="HeaderTemplateArrowUp" x:Uid="DataTemplate_1">
        <DockPanel x:Uid="DockPanel_1">
          <TextBlock x:Uid="TextBlock_1" HorizontalAlignment="Center">
            <TextBlock.Text>
              <Binding />
            </TextBlock.Text>
          </TextBlock>
          <Path x:Name="arrow" x:Uid="arrow" StrokeThickness="1" Fill="#FF808080" Data="M5,10L15,10 10,5 5,10" />
        </DockPanel>
      </DataTemplate>
      <DataTemplate x:Key="HeaderTemplateArrowDown" x:Uid="DataTemplate_2">
        <DockPanel x:Uid="DockPanel_2">
          <TextBlock x:Uid="TextBlock_2" HorizontalAlignment="Center">
            <TextBlock.Text>
              <Binding />
            </TextBlock.Text>
          </TextBlock>
          <Path x:Name="arrow" x:Uid="Path_1" StrokeThickness="1" Fill="#FF808080" Data="M5,5L10,10 15,5 5,5" />
        </DockPanel>
      </DataTemplate>
    </ResourceDictionary>
  </FrameworkElement.Resources>
  <Grid Name="grid1" x:Uid="grid1" MinHeight="400" MinWidth="400" Margin="{StaticResource AspenDialogOuterMargin}">
    <Grid.RowDefinitions>
      <RowDefinition x:Uid="RowDefinition_1" />
      <RowDefinition x:Uid="RowDefinition_2" />
      <RowDefinition x:Uid="RowDefinition_3" />
      <RowDefinition x:Uid="RowDefinition_4" />
      <RowDefinition x:Uid="RowDefinition_5" />
      <RowDefinition x:Uid="RowDefinition_6" />
      <RowDefinition x:Uid="RowDefinition_7" />
      <RowDefinition x:Uid="RowDefinition_8" />
      <RowDefinition x:Uid="RowDefinition_9" />
      <RowDefinition x:Uid="RowDefinition_10" />
    </Grid.RowDefinitions>
    <Grid.ColumnDefinitions>
      <ColumnDefinition x:Uid="ColumnDefinition_1" />
      <ColumnDefinition x:Uid="ColumnDefinition_2" />
    </Grid.ColumnDefinitions>
    <Button Click="Replace_Click" Name="Replace" x:Uid="Replace" Grid.Column="1" Content="{x:Static lp:WpfMMDialogResources.Replace}" Margin="{DynamicResource AspenVerticalRelativeControlMargin}" VerticalAlignment="Center">
      <UIElement.IsEnabled>
        <Binding Path="CppCode.ReplaceEnabled" />
      </UIElement.IsEnabled>
    </Button>
    <Button Click="Merge_Click" Name="Merge" x:Uid="Merge" Grid.Row="1" Grid.Column="1" Content="{x:Static lp:WpfMMDialogResources.Merge}" Margin="{DynamicResource AspenVerticalRelativeControlMargin}" VerticalAlignment="Center">
      <UIElement.IsEnabled>
        <Binding Path="CppCode.MergeEnabled" />
      </UIElement.IsEnabled>
    </Button>
    <Button Click="EditID_Click" Name="EditID" x:Uid="EditID" Grid.Row="2" Grid.Column="1" Content="{x:Static lp:WpfMMDialogResources.EditID}" Margin="{DynamicResource AspenVerticalRelativeControlMargin}" VerticalAlignment="Center">
      <UIElement.IsEnabled>
        <Binding Path="CppCode.EditEnabled" />
      </UIElement.IsEnabled>
    </Button>
    <Button Click="AddPrefix_Click" Name="AddPrefix" x:Uid="AddPrefix" Grid.Row="3" Grid.Column="1" Content="{x:Static lp:WpfMMDialogResources.AddPrefix}" Margin="{DynamicResource AspenVerticalRelativeControlMargin}" VerticalAlignment="Center">
      <UIElement.IsEnabled>
        <Binding Path="CppCode.PrefixEnabled" />
      </UIElement.IsEnabled>
    </Button>
    <Button Click="AddSuffix_Click" Name="AddSuffix" x:Uid="AddSuffix" Grid.Row="4" Grid.Column="1" Content="{x:Static lp:WpfMMDialogResources.AddSuffix}" Margin="{DynamicResource AspenVerticalRelativeControlMargin}" VerticalAlignment="Center">
      <UIElement.IsEnabled>
        <Binding Path="CppCode.SuffixEnabled" />
      </UIElement.IsEnabled>
    </Button>
    <Button Click="Ignore_Click" Name="Ignore" x:Uid="Ignore" Grid.Row="5" Grid.Column="1" Content="{x:Static lp:WpfMMDialogResources.Ignore}" Margin="{DynamicResource AspenVerticalRelativeControlMargin}" VerticalAlignment="Center">
      <UIElement.IsEnabled>
        <Binding Path="CppCode.IgnoreEnabled" />
      </UIElement.IsEnabled>
    </Button>
    <Button Click="Undo_Click" Name="Undo" x:Uid="Undo" Grid.Row="6" Grid.Column="1" Content="{x:Static lp:WpfMMDialogResources.Undo}" Margin="{DynamicResource AspenVerticalRelativeControlMargin}" VerticalAlignment="Center">
      <UIElement.IsEnabled>
        <Binding Path="CppCode.UndoEnabled" />
      </UIElement.IsEnabled>
    </Button>
    <Button Click="Ok_Click" Name="Ok" x:Uid="Ok" Grid.Row="7" Grid.Column="1" Content="{x:Static lp:WpfMMDialogResources.Ok}" Margin="{DynamicResource AspenVerticalRelativeControlMargin}" VerticalAlignment="Center">
      <UIElement.IsEnabled>
        <Binding Path="CppCode.OkEnabled" />
      </UIElement.IsEnabled>
    </Button>
    <Button Name="Cancel" x:Uid="Cancel" Grid.Row="8" Grid.Column="1" Content="{x:Static lp:WpfMMDialogResources.Cancel}" Margin="{DynamicResource AspenVerticalRelativeControlMargin}" IsCancel="True" VerticalAlignment="Center">
      <UIElement.IsEnabled>
        <Binding Path="CppCode.CancelEnabled" />
      </UIElement.IsEnabled>
    </Button>
    <Button Name="Help" x:Uid="Help" Grid.Row="9" Grid.Column="1" Content="{x:Static lp:WpfMMDialogResources.Help}" Command="ApplicationCommands.Help" Margin="{DynamicResource AspenVerticalRelativeControlMargin}" VerticalAlignment="Center" />
    <ListView SelectionChanged="ListView_SelectionChanged" ButtonBase.Click="ListView_ColumnHeaderClicked" Name="ConflictIDList" x:Uid="ConflictIDList" Height="400" HorizontalAlignment="Left" VerticalAlignment="Top" Grid.RowSpan="10" ScrollViewer.VerticalScrollBarVisibility="Auto" Margin="{DynamicResource AspenHorizontalRelativeControlMargin}">
      <ListView.View>
        <GridView x:Uid="GridView_1">
          <GridViewColumn x:Uid="GridViewColumn_1" Header="{x:Static lp:WpfMMDialogResources.Object}" Width="200">
            <GridViewColumn.DisplayMemberBinding>
              <Binding Path="Name" Converter="{StaticResource nameConvertor}" />
            </GridViewColumn.DisplayMemberBinding>
          </GridViewColumn>
          <GridViewColumn x:Uid="GridViewColumn_2" Header="{x:Static lp:WpfMMDialogResources.Status}" Width="100">
            <GridViewColumn.DisplayMemberBinding>
              <Binding Path="Status" />
            </GridViewColumn.DisplayMemberBinding>
          </GridViewColumn>
        </GridView>
      </ListView.View>
    </ListView>
  </Grid>
</local:MMDialog>
