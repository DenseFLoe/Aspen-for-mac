<?xml version='1.0' encoding='utf-8'?>
<mlc:WizardControlItem xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:mm="clr-namespace:AspenTech.AspenPlus.MMControls;assembly=AspenTech.AspenPlus.MMControls" xmlns:lp="clr-namespace:AspenTech.AspenPlus.Localization;assembly=AspenTech.AspenPlus.Localization" xmlns:mlc="clr-namespace:AspenTech.AspenPlus.ModelLibrary.Controls;assembly=AspenTech.AspenPlus.ModelLibrary.Controls" x:Uid="mlc_WizardControlItem_1" mm:MMHelp.HelpFile="cmpnts.chm" mm:MMHelp.HelpId="139" x:Class="AspenTech.AspenPlus.WpfFindComponent.SFEAssistantStep1">
  <Grid x:Uid="Grid_1" MinWidth="380" MinHeight="250">
    <Grid.RowDefinitions>
      <RowDefinition x:Uid="RowDefinition_1" Height="Auto" />
      <RowDefinition x:Uid="RowDefinition_2" Height="Auto" />
      <RowDefinition x:Uid="RowDefinition_3" Height="Auto" />
      <RowDefinition x:Uid="RowDefinition_4" Height="Auto" />
    </Grid.RowDefinitions>
    <TextBlock x:Uid="TextBlock_1" Grid.Row="0" TextWrapping="Wrap" HorizontalAlignment="Left" MaxWidth="350" Text="{x:Static lp:WpfFindComponentResources.WelcomeSFEAssistant}" Margin="0,0,0,0" />
    <GroupBox x:Uid="GroupBox_2" Header="{x:Static lp:WpfFindComponentResources.Selectspecies}" Grid.Row="1" Margin="0,10,0,0">
      <StackPanel x:Uid="StackPanel_1" Orientation="Horizontal" Margin="0,0,0,0">
        <GroupBox x:Uid="GroupBox_3" Header="{x:Static lp:WpfFindComponentResources.SFEAvailableComponents}">
          <ListBox MouseDoubleClick="lstAvailableComp_MouseDoubleClick" Name="lstAvailableComp" x:Uid="lstAvailableComp" SelectionMode="Extended" Width="125" Height="110" ScrollViewer.VerticalScrollBarVisibility="Auto" VerticalAlignment="Bottom" IsTextSearchEnabled="True" TextSearch.TextPath="ComponentID">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                  </Grid.ColumnDefinitions>
                  <TextBlock Grid.Column="0" HorizontalAlignment="Stretch">
                    <TextBlock.Text>
                      <Binding Path="ComponentID" />
                    </TextBlock.Text>
                    <FrameworkElement.ToolTip>
                      <ToolTip Placement="Mouse" ToolTipService.InitialShowDelay="100" ToolTipService.IsEnabled="True" ToolTipService.BetweenShowDelay="100">
                        <StackPanel>
                          <TextBlock>
                            <TextBlock.Text>
                              <Binding Path="ComponentDes" />
                            </TextBlock.Text>
                          </TextBlock>
                        </StackPanel>
                      </ToolTip>
                    </FrameworkElement.ToolTip>
                  </TextBlock>
                </Grid>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ListBox>
        </GroupBox>
        <StackPanel x:Uid="StackPanel_2" Orientation="Vertical" VerticalAlignment="Center">
          <Button Click="btnMove_Click" Name="btnMove" x:Uid="btnMove" MinWidth="40" Content="&gt;" Margin="0,0,0,5" />
          <Button Click="btnMoveAll_Click" Name="btnMoveAll" x:Uid="btnMoveAll" MinWidth="40" Content="&gt;&gt;" Margin="0,0,0,5" />
          <Button Click="btnRemove_Click" Name="btnRemove" x:Uid="btnRemove" MinWidth="40" Content="&lt;" Margin="0,0,0,5" />
          <Button Click="btnClearAll_Click" Name="btnClearAll" x:Uid="btnClearAll" MinWidth="40" Content="&lt;&lt;" Margin="0,0,0,5" />
        </StackPanel>
        <GroupBox x:Uid="GroupBox_4" Header="{x:Static lp:WpfFindComponentResources.SFESelectedComponents}" Margin="5,0,0,0">
          <ListBox MouseDoubleClick="lstSelectedComp_MouseDoubleClick" Name="lstSelectedComp" x:Uid="lstSelectedComp" SelectionMode="Extended" Width="125" Height="110" ScrollViewer.VerticalScrollBarVisibility="Auto" VerticalAlignment="Bottom">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                  </Grid.ColumnDefinitions>
                  <TextBlock HorizontalAlignment="Stretch">
                    <TextBlock.Text>
                      <Binding Path="ComponentID" />
                    </TextBlock.Text>
                    <FrameworkElement.ToolTip>
                      <ToolTip Placement="Mouse" ToolTipService.IsEnabled="True">
                        <StackPanel>
                          <TextBlock>
                            <TextBlock.Text>
                              <Binding Path="ComponentDes" />
                            </TextBlock.Text>
                          </TextBlock>
                        </StackPanel>
                      </ToolTip>
                    </FrameworkElement.ToolTip>
                  </TextBlock>
                </Grid>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ListBox>
        </GroupBox>
      </StackPanel>
    </GroupBox>
  </Grid>
</mlc:WizardControlItem>
