<?xml version='1.0' encoding='utf-8'?>
<UserControl xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:mmc="http://schemas.aspentech.com/xaml/presentation/aspenplus" xmlns:res="clr-namespace:AspenTech.AspenPlus.Localization;assembly=AspenTech.AspenPlus.Localization" xmlns:local="clr-namespace:AspenTech.AspenPlus.WpfFindComponent" MinWidth="530" MinHeight="300" mmc:MMHelp.HelpFile="cmpnts.chm" mmc:MMHelp.HelpId="149" x:Class="AspenTech.AspenPlus.WpfFindComponent.PubChemTab">
  <Grid Margin="{DynamicResource AspenDialogOuterMargin}">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="Auto" />
      <ColumnDefinition Width="*" MinWidth="150" />
      <ColumnDefinition Width="Auto" />
    </Grid.ColumnDefinitions>
    <Image Source="Images\PubChem.png" />
    <TextBox KeyDown="SearchTextBox_KeyDown" Margin="3,0,0,0" Grid.Column="1">
      <TextBox.Text>
        <Binding Path="SearchText" UpdateSourceTrigger="PropertyChanged" />
      </TextBox.Text>
    </TextBox>
    <Button Name="searchButton" Margin="3,0,0,0" Grid.Column="2" Padding="0" MinWidth="30">
      <ButtonBase.Command>
        <Binding Path="SearchCommand" />
      </ButtonBase.Command>
      <ContentControl.Content>
        <Image Source="Images\Search.png" />
      </ContentControl.Content>
    </Button>
    <GroupBox Grid.Row="1" Grid.ColumnSpan="3" Margin="{DynamicResource AspenVerticalRelativeControlMargin}">
      <HeaderedContentControl.Header>
        <Binding Path="StatusText" />
      </HeaderedContentControl.Header>
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="*" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <local:ListViewEx Margin="3">
          <ItemsControl.ItemsSource>
            <Binding Path="Compounds" />
          </ItemsControl.ItemsSource>
          <local:ListViewEx.BindableSelectedItems>
            <Binding Path="SelectedComponents" Mode="TwoWay" />
          </local:ListViewEx.BindableSelectedItems>
          <FrameworkElement.ContextMenu>
            <ContextMenu>
              <MenuItem Header="{x:Static res:WpfFindComponentResources.CompoundSummary}" ToolTip="{x:Static res:WpfFindComponentResources.ViewCompoundSummary}">
                <MenuItem.Command>
                  <Binding Path="ViewCompoundCommand" />
                </MenuItem.Command>
              </MenuItem>
            </ContextMenu>
          </FrameworkElement.ContextMenu>
          <ListView.View>
            <GridView>
              <GridViewColumn Header="{x:Static res:WpfFindComponentResources.CID}" Width="70">
                <GridViewColumn.DisplayMemberBinding>
                  <Binding Path="CID" />
                </GridViewColumn.DisplayMemberBinding>
              </GridViewColumn>
              <GridViewColumn Header="{x:Static res:WpfFindComponentResources.Image}" Width="130">
                <GridViewColumn.CellTemplate>
                  <DataTemplate>
                    <Grid>
                      <Image>
                        <Image.Source>
                          <Binding Path="Image" />
                        </Image.Source>
                      </Image>
                    </Grid>
                  </DataTemplate>
                </GridViewColumn.CellTemplate>
              </GridViewColumn>
              <GridViewColumn Header="{x:Static res:WpfFindComponentResources.MolecularFormula}" Width="150">
                <GridViewColumn.DisplayMemberBinding>
                  <Binding Path="MolecularFormula" />
                </GridViewColumn.DisplayMemberBinding>
              </GridViewColumn>
              <GridViewColumn Header="{x:Static res:WpfFindComponentResources.MW}" Width="70">
                <GridViewColumn.DisplayMemberBinding>
                  <Binding Path="MolecularWeight" />
                </GridViewColumn.DisplayMemberBinding>
              </GridViewColumn>
              <GridViewColumn Header="{x:Static res:WpfFindComponentResources.Name}" Width="150">
                <GridViewColumn.DisplayMemberBinding>
                  <Binding Path="Title" />
                </GridViewColumn.DisplayMemberBinding>
              </GridViewColumn>
              <GridViewColumn Header="{x:Static res:WpfFindComponentResources.IUPACName}" Width="160">
                <GridViewColumn.DisplayMemberBinding>
                  <Binding Path="IUPACName" />
                </GridViewColumn.DisplayMemberBinding>
              </GridViewColumn>
            </GridView>
          </ListView.View>
        </local:ListViewEx>
        <local:PagingControl Grid.Row="2" HorizontalAlignment="Center">
          <local:PagingControl.MaxAllowedPage>
            <Binding Path="MaxAllowedPage" Mode="TwoWay" />
          </local:PagingControl.MaxAllowedPage>
          <local:PagingControl.SelectedPage>
            <Binding Path="SelectedPage" Mode="TwoWay" />
          </local:PagingControl.SelectedPage>
          <UIElement.IsEnabled>
            <Binding Path="LoadComplete" />
          </UIElement.IsEnabled>
        </local:PagingControl>
      </Grid>
    </GroupBox>
    <Button Grid.Row="3" Grid.ColumnSpan="3" HorizontalAlignment="Left" Content="{x:Static res:WpfFindComponentResources.AddSelCom}">
      <ButtonBase.Command>
        <Binding Path="AddCommand" />
      </ButtonBase.Command>
    </Button>
  </Grid>
</UserControl>
