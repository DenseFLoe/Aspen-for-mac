<?xml version='1.0' encoding='utf-8'?>
<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:mc="clr-namespace:AspenTech.AspenPlus.ModelLibrary.Controls;assembly=AspenTech.AspenPlus.ModelLibrary.Controls" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:lp="clr-namespace:AspenTech.AspenPlus.Localization;assembly=AspenTech.AspenPlus.Localization" Name="sFEAssistantWindow" x:Uid="sFEAssistantWindow" ResizeMode="NoResize" ShowInTaskbar="False" SizeToContent="Height" WindowStartupLocation="CenterOwner" Title="{x:Static lp:WpfFindComponentResources.SFEAssistantTitle}" Width="400" MinHeight="300" x:Class="AspenTech.AspenPlus.WpfFindComponent.SFEAssistant">
  <FrameworkElement.Resources>
    <ResourceDictionary>
      <Style x:Key="{x:Type ListBoxItem}" TargetType="{x:Type ListBoxItem}">
        <Setter Property="FrameworkElement.HorizontalAlignment" Value="Stretch" />
        <Setter Property="Control.HorizontalContentAlignment" Value="Stretch" />
      </Style>
    </ResourceDictionary>
  </FrameworkElement.Resources>
  <Grid x:Uid="Grid_1" Margin="8">
    <Grid.RowDefinitions>
      <RowDefinition x:Uid="RowDefinition_1" Height="Auto" />
      <RowDefinition x:Uid="RowDefinition_2" Height="Auto" />
      <RowDefinition x:Uid="RowDefinition_3" Height="Auto" />
      <RowDefinition x:Uid="RowDefinition_4" Height="Auto" />
    </Grid.RowDefinitions>
    <TextBlock x:Uid="TextBlock_1" Grid.Row="0" TextWrapping="Wrap" HorizontalAlignment="Left" Text="{x:Static lp:WpfFindComponentResources.WelcomeSFEAssistant}" Margin="0,0,0,0" />
    <GroupBox x:Uid="GroupBox_2" Header="{x:Static lp:WpfFindComponentResources.Selectspecies}" Grid.Row="1" Margin="0,10,0,0">
      <StackPanel x:Uid="StackPanel_1" Orientation="Horizontal" Margin="0,0,0,0">
        <GroupBox x:Uid="GroupBox_3" Header="{x:Static lp:WpfFindComponentResources.SFEAvailableComponents}">
          <ListBox MouseDoubleClick="lstAvailableComp_MouseDoubleClick" Name="lstAvailableComp" x:Uid="lstAvailableComp" SelectionMode="Extended" Width="125" Height="110" ScrollViewer.VerticalScrollBarVisibility="Auto" VerticalAlignment="Bottom">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                  </Grid.ColumnDefinitions>
                  <TextBlock Grid.Column="0" HorizontalAlignment="Stretch">
                    <TextBlock.Text>
                      <Binding Path="ComponentID" />
                    </TextBlock.Text>
                    <FrameworkElement.ToolTip>
                      <ToolTip Placement="Mouse" ToolTipService.InitialShowDelay="100" ToolTipService.IsEnabled="True" ToolTipService.BetweenShowDelay="100">
                        <StackPanel>
                          <TextBlock>
                            <TextBlock.Text>
                              <Binding Path="ComponentDes" />
                            </TextBlock.Text>
                          </TextBlock>
                        </StackPanel>
                      </ToolTip>
                    </FrameworkElement.ToolTip>
                  </TextBlock>
                </Grid>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ListBox>
        </GroupBox>
        <StackPanel x:Uid="StackPanel_2" Orientation="Vertical" VerticalAlignment="Center">
          <Button Click="btnMove_Click" Name="btnMove" x:Uid="btnMove" MinWidth="40" Content="&gt;" Margin="0,0,0,5" />
          <Button Click="btnMoveAll_Click" Name="btnMoveAll" x:Uid="btnMoveAll" MinWidth="40" Content="&gt;&gt;" Margin="0,0,0,5" />
          <Button Click="btnRemove_Click" Name="btnRemove" x:Uid="btnRemove" MinWidth="40" Content="&lt;" Margin="0,0,0,5" />
          <Button Click="btnClearAll_Click" Name="btnClearAll" x:Uid="btnClearAll" MinWidth="40" Content="&lt;&lt;" Margin="0,0,0,5" />
        </StackPanel>
        <GroupBox x:Uid="GroupBox_4" Header="{x:Static lp:WpfFindComponentResources.SFESelectedComponents}" Margin="5,0,0,0">
          <ListBox MouseDoubleClick="lstSelectedComp_MouseDoubleClick" Name="lstSelectedComp" x:Uid="lstSelectedComp" SelectionMode="Extended" Width="125" Height="110" ScrollViewer.VerticalScrollBarVisibility="Auto">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                  </Grid.ColumnDefinitions>
                  <TextBlock HorizontalAlignment="Stretch">
                    <TextBlock.Text>
                      <Binding Path="ComponentID" />
                    </TextBlock.Text>
                    <FrameworkElement.ToolTip>
                      <ToolTip Placement="Mouse" ToolTipService.IsEnabled="True">
                        <StackPanel>
                          <TextBlock>
                            <TextBlock.Text>
                              <Binding Path="ComponentDes" />
                            </TextBlock.Text>
                          </TextBlock>
                        </StackPanel>
                      </ToolTip>
                    </FrameworkElement.ToolTip>
                  </TextBlock>
                </Grid>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ListBox>
        </GroupBox>
      </StackPanel>
    </GroupBox>
    <GroupBox x:Uid="GroupBox_5" Grid.Row="2" Header="{x:Static lp:WpfFindComponentResources.GenerateChemistry}" Margin="0,0,0,0">
      <Grid x:Uid="Grid_6">
        <Grid.ColumnDefinitions>
          <ColumnDefinition x:Uid="RowDefinition_1" />
          <ColumnDefinition x:Uid="RowDefinition_2" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
          <RowDefinition x:Uid="RowDefinition_1" />
          <RowDefinition x:Uid="RowDefinition_2" />
        </Grid.RowDefinitions>
        <RadioButton Name="radioNewChemistry" x:Uid="radioNewChemistry" GroupName="RG1" Grid.Row="0" Grid.Column="0" Content="{x:Static lp:WpfFindComponentResources.Generatenew}" Margin="0,5,0,5">
          <ToggleButton.IsChecked>
            <Binding Path="IsNewChemistryChecked" />
          </ToggleButton.IsChecked>
        </RadioButton>
        <TextBox Name="txtChemName" x:Uid="txtChemName" Width="100" HorizontalAlignment="Left" Grid.Row="0" Grid.Column="1" CharacterCasing="Upper" MaxLength="8">
          <TextBox.Text>
            <Binding Path="ChemName" />
          </TextBox.Text>
          <UIElement.IsEnabled>
            <Binding ElementName="radioNewChemistry" Path="IsChecked" UpdateSourceTrigger="PropertyChanged" Mode="OneWay" />
          </UIElement.IsEnabled>
        </TextBox>
        <RadioButton Name="radioExistChemistry" x:Uid="radioExistChemistry" Grid.Row="1" Grid.Column="0" GroupName="RG1" Content="{x:Static lp:WpfFindComponentResources.Addtoexisting}">
          <ToggleButton.IsChecked>
            <Binding Path="IsExistChemistryChecked" />
          </ToggleButton.IsChecked>
        </RadioButton>
        <ComboBox Name="cmbexistingChemistry" x:Uid="cmbexistingChemistry" HorizontalAlignment="Left" Grid.Row="1" Grid.Column="1" Width="100" SelectedIndex="0">
          <ItemsControl.ItemsSource>
            <Binding Path="ExistingChemistry" />
          </ItemsControl.ItemsSource>
          <Selector.SelectedValue>
            <Binding Path="ExistChemName" />
          </Selector.SelectedValue>
          <UIElement.IsEnabled>
            <Binding ElementName="radioExistChemistry" Path="IsChecked" UpdateSourceTrigger="PropertyChanged" Mode="OneWay" />
          </UIElement.IsEnabled>
        </ComboBox>
      </Grid>
    </GroupBox>
    <UniformGrid Grid.Row="3" Margin="0,0,5,10" Columns="2" HorizontalAlignment="Center">
      <Button Name="btnClose" x:Uid="btnClose" Content="{x:Static lp:WpfFindComponentResources.Cancel}" IsCancel="True" MinWidth="40" HorizontalAlignment="Center" Margin="0,5,5,0">
        <ButtonBase.Command>
          <Binding Path="CommandOnCancel" />
        </ButtonBase.Command>
        <ButtonBase.CommandParameter>
          <Binding ElementName="sFEAssistantWindow" />
        </ButtonBase.CommandParameter>
      </Button>
      <Button Name="btnOK" x:Uid="btnOK" Content="{x:Static lp:WpfFindComponentResources.OK}" IsDefault="True" MinWidth="40" VerticalAlignment="Bottom" Margin="0,5,5,0">
        <ButtonBase.Command>
          <Binding Path="CommandOnOK" />
        </ButtonBase.Command>
        <ButtonBase.CommandParameter>
          <Binding ElementName="sFEAssistantWindow" />
        </ButtonBase.CommandParameter>
      </Button>
    </UniformGrid>
  </Grid>
</Window>
