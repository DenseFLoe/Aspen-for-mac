<?xml version='1.0' encoding='utf-8'?>
<Window x:Class="AspenTech.AspenPlus.MMDialogs.DistillationSynthesisContinue" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:res="clr-namespace:AspenTech.AspenPlus.Localization;assembly=AspenTech.AspenPlus.Localization" x:Uid="Window_1" ShowInTaskbar="False" Title="{x:Static res:WpfMMDialogResources.InterLoadResult}" WindowStartupLocation="CenterScreen" SizeToContent="WidthAndHeight" Style="{StaticResource MMDialogStyle}">
  <StackPanel x:Uid="StackPanel_1" Margin="{StaticResource AspenDialogOuterMargin}">
    <Label Name="LblRa" x:Uid="LblRa" Content="{x:Static res:WpfMMDialogResources.InterLoadResultTip}" />
    <StackPanel x:Uid="StackPanel_2" Orientation="Horizontal" HorizontalAlignment="Center" Margin="{StaticResource AspenVerticalRelativeControlMargin}">
      <Button Click="BtnOK_Click" Name="BtnOK" x:Uid="BtnOK" Margin="{StaticResource AspenHorizontalRelativeControlMargin}" Content="{x:Static res:WpfMMDialogResources.Ok}" />
      <Button Click="BtnCancel_Click" Name="BtnCancel" x:Uid="BtnCancel" Content="{x:Static res:WpfMMDialogResources.Cancel}" />
    </StackPanel>
  </StackPanel>
</Window>
