            <Border Name="Selected" Visibility="Visible" Background="{TemplateBinding igDP:DataRecordCellArea.BackgroundSelected}" BorderBrush="{TemplateBinding igDP:DataRecordCellArea.BorderSelectedBrush}" BorderThickness="{TemplateBinding Border.BorderThickness}" CornerRadius="{TemplateBinding igDP:DataRecordCellArea.CornerRadius}" Opacity="0" />
            <ContentPresenter Name="CellContent" Style="{TemplateBinding igDP:DataRecordCellArea.ForegroundStyle}" Content="{TemplateBinding ContentControl.Content}" x:Uid="CellContent" />
          </igWindows:CardPanel>
          <ControlTemplate.Triggers>
            <MultiTrigger>
              <MultiTrigger.Conditions>
                <Condition Property="igDP:DataRecordCellArea.IsAlternate" Value="True" />
                <Condition Property="igDP:DataRecordCellArea.IsFilterRecord" Value="False" />
                <Condition Property="igDP:DataRecordCellArea.IsAddRecord" Value="False" />
              </MultiTrigger.Conditions>
              <Setter TargetName="Alternate" Property="UIElement.Visibility" Value="Visible" />
              <Setter TargetName="CellContent" Property="FrameworkElement.Style">
