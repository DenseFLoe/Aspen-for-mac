<?xml version='1.0' encoding='utf-8'?>
<UserControl x:Class="AspenTech.AspenPlus.MMForms.GridForms.StreamReport.Template.EditorScopeOptions" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:lc="clr-namespace:AspenTech.AspenPlus.Localization;assembly=AspenTech.AspenPlus.Localization">
  <UIElement.IsEnabled>
    <Binding Path="IsEditable" Mode="OneWay">
      <Binding.RelativeSource>
        <RelativeSource Mode="Self" />
      </Binding.RelativeSource>
    </Binding>
  </UIElement.IsEnabled>
  <StackPanel>
    <FrameworkElement.Resources>
      <ResourceDictionary>
        <Style x:Key="{x:Type CheckBox}" TargetType="{x:Type CheckBox}">
          <Setter Property="FrameworkElement.Margin" Value="0,5,0,5" />
        </Style>
      </ResourceDictionary>
    </FrameworkElement.Resources>
    <StackPanel Margin="0,0,0,20">
      <Label Content="{x:Static lc:GridFormsResources.StreamSummaryTemplate_ScopeOptions_Scope}" />
      <CheckBox Content="{x:Static lc:GridFormsResources.StreamSummaryTemplate_ScopeOptions_ShowTotalStream}">
        <ToggleButton.IsChecked>
          <Binding Path="TotalStream" Mode="TwoWay" />
        </ToggleButton.IsChecked>
      </CheckBox>
      <CheckBox Content="{x:Static lc:GridFormsResources.StreamSummaryTemplate_ScopeOptions_ShowSubstreams}">
        <ToggleButton.IsChecked>
          <Binding Path="Substreams" Mode="TwoWay" />
        </ToggleButton.IsChecked>
      </CheckBox>
      <CheckBox Content="{x:Static lc:GridFormsResources.StreamSummaryTemplate_ScopeOptions_ShowPhasesForMixedSubstream}">
        <UIElement.IsEnabled>
          <Binding Path="Substreams" Mode="OneWay" />
        </UIElement.IsEnabled>
        <ToggleButton.IsChecked>
          <Binding Path="PhasesForMixedSubstream" Mode="TwoWay" />
        </ToggleButton.IsChecked>
      </CheckBox>
    </StackPanel>
    <StackPanel Margin="0,0,0,20">
      <Label Content="{x:Static lc:GridFormsResources.StreamSummaryTemplate_ScopeOptions_Flows}" />
      <CheckBox Content="{x:Static lc:GridFormsResources.StreamSummaryTemplate_ScopeOptions_MoleFlows}">
        <ToggleButton.IsChecked>
          <Binding Path="MoleFlows" Mode="TwoWay" />
        </ToggleButton.IsChecked>
      </CheckBox>
      <CheckBox Content="{x:Static lc:GridFormsResources.StreamSummaryTemplate_ScopeOptions_MassFlows}">
        <ToggleButton.IsChecked>
          <Binding Path="MassFlows" Mode="TwoWay" />
        </ToggleButton.IsChecked>
      </CheckBox>
      <CheckBox Content="{x:Static lc:GridFormsResources.StreamSummaryTemplate_ScopeOptions_VolumeFlows}">
        <ToggleButton.IsChecked>
          <Binding Path="VolumeFlows" Mode="TwoWay" />
        </ToggleButton.IsChecked>
      </CheckBox>
      <CheckBox Content="{x:Static lc:GridFormsResources.StreamSummaryTemplate_ScopeOptions_HideComponents}">
        <ToggleButton.IsChecked>
          <Binding Path="HideComWithZeroFlow" Mode="TwoWay" />
        </ToggleButton.IsChecked>
      </CheckBox>
    </StackPanel>
    <StackPanel Margin="0,0,0,20">
      <Label Content="{x:Static lc:GridFormsResources.StreamSummaryTemplate_ScopeOptions_Composition}" />
      <CheckBox Content="{x:Static lc:GridFormsResources.StreamSummaryTemplate_ScopeOptions_MoleFractions}">
        <ToggleButton.IsChecked>
          <Binding Path="MoleFractions" Mode="TwoWay" />
        </ToggleButton.IsChecked>
      </CheckBox>
      <CheckBox Content="{x:Static lc:GridFormsResources.StreamSummaryTemplate_ScopeOptions_MassFractions}">
        <ToggleButton.IsChecked>
          <Binding Path="MassFractions" Mode="TwoWay" />
        </ToggleButton.IsChecked>
      </CheckBox>
    </StackPanel>
  </StackPanel>
</UserControl>
