<?xml version='1.0' encoding='utf-8'?>
<mmd:MMDialog x:Class="AspenTech.AspenPlus.MMDialogs.IDBoxDlg" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:mmd="clr-namespace:AspenTech.AspenPlus.MMDialogs" xmlns:res="clr-namespace:AspenTech.AspenPlus.Localization;assembly=AspenTech.AspenPlus.Localization" xmlns:atSupport="http://schemas.aspentech.com/xaml/presentation/visualisation/support" x:Name="root" Loaded="DlgBox_Loaded" x:Uid="root" WindowState="Normal" ShowInTaskbar="False" ResizeMode="NoResize" WindowStartupLocation="CenterOwner" Title="{x:Static res:WpfMMDialogResources.ObjectName}" MinWidth="300" SizeToContent="WidthAndHeight" Style="{StaticResource MMDialogStyle}">
  <FrameworkElement.Resources>
    <ResourceDictionary x:Uid="ResourceDictionary_1">
      <ResourceDictionary.MergedDictionaries>
        <atSupport:AspenCommonResources />
        <atSupport:AspenCommonProperties x:Uid="atSupport_AspenCommonProperties_1" />
        <atSupport:AspenCommonStyles />
        <atSupport:AspenDefaultStyles />
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </FrameworkElement.Resources>
  <StackPanel x:Uid="StackPanel_1" Margin="{StaticResource AspenDialogOuterMargin}">
    <DockPanel x:Uid="DockPanel_1" Margin="{StaticResource AspenVerticalIrrelativeControlMargin}">
      <Label x:Name="promptLabel" x:Uid="promptLabel" Content="{x:Static res:WpfMMDialogResources.PlsEnterID}" Margin="{StaticResource AspenHorizontalRelativeControlMargin}" />
      <TextBox TextChanged="editBox_TextChanged" PreviewTextInput="editBox_PreviewTextInput" x:Name="editBox" x:Uid="editBox" MinWidth="80" CharacterCasing="Upper" />
    </DockPanel>
    <UniformGrid x:Uid="UniformGrid_1" Columns="2" HorizontalAlignment="Center">
      <Button Click="btnOK_Click" Name="btnOK" x:Uid="btnOK" Content="{x:Static res:WpfSimdllResources.BtnOk}" IsDefault="True" Margin="{StaticResource AspenHorizontalRelativeControlMargin}">
        <UIElement.IsEnabled>
          <Binding Path="IsOKEnable" ElementName="root" Mode="OneWay" />
        </UIElement.IsEnabled>
      </Button>
      <Button Name="btnCancel" x:Uid="btnCancel" Content="{x:Static res:WpfSimdllResources.BtnCancel}" IsCancel="True" Margin="{StaticResource AspenNoMargin}" />
    </UniformGrid>
  </StackPanel>
</mmd:MMDialog>
