<?xml version='1.0' encoding='utf-8'?>
<Window x:Class="AspenTech.AspenPlus.MMForms.GridForms.Dialogs.ChangeTypeDialog" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:lp="clr-namespace:AspenTech.AspenPlus.Localization;assembly=AspenTech.AspenPlus.Localization" xmlns:converters="clr-namespace:AspenTech.AspenPlus.MMForms.GridForms.Controls.Converters;assembly=AspenTech.AspenPlus.MMForms.GridForms.Controls" x:Uid="Window_1" Title="{x:Static lp:GridFormsResources.ChangeTypeDialog_Title}" SizeToContent="WidthAndHeight" ResizeMode="NoResize" ShowInTaskbar="False" WindowStartupLocation="CenterOwner" Background="{DynamicResource AspenDialogBackgroundBrush}">
  <FrameworkElement.Resources>
    <ResourceDictionary>
      <converters:RadioButtonValueConverter x:Key="rbvConverter" x:Uid="converters_RadioButtonValueConverter_1" />
    </ResourceDictionary>
  </FrameworkElement.Resources>
  <StackPanel x:Uid="StackPanel_1" Margin="{DynamicResource AspenDialogOuterMargin}">
    <GroupBox x:Uid="GroupBox_1" Header="{x:Static lp:GridFormsResources.ChangeTypeDialog_GroupHeader}" Margin="{DynamicResource AspenVerticalRelativeControlMargin}">
      <StackPanel x:Uid="StackPanel_2">
        <FrameworkElement.DataContext>
          <Binding>
            <Binding.RelativeSource>
              <RelativeSource Mode="FindAncestor" AncestorType="Window" />
            </Binding.RelativeSource>
          </Binding>
        </FrameworkElement.DataContext>
        <RadioButton x:Uid="RadioButton_1" Content="{x:Static lp:GridFormsResources.ChangeTypeDialog_LocalToThisRecord}" Margin="{DynamicResource AspenVerticalRelativeControlMargin}">
          <ToggleButton.IsChecked>
            <Binding Path="SelectedType" Mode="TwoWay" Converter="{StaticResource rbvConverter}" ConverterParameter="0" />
          </ToggleButton.IsChecked>
        </RadioButton>
        <RadioButton x:Uid="RadioButton_2" Content="{x:Static lp:GridFormsResources.ChangeTypeDialog_AvailableToSimilar}" Margin="{DynamicResource AspenVerticalRelativeControlMargin}">
          <ToggleButton.IsChecked>
            <Binding Path="SelectedType" Mode="TwoWay" Converter="{StaticResource rbvConverter}" ConverterParameter="1" />
          </ToggleButton.IsChecked>
        </RadioButton>
        <RadioButton x:Uid="RadioButton_3" Content="{x:Static lp:GridFormsResources.ChangeTypeDialog_AvailableInHierarchy}" Margin="{DynamicResource AspenVerticalRelativeControlMargin}">
          <ToggleButton.IsChecked>
            <Binding Path="SelectedType" Mode="TwoWay" Converter="{StaticResource rbvConverter}" ConverterParameter="2" />
          </ToggleButton.IsChecked>
        </RadioButton>
        <RadioButton x:Uid="RadioButton_4" Content="{x:Static lp:GridFormsResources.ChangeTypeDialog_GlobalToThisHierarchy}" Margin="{DynamicResource AspenVerticalRelativeControlMargin}">
          <ToggleButton.IsChecked>
            <Binding Path="SelectedType" Mode="TwoWay" Converter="{StaticResource rbvConverter}" ConverterParameter="3" />
          </ToggleButton.IsChecked>
        </RadioButton>
        <RadioButton x:Uid="RadioButton_5" Content="{x:Static lp:GridFormsResources.ChangeTypeDialog_GlaobalToAll}">
          <ToggleButton.IsChecked>
            <Binding Path="SelectedType" Mode="TwoWay" Converter="{StaticResource rbvConverter}" ConverterParameter="4" />
          </ToggleButton.IsChecked>
        </RadioButton>
      </StackPanel>
    </GroupBox>
    <StackPanel x:Uid="StackPanel_3" Orientation="Horizontal" HorizontalAlignment="Right">
      <Button Click="buttonOK_Click" x:Name="buttonOK" x:Uid="buttonOK" IsDefault="True" Content="{x:Static lp:GridFormsResources.ChangeTypeDialog_ButtonOK}" />
      <Button Click="buttonCancel_Click" x:Name="buttonCancel" x:Uid="buttonCancel" IsCancel="True" Margin="0" Content="{x:Static lp:GridFormsResources.ChangeTypeDialog_ButtonCancel}" />
    </StackPanel>
  </StackPanel>
</Window>
