<?xml version='1.0' encoding='utf-8'?>
<ribbon:ContextualTabGroup x:Class="AspenTech.AspenPlus.MMForms.GridForms.StreamReport.StreamReportContextualRibbonTabGroup" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:ribbon="http://infragistics.com/Ribbon" xmlns:lc="clr-namespace:AspenTech.AspenPlus.Localization;assembly=AspenTech.AspenPlus.Localization" xmlns:gcInternal="clr-namespace:AspenTech.Engineering.GridControls.Internal;assembly=AspenTech.Engineering.GridControls" Caption="{x:Static lc:GridFormsResources.StreamReport_Ribbon_GroupHeader}" IsVisible="False" xmlns:igWpControls="clr-namespace:Infragistics.Windows.Controls;assembly=InfragisticsWPF" xmlns:igEditorTypes="clr-namespace:Infragistics.Windows.Editors;assembly=InfragisticsWPF.Editors">
  <ribbon:RibbonTabItem Name="StreamSummaryRibbonTabItem" Header="{x:Static lc:GridFormsResources.StreamReport_Ribbon_TabHeader}" x:Uid="StreamSummaryRibbonTabItem">
    <FrameworkElement.Resources>
      <ResourceDictionary>
        <Style x:Key="{x:Type ribbon:XamRibbonScreenTip}" TargetType="{x:Type ribbon:XamRibbonScreenTip}">
          <Setter Property="igWpControls:XamScreenTip.FooterSeparatorVisibility" Value="Collapsed" />
        </Style>
        <BooleanToVisibilityConverter x:Key="btvConverter" />
      </ResourceDictionary>
    </FrameworkElement.Resources>
    <ribbon:RibbonGroup Caption="{x:Static lc:GridFormsResources.StreamReport_Ribbon_StreamGroup_Caption}" Margin="5,0,0,0">
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="10*" />
          <RowDefinition Height="10*" />
          <RowDefinition Height="10*" />
        </Grid.RowDefinitions>
        <ribbon:ComboEditorTool x:Name="comboStreamGroup" Margin="3,0,3,0" EditAreaWidth="180" DisplayMemberPath="Name">
          <igEditorTypes:XamComboEditor.ItemsSource>
            <Binding Path="StreamGroups" Mode="OneWay" />
          </igEditorTypes:XamComboEditor.ItemsSource>
          <igEditorTypes:ValueEditor.Value>
            <Binding Path="SelectedStreamGroup" Mode="TwoWay" />
          </igEditorTypes:ValueEditor.Value>
          <FrameworkElement.ToolTip>
            <ribbon:XamRibbonScreenTip Header="{x:Static lc:GridFormsResources.StreamReport_Ribbon_Display_SteamGroup}" Content="{x:Static lc:GridFormsResources.StreamReport_Ribbon_Display_SteamGroup_Tooltip}" />
          </FrameworkElement.ToolTip>
        </ribbon:ComboEditorTool>
        <StackPanel Orientation="Horizontal" Grid.Row="1">
          <ribbon:ButtonTool x:Name="buttonSaveCurrentGroup" LargeImage="../Images/SaveCurrentGroup16.png" Caption="{x:Static lc:GridFormsResources.StreamReport_Ribbon_StreamGroup_SaveCurrent}">
            <ButtonBase.Command>
              <Binding Path="SaveCurrentGroupCommand" Mode="OneWay" />
            </ButtonBase.Command>
            <FrameworkElement.ToolTip>
              <ribbon:XamRibbonScreenTip Header="{x:Static lc:GridFormsResources.StreamReport_Ribbon_StreamGroup_SaveCurrent}" Content="{x:Static lc:GridFormsResources.StreamReport_Ribbon_StreamGroup_SaveCurrent_Tooltip}" />
            </FrameworkElement.ToolTip>
          </ribbon:ButtonTool>
          <ribbon:ButtonTool x:Name="buttonCreateNewGroup" LargeImage="../Images/NewGroup16.png" Caption="{x:Static lc:GridFormsResources.StreamReport_Ribbon_StreamGroup_SaveAsNew}">
            <ButtonBase.Command>
              <Binding Path="CreateNewGroupCommand" Mode="OneWay" />
            </ButtonBase.Command>
            <FrameworkElement.ToolTip>
              <ribbon:XamRibbonScreenTip Header="{x:Static lc:GridFormsResources.StreamReport_Ribbon_StreamGroup_SaveAsNew}" Content="{x:Static lc:GridFormsResources.StreamReport_Ribbon_StreamGroup_SaveAsNew_Tooltip}" />
            </FrameworkElement.ToolTip>
          </ribbon:ButtonTool>
        </StackPanel>
        <ribbon:CheckBoxTool x:Name="checkShowChildHierarchyStreams" Grid.Row="2" Caption="{x:Static lc:GridFormsResources.StreamReport_Ribbon_Display_ShowChildHierarchyStreams}">
          <UIElement.IsEnabled>
            <Binding Path="HasChildHierarchyStreams" Mode="OneWay" />
          </UIElement.IsEnabled>
          <ToggleButton.IsChecked>
            <Binding Path="ShowChildHierarchyStreams" Mode="TwoWay" />
          </ToggleButton.IsChecked>
          <FrameworkElement.ToolTip>
            <ribbon:XamRibbonScreenTip Header="{x:Static lc:GridFormsResources.StreamReport_Ribbon_Display_ShowChildHierarchyStreams}" Content="{x:Static lc:GridFormsResources.StreamReport_Ribbon_Display_ShowChildHierarchyStreams_Tooltip}" />
          </FrameworkElement.ToolTip>
        </ribbon:CheckBoxTool>
      </Grid>
      <ribbon:RibbonGroup.DialogBoxLauncherTool>
        <ribbon:ButtonTool x:Name="buttonManageGroups" Template="{DynamicResource customDialogBoxLauncherTemplater}">
          <ButtonBase.Command>
            <Binding Path="ManageGroupsCommand" Mode="OneWay" />
          </ButtonBase.Command>
          <FrameworkElement.ToolTip>
            <ribbon:XamRibbonScreenTip Header="{x:Static lc:GridFormsResources.StreamReport_Ribbon_StreamGroup_ManageGroups}" Content="{x:Static lc:GridFormsResources.StreamReport_Ribbon_StreamGroup_ManageGroups_Tooltip}" />
          </FrameworkElement.ToolTip>
        </ribbon:ButtonTool>
      </ribbon:RibbonGroup.DialogBoxLauncherTool>
    </ribbon:RibbonGroup>
    <ribbon:RibbonGroup Caption="{x:Static lc:GridFormsResources.StreamReport_Ribbon_Template_Caption}" Margin="5,0,0,0">
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <StackPanel Orientation="Horizontal" Grid.Row="0" Width="147" Margin="0,0,3,0">
          <ribbon:ComboEditorTool x:Name="comboTemplate" EditAreaWidth="140" VerticalAlignment="Center" DisplayMemberPath="LocalizedName">
            <igEditorTypes:XamComboEditor.ItemsSource>
              <Binding Path="ReportTemplates" Mode="OneWay" />
            </igEditorTypes:XamComboEditor.ItemsSource>
            <igEditorTypes:XamComboEditor.SelectedItem>
              <Binding Path="SelectedReportTemplate" Mode="TwoWay" />
            </igEditorTypes:XamComboEditor.SelectedItem>
            <FrameworkElement.ToolTip>
              <ribbon:XamRibbonScreenTip Header="{x:Static lc:GridFormsResources.StreamReport_Ribbon_Display_Template}" Content="{x:Static lc:GridFormsResources.StreamReport_Ribbon_Display_Template_Tooltip}" />
            </FrameworkElement.ToolTip>
          </ribbon:ComboEditorTool>
          <Label x:Name="lblStar" Content="*" Foreground="#FFFF0000" Margin="2,0,0,0" VerticalAlignment="Center" />
        </StackPanel>
        <StackPanel Orientation="Horizontal" Grid.Row="1">
          <ribbon:ButtonTool x:Name="buttonSaveCurrentTemplate" LargeImage="../Images/SaveCurrentTemplate16.png" Caption="{x:Static lc:GridFormsResources.StreamReport_Ribbon_Template_SaveCurrent}">
            <ButtonBase.Command>
              <Binding Path="SaveCurrentTemplateCommand" Mode="OneWay" />
            </ButtonBase.Command>
            <FrameworkElement.ToolTip>
              <ribbon:XamRibbonScreenTip Header="{x:Static lc:GridFormsResources.StreamReport_Ribbon_Template_SaveCurrent}" Content="{x:Static lc:GridFormsResources.StreamReport_Ribbon_Template_SaveCurrent_Tooltip}" />
            </FrameworkElement.ToolTip>
          </ribbon:ButtonTool>
          <ribbon:ButtonTool x:Name="buttonCreateNewTemplate" LargeImage="../Images/NewTemplate16.png" Caption="{x:Static lc:GridFormsResources.StreamReport_Ribbon_Template_SaveAsNew}">
            <ButtonBase.Command>
              <Binding Path="CreateNewTemplateCommand" Mode="OneWay" />
            </ButtonBase.Command>
            <FrameworkElement.ToolTip>
              <ribbon:XamRibbonScreenTip Header="{x:Static lc:GridFormsResources.StreamReport_Ribbon_Template_SaveAsNew}" Content="{x:Static lc:GridFormsResources.StreamReport_Ribbon_Template_SaveAsNew_Tooltip}" />
            </FrameworkElement.ToolTip>
          </ribbon:ButtonTool>
        </StackPanel>
        <StackPanel Orientation="Horizontal" Grid.Row="2">
          <ribbon:ButtonTool x:Name="buttonDiscardChange" LargeImage="../Images/DiscardTemplateChange.png" Caption="{x:Static lc:GridFormsResources.StreamReport_Ribbon_Template_DiscardChange}">
            <ButtonBase.Command>
              <Binding Path="DiscardChangeCommand" Mode="OneWay" />
            </ButtonBase.Command>
            <FrameworkElement.ToolTip>
              <ribbon:XamRibbonScreenTip Header="{x:Static lc:GridFormsResources.StreamReport_Ribbon_Template_DiscardChange}" Content="{x:Static lc:GridFormsResources.StreamReport_Ribbon_Template_DiscardChange_Tooltip}" />
            </FrameworkElement.ToolTip>
          </ribbon:ButtonTool>
        </StackPanel>
      </Grid>
      <ribbon:RibbonGroup.DialogBoxLauncherTool>
        <ribbon:ButtonTool x:Name="buttonManageTemplates" Template="{DynamicResource customDialogBoxLauncherTemplater}">
          <ButtonBase.Command>
            <Binding Path="ManageTemplatesCommand" Mode="OneWay" />
          </ButtonBase.Command>
          <FrameworkElement.ToolTip>
            <ribbon:XamRibbonScreenTip Header="{x:Static lc:GridFormsResources.StreamReport_Ribbon_Template_ManageTemplates}" Content="{x:Static lc:GridFormsResources.StreamReport_Ribbon_Template_ManageTemplates_Tooltip}" />
          </FrameworkElement.ToolTip>
        </ribbon:ButtonTool>
      </ribbon:RibbonGroup.DialogBoxLauncherTool>
    </ribbon:RibbonGroup>
    <ribbon:RibbonGroup Caption="{x:Static lc:GridFormsResources.StreamReport_Ribbon_Options_Caption}">
      <ribbon:ButtonTool x:Name="buttonGeneralOptions" LargeImage="../Images/GeneralOptions32.png" ribbon:RibbonGroup.MaximumSize="ImageAndTextLarge" Caption="{x:Static lc:GridFormsResources.StreamReport_Ribbon_Options_GeneralOptions}">
        <ButtonBase.Command>
          <Binding Path="GeneralOptionsCommand" Mode="OneWay" />
        </ButtonBase.Command>
        <FrameworkElement.ToolTip>
          <ribbon:XamRibbonScreenTip Header="{x:Static lc:GridFormsResources.StreamReport_Ribbon_Options_GeneralOptions}" Content="{x:Static lc:GridFormsResources.StreamReport_Ribbon_Options_GeneralOptions_Tooltip}" />
        </FrameworkElement.ToolTip>
      </ribbon:ButtonTool>
      <ribbon:CheckBoxTool x:Name="checkOptionsTotal" Caption="{x:Static lc:GridFormsResources.StreamReport_Ribbon_Options_Total}">
        <ToggleButton.IsChecked>
          <Binding Path="TargetControl.TemplateItem.Settings.ScopeOptions.TotalStream" Mode="TwoWay" />
        </ToggleButton.IsChecked>
        <FrameworkElement.ToolTip>
          <ribbon:XamRibbonScreenTip Header="{x:Static lc:GridFormsResources.StreamReport_Ribbon_Options_Total}" Content="{x:Static lc:GridFormsResources.StreamReport_Ribbon_Options_Total_Tooltip}" />
        </FrameworkElement.ToolTip>
      </ribbon:CheckBoxTool>
      <ribbon:CheckBoxTool x:Name="checkOptionsSubstreams" Caption="{x:Static lc:GridFormsResources.StreamReport_Ribbon_Options_Substreams}">
        <ToggleButton.IsChecked>
          <Binding Path="TargetControl.TemplateItem.Settings.ScopeOptions.Substreams" Mode="TwoWay" />
        </ToggleButton.IsChecked>
        <FrameworkElement.ToolTip>
          <ribbon:XamRibbonScreenTip Header="{x:Static lc:GridFormsResources.StreamReport_Ribbon_Options_Substreams}" Content="{x:Static lc:GridFormsResources.StreamReport_Ribbon_Options_Substreams_Tooltip}" />
        </FrameworkElement.ToolTip>
      </ribbon:CheckBoxTool>
      <ribbon:CheckBoxTool x:Name="checkOptionsPhases" Caption="{x:Static lc:GridFormsResources.StreamReport_Ribbon_Options_Phases}">
        <UIElement.IsEnabled>
          <Binding Path="TargetControl.TemplateItem.Settings.ScopeOptions.Substreams" Mode="OneWay" />
        </UIElement.IsEnabled>
        <ToggleButton.IsChecked>
          <Binding Path="TargetControl.TemplateItem.Settings.ScopeOptions.PhasesForMixedSubstream" Mode="TwoWay" />
        </ToggleButton.IsChecked>
        <FrameworkElement.ToolTip>
          <ribbon:XamRibbonScreenTip Header="{x:Static lc:GridFormsResources.StreamReport_Ribbon_Options_Phases}" Content="{x:Static lc:GridFormsResources.StreamReport_Ribbon_Options_Phases_Tooltip}" />
        </FrameworkElement.ToolTip>
      </ribbon:CheckBoxTool>
    </ribbon:RibbonGroup>
    <ribbon:RibbonGroup Caption="{x:Static lc:GridFormsResources.StreamReport_Ribbon_Flows_Caption}">
      <ribbon:CheckBoxTool x:Name="checkFlowsMole" Caption="{x:Static lc:GridFormsResources.StreamReport_Ribbon_Flows_Mole}">
        <ToggleButton.IsChecked>
          <Binding Path="TargetControl.TemplateItem.Settings.ScopeOptions.MoleFlows" Mode="TwoWay" />
        </ToggleButton.IsChecked>
        <FrameworkElement.ToolTip>
          <ribbon:XamRibbonScreenTip Header="{x:Static lc:GridFormsResources.StreamReport_Ribbon_Flows_Mole}" Content="{x:Static lc:GridFormsResources.StreamReport_Ribbon_Flows_Mole_Tooltip}" />
        </FrameworkElement.ToolTip>
      </ribbon:CheckBoxTool>
      <ribbon:CheckBoxTool x:Name="checkFlowsMass" Caption="{x:Static lc:GridFormsResources.StreamReport_Ribbon_Flows_Mass}">
        <ToggleButton.IsChecked>
          <Binding Path="TargetControl.TemplateItem.Settings.ScopeOptions.MassFlows" Mode="TwoWay" />
        </ToggleButton.IsChecked>
        <FrameworkElement.ToolTip>
          <ribbon:XamRibbonScreenTip Header="{x:Static lc:GridFormsResources.StreamReport_Ribbon_Flows_Mass}" Content="{x:Static lc:GridFormsResources.StreamReport_Ribbon_Flows_Mass_Tooltip}" />
        </FrameworkElement.ToolTip>
      </ribbon:CheckBoxTool>
      <ribbon:CheckBoxTool x:Name="checkFlowsVolume" Caption="{x:Static lc:GridFormsResources.StreamReport_Ribbon_Flows_Volume}">
        <ToggleButton.IsChecked>
          <Binding Path="TargetControl.TemplateItem.Settings.ScopeOptions.VolumeFlows" Mode="TwoWay" />
        </ToggleButton.IsChecked>
        <FrameworkElement.ToolTip>
          <ribbon:XamRibbonScreenTip Header="{x:Static lc:GridFormsResources.StreamReport_Ribbon_Flows_Volume}" Content="{x:Static lc:GridFormsResources.StreamReport_Ribbon_Flows_Volume_Tooltip}" />
        </FrameworkElement.ToolTip>
      </ribbon:CheckBoxTool>
    </ribbon:RibbonGroup>
    <ribbon:RibbonGroup Caption="{x:Static lc:GridFormsResources.StreamReport_Ribbon_Composition_Caption}">
      <ribbon:CheckBoxTool x:Name="checkCompositionMole" Caption="{x:Static lc:GridFormsResources.StreamReport_Ribbon_Composition_Mole}">
        <ToggleButton.IsChecked>
          <Binding Path="TargetControl.TemplateItem.Settings.ScopeOptions.MoleFractions" Mode="TwoWay" />
        </ToggleButton.IsChecked>
        <FrameworkElement.ToolTip>
          <ribbon:XamRibbonScreenTip Header="{x:Static lc:GridFormsResources.StreamReport_Ribbon_Composition_Mole}" Content="{x:Static lc:GridFormsResources.StreamReport_Ribbon_Composition_Mole_Tooltip}" />
        </FrameworkElement.ToolTip>
      </ribbon:CheckBoxTool>
      <ribbon:CheckBoxTool x:Name="checkCompositionMass" Caption="{x:Static lc:GridFormsResources.StreamReport_Ribbon_Composition_Mass}">
        <ToggleButton.IsChecked>
          <Binding Path="TargetControl.TemplateItem.Settings.ScopeOptions.MassFractions" Mode="TwoWay" />
        </ToggleButton.IsChecked>
        <FrameworkElement.ToolTip>
          <ribbon:XamRibbonScreenTip Header="{x:Static lc:GridFormsResources.StreamReport_Ribbon_Composition_Mass}" Content="{x:Static lc:GridFormsResources.StreamReport_Ribbon_Composition_Mass_Tooltip}" />
        </FrameworkElement.ToolTip>
      </ribbon:CheckBoxTool>
    </ribbon:RibbonGroup>
    <ribbon:RibbonGroup Caption="{x:Static lc:GridFormsResources.StreamReport_Ribbon_PropertySets_Caption}">
      <ribbon:ButtonTool x:Name="buttonSelectProperties" LargeImage="../Images/SelectProperties32.png" ribbon:RibbonGroup.MaximumSize="ImageAndTextLarge" Caption="{x:Static lc:GridFormsResources.StreamReport_Ribbon_PropertySets_SelectProperties}">
        <ButtonBase.Command>
          <Binding Path="SelectPropertiesCommand" Mode="OneWay" />
        </ButtonBase.Command>
        <FrameworkElement.ToolTip>
          <ribbon:XamRibbonScreenTip Header="{x:Static lc:GridFormsResources.StreamReport_Ribbon_PropertySets_SelectProperties}" Content="{x:Static lc:GridFormsResources.StreamReport_Ribbon_PropertySets_SelectProperties_Tooltip}" />
        </FrameworkElement.ToolTip>
      </ribbon:ButtonTool>
      <ribbon:ButtonTool x:Name="buttonDisplayOptions" LargeImage="../Images/DisplayOptions32.png" ribbon:RibbonGroup.MaximumSize="ImageAndTextLarge" Caption="{x:Static lc:GridFormsResources.StreamReport_Ribbon_PropertySets_DisplayOptions}">
        <ButtonBase.Command>
          <Binding Path="DisplayOptionsCommand" Mode="OneWay" />
        </ButtonBase.Command>
        <FrameworkElement.ToolTip>
          <ribbon:XamRibbonScreenTip Header="{x:Static lc:GridFormsResources.StreamReport_Ribbon_PropertySets_DisplayOptions}" Content="{x:Static lc:GridFormsResources.StreamReport_Ribbon_PropertySets_DisplayOptions_Tooltip}" />
        </FrameworkElement.ToolTip>
      </ribbon:ButtonTool>
      <ribbon:ButtonTool x:Name="buttonCalculationOptions" LargeImage="../Images/CalculationOptions32.png" ribbon:RibbonGroup.MaximumSize="ImageAndTextLarge" Caption="{x:Static lc:GridFormsResources.StreamReport_Ribbon_PropertySets_CalculationOptions}">
        <ButtonBase.Command>
          <Binding Path="CalculationOptionsCommand" Mode="OneWay" />
        </ButtonBase.Command>
        <FrameworkElement.ToolTip>
          <ribbon:XamRibbonScreenTip Header="{x:Static lc:GridFormsResources.StreamReport_Ribbon_PropertySets_CalculationOptions}" Content="{x:Static lc:GridFormsResources.StreamReport_Ribbon_PropertySets_CalculationOptions_Tooltip}" />
        </FrameworkElement.ToolTip>
      </ribbon:ButtonTool>
    </ribbon:RibbonGroup>
    <ribbon:RibbonGroup Caption="{x:Static lc:GridFormsResources.StreamReport_Ribbon_Report_Caption}">
      <ribbon:ButtonTool x:Name="buttonSendToExcel" LargeImage="../Images/SendToExcel16.png" Caption="{x:Static lc:GridFormsResources.StreamReport_Ribbon_Report_SendToExcelASW}">
        <ButtonBase.Command>
          <Binding Path="SendToExcelAswCommand" Mode="OneWay" />
        </ButtonBase.Command>
        <FrameworkElement.ToolTip>
          <ribbon:XamRibbonScreenTip Header="{x:Static lc:GridFormsResources.StreamReport_Ribbon_Report_SendToExcelASW}" Content="{x:Static lc:GridFormsResources.StreamReport_Ribbon_Report_SendToExcelASW_Tooltip}" />
        </FrameworkElement.ToolTip>
      </ribbon:ButtonTool>
      <ribbon:ButtonTool x:Name="buttonSendToFlowsheet" LargeImage="../Images/SendToFlowsheet16.png" Caption="{x:Static lc:GridFormsResources.StreamReport_Ribbon_Report_SendToFlowsheet}">
        <ButtonBase.Command>
          <Binding Path="SendToFlowsheetCommand" Mode="OneWay" />
        </ButtonBase.Command>
        <FrameworkElement.ToolTip>
          <ribbon:XamRibbonScreenTip Header="{x:Static lc:GridFormsResources.StreamReport_Ribbon_Report_SendToFlowsheet}" Content="{x:Static lc:GridFormsResources.StreamReport_Ribbon_Report_SendToFlowsheet_Tooltip}" />
        </FrameworkElement.ToolTip>
      </ribbon:ButtonTool>
      <ribbon:ButtonTool x:Name="buttonCopyAll" LargeImage="{x:Static gcInternal:ImageSourceHelper.Copy16}" Caption="{x:Static lc:GridFormsResources.StreamReport_Ribbon_Report_CopyAll}">
        <ButtonBase.Command>
          <Binding Path="CopyAllCommand" Mode="OneWay" />
        </ButtonBase.Command>
        <FrameworkElement.ToolTip>
          <ribbon:XamRibbonScreenTip Header="{x:Static lc:GridFormsResources.StreamReport_Ribbon_Report_CopyAll}" Content="{x:Static lc:GridFormsResources.StreamReport_Ribbon_Report_CopyAll_Tooltip}" />
