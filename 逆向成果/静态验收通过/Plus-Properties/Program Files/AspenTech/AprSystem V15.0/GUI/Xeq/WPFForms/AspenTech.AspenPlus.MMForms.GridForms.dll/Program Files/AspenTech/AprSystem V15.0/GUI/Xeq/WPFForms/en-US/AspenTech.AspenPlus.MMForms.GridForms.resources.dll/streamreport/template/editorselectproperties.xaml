<?xml version='1.0' encoding='utf-8'?>
<UserControl x:Class="AspenTech.AspenPlus.MMForms.GridForms.StreamReport.Template.EditorSelectProperties" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:te="clr-namespace:AspenTech.AspenPlus.MMForms.GridForms.StreamReport.Template" xmlns:lc="clr-namespace:AspenTech.AspenPlus.Localization;assembly=AspenTech.AspenPlus.Localization" xmlns:images="http://schemas.aspentech.com/xaml/presentation/visualisation/commonimages">
  <FrameworkElement.Resources>
    <ResourceDictionary>
      <te:TemplatePropertyItemToForegroundConverter x:Key="tpiToForegroundConverter" />
      <te:PropertiesFilterConverter x:Key="filterConverter" />
      <Style x:Key="imageButtonStyle" TargetType="{x:Type Button}" BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="FrameworkElement.MinWidth" Value="0" />
        <Setter Property="FrameworkElement.MinHeight" Value="0" />
        <Setter Property="FrameworkElement.Margin" Value="0" />
        <Style.Triggers>
          <Trigger Property="UIElement.IsEnabled" Value="False">
            <Setter Property="UIElement.Opacity" Value="0.5" />
          </Trigger>
        </Style.Triggers>
      </Style>
      <Style x:Key="propertyItemStyle" TargetType="{x:Type ListBoxItem}">
        <Setter Property="te:TemplatePropertyTooltip.PropertyItem">
          <Setter.Value>
            <Binding Mode="OneWay" />
          </Setter.Value>
        </Setter>
        <Setter Property="TextElement.Foreground">
          <Setter.Value>
            <Binding Converter="{StaticResource tpiToForegroundConverter}" Mode="OneWay" />
          </Setter.Value>
        </Setter>
      </Style>
      <images:CommonImages x:Key="shellImages" />
    </ResourceDictionary>
  </FrameworkElement.Resources>
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="*" />
      <ColumnDefinition Width="Auto" />
      <ColumnDefinition Width="Auto" />
    </Grid.ColumnDefinitions>
    <CheckBox Grid.Row="0" Grid.Column="0" Margin="0,0,0,4" Content="{x:Static lc:GridFormsResources.StreamSummaryTemplate_Editor_HideStateConditions}">
      <ToggleButton.IsChecked>
        <Binding Path="HideStateConditions" Mode="TwoWay">
          <Binding.RelativeSource>
            <RelativeSource AncestorType="UserControl" Mode="FindAncestor" />
          </Binding.RelativeSource>
        </Binding>
      </ToggleButton.IsChecked>
    </CheckBox>
    <ListBox x:Name="listBoxProperties" Grid.Row="1" Grid.Column="0" SelectionMode="Extended" DisplayMemberPath="DisplayName" ItemContainerStyle="{StaticResource propertyItemStyle}" Margin="{DynamicResource AspenHorizontalRelativeControlMargin}">
      <ItemsControl.ItemsSource>
        <MultiBinding Converter="{StaticResource filterConverter}" Mode="OneWay">
          <Binding Path="Properties" />
          <Binding Path="UserAddedProperties" />
          <Binding Path="HideStateConditions">
            <Binding.RelativeSource>
              <RelativeSource AncestorType="UserControl" Mode="FindAncestor" />
            </Binding.RelativeSource>
          </Binding>
        </MultiBinding>
      </ItemsControl.ItemsSource>
    </ListBox>
    <StackPanel Grid.Row="1" Grid.Column="1" VerticalAlignment="Center" Margin="{DynamicResource AspenHorizontalRelativeControlMargin}">
      <Button x:Name="buttonUp" x:Uid="buttonUp" Margin="{DynamicResource AspenVerticalRelativeControlMargin}" Style="{StaticResource imageButtonStyle}">
        <ButtonBase.Command>
          <Binding Path="MoveUpCommand">
            <Binding.RelativeSource>
              <RelativeSource AncestorType="UserControl" Mode="FindAncestor" />
            </Binding.RelativeSource>
          </Binding>
        </ButtonBase.Command>
        <Image Stretch="None">
          <Image.Source>
            <Binding Source="{StaticResource shellImages}" Path="MoveUp_16" />
          </Image.Source>
        </Image>
      </Button>
      <Button x:Name="buttonDown" x:Uid="buttonDown" Style="{StaticResource imageButtonStyle}">
        <ButtonBase.Command>
          <Binding Path="MoveDownCommand">
            <Binding.RelativeSource>
              <RelativeSource AncestorType="UserControl" Mode="FindAncestor" />
            </Binding.RelativeSource>
          </Binding>
        </ButtonBase.Command>
        <Image Stretch="None">
          <Image.Source>
            <Binding Source="{StaticResource shellImages}" Path="MoveDown_16" />
          </Image.Source>
        </Image>
      </Button>
    </StackPanel>
    <StackPanel Grid.Row="1" Grid.Column="2" VerticalAlignment="Top" Margin="{DynamicResource AspenHorizontalRelativeControlMargin}">
      <Button Content="{x:Static lc:GridFormsResources.StreamSummaryTemplate_SelectProperties_Add}" Margin="{DynamicResource AspenVerticalRelativeControlMargin}">
        <ButtonBase.Command>
          <Binding Path="AddPropertyCommand">
            <Binding.RelativeSource>
              <RelativeSource AncestorType="UserControl" Mode="FindAncestor" />
            </Binding.RelativeSource>
          </Binding>
        </ButtonBase.Command>
      </Button>
      <Button x:Name="PrpSetBtn" Content="{x:Static lc:GridFormsResources.StreamSummaryTemplate_SelectProperties_UserPropSet}" Margin="{DynamicResource AspenVerticalRelativeControlMargin}" ToolTip="{x:Static lc:GridFormsResources.StreamSummaryTemplate_SelectProperties_UserPropSetToolTip}">
        <ButtonBase.Command>
          <Binding Path="GetUserPropSetCommand">
            <Binding.RelativeSource>
              <RelativeSource AncestorType="UserControl" Mode="FindAncestor" />
            </Binding.RelativeSource>
          </Binding>
        </ButtonBase.Command>
      </Button>
      <Button Content="{x:Static lc:GridFormsResources.StreamSummaryTemplate_SelectProperties_Remove}" Margin="{DynamicResource AspenVerticalRelativeControlMargin}">
        <ButtonBase.Command>
          <Binding Path="RemovePropertyCommand">
            <Binding.RelativeSource>
              <RelativeSource AncestorType="UserControl" Mode="FindAncestor" />
            </Binding.RelativeSource>
          </Binding>
        </ButtonBase.Command>
      </Button>
    </StackPanel>
  </Grid>
</UserControl>
