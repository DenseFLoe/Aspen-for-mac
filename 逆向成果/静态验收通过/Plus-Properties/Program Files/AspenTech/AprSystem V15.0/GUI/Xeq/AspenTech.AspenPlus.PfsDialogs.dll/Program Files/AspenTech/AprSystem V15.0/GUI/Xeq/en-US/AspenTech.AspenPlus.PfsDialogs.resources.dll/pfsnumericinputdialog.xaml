<?xml version='1.0' encoding='utf-8'?>
<Window x:Class="AspenTech.AspenPlus.PfsDialogs.PFSNumericInputDialog" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:my="clr-namespace:AspenTech.AspenPlus.PfsDialogs" xmlns:res="clr-namespace:AspenTech.AspenPlus.Localization;assembly=AspenTech.AspenPlus.Localization" Loaded="OnDialogLoaded" x:Uid="Window_1" Title="{x:Static res:WpfPfsDialogsResources.RuntimeCaption}" Style="{StaticResource MMDialogStyle}" SizeToContent="WidthAndHeight" ResizeMode="NoResize" ShowInTaskbar="False" WindowStartupLocation="CenterOwner">
  <StackPanel Name="stackPanel1" x:Uid="stackPanel1" Margin="10,10,10,0">
    <TextBlock Name="inputPrompt" x:Uid="inputPrompt" Text="{x:Static res:WpfPfsDialogsResources.RuntimePrompt}" FontSize="12" Margin="0,0,0,5" />
    <DockPanel Name="dockPanel1" x:Uid="dockPanel1">
      <TextBox TextChanged="OnTextChanged" PreviewTextInput="OnPreviewTextInput" PreviewKeyDown="OnPreviewKeyDown" Name="inputText" x:Uid="inputText" FontSize="12" MinWidth="120" VerticalScrollBarVisibility="Disabled" DockPanel.Dock="Left" Width="145">
        <TextBox.Text>
          <Binding x:Uid="Binding_1" Path="StrInput" UpdateSourceTrigger="PropertyChanged" RelativeSource="{RelativeSource FindAncestor, AncestorType=my:PFSNumericInputDialog, AncestorLevel=1}" />
        </TextBox.Text>
      </TextBox>
      <ScrollBar Scroll="OnScroll" Name="scrollBar1" x:Uid="scrollBar1" Height="22" Width="12" MinWidth="0" DockPanel.Dock="Left" />
    </DockPanel>
    <StackPanel Name="stackPanel3" x:Uid="stackPanel3" Orientation="Horizontal" HorizontalAlignment="Center">
      <Button Click="OnClickOk" Name="btnOK" x:Uid="btnOK" Content="{x:Static res:WpfPfsDialogsResources.BtnOk}" IsDefault="True" Margin="10" MinWidth="60" />
      <Button Click="OnClickCancel" Name="btnCancel" x:Uid="btnCancel" Content="{x:Static res:WpfPfsDialogsResources.BtnCancel}" Margin="10" MinWidth="60" />
    </StackPanel>
  </StackPanel>
</Window>
