<?xml version='1.0' encoding='utf-8'?>
<UserControl x:Class="AspenTech.AspenPlus.MMDialogs.FileInputBox" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:res="clr-namespace:AspenTech.AspenPlus.Localization;assembly=AspenTech.AspenPlus.Localization" x:Uid="UserControl_1">
  <DockPanel x:Uid="DockPanel_1">
    <TextBox Name="theTextBox" x:Uid="theTextBox" Width="250" Margin="0,0,2,0">
      <FrameworkElement.MinWidth>
        <Binding Path="ActualWidth" ElementName="theButton" />
      </FrameworkElement.MinWidth>
    </TextBox>
    <Button Click="theButton_Click" Name="theButton" x:Uid="theButton" DockPanel.Dock="Right" Content="{x:Static res:WpfMMDialogResources.Browse}" />
  </DockPanel>
</UserControl>
