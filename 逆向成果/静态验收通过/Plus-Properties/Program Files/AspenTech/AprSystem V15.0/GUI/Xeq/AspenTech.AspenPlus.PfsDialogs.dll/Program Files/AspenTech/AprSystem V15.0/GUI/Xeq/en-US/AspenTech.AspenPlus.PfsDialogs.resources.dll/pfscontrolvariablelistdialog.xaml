<?xml version='1.0' encoding='utf-8'?>
<Window x:Class="AspenTech.AspenPlus.PfsDialogs.ControlVariableListDialog" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:AspenTech.AspenPlus.PfsDialogs" xmlns:res="clr-namespace:AspenTech.AspenPlus.Localization;assembly=AspenTech.AspenPlus.Localization" xmlns:mm="http://schemas.aspentech.com/xaml/presentation/aspenplus" xmlns:atSupport="http://schemas.aspentech.com/xaml/presentation/visualisation/support" x:Name="dlg" x:Uid="dlg" ResizeMode="NoResize" SizeToContent="WidthAndHeight" ShowInTaskbar="False" MaxHeight="500" Title="{x:Static res:WpfPfsDialogsResources.PFSControlVariableListDialog_Title}" Style="{StaticResource MMDialogStyle}">
  <mm:MMHelp.HelpFile>
    <Binding Path="HelpFile" />
  </mm:MMHelp.HelpFile>
  <mm:MMHelp.HelpId>
    <Binding Path="HelpId" />
  </mm:MMHelp.HelpId>
  <Grid Name="grid1" x:Uid="grid1" Margin="{StaticResource AspenDialogOuterMargin}">
    <Grid.RowDefinitions>
      <RowDefinition x:Uid="RowDefinition_1" Height="Auto" />
      <RowDefinition x:Uid="RowDefinition_2" Height="Auto" />
    </Grid.RowDefinitions>
    <Grid.ColumnDefinitions>
      <ColumnDefinition x:Uid="ColumnDefinition_1" Width="*" />
      <ColumnDefinition x:Uid="ColumnDefinition_2" Width="*" />
    </Grid.ColumnDefinitions>
    <Button Click="Ok_Click" Name="CVListOk" x:Uid="Ok" Grid.Row="1" Grid.Column="0" Content="{x:Static res:WpfMMDialogResources.Ok}" Margin="10" HorizontalAlignment="Center" IsEnabled="True" />
    <Button Name="Cancel" x:Uid="Cancel" Grid.Row="1" Grid.Column="1" Content="{x:Static res:WpfMMDialogResources.Cancel}" Margin="10" IsCancel="True" HorizontalAlignment="Center" IsEnabled="True" />
    <DataGrid Name="dgVariableList" x:Uid="ControlVariableList" Grid.Row="0" Grid.ColumnSpan="2" AutoGenerateColumns="False" CanUserAddRows="False" CanUserSortColumns="False" SelectionUnit="FullRow">
      <DataGrid.Columns>
        <DataGridTextColumn Header="{x:Static res:WpfPfsDialogsResources.PFSControlVariableListDialog_Name}" IsReadOnly="True" Binding="{Binding Name}" />
        <DataGridTextColumn Header="{x:Static res:WpfPfsDialogsResources.PFSControlVariableListDialog_Description}" IsReadOnly="True" Binding="{Binding Description}" />
      </DataGrid.Columns>
    </DataGrid>
  </Grid>
</Window>
