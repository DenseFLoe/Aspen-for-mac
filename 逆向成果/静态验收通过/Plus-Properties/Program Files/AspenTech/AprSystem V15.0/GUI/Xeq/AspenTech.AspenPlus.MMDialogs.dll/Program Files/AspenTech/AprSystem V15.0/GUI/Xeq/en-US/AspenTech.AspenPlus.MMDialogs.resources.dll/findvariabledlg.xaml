<?xml version='1.0' encoding='utf-8'?>
<Window x:Class="AspenTech.AspenPlus.MMDialogs.FindVariableDlg" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:mm="http://schemas.aspentech.com/xaml/presentation/aspenplus" xmlns:res="clr-namespace:AspenTech.AspenPlus.Localization;assembly=AspenTech.AspenPlus.Localization" xmlns:local="clr-namespace:AspenTech.AspenPlus.MMDialogs" Name="DlgSearchVar" x:Uid="DlgSearchVar" mm:MMHelp.HelpId="29" WindowStartupLocation="CenterOwner" Title="{x:Static res:WpfMMDialogResources.FindVarCap}" ResizeMode="CanResize" MinWidth="400" Height="400" SizeToContent="Width" ShowInTaskbar="False" Style="{StaticResource MMDialogStyle}">
  <mm:MMHelp.HelpFile>
    <Binding Path="HelpFile" FallbackValue="hlpflwop.chm" />
  </mm:MMHelp.HelpFile>
  <FrameworkElement.Resources>
    <ResourceDictionary>
      <DataTemplate x:Key="DescCellTemplate" x:Uid="DataTemplate_1">
        <TextBlock x:Uid="TextBlock_1" TextTrimming="CharacterEllipsis">
          <TextBlock.Text>
            <Binding Path="Alias" />
          </TextBlock.Text>
        </TextBlock>
      </DataTemplate>
      <DataTemplate x:Key="HeaderTemplateArrowUp" x:Uid="DataTemplate_2">
        <DockPanel x:Uid="DockPanel_1">
          <TextBlock x:Uid="TextBlock_2" HorizontalAlignment="Center">
            <TextBlock.Text>
              <Binding />
            </TextBlock.Text>
          </TextBlock>
          <Path x:Name="arrow" x:Uid="arrow" StrokeThickness="1" Fill="#FF808080" Data="M5,10L15,10 10,5 5,10" />
        </DockPanel>
      </DataTemplate>
      <DataTemplate x:Key="HeaderTemplateArrowDown" x:Uid="DataTemplate_3">
        <DockPanel x:Uid="DockPanel_2">
          <TextBlock x:Uid="TextBlock_3" HorizontalAlignment="Center">
            <TextBlock.Text>
              <Binding />
            </TextBlock.Text>
          </TextBlock>
          <Path x:Name="arrow" x:Uid="Path_1" StrokeThickness="1" Fill="#FF808080" Data="M5,5L10,10 15,5 5,5" />
        </DockPanel>
      </DataTemplate>
    </ResourceDictionary>
  </FrameworkElement.Resources>
  <DockPanel x:Uid="DockPanel_3" LastChildFill="True" Margin="{StaticResource AspenDialogOuterMargin}">
    <StackPanel x:Uid="StackPanel_1" DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Bottom">
      <Button x:Uid="Button_1" Content="{x:Static res:WpfMMDialogResources.BtnSelect}" Margin="{StaticResource AspenHorizontalRelativeControlMargin}">
        <ButtonBase.Command>
          <Binding ElementName="DlgSearchVar" Path="CommandOnOK" />
        </ButtonBase.Command>
      </Button>
      <Button x:Uid="Button_2" Content="{x:Static res:WpfSimdllResources.BtnCancel}" IsCancel="True" Margin="{StaticResource AspenHorizontalRelativeControlMargin}" />
      <Button x:Uid="Button_3" Content="{x:Static res:WpfSimdllResources.BtnHelp}" Command="ApplicationCommands.Help" Margin="{StaticResource AspenNoMargin}" />
    </StackPanel>
    <Grid x:Uid="Grid_1" Margin="{StaticResource AspenVerticalRelativeControlMargin}">
      <Grid.RowDefinitions>
        <RowDefinition x:Uid="RowDefinition_1" Height="Auto" />
        <RowDefinition x:Uid="RowDefinition_2" Height="*" />
      </Grid.RowDefinitions>
      <GroupBox x:Uid="GroupBox_1" Header="{x:Static res:WpfMMDialogResources.LblSearchCriteria}" Grid.Row="0">
        <StackPanel x:Uid="StackPanel_2" Orientation="Horizontal">
          <TextBox x:Name="txtSearchCriteria" x:Uid="txtSearchCriteria" Width="220" Margin="{StaticResource AspenHorizontalRelativeControlMargin}">
            <TextBox.Text>
              <Binding ElementName="DlgSearchVar" Path="SearchVaribale" Mode="TwoWay" UpdateSourceTrigger="PropertyChanged" />
            </TextBox.Text>
          </TextBox>
          <Button Click="BtnSearch_Click" x:Name="btnSearch" x:Uid="btnSearch" Content="{x:Static res:WpfMMDialogResources.BtnSearch}" IsDefault="True" Margin="{StaticResource AspenNoMargin}" />
        </StackPanel>
      </GroupBox>
      <GroupBox x:Uid="GroupBox_2" Header="{x:Static res:WpfMMDialogResources.LblSearchLst}" Grid.Row="1">
        <ListView ButtonBase.Click="GridViewColumnHeaderClickedHandler" x:Name="lv" x:Uid="lv" SelectionMode="Single" MinHeight="180">
          <ItemsControl.ItemsSource>
            <Binding ElementName="DlgSearchVar" Path="AllFoundVariable" Mode="TwoWay" />
          </ItemsControl.ItemsSource>
          <Selector.SelectedItem>
            <Binding ElementName="DlgSearchVar" Path="SelectedItem" Mode="TwoWay" />
          </Selector.SelectedItem>
          <ItemsControl.ItemContainerStyle>
            <Style x:Uid="Style_1" TargetType="{x:Type ListViewItem}">
              <EventSetter Event="Control.MouseDoubleClick" Handler="ListView_MouseDoubleClick" />
            </Style>
          </ItemsControl.ItemContainerStyle>
          <ListView.View>
            <GridView x:Uid="GridView_1" ColumnHeaderToolTip="{x:Static res:WpfMMDialogResources.VSearchInfo}">
              <GridViewColumn x:Uid="GridViewColumn_1" Header="{x:Static res:WpfMMDialogResources.VariableName}" Width="100">
                <GridViewColumn.DisplayMemberBinding>
                  <Binding Path="Name" Mode="OneWay" />
                </GridViewColumn.DisplayMemberBinding>
              </GridViewColumn>
              <GridViewColumn x:Uid="GridViewColumn_2" Header="{x:Static res:WpfMMDialogResources.Description}" Width="180" CellTemplate="{StaticResource DescCellTemplate}" />
            </GridView>
          </ListView.View>
        </ListView>
      </GroupBox>
    </Grid>
  </DockPanel>
</Window>
