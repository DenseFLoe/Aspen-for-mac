<?xml version='1.0' encoding='utf-8'?>
<Window x:Class="AspenTech.AspenPlus.MMForms.CustomForms.CaseVariablesBrowser" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:res="clr-namespace:AspenTech.AspenPlus.Localization;assembly=AspenTech.AspenPlus.Localization" Title="{x:Static res:CustomFormsResources.VariablesBrowser_CaseVariablesBrowser}" Height="600" Width="600" x:Uid="Window_1">
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="30" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>
    <StackPanel Orientation="Horizontal" Grid.Row="2" HorizontalAlignment="Right">
      <Button Click="btnCancel_Click" x:Name="btnCancel" Margin="12" MinWidth="72" Height="32" Content="{x:Static res:CustomFormsResources.VariablesBrowser_Cancel}" x:Uid="btnCancel" />
      <Button Click="btnOK_Click" x:Name="btnOK" Margin="12" MinWidth="72" Height="32" Content="{x:Static res:CustomFormsResources.VariablesBrowser_OK}" x:Uid="btnOK" />
    </StackPanel>
    <TextBlock VerticalAlignment="Center" FontWeight="Bold" Grid.Row="0" HorizontalAlignment="Center" Text="{x:Static res:CustomFormsResources.VariablesBrowser_SelectCaseVariables}" x:Uid="TextBlock_1" />
    <Grid x:Name="gridBrowser" Grid.Row="1" />
  </Grid>
</Window>
