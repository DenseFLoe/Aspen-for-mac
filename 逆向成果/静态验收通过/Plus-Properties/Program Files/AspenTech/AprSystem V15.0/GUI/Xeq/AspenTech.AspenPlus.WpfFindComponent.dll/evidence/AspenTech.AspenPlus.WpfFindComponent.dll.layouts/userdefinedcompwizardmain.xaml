<?xml version='1.0' encoding='utf-8'?>
<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:mm="clr-namespace:AspenTech.AspenPlus.MMControls;assembly=AspenTech.AspenPlus.MMControls" xmlns:mc="clr-namespace:AspenTech.AspenPlus.ModelLibrary.Controls;assembly=AspenTech.AspenPlus.ModelLibrary.Controls" xmlns:res="clr-namespace:AspenTech.AspenPlus.Localization;assembly=AspenTech.AspenPlus.Localization" x:Uid="Window_1" mm:MMHelp.HelpFile="cmpnts.chm" mm:MMHelp.HelpId="144" ResizeMode="NoResize" ShowInTaskbar="False" Width="650" Height="525" WindowStartupLocation="CenterOwner" Title="{x:Static res:WpfFindComponentResources.UserDefinedComWizard}" Style="{StaticResource MMDialogStyle}" x:Class="AspenTech.AspenPlus.WpfFindComponent.UserDefinedCompWizardMain">
  <Grid x:Uid="Grid_1" Margin="{DynamicResource AspenDialogOuterMargin}">
    <Grid.RowDefinitions>
      <RowDefinition x:Uid="RowDefinition_1" Height="Auto" />
      <RowDefinition x:Uid="RowDefinition_2" Height="{DynamicResource AspenVerticalRelativeLength}" />
      <RowDefinition x:Uid="RowDefinition_3" Height="Auto" />
      <RowDefinition x:Uid="RowDefinition_4" Height="{DynamicResource AspenVerticalRelativeLength}" />
      <RowDefinition x:Uid="RowDefinition_5" Height="*" />
      <RowDefinition x:Uid="RowDefinition_6" Height="{DynamicResource AspenVerticalRelativeLength}" />
      <RowDefinition x:Uid="RowDefinition_7" Height="Auto" />
      <RowDefinition x:Uid="RowDefinition_8" Height="{DynamicResource AspenVerticalRelativeLength}" />
      <RowDefinition x:Uid="RowDefinition_9" Height="Auto" />
    </Grid.RowDefinitions>
    <Border x:Uid="Border_1" Grid.Row="0">
      <Label x:Uid="Label_1" FontWeight="Medium">
        <ContentControl.Content>
          <Binding ElementName="theWizard" Path="CurrentItem.Title" Mode="OneWay" />
        </ContentControl.Content>
      </Label>
    </Border>
    <Border x:Uid="Border_2" Grid.Row="2">
      <Separator x:Uid="Separator_1" />
    </Border>
    <Border x:Uid="Border_3" Grid.Row="4">
      <mc:WizardControl Finished="theWizard_Finished" Name="theWizard" x:Uid="theWizard" Margin="10" />
    </Border>
    <Border x:Uid="Border_4" Grid.Row="6">
      <Separator x:Uid="Separator_2" />
    </Border>
    <StackPanel x:Uid="StackPanel_1" Orientation="Horizontal" HorizontalAlignment="Right" Grid.Row="8">
      <Button Click="buttonCancel_Click" Name="buttonCancel" x:Uid="buttonCancel" IsCancel="True" Margin="{DynamicResource AspenHorizontalRelativeControlMargin}" Content="{x:Static res:WpfFindComponentResources.Cancel}" />
      <Button x:Uid="Button_1" Command="{x:Static mc:WizardControl.BackwardCommand}" Content="{x:Static res:WpfFindComponentResources.Back}">
        <ButtonBase.CommandTarget>
          <Binding ElementName="theWizard" />
        </ButtonBase.CommandTarget>
      </Button>
      <Button x:Uid="Button_2" Command="{x:Static mc:WizardControl.ForwardCommand}" Content="{x:Static res:WpfFindComponentResources.Next}">
        <ButtonBase.CommandTarget>
          <Binding ElementName="theWizard" />
        </ButtonBase.CommandTarget>
      </Button>
      <Button x:Uid="Button_3" Command="{x:Static mc:WizardControl.FinishCommand}" Content="{x:Static res:WpfFindComponentResources.Finish}">
        <ButtonBase.CommandTarget>
          <Binding ElementName="theWizard" />
        </ButtonBase.CommandTarget>
      </Button>
    </StackPanel>
  </Grid>
</Window>
