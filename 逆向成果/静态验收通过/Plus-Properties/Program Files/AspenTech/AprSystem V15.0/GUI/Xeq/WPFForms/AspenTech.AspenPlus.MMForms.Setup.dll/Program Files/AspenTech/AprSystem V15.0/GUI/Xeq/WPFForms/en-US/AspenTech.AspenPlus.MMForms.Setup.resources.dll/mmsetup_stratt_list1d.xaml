<?xml version='1.0' encoding='utf-8'?>
<MMTabPage x:Class="AspenTech.AspenPlus.MMForms.Setup.MMSetup_Stratt_List1D" xmlns="http://schemas.aspentech.com/xaml/presentation/aspenplus" xmlns:res="clr-namespace:AspenTech.AspenPlus.Localization;assembly=AspenTech.AspenPlus.Localization" xmlns:av="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Uid="MMTabPage_1" MinWidth="520" MinHeight="340" MMHelp.HelpId="113" MMHelp.HelpFile="plotwiz.hlp">
  <MMStretchGrid x:Uid="MMStretchGrid_1" av:Grid.IsSharedSizeScope="True" Margin="20,20,20,20">
    <av:Grid.ColumnDefinitions>
      <av:ColumnDefinition x:Uid="av_ColumnDefinition_1" Width="Auto" />
    </av:Grid.ColumnDefinitions>
    <av:Grid.RowDefinitions>
      <av:RowDefinition x:Uid="av_RowDefinition_1" Height="Auto" />
      <av:RowDefinition x:Uid="av_RowDefinition_2" Height="Auto" />
    </av:Grid.RowDefinitions>
    <MMFlatButton Margin="0,0,0,10" av:Grid.Column="0" av:Grid.Row="0" HorizontalAlignment="Left" CornerRadius="8">
      <av:StackPanel x:Uid="av_Grid_1" Orientation="Horizontal">
        <MMFlatButton Name="cmdAdd" x:Uid="MMCmdButton_1" CornerRadius="8,0,0,8" BorderThickness="0" MinWidth="67" Content="{x:Static res:ApwnResources.MMSetup_Stratt_List1D_MMF_Content0}">
          <av:ButtonBase.Command>
            <av:Binding Path="cmdAdd_Command" />
          </av:ButtonBase.Command>
        </MMFlatButton>
        <MMFlatButton Name="cmdCopy" x:Uid="MMCmdButton_4" BorderThickness="0" MinWidth="80" Content="{x:Static res:ApwnResources.MMSetup_Stratt_List1D_MMF_Content3}">
          <av:ButtonBase.Command>
            <av:Binding Path="cmdCopy_Command" />
          </av:ButtonBase.Command>
        </MMFlatButton>
        <MMFlatButton Name="cmdPaste" x:Uid="MMCmdButton_8" BorderThickness="0" MinWidth="80" Content="{x:Static res:ApwnResources.MMSetup_Stratt_List1D_MMF_Content7}">
          <av:ButtonBase.Command>
            <av:Binding Path="cmdPaste_Command" />
          </av:ButtonBase.Command>
        </MMFlatButton>
        <MMFlatButton Name="cmdExport" Height="25" MinWidth="80" BorderThickness="0" BorderBrush="#00FFFFFF" Margin="0" x:Uid="cmdExport" Content="{x:Static res:ApwnResources.MMSetup_Stratt_List1D_MMF_Export}">
          <av:ButtonBase.Command>
            <av:Binding Path="cmdExport_Command" />
          </av:ButtonBase.Command>
        </MMFlatButton>
        <MMFlatButton Name="cmdEdit" x:Uid="MMCmdButton_2" BorderThickness="0" CornerRadius="0,8,8,0" MinWidth="80" Content="{x:Static res:ApwnResources.MMSetup_Stratt_List1D_MMF_Content1}">
          <av:ButtonBase.Command>
            <av:Binding Path="cmdEdit_Command" />
          </av:ButtonBase.Command>
        </MMFlatButton>
      </av:StackPanel>
    </MMFlatButton>
    <MMScrollArea Name="grdChild" x:Uid="MMScrollArea_1" DataProperty="grdChild_GridData" av:Grid.Column="0" av:Grid.Row="1">
      <MMScrollAreaBase.AllSelectedRecordsCount>
        <av:Binding Path="AllSelectedRecordsCount" Mode="TwoWay" />
      </MMScrollAreaBase.AllSelectedRecordsCount>
      <MMScrollAreaBase.SelectedRowIndexes>
        <av:Binding Path="SelectedRowIndexes" Mode="TwoWay" />
      </MMScrollAreaBase.SelectedRowIndexes>
      <MMScrollAreaBase.RowDoubleClickCommand>
        <av:Binding Path="grid_RowDoubleClickCommand" />
      </MMScrollAreaBase.RowDoubleClickCommand>
      <MMScrollArea.DeleteRowCommand>
        <av:Binding Path="cmdDelete_Command" />
      </MMScrollArea.DeleteRowCommand>
      <MMScrollArea.MMFields>
        <MMScrollAreaValueField x:Uid="MMScrollAreaValueField_1" PropertyPath="txtName_var1" Width="95" Label="{x:Static res:ApwnResources.MMSetup_Stratt_List1D_MMFLabel0}" IsFieldFixed="True" Mask="Id" />
        <MMScrollAreaValueField x:Uid="MMScrollAreaValueField_2" PropertyPath="txtType_var1" Width="110" Label="{x:Static res:ApwnResources.MMSetup_Stratt_List1D_MMFLabel2}" />
        <MMScrollAreaValueField x:Uid="MMScrollAreaValueField_3" PropertyPath="txtIncrements_var1" Width="125" Label="{x:Static res:ApwnResources.MMSetup_Stratt_List1D_MMFLabel3}" />
        <MMScrollAreaValueField x:Uid="MMScrollAreaValueField_4" PropertyPath="txtStart_var1" Width="95" Label="{x:Static res:ApwnResources.MMSetup_Stratt_List1D_MMFLabel4}" />
        <MMScrollAreaValueField x:Uid="MMScrollAreaValueField_6" PropertyPath="txtEnd_var1" Width="95" Label="{x:Static res:ApwnResources.MMSetup_Stratt_List1D_MMFLabel5}" />
        <MMScrollAreaUnitsField x:Uid="MMScrollAreaUnitsField_1" PropertyPath="txtUnits_var1" Width="110" Label="{x:Static res:ApwnResources.MMSetup_Stratt_List1D_MMFLabel6}" />
        <MMScrollAreaValueField x:Uid="MMScrollAreaValueField_5" PropertyPath="cboStatus_Status" Width="140" Label="{x:Static res:ApwnResources.MMSetup_Stratt_List1D_MMFLabel1}" />
        <MMScrollAreaDeleteButtonField x:Uid="MMScrollAreaValueField_Delete" CommandPath="cmdDelete_Command" CommandParameterPath="txtName_var1.Value" Label="{x:Static res:ApwnResources.MMGeneric_List2D_Delete}" Width="90" />
      </MMScrollArea.MMFields>
    </MMScrollArea>
  </MMStretchGrid>
</MMTabPage>
