<?xml version='1.0' encoding='utf-8'?>
<Window x:Class="AspenTech.AspenPlus.MMControls.Dialogs.ListChooserDialog" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:atSupport="http://schemas.aspentech.com/xaml/presentation/visualisation/support" xmlns:local="clr-namespace:AspenTech.AspenPlus.MMControls.Dialogs" xmlns:mm="clr-namespace:AspenTech.AspenPlus.MMControls" xmlns:resources="clr-namespace:AspenTech.AspenPlus.MMControls.Properties" x:Uid="Window_1" Title="{x:Static resources:Resources.strListChooserTitle}" MinWidth="400" MinHeight="245" ResizeMode="CanResize" SizeToContent="WidthAndHeight" WindowStartupLocation="CenterOwner">
  <FrameworkElement.Resources>
    <ResourceDictionary x:Uid="ResourceDictionary_1">
      <ResourceDictionary.MergedDictionaries>
        <atSupport:AspenCommonResources />
        <atSupport:AspenCommonProperties x:Uid="atSupport_AspenCommonProperties_1" />
        <atSupport:AspenCommonStyles />
        <atSupport:AspenDefaultStyles />
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </FrameworkElement.Resources>
  <Grid Margin="{StaticResource AspenDialogOuterMargin}">
    <Grid.RowDefinitions>
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="*" />
      <ColumnDefinition Width="Auto" />
    </Grid.ColumnDefinitions>
    <ListView SelectionChanged="lbItems_SelectionChanged" Name="lbItems" x:Uid="lbItems" Grid.Row="0" Grid.Column="0" MinWidth="280" Margin="{StaticResource AspenHorizontalRelativeControlMargin}" ScrollViewer.HorizontalScrollBarVisibility="Auto" SelectionMode="Extended">
      <ListView.View>
        <GridView x:Uid="GridView_1">
          <GridViewColumn x:Uid="GridViewColumn_1" Width="Auto">
            <GridViewColumn.Header>
              <Binding Path="HeaderLabel" />
            </GridViewColumn.Header>
          </GridViewColumn>
        </GridView>
      </ListView.View>
    </ListView>
    <StackPanel Grid.Row="0" Grid.Column="1" Margin="{StaticResource AspenVerticalRelativeControlMargin}" HorizontalAlignment="Left" VerticalAlignment="Center">
      <Button Click="Button_Click" Name="btnOK" x:Uid="btnOK" MinWidth="60" Margin="{StaticResource AspenVerticalRelativeControlMargin}" Content="{x:Static resources:Resources.strOK}" IsDefault="True">
        <UIElement.IsEnabled>
          <Binding Path="ButtonOkEnable" />
        </UIElement.IsEnabled>
      </Button>
      <Button Click="btnRemove_Click" Name="btnRemove" x:Uid="btnRemove" MinWidth="60" Margin="{StaticResource AspenVerticalRelativeControlMargin}" Content="{x:Static resources:Resources.strRemove}" IsEnabled="False" />
      <Button Click="btnExport_Click" Name="btnExport" x:Uid="btnExport" MinWidth="60" Margin="{StaticResource AspenVerticalRelativeControlMargin}" Content="{x:Static resources:Resources.strExport}" IsEnabled="False" />
      <Button Click="btnUndo_Click" Name="btnUndo" x:Uid="btnUndo" MinWidth="60" Margin="{StaticResource AspenVerticalRelativeControlMargin}" Content="{x:Static resources:Resources.strUndo}" IsEnabled="False" />
      <Button x:Uid="Button_1" MinWidth="60" Margin="{StaticResource AspenVerticalRelativeControlMargin}" Content="{x:Static resources:Resources.strCancel}" IsCancel="True" />
      <Button x:Uid="Button_2" MinWidth="60" Margin="{StaticResource AspenNoMargin}" Command="ApplicationCommands.Help" Content="{x:Static resources:Resources.strHelp}" />
    </StackPanel>
  </Grid>
</Window>
