<?xml version='1.0' encoding='utf-8'?>
<UserControl x:Class="AspenTech.AspenPlus.MMForms.PhysicalProperties.MolecularStructure.GraphicalStructure" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:localization="clr-namespace:AspenTech.AspenPlus.Localization;assembly=AspenTech.AspenPlus.Localization">
  <GroupBox Header="{x:Static localization:ApwnResources.PhysicalProperties_MoleculeStructure_StructureAndFuncGroup_GraphicalStructure}">
    <FrameworkElement.DataContext>
      <Binding Mode="OneWay">
        <Binding.RelativeSource>
          <RelativeSource Mode="FindAncestor" AncestorType="UserControl" />
        </Binding.RelativeSource>
      </Binding>
    </FrameworkElement.DataContext>
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="*" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>
      <Image VerticalAlignment="Center" Stretch="None">
        <FrameworkElement.Width>
          <Binding Path="ImageWidth" Mode="OneWay" />
        </FrameworkElement.Width>
        <FrameworkElement.Height>
          <Binding Path="ImageHeight" Mode="OneWay" />
        </FrameworkElement.Height>
        <Image.Source>
          <Binding Path="MoleculeImageSource" Mode="OneWay" />
        </Image.Source>
      </Image>
      <Grid Grid.Row="1" HorizontalAlignment="Left">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Button Grid.Row="0" Content="{x:Static localization:ApwnResources.PhysicalProperties_MoleculeStructure_DrawImportEdit}" MinWidth="70" Margin="0,8,0,0">
          <ButtonBase.Command>
            <Binding Path="DrawImportEditCommand" Mode="OneWay" />
          </ButtonBase.Command>
        </Button>
        <Button Grid.Row="1" Content="{x:Static localization:ApwnResources.PhysicalProperties_MoleculeStructure_CalculateBonds}" MinWidth="70" Margin="0,8,0,0">
          <ButtonBase.Command>
            <Binding Path="CalculateBondsCommand" Mode="OneWay" />
          </ButtonBase.Command>
        </Button>
      </Grid>
    </Grid>
  </GroupBox>
</UserControl>
