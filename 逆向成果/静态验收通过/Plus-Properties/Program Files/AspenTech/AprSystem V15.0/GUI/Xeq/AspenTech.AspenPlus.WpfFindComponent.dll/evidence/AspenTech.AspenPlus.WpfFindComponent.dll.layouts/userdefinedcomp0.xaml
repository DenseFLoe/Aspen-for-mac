<?xml version='1.0' encoding='utf-8'?>
<mlc:WizardControlItem xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:mm="clr-namespace:AspenTech.AspenPlus.MMControls;assembly=AspenTech.AspenPlus.MMControls" xmlns:local="clr-namespace:AspenTech.AspenPlus.WpfFindComponent" xmlns:mlc="clr-namespace:AspenTech.AspenPlus.ModelLibrary.Controls;assembly=AspenTech.AspenPlus.ModelLibrary.Controls" xmlns:res="clr-namespace:AspenTech.AspenPlus.Localization;assembly=AspenTech.AspenPlus.Localization" x:Uid="mlc_WizardControlItem_1" Title="{x:Static res:WpfFindComponentResources.UserDefinedComWizard}" mm:MMHelp.HelpFile="cmpnts.chm" mm:MMHelp.HelpId="144" Background="{DynamicResource AspenDialogBackgroundBrush}" x:Class="AspenTech.AspenPlus.WpfFindComponent.UserDefinedComp0">
  <Grid x:Uid="Grid_1">
    <Grid.RowDefinitions>
      <RowDefinition x:Uid="RowDefinition_1" Height="Auto" />
      <RowDefinition x:Uid="RowDefinition_2" Height="*" />
    </Grid.RowDefinitions>
    <Grid x:Uid="Grid_2" Grid.Row="0">
      <Grid.RowDefinitions>
        <RowDefinition x:Uid="RowDefinition_3" Height="Auto" />
        <RowDefinition x:Uid="RowDefinition_4" Height="Auto" />
        <RowDefinition x:Uid="RowDefinition_5" Height="Auto" />
      </Grid.RowDefinitions>
      <GroupBox x:Uid="GroupBox_1" Grid.Row="0" Margin="{DynamicResource AspenVerticalIrrelativeControlMargin}">
        <TextBlock x:Uid="TextBlock_1" HorizontalAlignment="Center" TextWrapping="Wrap" MaxWidth="580" Text="{x:Static res:WpfFindComponentResources.WelcomeUserDefineCom}" />
      </GroupBox>
      <Grid x:Uid="Grid_3" Grid.Row="1">
        <Grid.RowDefinitions>
          <RowDefinition x:Uid="RowDefinition_6" Height="Auto" />
          <RowDefinition x:Uid="RowDefinition_7" Height="Auto" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
          <ColumnDefinition x:Uid="ColumnDefinition_1" Width="Auto" />
          <ColumnDefinition x:Uid="ColumnDefinition_2" Width="120" />
          <ColumnDefinition x:Uid="ColumnDefinition_5" Width="20" />
          <ColumnDefinition x:Uid="ColumnDefinition_3" Width="Auto" />
          <ColumnDefinition x:Uid="ColumnDefinition_4" Width="*" />
        </Grid.ColumnDefinitions>
        <Label x:Uid="Label_1" Grid.Row="0" Grid.Column="0" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="{DynamicResource AspenHorizontalRelativeControlMargin}" Content="{x:Static res:WpfFindComponentResources.ComponentID}" />
        <local:TextBoxEx Name="txtCompID" TextChanged="txtCompID_TextChanged" x:Uid="txtCompID" CharacterCasing="Upper" MaxLength="8" Grid.Row="0" Grid.Column="1" Margin="{DynamicResource AspenVerticalRelativeControlMargin}" />
        <Label x:Uid="Label_2" Grid.Row="0" Grid.Column="3" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="{DynamicResource AspenHorizontalRelativeControlMargin}" Content="{x:Static res:WpfFindComponentResources.Type}" />
        <ComboBox SelectionChanged="cboType_SelectionChanged" Name="cboType" x:Uid="cboType" Grid.Row="0" Grid.Column="4" MinWidth="80" Margin="{DynamicResource AspenVerticalRelativeControlMargin}">
          <ComboBoxItem x:Uid="ComboBoxItem_1" Content="{x:Static res:WpfFindComponentResources.comp0Item1}" />
          <ComboBoxItem x:Uid="ComboBoxItem_2" Content="{x:Static res:WpfFindComponentResources.comp0Item2}" />
          <ComboBoxItem x:Uid="ComboBoxItem_3" Content="{x:Static res:WpfFindComponentResources.comp0Item3}" />
        </ComboBox>
        <Label x:Uid="Label_3" Grid.Row="1" Grid.Column="0" VerticalAlignment="Top" HorizontalAlignment="Right" Margin="{DynamicResource AspenHorizontalRelativeControlMargin}" Content="{x:Static res:WpfFindComponentResources.Alias}" />
        <local:TextBoxEx Name="tbFormula" TextChanged="tbFormula_TextChanged" x:Uid="tbFormula" CharacterCasing="Upper" MaxLength="12" Grid.Row="1" Grid.Column="1" Margin="{DynamicResource AspenVerticalRelativeControlMargin}" />
      </Grid>
      <GroupBox Name="grpCompTypeText" x:Uid="grpCompTypeText" Grid.Row="2" MinHeight="80" Margin="{DynamicResource AspenVerticalIrrelativeControlMargin}">
        <TextBlock Name="txtReqParams" x:Uid="txtReqParams" HorizontalAlignment="Center" MaxWidth="570" TextWrapping="Wrap" Margin="7" />
      </GroupBox>
    </Grid>
    <Label x:Uid="Label_4" Grid.Row="1" VerticalAlignment="Bottom" Content="{x:Static res:WpfFindComponentResources.NextToComDeal}" />
  </Grid>
</mlc:WizardControlItem>
