<?xml version='1.0' encoding='utf-8'?>
<MMTabPage x:Class="AspenTech.AspenPlus.MMForms.Components.PetroleumCharacterization.MMPCCalc_Result_Viscos" xmlns="http://schemas.aspentech.com/xaml/presentation/aspenplus" xmlns:res="clr-namespace:AspenTech.AspenPlus.Localization;assembly=AspenTech.AspenPlus.Localization" xmlns:av="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:aes="http://schemas.aspentech.com/xaml/presentation/engineering" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Uid="MMTabPage_1" MinWidth="520" MinHeight="340">
  <av:Grid x:Uid="av_Grid_1" Margin="0,0,8,8">
    <av:Grid.ColumnDefinitions>
      <av:ColumnDefinition x:Uid="av_ColumnDefinition_1" Width="*" />
    </av:Grid.ColumnDefinitions>
    <av:Grid.RowDefinitions>
      <av:RowDefinition x:Uid="av_RowDefinition_1" Height="Auto" />
      <av:RowDefinition x:Uid="av_RowDefinition_2" Height="*" MinHeight="303" />
    </av:Grid.RowDefinitions>
    <av:Grid x:Uid="av_Grid_2" Margin="0,8,0,0" av:Grid.Column="0" av:Grid.Row="0">
      <av:Grid.ColumnDefinitions>
        <av:ColumnDefinition x:Uid="av_ColumnDefinition_2" Width="Auto" />
        <av:ColumnDefinition x:Uid="av_ColumnDefinition_3" Width="Auto" />
        <av:ColumnDefinition x:Uid="av_ColumnDefinition_4" Width="Auto" />
        <av:ColumnDefinition x:Uid="av_ColumnDefinition_5" Width="Auto" />
      </av:Grid.ColumnDefinitions>
      <av:Grid.RowDefinitions>
        <av:RowDefinition x:Uid="av_RowDefinition_3" Height="Auto" />
      </av:Grid.RowDefinitions>
      <MMLabel Name="Advcbo_label" x:Uid="MMLabel_1" TargetControl="Advcbo" MinWidth="40" Margin="8,0,0,0" av:Grid.Column="0" av:Grid.Row="0" Content="{x:Static res:ApwnResources.MMPCCalc_Result_Viscos_MMF_Content0}" />
      <MMComboEdit Name="Advcbo" x:Uid="MMComboEdit_1" Mask="Integer" VariablePath="Advcbo_AdvCollection" Width="182" av:Grid.Column="1" av:Grid.Row="0" />
      <MMLabel Name="lbtuViscUnit_label" x:Uid="MMLabel_2" TargetControl="lbtuViscUnit" MinWidth="68" Margin="81,0,0,0" av:Grid.Column="2" av:Grid.Row="0" Content="{x:Static res:ApwnResources.MMPCCalc_Result_Viscos_MMF_Content1}" />
      <MMLabel Name="lbtuKViscUnit_label" x:Uid="MMLabel_3" TargetControl="lbtuKViscUnit" MinWidth="68" Margin="81,0,0,0" av:Grid.Column="2" av:Grid.Row="0" Content="{x:Static res:ApwnResources.MMPCCalc_Result_Viscos_MMF_Content2}" />
      <MMVariableEdit Name="lbtuViscUnit" x:Uid="MMVariableEdit_1" ValueVisibility="Collapsed" ValueMask="Double" UnitsWidth="*" Orientation="Horizontal" VariablePath="lbtuViscUnit_var1" Width="104" av:Grid.Column="3" av:Grid.Row="0">
        <av:UIElement.Visibility>
          <av:Binding Path="Visc_Visibility" />
        </av:UIElement.Visibility>
      </MMVariableEdit>
      <MMVariableEdit Name="lbtuKViscUnit" x:Uid="MMVariableEdit_2" ValueVisibility="Collapsed" ValueMask="Double" UnitsWidth="*" Orientation="Horizontal" VariablePath="lbtuKViscUnit_var1" Width="104" av:Grid.Column="3" av:Grid.Row="0">
        <av:UIElement.Visibility>
          <av:Binding Path="KVisc_Visibility" />
        </av:UIElement.Visibility>
      </MMVariableEdit>
    </av:Grid>
    <MMGroupBox Name="fraViscosityResults" x:Uid="MMGroupBox_1" MinWidth="504" Margin="8,8,0,0" av:Grid.Column="0" av:Grid.Row="1">
      <aes:AesGroupBox.Header>
        <av:Binding Path="Advcbo_AdvCollection.SelectedItem" />
      </aes:AesGroupBox.Header>
      <MMScrollArea Name="grdMyVisc" x:Uid="MMScrollArea_1" DataProperty="grdMyVisc_GridData">
        <MMScrollArea.MMFields>
          <MMScrollAreaValueField x:Uid="MMScrollAreaValueField_1" Mask="Id" LabelBindingPath="ViscosityCaption" CharacterCasing="Upper" PropertyPath="txtViscosity_var1" Width="130" IsFieldFixed="True" />
          <MMScrollAreaFieldRepeater x:Uid="MMScrollAreaFieldRepeater_1" SecondLevelVectorProperty="inner" KeyPath="grdMyVisc_GridData[0].inner[{0}].txtComponent_var1.Value">
            <MMScrollAreaValueField x:Uid="MMScrollAreaValueField_2" PropertyPath="inner[{index}].txtValue_var1" Label="{}{key}" LabelTextConverterBindingPath="LabelConverter" ColumnHeaderTextAlignment="Left" />
          </MMScrollAreaFieldRepeater>
        </MMScrollArea.MMFields>
      </MMScrollArea>
    </MMGroupBox>
  </av:Grid>
</MMTabPage>
