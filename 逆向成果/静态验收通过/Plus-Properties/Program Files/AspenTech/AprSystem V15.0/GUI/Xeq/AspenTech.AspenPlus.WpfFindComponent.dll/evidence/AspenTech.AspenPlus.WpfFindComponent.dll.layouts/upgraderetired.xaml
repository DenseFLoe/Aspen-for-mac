<?xml version='1.0' encoding='utf-8'?>
<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:res="clr-namespace:AspenTech.AspenPlus.Localization;assembly=AspenTech.AspenPlus.Localization" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Uid="Window_1" Width="520" ResizeMode="NoResize" SizeToContent="Height" Title="{x:Static res:WpfFindComponentResources.UpgradeDatabanks}" WindowStartupLocation="CenterOwner" Style="{StaticResource MMDialogStyle}" x:Class="AspenTech.AspenPlus.WpfFindComponent.UpgradeRetired">
  <StackPanel x:Uid="StackPanel_1" Margin="{StaticResource AspenDialogOuterMargin}">
    <Border x:Uid="Border_1" BorderBrush="#FF000000" BorderThickness="0,0,0,2" Margin="{StaticResource AspenVerticalIrrelativeControlMargin}">
      <StackPanel x:Uid="StackPanel_2">
        <GroupBox x:Uid="GroupBox_1" Margin="{StaticResource AspenVerticalIrrelativeControlMargin}">
          <TextBlock Name="lblDesc" x:Uid="lblDesc" TextWrapping="Wrap" LineHeight="20" />
        </GroupBox>
        <CheckBox Click="chkUpgrade_Click" Name="chkUpgrade" x:Uid="chkUpgrade" MinWidth="0" Margin="{StaticResource AspenVerticalIrrelativeControlMargin}" Content="{x:Static res:WpfFindComponentResources.UpgradeReDatabanks}" />
      </StackPanel>
    </Border>
    <Button Click="btnOK_Click" Name="btnOK" x:Uid="btnOK" IsDefault="True" Content="{x:Static res:WpfFindComponentResources.OK}" HorizontalAlignment="Center" />
  </StackPanel>
</Window>
