<?xml version='1.0' encoding='utf-8'?>
<UserControl xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:local="clr-namespace:AspenTech.Engineering.Controls.FileMenu" x:Class="AspenTech.Engineering.Controls.FileMenu.AspenPlusTemplatesSelector">
  <FrameworkElement.Resources>
    <ResourceDictionary>
      <local:UnitSetSelectConverter x:Key="eussc" />
      <local:PlusTemplateUnitSetFilterConverter x:Key="ptusfc" />
      <local:PlusListViewItemSelectedByUnitSetFilterConverter x:Key="plvisbusfc" />
      <local:UnitOptionDisplayConverter x:Key="uodc" />
      <local:FileMenuItemTemplateSelector x:Key="FileMenuItemTemplateSelector" />
      <SolidColorBrush x:Key="DropdownBackgroundGray" Color="#F0F2F5" />
      <Style x:Key="{x:Type ToggleButton}" TargetType="{x:Type ToggleButton}">
        <Setter Property="Panel.Background" Value="#00FFFFFF" />
        <Setter Property="Control.Template">
          <Setter.Value>
            <ControlTemplate>
              <Grid Background="#00FFFFFF">
                <Label HorizontalAlignment="Center" VerticalAlignment="Center" Background="#00FFFFFF">
                  <ContentControl.Content>
                    <Binding Path="Content">
                      <Binding.RelativeSource>
                        <RelativeSource AncestorType="ToggleButton" />
                      </Binding.RelativeSource>
                    </Binding>
                  </ContentControl.Content>
                  <Control.Foreground>
                    <Binding Path="Foreground">
                      <Binding.RelativeSource>
                        <RelativeSource AncestorType="ToggleButton" />
                      </Binding.RelativeSource>
                    </Binding>
                  </Control.Foreground>
                </Label>
              </Grid>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
        <Style.Triggers>
          <Trigger Property="UIElement.IsMouseOver" Value="True">
            <Setter Property="FrameworkElement.Cursor" Value="Hand" />
            <Setter Property="Panel.Background" Value="{StaticResource DropdownBackgroundGray}" />
          </Trigger>
          <Trigger Property="ToggleButton.IsChecked" Value="True">
            <Setter Property="TextElement.Foreground" Value="#FF0000FF" />
          </Trigger>
        </Style.Triggers>
      </Style>
      <Style x:Key="FocusVisual">
        <Setter Property="Control.Template">
          <Setter.Value>
            <ControlTemplate>
              <Rectangle Margin="2" SnapsToDevicePixels="True" Stroke="{DynamicResource {x:Static SystemColors.ControlTextBrushKey}}" StrokeThickness="1" StrokeDashArray="1 2" />
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>
      <SolidColorBrush x:Key="Item.MouseOver.Background" Color="#1F26A0DA" />
      <SolidColorBrush x:Key="Item.MouseOver.Border" Color="#a826A0Da" />
      <SolidColorBrush x:Key="Item.SelectedInactive.Background" Color="#3DDADADA" />
      <SolidColorBrush x:Key="Item.SelectedInactive.Border" Color="#FFDADADA" />
      <SolidColorBrush x:Key="Item.SelectedActive.Background" Color="#3D26A0DA" />
      <SolidColorBrush x:Key="Item.SelectedActive.Border" Color="#FF26A0DA" />
    </ResourceDictionary>
  </FrameworkElement.Resources>
  <Grid>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="200" />
      <ColumnDefinition Width="500" />
      <ColumnDefinition Width="*" />
    </Grid.ColumnDefinitions>
    <Grid.RowDefinitions>
      <RowDefinition Height="80" />
      <RowDefinition Height="*" />
      <RowDefinition Height="70" />
    </Grid.RowDefinitions>
    <Border BorderThickness="1" BorderBrush="#FFF2F2F2" Grid.RowSpan="2" Grid.ColumnSpan="3" Grid.Row="0" Grid.Column="0" />
    <DockPanel Grid.Row="0" Grid.Column="0" Background="#FFF2F2F2">
      <TextBlock Foreground="#FF000000" Text="Category" FontWeight="Bold" FontSize="18" Grid.Row="0" Grid.Column="0" Margin="25,25,0,0" />
    </DockPanel>
    <DockPanel Grid.Row="0" Grid.Column="1" Margin="0,0,20,0">
      <TextBlock Foreground="#FF000000" Text="Template" FontWeight="Bold" FontSize="18" DockPanel.Dock="Left" Margin="25,25,0,0" />
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" DockPanel.Dock="Right">
        <ToggleButton Content="English" FontSize="14" Margin="0,0,5,0">
          <ToggleButton.IsChecked>
            <Binding Path="TemplateUnitSet" Mode="TwoWay" Converter="{StaticResource eussc}" ConverterParameter="English">
              <Binding.RelativeSource>
                <RelativeSource AncestorType="local:AspenPlusTemplatesSelector" />
              </Binding.RelativeSource>
            </Binding>
          </ToggleButton.IsChecked>
        </ToggleButton>
        <Border Width="1" Height="14" Margin="0,0,7,0" BorderBrush="#FF000000" BorderThickness="1" />
        <ToggleButton Content="Metric" FontSize="14" Margin="0,0,5,0">
          <ToggleButton.IsChecked>
            <Binding Path="TemplateUnitSet" Mode="TwoWay" Converter="{StaticResource eussc}" ConverterParameter="Metric">
              <Binding.RelativeSource>
                <RelativeSource AncestorType="local:AspenPlusTemplatesSelector" />
              </Binding.RelativeSource>
            </Binding>
          </ToggleButton.IsChecked>
        </ToggleButton>
        <Border Width="1" Height="14" Margin="0,0,7,0" BorderBrush="#FF000000" BorderThickness="1">
          <UIElement.Visibility>
            <Binding Path="Visibility" ElementName="MetC" />
          </UIElement.Visibility>
        </Border>
        <ToggleButton Name="MetC" Content="Met-C__bar__hr" FontSize="14">
          <ToggleButton.IsChecked>
            <Binding Path="TemplateUnitSet" Mode="TwoWay" Converter="{StaticResource eussc}" ConverterParameter="Met-C_bar_hr">
              <Binding.RelativeSource>
                <RelativeSource AncestorType="local:AspenPlusTemplatesSelector" />
              </Binding.RelativeSource>
            </Binding>
          </ToggleButton.IsChecked>
          <UIElement.Visibility>
            <Binding Path="SelectedItem.Children" ElementName="CatagoryList" Converter="{StaticResource uodc}" ConverterParameter="Met-C_bar_hr" />
          </UIElement.Visibility>
        </ToggleButton>
      </StackPanel>
    </DockPanel>
    <DockPanel Grid.Row="0" Grid.Column="2" Background="#FFF2F2F2">
      <TextBlock Foreground="#FF000000" Text="Template Details" FontWeight="Bold" FontSize="18" Margin="25,25,0,0" Grid.Row="0" Grid.Column="2" />
    </DockPanel>
    <local:FileMenuListView Name="CatagoryList" SelectionChanged="FileMenuListView_SelectionChanged" Grid.Row="1" Grid.Column="0" Background="#FFF2F2F2" ItemTemplateSelector="{StaticResource FileMenuItemTemplateSelector}" ScrollViewer.HorizontalScrollBarVisibility="Disabled" BorderThickness="0" MinHeight="100" Width="230">
      <ItemsControl.ItemsSource>
        <Binding Path="Children" />
      </ItemsControl.ItemsSource>
      <FrameworkElement.Resources>
        <ResourceDictionary>
          <Style x:Key="{x:Type GridViewColumnHeader}" TargetType="{x:Type GridViewColumnHeader}">
            <Setter Property="UIElement.Visibility" Value="Collapsed" />
          </Style>
        </ResourceDictionary>
      </FrameworkElement.Resources>
      <ItemsControl.ItemContainerStyle>
        <Style TargetType="{x:Type ListViewItem}">
          <Setter Property="Control.VerticalContentAlignment" Value="Top" />
          <Setter Property="FrameworkElement.MinHeight" Value="50" />
          <Setter Property="FrameworkElement.Margin" Value="0,0,0,0" />
          <Setter Property="UIElement.SnapsToDevicePixels" Value="True" />
          <Setter Property="Control.Padding" Value="0,1" />
          <Setter Property="Control.HorizontalContentAlignment">
            <Setter.Value>
              <Binding Path="HorizontalContentAlignment">
                <Binding.RelativeSource>
                  <RelativeSource AncestorType="{x:Type ItemsControl}" />
                </Binding.RelativeSource>
              </Binding>
            </Setter.Value>
          </Setter>
          <Setter Property="Panel.Background" Value="#00FFFFFF" />
          <Setter Property="Border.BorderBrush" Value="#00FFFFFF" />
          <Setter Property="Border.BorderThickness" Value="1" />
          <Setter Property="FrameworkElement.FocusVisualStyle" Value="{StaticResource FocusVisual}" />
          <Setter Property="Control.Template">
            <Setter.Value>
              <ControlTemplate TargetType="{x:Type ListViewItem}">
                <Border Name="Bd" BorderBrush="{TemplateBinding Border.BorderBrush}" BorderThickness="{TemplateBinding Border.BorderThickness}" Background="{TemplateBinding Panel.Background}" Padding="{TemplateBinding Control.Padding}" SnapsToDevicePixels="True">
                  <ContentPresenter HorizontalAlignment="{TemplateBinding Control.HorizontalContentAlignment}" SnapsToDevicePixels="{TemplateBinding UIElement.SnapsToDevicePixels}" VerticalAlignment="{TemplateBinding Control.VerticalContentAlignment}" Margin="15,0,0,0" />
                </Border>
                <ControlTemplate.Triggers>
                  <MultiTrigger>
                    <MultiTrigger.Conditions>
                      <Condition Property="UIElement.IsMouseOver" Value="True" />
                    </MultiTrigger.Conditions>
                    <Setter TargetName="Bd" Value="{StaticResource Item.MouseOver.Background}" Property="Panel.Background" />
                    <Setter TargetName="Bd" Value="{StaticResource Item.MouseOver.Border}" Property="Border.BorderBrush" />
                  </MultiTrigger>
                  <MultiTrigger>
                    <MultiTrigger.Conditions>
                      <Condition Property="Selector.IsSelectionActive" Value="False" />
                      <Condition Property="ListBoxItem.IsSelected" Value="True" />
                    </MultiTrigger.Conditions>
                    <Setter Property="TextElement.Foreground" Value="#FFFFFFFF" />
                    <Setter TargetName="Bd" Property="Panel.Background" Value="#FF3D6283" />
                    <Setter TargetName="Bd" Value="{StaticResource Item.SelectedInactive.Border}" Property="Border.BorderBrush" />
                  </MultiTrigger>
                  <MultiTrigger>
                    <MultiTrigger.Conditions>
                      <Condition Property="Selector.IsSelectionActive" Value="True" />
                      <Condition Property="ListBoxItem.IsSelected" Value="True" />
                    </MultiTrigger.Conditions>
                    <Setter Property="TextElement.Foreground" Value="#FFFFFFFF" />
                    <Setter TargetName="Bd" Property="Panel.Background" Value="#FF3D6283" />
                    <Setter TargetName="Bd" Value="{StaticResource Item.SelectedActive.Border}" Property="Border.BorderBrush" />
                  </MultiTrigger>
                  <Trigger Property="UIElement.IsEnabled" Value="False">
                    <Setter TargetName="Bd" Value="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}" Property="TextElement.Foreground" />
                  </Trigger>
                </ControlTemplate.Triggers>
              </ControlTemplate>
            </Setter.Value>
          </Setter>
        </Style>
      </ItemsControl.ItemContainerStyle>
      <ItemsControl.ItemsPanel>
        <ItemsPanelTemplate>
          <StackPanel Name="Panel" IsItemsHost="True" Orientation="Vertical" />
        </ItemsPanelTemplate>
      </ItemsControl.ItemsPanel>
    </local:FileMenuListView>
    <local:FileMenuListView Name="TemplateListView" Margin="0,0,0,0" Grid.Row="1" Grid.Column="1" Background="#00FFFFFF" ScrollViewer.HorizontalScrollBarVisibility="Disabled" BorderThickness="0,0,0,1" MinHeight="100" BorderBrush="#FFF2F2F2" ItemTemplateSelector="{StaticResource FileMenuItemTemplateSelector}">
      <FrameworkElement.DataContext>
        <Binding ElementName="CatagoryList" Path="SelectedItem" />
      </FrameworkElement.DataContext>
      <FrameworkElement.Resources>
        <ResourceDictionary>
          <Style x:Key="{x:Type GridViewColumnHeader}" TargetType="{x:Type GridViewColumnHeader}">
            <Setter Property="UIElement.Visibility" Value="Collapsed" />
          </Style>
        </ResourceDictionary>
      </FrameworkElement.Resources>
      <ItemsControl.ItemsSource>
        <MultiBinding Converter="{StaticResource ptusfc}" Mode="OneWay">
          <Binding Path="Children" />
          <Binding Path="TemplateUnitSet">
            <Binding.RelativeSource>
              <RelativeSource AncestorType="local:AspenPlusTemplatesSelector" />
            </Binding.RelativeSource>
          </Binding>
        </MultiBinding>
      </ItemsControl.ItemsSource>
      <Selector.SelectedItem>
        <MultiBinding Converter="{StaticResource plvisbusfc}" Mode="OneWay">
          <Binding Path="Children" />
          <Binding Path="TemplateUnitSet">
            <Binding.RelativeSource>
              <RelativeSource AncestorType="local:AspenPlusTemplatesSelector" />
            </Binding.RelativeSource>
          </Binding>
        </MultiBinding>
      </Selector.SelectedItem>
      <ItemsControl.ItemContainerStyle>
        <Style TargetType="{x:Type ListViewItem}">
          <Setter Property="FrameworkElement.Margin" Value="0,0,0,0" />
          <Setter Property="UIElement.SnapsToDevicePixels" Value="True" />
          <Setter Property="Control.Padding" Value="0,1" />
          <Setter Property="Control.HorizontalContentAlignment">
            <Setter.Value>
              <Binding Path="HorizontalContentAlignment">
                <Binding.RelativeSource>
                  <RelativeSource AncestorType="{x:Type ItemsControl}" />
                </Binding.RelativeSource>
              </Binding>
            </Setter.Value>
          </Setter>
          <Setter Property="Panel.Background" Value="#00FFFFFF" />
          <Setter Property="Border.BorderBrush" Value="#00FFFFFF" />
          <Setter Property="Border.BorderThickness" Value="1" />
          <Setter Property="FrameworkElement.FocusVisualStyle" Value="{StaticResource FocusVisual}" />
          <Setter Property="Control.Template">
            <Setter.Value>
              <ControlTemplate TargetType="{x:Type ListViewItem}">
                <Border Name="Bd" BorderBrush="{TemplateBinding Border.BorderBrush}" BorderThickness="{TemplateBinding Border.BorderThickness}" Background="{TemplateBinding Panel.Background}" Padding="{TemplateBinding Control.Padding}" SnapsToDevicePixels="True">
                  <ContentPresenter HorizontalAlignment="{TemplateBinding Control.HorizontalContentAlignment}" SnapsToDevicePixels="{TemplateBinding UIElement.SnapsToDevicePixels}" VerticalAlignment="{TemplateBinding Control.VerticalContentAlignment}" Margin="15,0,0,0" />
                </Border>
                <ControlTemplate.Triggers>
                  <MultiTrigger>
                    <MultiTrigger.Conditions>
                      <Condition Property="UIElement.IsMouseOver" Value="True" />
                    </MultiTrigger.Conditions>
                    <Setter TargetName="Bd" Value="{StaticResource Item.MouseOver.Background}" Property="Panel.Background" />
                    <Setter TargetName="Bd" Value="{StaticResource Item.MouseOver.Border}" Property="Border.BorderBrush" />
                  </MultiTrigger>
                  <MultiTrigger>
                    <MultiTrigger.Conditions>
                      <Condition Property="Selector.IsSelectionActive" Value="False" />
                      <Condition Property="ListBoxItem.IsSelected" Value="True" />
                    </MultiTrigger.Conditions>
                    <Setter TargetName="Bd" Property="Panel.Background" Value="#FFEEF6FF" />
                    <Setter TargetName="Bd" Value="{StaticResource Item.SelectedInactive.Border}" Property="Border.BorderBrush" />
                  </MultiTrigger>
                  <MultiTrigger>
                    <MultiTrigger.Conditions>
                      <Condition Property="Selector.IsSelectionActive" Value="True" />
                      <Condition Property="ListBoxItem.IsSelected" Value="True" />
                    </MultiTrigger.Conditions>
                    <Setter TargetName="Bd" Property="Panel.Background" Value="#FFEEF6FF" />
                    <Setter TargetName="Bd" Value="{StaticResource Item.SelectedActive.Border}" Property="Border.BorderBrush" />
                  </MultiTrigger>
                  <Trigger Property="UIElement.IsEnabled" Value="False">
                    <Setter TargetName="Bd" Value="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}" Property="TextElement.Foreground" />
                  </Trigger>
                </ControlTemplate.Triggers>
              </ControlTemplate>
            </Setter.Value>
          </Setter>
        </Style>
      </ItemsControl.ItemContainerStyle>
      <ItemsControl.ItemsPanel>
        <ItemsPanelTemplate>
          <StackPanel Name="Panel" IsItemsHost="True" Orientation="Vertical" />
        </ItemsPanelTemplate>
      </ItemsControl.ItemsPanel>
    </local:FileMenuListView>
    <DockPanel Background="#FFF2F2F2" Width="525" Grid.Row="1" Grid.Column="2">
      <TextBox TextWrapping="Wrap" Background="#00FFFFFF" BorderThickness="0" BorderBrush="#00FFFFFF" Margin="25,0,0,0" VerticalAlignment="Stretch" VerticalScrollBarVisibility="Auto" FontSize="14">
        <TextBox.Text>
          <Binding Path="SelectedItem.Description" ElementName="TemplateListView" />
        </TextBox.Text>
      </TextBox>
    </DockPanel>
    <Button Margin="0,10" Height="42" Width="280" HorizontalContentAlignment="Left" HorizontalAlignment="Right" Grid.Row="2" Grid.Column="2" DockPanel.Dock="Right">
      <ContentControl.Content>
        <Binding Path="CommandText" />
      </ContentControl.Content>
      <FrameworkElement.DataContext>
        <Binding Path="SelectedItem" ElementName="TemplateListView" />
      </FrameworkElement.DataContext>
      <ButtonBase.Command>
        <Binding Path="Command" />
      </ButtonBase.Command>
      <ButtonBase.CommandParameter>
        <Binding Path="CommandParameter" />
      </ButtonBase.CommandParameter>
      <UIElement.Uid>
        <Binding Path="Uid" />
      </UIElement.Uid>
      <FrameworkElement.Style>
        <Style TargetType="{x:Type Button}">
          <Setter Property="Control.Template">
            <Setter.Value>
              <ControlTemplate TargetType="{x:Type Button}">
                <Border Background="{TemplateBinding Panel.Background}" BorderBrush="{TemplateBinding Border.BorderBrush}" BorderThickness="{TemplateBinding Border.BorderThickness}">
                  <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
              </ControlTemplate>
            </Setter.Value>
          </Setter>
          <Style.Triggers>
            <Trigger Property="UIElement.IsMouseOver" Value="True">
              <Setter Property="Border.BorderThickness" Value="2" />
              <Setter Property="Border.BorderBrush" Value="#FFADD8E6" />
            </Trigger>
            <Trigger Property="UIElement.IsEnabled" Value="False">
              <Setter Property="Panel.Background" Value="#FFF4F4F4" />
              <Setter Property="TextElement.Foreground" Value="#FFA9A9A9" />
              <Setter Property="Border.BorderThickness" Value="2" />
              <Setter Property="Border.BorderBrush" Value="#00FFFFFF" />
            </Trigger>
            <Trigger Property="UIElement.IsEnabled" Value="True">
              <Setter Property="Panel.Background" Value="#FF0078C9" />
              <Setter Property="TextElement.Foreground" Value="#FFFFFFFF" />
            </Trigger>
          </Style.Triggers>
        </Style>
      </FrameworkElement.Style>
      <ContentControl.ContentTemplate>
        <DataTemplate>
          <DockPanel>
            <FrameworkElement.Width>
              <Binding Path="Width">
                <Binding.RelativeSource>
                  <RelativeSource AncestorType="{x:Type Button}" />
                </Binding.RelativeSource>
              </Binding>
            </FrameworkElement.Width>
            <TextBlock Background="#00FFFFFF" Margin="10,0,0,0" HorizontalAlignment="Left">
              <TextBlock.Text>
                <Binding Path="Content">
                  <Binding.RelativeSource>
                    <RelativeSource AncestorType="{x:Type Button}" />
                  </Binding.RelativeSource>
                </Binding>
              </TextBlock.Text>
              <TextBlock.Foreground>
                <Binding Path="Foreground">
                  <Binding.RelativeSource>
                    <RelativeSource AncestorType="{x:Type Button}" />
                  </Binding.RelativeSource>
                </Binding>
              </TextBlock.Foreground>
              <TextBlock.FontSize>
                <Binding Path="DataContext.FontSize">
                  <Binding.RelativeSource>
                    <RelativeSource AncestorType="{x:Type Button}" />
                  </Binding.RelativeSource>
                </Binding>
              </TextBlock.FontSize>
            </TextBlock>
            <TextBlock Text="►" Margin="0,0,10,0" FontFamily="Arial Black" HorizontalAlignment="Right" Background="#00FFFFFF">
              <TextBlock.FontSize>
                <Binding Path="DataContext.FontSize">
                  <Binding.RelativeSource>
                    <RelativeSource AncestorType="{x:Type Button}" />
                  </Binding.RelativeSource>
                </Binding>
              </TextBlock.FontSize>
            </TextBlock>
          </DockPanel>
        </DataTemplate>
      </ContentControl.ContentTemplate>
    </Button>
  </Grid>
</UserControl>
