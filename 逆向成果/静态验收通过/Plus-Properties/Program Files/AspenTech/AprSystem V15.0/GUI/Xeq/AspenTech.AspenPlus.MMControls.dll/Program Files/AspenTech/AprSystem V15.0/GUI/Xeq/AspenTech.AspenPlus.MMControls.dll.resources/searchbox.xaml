<?xml version='1.0' encoding='utf-8'?>
<UserControl x:Class="AspenTech.AspenPlus.MMControls.SearchBox" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:resources="clr-namespace:AspenTech.AspenPlus.MMControls.Properties">
  <Border Background="#FFFFFFFF" CornerRadius="14,14,14,14">
    <Grid HorizontalAlignment="Stretch" VerticalAlignment="Center">
      <Grid.RowDefinitions>
        <RowDefinition Height="24" />
      </Grid.RowDefinitions>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="16" />
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="24" />
      </Grid.ColumnDefinitions>
      <Path Grid.Row="0" Grid.Column="0" Stroke="#FF808080" StrokeThickness="1">
        <Path.Data>
          <PathGeometry>
            <PathFigure StartPoint="14,0">
              <PathFigure.Segments>
                <ArcSegment Point="14,24" Size="13.5,12" IsLargeArc="True" SweepDirection="Counterclockwise" />
              </PathFigure.Segments>
            </PathFigure>
          </PathGeometry>
        </Path.Data>
      </Path>
      <Path Grid.Row="0" Grid.Column="0" Stroke="#FF808080" StrokeThickness="1.5">
        <Path.Data>
          <PathGeometry>
            <PathFigure StartPoint="14,0">
              <LineSegment Point="16,0" />
            </PathFigure>
            <PathFigure StartPoint="14,24">
              <LineSegment Point="16,24" />
            </PathFigure>
          </PathGeometry>
        </Path.Data>
      </Path>
      <Path Name="ImagePath" Grid.Row="0" Grid.Column="2">
        <Path.Data>
          <PathGeometry>
            <PathGeometry.Figures>
              <PathFigure StartPoint="0,4">
                <LineSegment Point="16,4" />
                <LineSegment Point="16,20" />
                <LineSegment Point="0,20" />
                <LineSegment Point="0,4" />
              </PathFigure>
            </PathGeometry.Figures>
          </PathGeometry>
        </Path.Data>
        <Shape.Fill>
          <ImageBrush />
        </Shape.Fill>
      </Path>
      <Border Grid.Row="0" Grid.Column="1" BorderBrush="#FF808080" BorderThickness="0,1,0,1" Margin="0,0,0,0">
        <TextBox Name="SearchTextBoxItem" BorderThickness="0" />
      </Border>
      <TextBlock Name="LayerCover" Grid.Row="0" Grid.Column="1" Text="{x:Static resources:Resources.Search}" FontStyle="Italic" Foreground="#FF808080" VerticalAlignment="Center">
        <FrameworkElement.Width>
          <Binding ElementName="SearchTextBox" Path="ActualWidth" />
        </FrameworkElement.Width>
      </TextBlock>
      <Path Grid.Row="0" Grid.Column="2" Stroke="#FF808080" StrokeThickness="1">
        <Path.Data>
          <PathGeometry>
            <PathFigure StartPoint="10,0">
              <ArcSegment Point="10,24" Size="13.5,12" SweepDirection="Clockwise" />
            </PathFigure>
          </PathGeometry>
        </Path.Data>
      </Path>
      <Path Grid.Row="0" Grid.Column="2" Stroke="#FF808080" StrokeThickness="1.5">
        <Path.Data>
          <PathGeometry>
            <PathFigure StartPoint="0,0">
              <LineSegment Point="10,0" />
            </PathFigure>
            <PathFigure StartPoint="0,24">
              <LineSegment Point="10,24" />
            </PathFigure>
          </PathGeometry>
        </Path.Data>
      </Path>
    </Grid>
  </Border>
</UserControl>
