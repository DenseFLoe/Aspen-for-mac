<?xml version='1.0' encoding='utf-8'?>
<Window x:Class="AspenTech.AspenPlus.PfsDialogs.PFSPlotEditLegendDialog" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:res="clr-namespace:AspenTech.AspenPlus.Localization;assembly=AspenTech.AspenPlus.Localization" Loaded="OnDialogLoaded" x:Uid="Window_1" Title="{x:Static res:WpfPfsDialogsResources.EditLegend}" Style="{StaticResource MMDialogStyle}" SizeToContent="WidthAndHeight" ResizeMode="NoResize" WindowStartupLocation="CenterOwner" MinHeight="350" MinWidth="550">
  <Grid x:Uid="Grid_1" Width="533">
    <Grid.RowDefinitions>
      <RowDefinition x:Uid="RowDefinition_1" Height="40*" />
      <RowDefinition x:Uid="RowDefinition_2" Height="231*" />
      <RowDefinition x:Uid="RowDefinition_3" Height="40*" />
    </Grid.RowDefinitions>
    <StackPanel Grid.Row="2" HorizontalAlignment="Center" Orientation="Horizontal">
      <Button Click="btnOk_Click" Name="btnOk" x:Uid="btnOk" Content="{x:Static res:WpfPfsDialogsResources.BtnOk}" Margin="10" Width="120" />
      <Button Click="btnCancel_Click" Name="btnCancel" x:Uid="btnCancel" Content="{x:Static res:WpfPfsDialogsResources.BtnCancel}" Margin="10" Width="120" />
    </StackPanel>
    <DataGrid Name="dataGrid1" x:Uid="dataGrid1" AutoGenerateColumns="False" RowHeight="23" Margin="10,0" MaxHeight="259" Width="510" Background="#FFFFFFFF" CanUserDeleteRows="False" CanUserReorderColumns="False" CanUserResizeRows="False" IsReadOnly="False" Grid.Row="1" CanUserAddRows="False" GridLinesVisibility="None" HeadersVisibility="None" SnapsToDevicePixels="True" SelectionMode="Single">
      <DataGrid.Columns>
        <DataGridTextColumn x:Uid="DataGridTextColumn_1" Width="508" CanUserSort="False" FontSize="11" Binding="{Binding LegendText}">
          <DataGridBoundColumn.EditingElementStyle>
            <Style x:Uid="Style_1" TargetType="{x:Type TextBox}">
              <Setter x:Uid="Setter_1" Property="TextElement.Foreground" Value="#FF0000FF" />
            </Style>
          </DataGridBoundColumn.EditingElementStyle>
          <DataGridColumn.CellStyle>
            <Style x:Uid="Style_2" TargetType="{x:Type DataGridCell}">
              <Style.Triggers>
                <Trigger x:Uid="Trigger_1" Property="DataGridCell.IsSelected" Value="True">
                  <Setter x:Uid="Setter_2" Property="Panel.Background" Value="#FFF0F8FF" />
                  <Setter x:Uid="Setter_3" Property="TextElement.Foreground" Value="#FF000000" />
                </Trigger>
              </Style.Triggers>
            </Style>
          </DataGridColumn.CellStyle>
        </DataGridTextColumn>
      </DataGrid.Columns>
    </DataGrid>
    <Label Name="label1" x:Uid="label1" Content="{x:Static res:WpfPfsDialogsResources.LegendText}" Height="25" VerticalAlignment="Stretch" HorizontalAlignment="Stretch" Margin="10,10,5,5" FontSize="14" />
  </Grid>
</Window>
