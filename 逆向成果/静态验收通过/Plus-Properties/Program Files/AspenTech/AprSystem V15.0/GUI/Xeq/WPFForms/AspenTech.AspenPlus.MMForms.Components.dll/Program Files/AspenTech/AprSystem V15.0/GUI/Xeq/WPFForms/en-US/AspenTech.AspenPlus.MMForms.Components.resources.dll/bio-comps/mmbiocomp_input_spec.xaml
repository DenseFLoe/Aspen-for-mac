<?xml version='1.0' encoding='utf-8'?>
<MMTabPage x:Class="AspenTech.AspenPlus.MMForms.Components.Bio_Comps.MMBioComp_Input_Spec" xmlns="http://schemas.aspentech.com/xaml/presentation/aspenplus" xmlns:res="clr-namespace:AspenTech.AspenPlus.Localization;assembly=AspenTech.AspenPlus.Localization" xmlns:av="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Uid="MMTabPage_1" MinWidth="520" MinHeight="340">
  <MMStretchGrid x:Uid="MMStretchGrid_1" Margin="10,10,0,14">
    <av:Grid.ColumnDefinitions>
      <av:ColumnDefinition x:Uid="av_ColumnDefinition_1" Width="Auto" />
    </av:Grid.ColumnDefinitions>
    <av:Grid.RowDefinitions>
      <av:RowDefinition x:Uid="av_RowDefinition_1" Height="Auto" />
      <av:RowDefinition x:Uid="av_RowDefinition_2" Height="Auto" />
      <av:RowDefinition x:Uid="av_RowDefinition_3" Height="Auto" />
      <av:RowDefinition x:Uid="av_RowDefinition_4" Height="Auto" />
      <av:RowDefinition x:Uid="av_RowDefinition_5" Height="Auto" />
      <av:RowDefinition x:Uid="av_RowDefinition_6" Height="Auto" />
    </av:Grid.RowDefinitions>
    <MMLabel Name="Component" av:Grid.Row="0" Margin="0,8,0,0" HorizontalAlignment="Left" Content="{x:Static res:FormsComponentsResources.MMBioComp_Input_SpecifyBiocomponent}" />
    <MMScrollAreaMS Name="gridPhase" HorizontalAlignment="Left" av:Grid.Row="1" DataProperty="grdPhase_GridData">
      <MMScrollAreaMS.MMFields>
        <MMScrollAreaComboValueField Width="100" Label="{x:Static res:FormsComponentsResources.ComponentID}" VariableDataMember="Value" PropertyPath="txtCompID_var1" IsFieldFixed="True" />
        <MMScrollAreaComboValueField Label="{x:Static res:FormsComponentsResources.Phase}" Width="100" VariableDataMember="Value" PropertyPath="Phase_var1" />
        <MMScrollAreaCheckBoxField PropertyPath="chkEnabled_var1" Width="100" Label="{x:Static res:FormsComponentsResources.TrackBioState}" />
        <MMScrollAreaComboValueField Label="{x:Static res:FormsComponentsResources.CompositionInputBasis}" Width="150" PropertyPath="MMComboBasis_MultiMap" />
        <MMScrollAreaValueField Label="{x:Static res:FormsComponentsResources.Carbon}" Width="100" PropertyPath="txtCarbon_var1" />
        <MMScrollAreaValueField Label="{x:Static res:FormsComponentsResources.Hydrogen}" Width="100" PropertyPath="txtHydrogen_var1" />
        <MMScrollAreaValueField Label="{x:Static res:FormsComponentsResources.Oxygen}" Width="100" PropertyPath="txtOxygen_var1" />
        <MMScrollAreaValueField Label="{x:Static res:FormsComponentsResources.Nitrogen}" Width="100" PropertyPath="txtNitrogen_var1" />
        <MMScrollAreaValueField Label="{x:Static res:FormsComponentsResources.AshWeightPer}" Width="100" PropertyPath="txtAsh_var1" />
        <MMScrollAreaValueField Label="{x:Static res:FormsComponentsResources.Total}" Width="100" DisabledBackground="#FFEEEEEE" PropertyPath="txtTotal_var1" />
      </MMScrollAreaMS.MMFields>
    </MMScrollAreaMS>
    <MMLabel Name="Molar" av:Grid.Row="2" Margin="0,20,0,0" HorizontalAlignment="Left" Content="{x:Static res:FormsComponentsResources.MMBioComp_Input_MolarStoicRatiosAsh}" />
    <MMScrollAreaMS Name="gridMolar" HorizontalAlignment="Left" av:Grid.Row="3" DataProperty="grdMolar_GridData">
      <MMScrollAreaMS.MMFields>
        <MMScrollAreaComboValueField Width="100" Label="{x:Static res:FormsComponentsResources.ComponentID}" VariableDataMember="Value" PropertyPath="txtCompIDMolar_var1" IsFieldFixed="True" />
        <MMScrollAreaValueField Label="{x:Static res:FormsComponentsResources.Carbon}" Width="100" PropertyPath="txtCarbonMolar_var1" />
        <MMScrollAreaValueField Label="{x:Static res:FormsComponentsResources.Hydrogen}" Width="100" PropertyPath="txtHydrogenMolar_var1" />
        <MMScrollAreaValueField Label="{x:Static res:FormsComponentsResources.Oxygen}" Width="100" PropertyPath="txtOxygenMolar_var1" />
        <MMScrollAreaValueField Label="{x:Static res:FormsComponentsResources.Nitrogen}" Width="100" PropertyPath="txtNitrogenMolar_var1" />
        <MMScrollAreaValueField Label="{x:Static res:FormsComponentsResources.AshWeightPer}" Width="100" PropertyPath="txtAshMolar_var1" />
      </MMScrollAreaMS.MMFields>
    </MMScrollAreaMS>
    <MMLabel Name="Mass" av:Grid.Row="4" Margin="0,20,0,0" HorizontalAlignment="Left" Content="{x:Static res:FormsComponentsResources.MMBioComp_Input_MassComp}" />
    <MMScrollAreaMS Name="gridMass" HorizontalAlignment="Left" av:Grid.Row="5" DataProperty="grdMass_GridData">
      <MMScrollAreaMS.MMFields>
        <MMScrollAreaComboValueField Width="100" Label="{x:Static res:FormsComponentsResources.ComponentID}" VariableDataMember="Value" PropertyPath="txtCompIDMass_var1" IsFieldFixed="True" />
        <MMScrollAreaValueField Label="{x:Static res:FormsComponentsResources.Carbon}" Width="100" PropertyPath="txtCarbonMass_var1" />
        <MMScrollAreaValueField Label="{x:Static res:FormsComponentsResources.Hydrogen}" Width="100" PropertyPath="txtHydrogenMass_var1" />
        <MMScrollAreaValueField Label="{x:Static res:FormsComponentsResources.Oxygen}" Width="100" PropertyPath="txtOxygenMass_var1" />
        <MMScrollAreaValueField Label="{x:Static res:FormsComponentsResources.Nitrogen}" Width="100" PropertyPath="txtNitrogenMass_var1" />
        <MMScrollAreaValueField Label="{x:Static res:FormsComponentsResources.AshWeightPer}" Width="100" PropertyPath="txtAshMass_var1" />
      </MMScrollAreaMS.MMFields>
    </MMScrollAreaMS>
  </MMStretchGrid>
</MMTabPage>
