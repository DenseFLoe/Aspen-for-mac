<?xml version='1.0' encoding='utf-8'?>
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:igDP="http://infragistics.com/DataPresenter" xmlns:igEditors="http://infragistics.com/Editors" xmlns:lp="clr-namespace:AspenTech.AspenPlus.Localization;assembly=AspenTech.AspenPlus.Localization" xmlns:local="clr-namespace:AspenTech.AspenPlus.MMForms.GridForms.Controls" xmlns:localData="clr-namespace:AspenTech.AspenPlus.MMForms.GridForms.Controls.Data" xmlns:images="http://schemas.aspentech.com/xaml/presentation/visualisation/commonimages" xmlns:system="clr-namespace:System;assembly=mscorlib" x:Uid="ResourceDictionary_1">
  <images:CommonImages x:Key="shellImages" x:Uid="images_CommonImages_1" />
  <Style x:Key="{x:Type local:EditableListBox}" TargetType="{x:Type local:EditableListBox}">
    <Setter Property="Control.Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type local:EditableListBox}">
          <Border Background="{TemplateBinding Panel.Background}" BorderBrush="{TemplateBinding Border.BorderBrush}" BorderThickness="{TemplateBinding Border.BorderThickness}">
            <FrameworkElement.Resources>
              <ResourceDictionary>
                <Style x:Key="{x:Type Button}" TargetType="{x:Type Button}">
                  <Setter Property="FrameworkElement.MinWidth" Value="0" />
                  <Setter Property="FrameworkElement.Margin" Value="2,0,0,0" />
                </Style>
                <Style x:Key="{x:Type Image}" TargetType="{x:Type Image}">
                  <Setter Property="Viewbox.Stretch" Value="None" />
                  <Style.Triggers>
                    <Trigger Property="UIElement.IsEnabled" Value="False">
                      <Setter Property="UIElement.Opacity" Value="0.5" />
                    </Trigger>
                  </Style.Triggers>
                </Style>
                <Style TargetType="{x:Type igEditors:XamMaskedEditor}" x:Key="EditableListBox_EditorStyle">
                  <Setter Property="igEditors:XamMaskedEditor.Mask">
                    <Setter.Value>
                      <Binding Path="Mask" Mode="OneWay">
                        <Binding.RelativeSource>
                          <RelativeSource Mode="FindAncestor" AncestorType="local:EditableListBox" />
                        </Binding.RelativeSource>
                      </Binding>
                    </Setter.Value>
                  </Setter>
                  <Setter Property="igEditors:XamMaskedEditor.DataMode" Value="Raw" />
                  <Setter Property="igEditors:XamMaskedEditor.DisplayMode" Value="Raw" />
                  <Setter Property="igEditors:XamMaskedEditor.PromptChar" Value="" />
                </Style>
              </ResourceDictionary>
            </FrameworkElement.Resources>
            <DockPanel x:Uid="DockPanel_1">
              <DockPanel DockPanel.Dock="Top" Margin="0,0,0,2" x:Uid="DockPanel_2">
                <Label Content="{TemplateBinding local:EditableListBox.Header}" VerticalAlignment="Center" DockPanel.Dock="Left" x:Uid="Label_1" />
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Right">
                  <Button ToolTip="{x:Static lp:GridFormsResources.EditableListBox_Tooltip_Insert}" Command="{x:Static local:EditableListBox.InsertCommand}" x:Uid="Button_1">
                    <Image x:Uid="Image_1">
                      <Image.Source>
                        <Binding Source="{StaticResource shellImages}" Path="New_16" />
                      </Image.Source>
                    </Image>
                  </Button>
                  <Button ToolTip="{x:Static lp:GridFormsResources.EditableListBox_Tooltip_Delete}" Command="{x:Static local:EditableListBox.DeleteCommand}" x:Uid="Button_2">
                    <Image x:Uid="Image_2">
                      <Image.Source>
                        <Binding Source="{StaticResource shellImages}" Path="Delete_16" />
                      </Image.Source>
                    </Image>
                  </Button>
                  <Button ToolTip="{x:Static lp:GridFormsResources.EditableListBox_Tooltip_MoveUp}" Command="{x:Static local:EditableListBox.MoveUpCommand}" x:Uid="Button_3">
                    <Image x:Uid="Image_3">
                      <Image.Source>
                        <Binding Source="{StaticResource shellImages}" Path="MoveUp_16" />
                      </Image.Source>
                    </Image>
                  </Button>
                  <Button ToolTip="{x:Static lp:GridFormsResources.EditableListBox_Tooltip_MoveDown}" Command="{x:Static local:EditableListBox.MoveDownCommand}" x:Uid="Button_4">
                    <Image x:Uid="Image_4">
                      <Image.Source>
                        <Binding Source="{StaticResource shellImages}" Path="MoveDown_16" />
                      </Image.Source>
                    </Image>
                  </Button>
                </StackPanel>
              </DockPanel>
              <ListBox x:Name="PART_ListBox" SelectionMode="Single" x:Uid="PART_ListBox">
                <ItemsControl.ItemsSource>
                  <Binding Path="Items" Mode="OneWay">
                    <Binding.RelativeSource>
                      <RelativeSource Mode="TemplatedParent" />
                    </Binding.RelativeSource>
                  </Binding>
                </ItemsControl.ItemsSource>
                <ItemsControl.ItemTemplate>
                  <DataTemplate DataType="{x:Type localData:EditableListBoxItem}">
                    <igEditors:XamMaskedEditor DataMode="Raw" DisplayMode="Raw" PromptChar="" Padding="3,0" BorderThickness="0,0,0,1" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" x:Uid="igEditors_XamMaskedEditor_1">
                      <FrameworkElement.Style>
                        <x:Null />
                      </FrameworkElement.Style>
                      <igEditors:ValueEditor.Text>
                        <Binding Path="Text" Mode="TwoWay" UpdateSourceTrigger="PropertyChanged" />
                      </igEditors:ValueEditor.Text>
                      <igEditors:ValueEditor.ValueType>
                        <Binding Path="EditAsType" Mode="OneWay">
                          <Binding.RelativeSource>
                            <RelativeSource Mode="FindAncestor" AncestorType="local:EditableListBox" />
                          </Binding.RelativeSource>
                        </Binding>
                      </igEditors:ValueEditor.ValueType>
                      <igEditors:XamMaskedEditor.Mask>
                        <Binding Path="Mask" Mode="OneWay">
                          <Binding.RelativeSource>
                            <RelativeSource Mode="FindAncestor" AncestorType="local:EditableListBox" />
                          </Binding.RelativeSource>
                        </Binding>
                      </igEditors:XamMaskedEditor.Mask>
                    </igEditors:XamMaskedEditor>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
                <ItemsControl.ItemContainerStyle>
                  <Style TargetType="{x:Type ListBoxItem}">
                    <Setter Property="Control.HorizontalContentAlignment" Value="Stretch" />
                  </Style>
                </ItemsControl.ItemContainerStyle>
              </ListBox>
            </DockPanel>
          </Border>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
</ResourceDictionary>
