<?xml version='1.0' encoding='utf-8'?>
<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:mmc="http://schemas.aspentech.com/xaml/presentation/aspenplus" xmlns:res="clr-namespace:AspenTech.AspenPlus.Localization;assembly=AspenTech.AspenPlus.Localization" xmlns:local="clr-namespace:AspenTech.AspenPlus.WpfFindComponent" Name="biomassLookup" Height="600" SizeToContent="Width" MinWidth="300" Style="{StaticResource MMDialogStyle}" Title="{x:Static res:ApwnResources.BiomassLookup}" mmc:MMHelp.HelpFile="cmpnts.chm" mmc:MMHelp.HelpId="149" x:Class="AspenTech.AspenPlus.WpfFindComponent.BiomassLookup">
  <FrameworkElement.Resources>
    <ResourceDictionary>
      <local:HeaderDisplayConverter x:Key="selectedHeaderConverter" HeaderFormat="{x:Static res:WpfFindComponentResources.SelectedBaseComponents}" />
      <local:HeaderDisplayConverter x:Key="availableHeaderConverter" HeaderFormat="{x:Static res:WpfFindComponentResources.AvailableBaseComponents}" />
    </ResourceDictionary>
  </FrameworkElement.Resources>
  <Grid Margin="{DynamicResource AspenDialogOuterMargin}">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>
    <mmc:MMLabel Content="{x:Static res:WpfFindComponentResources.BiomassBaseComponentsSelection}" />
    <mmc:MMGroupBox Grid.Row="1" Header="{x:Static res:WpfFindComponentResources.SelectBaseComponent}">
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" MinWidth="230" />
          <ColumnDefinition Width="30" />
          <ColumnDefinition Width="*" MinWidth="230" />
        </Grid.ColumnDefinitions>
        <TextBlock Margin="0,2,0,2">
          <TextBlock.Text>
            <Binding ElementName="leftListBox" Path="Items.Count" Converter="{StaticResource availableHeaderConverter}" />
          </TextBlock.Text>
        </TextBlock>
        <ListBox Name="leftListBox" Grid.Row="1">
          <ItemsControl.ItemsSource>
            <Binding Path="AvailableBioBaseCompounds" />
          </ItemsControl.ItemsSource>
        </ListBox>
        <TextBlock Grid.Column="2" Margin="0,2,0,2">
          <TextBlock.Text>
            <Binding ElementName="rightListBox" Path="Items.Count" Converter="{StaticResource selectedHeaderConverter}" />
          </TextBlock.Text>
        </TextBlock>
        <ListBox Name="rightListBox" Grid.Row="1" Grid.Column="2">
          <ItemsControl.ItemsSource>
            <Binding Path="SelectedBioBaseCompounds" />
          </ItemsControl.ItemsSource>
        </ListBox>
      </Grid>
    </mmc:MMGroupBox>
    <StackPanel Grid.Row="2" Margin="0,7,0,0" Orientation="Horizontal" HorizontalAlignment="Right">
      <Button Content="{x:Static res:WpfFindComponentResources.OK}" MinWidth="80">
        <ButtonBase.Command>
          <Binding Path="OKCommand" />
        </ButtonBase.Command>
        <ButtonBase.CommandTarget>
          <Binding ElementName="biomassLookup" />
        </ButtonBase.CommandTarget>
        <ButtonBase.CommandParameter>
          <Binding ElementName="biomassLookup" />
        </ButtonBase.CommandParameter>
      </Button>
      <Button Margin="6,0,0,0" Content="{x:Static res:WpfFindComponentResources.Cancel}" MinWidth="80">
        <ButtonBase.Command>
          <Binding Path="CancelCommand" />
        </ButtonBase.Command>
        <ButtonBase.CommandParameter>
          <Binding ElementName="biomassLookup" />
        </ButtonBase.CommandParameter>
      </Button>
    </StackPanel>
  </Grid>
</Window>
