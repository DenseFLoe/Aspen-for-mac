<?xml version='1.0' encoding='utf-8'?>
<Window x:Class="AspenTech.AspenPlus.MMDialogs.ApwzFormat" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:res="clr-namespace:AspenTech.AspenPlus.Localization;assembly=AspenTech.AspenPlus.Localization" x:Uid="Window_1" ResizeMode="NoResize" SizeToContent="Height" ShowInTaskbar="False" Width="380" Title="{x:Static res:WpfMMDialogResources.DlgTitle}" Style="{StaticResource MMDialogStyle}">
  <Grid x:Uid="Grid_1">
    <StackPanel x:Uid="StackPanel_1" Orientation="Vertical">
      <TextBlock x:Name="apwzTxtForPlus" x:Uid="apwzTxtForPlus" TextWrapping="Wrap" Margin="6, 8, 6, 8" Text="{x:Static res:WpfMMDialogResources.LblApwz1}" />
      <TextBlock x:Name="apwzTxtForProperty" x:Uid="apwzTxtForProperty" TextWrapping="Wrap" Margin="6, 8, 6, 8" Text="{x:Static res:WpfMMDialogResources.LblApwz2}" />
      <TextBlock x:Name="bkpTxtForPlus" x:Uid="bkpTxtForPlus" TextWrapping="Wrap" Margin="6, 8, 6, 8" Text="{x:Static res:WpfMMDialogResources.LblApwz3}" />
      <TextBlock x:Name="bkpTxtForProperty" x:Uid="bkpTxtForProperty" TextWrapping="Wrap" Margin="6, 8, 6, 8" Text="{x:Static res:WpfMMDialogResources.LblApwz4}" />
      <CheckBox x:Uid="CheckBox_1" MinWidth="0" Margin="0,2" HorizontalAlignment="Center" Content="{x:Static res:WpfMMDialogResources.MsgNotShowAgain}">
        <ToggleButton.IsChecked>
          <Binding Path="NoMore" />
        </ToggleButton.IsChecked>
      </CheckBox>
      <StackPanel x:Uid="StackPanel_2" Margin="0,10" Orientation="Horizontal" HorizontalAlignment="Center">
        <Button Click="btnOk_Click" x:Name="btnOk" x:Uid="btnOk" Content="{x:Static res:WpfMMDialogResources.Yes}" />
        <Button Click="btnNo_Click" x:Name="btnNo" x:Uid="btnNo" Content="{x:Static res:WpfMMDialogResources.No}" />
      </StackPanel>
    </StackPanel>
  </Grid>
</Window>
