  <Style x:Key="{x:Type local:MMFlatButton}" TargetType="{x:Type local:MMFlatButton}" BasedOn="{StaticResource {x:Type Button}}">
    <Setter Property="aes:SimulatorStatusBox.CheckSimulatorStatus" Value="True" />
    <Setter Property="Control.Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type local:MMFlatButton}">
          <Border Name="back" Opacity="1" CornerRadius="{TemplateBinding local:MMFlatButton.CornerRadius}" MinWidth="{TemplateBinding FrameworkElement.MinWidth}" Height="{TemplateBinding FrameworkElement.Height}">
            <UIElement.BitmapEffect>
              <OuterGlowBitmapEffect Opacity="1" GlowSize="0">
                <OuterGlowBitmapEffect.GlowColor>
                  <Binding Path="(Button.Background).(SolidColorBrush.Color)">
                    <Binding.RelativeSource>
                      <RelativeSource Mode="TemplatedParent" />
                    </Binding.RelativeSource>
                  </Binding>
                </OuterGlowBitmapEffect.GlowColor>
              </OuterGlowBitmapEffect>
            </UIElement.BitmapEffect>
            <Border.Background>
              <LinearGradientBrush StartPoint="0,0" EndPoint="0,1.5">
                <GradientBrush.GradientStops>
                  <GradientStopCollection>
                    <GradientStop Offset="0">
                      <GradientStop.Color>
                        <Binding Path="(Button.Background).(SolidColorBrush.Color)">
                          <Binding.RelativeSource>
                            <RelativeSource Mode="TemplatedParent" />
                          </Binding.RelativeSource>
                        </Binding>
                      </GradientStop.Color>
                    </GradientStop>
                    <GradientStop Offset="0.3">
                      <GradientStop.Color>
                        <Binding Path="(Button.Background).(SolidColorBrush.Color)">
                          <Binding.RelativeSource>
                            <RelativeSource Mode="TemplatedParent" />
                          </Binding.RelativeSource>
                        </Binding>
                      </GradientStop.Color>
                    </GradientStop>
                    <GradientStop Color="#FFF" Offset="0.6" />
                  </GradientStopCollection>
                </GradientBrush.GradientStops>
              </LinearGradientBrush>
            </Border.Background>
            <Border Name="fore" BorderThickness="1" CornerRadius="{TemplateBinding local:MMFlatButton.CornerRadius}" BorderBrush="#55555555" Padding="{TemplateBinding Control.Padding}" MinWidth="{TemplateBinding FrameworkElement.MinWidth}" Height="{TemplateBinding FrameworkElement.Height}">
              <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                  <GradientBrush.GradientStops>
                    <GradientStopCollection>
                      <GradientStop Color="#6FFF" Offset="0.5" />
                      <GradientStop Color="#1111" Offset="0.51" />
                    </GradientStopCollection>
                  </GradientBrush.GradientStops>
                </LinearGradientBrush>
              </Border.Background>
              <ContentPresenter Name="content" VerticalAlignment="Center" HorizontalAlignment="Center">
                <UIElement.BitmapEffect>
                  <DropShadowBitmapEffect Color="#000" Direction="-90" ShadowDepth="0" Softness="0" Opacity="0" />
                </UIElement.BitmapEffect>
              </ContentPresenter>
            </Border>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="UIElement.IsMouseOver" Value="True">
              <Setter Property="Panel.Background" Value="#FFADD8E6" />
            </Trigger>
            <Trigger Property="ButtonBase.IsPressed" Value="True">
              <TriggerBase.EnterActions>
                <BeginStoryboard>
                  <Storyboard>
                    <DoubleAnimation To="3" Duration="0:0:0.1" Storyboard.TargetName="back" Storyboard.TargetProperty="(Border.BitmapEffect).(OuterGlowBitmapEffect.GlowSize)" />
                    <ColorAnimation To="#3AAA" Duration="0:0:0.1" Storyboard.TargetName="fore" Storyboard.TargetProperty="(Border.Background).(LinearGradientBrush.GradientStops)[0].(GradientStop.Color)" />
                    <ColorAnimation To="#2111" Duration="0:0:0.1" Storyboard.TargetName="fore" Storyboard.TargetProperty="(Border.Background).(LinearGradientBrush.GradientStops)[1].(GradientStop.Color)" />
                  </Storyboard>
                </BeginStoryboard>
