<?xml version='1.0' encoding='utf-8'?>
<Window x:Class="AspenTech.AspenPlus.PfsDialogs.PFSIconImportDXFDialog" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:res="clr-namespace:AspenTech.AspenPlus.Localization;assembly=AspenTech.AspenPlus.Localization" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:my="clr-namespace:AspenTech.AspenPlus.PfsDialogs" Loaded="OnDialogLoaded" x:Uid="Window_1" Title="{x:Static res:WpfPfsDialogsResources.SelectBlkNameImport}" FontSize="12" SizeToContent="WidthAndHeight" ResizeMode="NoResize" WindowStartupLocation="CenterOwner" MinWidth="400" MinHeight="265" Style="{StaticResource MMDialogStyle}">
