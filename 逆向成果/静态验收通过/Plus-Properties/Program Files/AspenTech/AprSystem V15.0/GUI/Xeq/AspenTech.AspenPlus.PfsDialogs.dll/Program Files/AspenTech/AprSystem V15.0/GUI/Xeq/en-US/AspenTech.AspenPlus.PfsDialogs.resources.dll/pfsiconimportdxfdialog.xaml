    <CheckBox Click="checkBox1_Click" Name="checkBox1" x:Uid="checkBox1" Content="{x:Static res:WpfPfsDialogsResources.IncludeMainDrawAs}" Grid.Row="4" Height="23" MinWidth="0" Margin="11" HorizontalAlignment="Left" VerticalAlignment="Center" />
