      <RowDefinition x:Uid="RowDefinition_4" Height="45*" />
      <RowDefinition x:Uid="RowDefinition_5" Height="45*" />
    </Grid.RowDefinitions>
    <Grid.ColumnDefinitions>
      <ColumnDefinition x:Uid="ColumnDefinition_1" Width="274*" />
      <ColumnDefinition x:Uid="ColumnDefinition_2" Width="104*" />
    </Grid.ColumnDefinitions>
    <ListBox SelectionChanged="listBox1_SelectionChanged" Name="listBox1" x:Uid="listBox1" Grid.RowSpan="4" MinHeight="164" HorizontalAlignment="Stretch" Margin="5,5,4,5" VerticalAlignment="Stretch" MinWidth="265" DisplayMemberPath="BlockText" SelectionMode="Multiple" SnapsToDevicePixels="True" ItemsSource="{Binding RelativeSource={RelativeSource FindAncestor, AncestorType=my:PFSIconImportDXFDialog, AncestorLevel=1}, Path=BlockList}" />
