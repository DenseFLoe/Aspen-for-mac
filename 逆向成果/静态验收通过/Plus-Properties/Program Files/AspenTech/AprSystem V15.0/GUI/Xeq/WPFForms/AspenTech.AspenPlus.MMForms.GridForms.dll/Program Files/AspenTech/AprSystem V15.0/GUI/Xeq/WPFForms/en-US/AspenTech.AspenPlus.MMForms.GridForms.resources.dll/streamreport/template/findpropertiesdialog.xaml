<?xml version='1.0' encoding='utf-8'?>
<Window x:Class="AspenTech.AspenPlus.MMForms.GridForms.StreamReport.Template.FindPropertiesDialog" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:lp="clr-namespace:AspenTech.AspenPlus.Localization;assembly=AspenTech.AspenPlus.Localization" xmlns:gc="clr-namespace:AspenTech.Engineering.GridControls;assembly=AspenTech.Engineering.GridControls" xmlns:images="http://schemas.aspentech.com/xaml/presentation/visualisation/commonimages" xmlns:mmctrl="clr-namespace:AspenTech.AspenPlus.MMControls;assembly=AspenTech.AspenPlus.MMControls" Title="{x:Static lp:GridFormsResources.StreamSummaryTemplate_FindProperties_Caption}" MinWidth="600" MinHeight="488" Width="600" Height="488" SizeToContent="Manual" ResizeMode="CanResizeWithGrip" ShowInTaskbar="False" WindowStartupLocation="CenterScreen" Background="{DynamicResource AspenDialogBackgroundBrush}" mmctrl:MMHelp.HelpFile="props.chm" mmctrl:MMHelp.HelpId="94">
  <FrameworkElement.Resources>
    <ResourceDictionary>
      <Style x:Key="imageButtonStyle" TargetType="{x:Type Button}" BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="FrameworkElement.MinWidth" Value="0" />
        <Setter Property="FrameworkElement.MinHeight" Value="0" />
        <Setter Property="FrameworkElement.Margin" Value="0" />
        <Style.Triggers>
          <Trigger Property="UIElement.IsEnabled" Value="False">
            <Setter Property="UIElement.Opacity" Value="0.5" />
          </Trigger>
        </Style.Triggers>
      </Style>
      <images:CommonImages x:Key="shellImages" />
    </ResourceDictionary>
  </FrameworkElement.Resources>
  <Grid Margin="{DynamicResource AspenDialogOuterMargin}">
    <FrameworkElement.DataContext>
      <Binding>
        <Binding.RelativeSource>
          <RelativeSource AncestorType="Window" Mode="FindAncestor" />
        </Binding.RelativeSource>
      </Binding>
    </FrameworkElement.DataContext>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="20*" MinHeight="100" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="10*" MinHeight="80" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>
    <Grid Margin="{DynamicResource AspenVerticalRelativeControlMargin}">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <StackPanel Margin="{DynamicResource AspenHorizontalRelativeControlMargin}">
        <Label Content="{x:Static lp:GridFormsResources.StreamSummaryTemplate_FindProperties_SearchLabel}" Margin="{DynamicResource AspenVerticalRelativeControlMargin}" />
        <mmctrl:SearchBox x:Name="textBoxSearch">
          <mmctrl:SearchBox.SearchValue>
            <Binding Path="SearchText" Mode="TwoWay" UpdateSourceTrigger="PropertyChanged" />
          </mmctrl:SearchBox.SearchValue>
        </mmctrl:SearchBox>
      </StackPanel>
      <StackPanel Grid.Column="1" VerticalAlignment="Bottom">
        <CheckBox x:Name="checkBoxLimitation" Content="{x:Static lp:GridFormsResources.StreamSummaryTemplate_FindProperties_LimitSearch}" Margin="{DynamicResource AspenVerticalRelativeControlMargin}">
          <ToggleButton.IsChecked>
            <Binding Path="PureComponentPropertiesOnly" Mode="TwoWay" />
          </ToggleButton.IsChecked>
        </CheckBox>
        <CheckBox x:Name="checkBoxExclusion" Content="{x:Static lp:GridFormsResources.StreamSummaryTemplate_FindProperties_ExcludePetroleumCorrelations}">
          <ToggleButton.IsChecked>
            <Binding Path="ExcludePetroleumCorrelations" Mode="TwoWay" />
          </ToggleButton.IsChecked>
        </CheckBox>
      </StackPanel>
    </Grid>
    <Grid Grid.Row="1" Margin="{DynamicResource AspenVerticalRelativeControlMargin}">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
      </Grid.RowDefinitions>
      <Label Content="{x:Static lp:GridFormsResources.StreamSummaryTemplate_FindProperties_SelectProperties}" Margin="{DynamicResource AspenVerticalRelativeControlMargin}" />
      <gc:GridControl x:Name="gcSearch" AllowColumnChooser="False" AllowColumnFreeze="False" AllowColumnReorder="False" AllowRecordFiltering="False" AllowRowReorder="False" Grid.Row="1" />
    </Grid>
    <GridSplitter Grid.Row="2" Background="#FFF5F5F5" Height="4" />
    <Grid Grid.Row="3" Margin="{DynamicResource AspenVerticalRelativeControlMargin}">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
      </Grid.RowDefinitions>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <Label Content="{x:Static lp:GridFormsResources.StreamSummaryTemplate_FindProperties_PropertiesToAdd}" Margin="{DynamicResource AspenVerticalRelativeControlMargin}" />
      <gc:GridControl x:Name="gcSelected" Grid.Row="1" AllowColumnChooser="False" AllowColumnFreeze="False" AllowColumnReorder="False" AllowRecordFiltering="False" AllowRowReorder="False" SortingMode="NotAllowed" SelectionMode="Extended" SelectionUnit="FullRow" Margin="{DynamicResource AspenHorizontalRelativeControlMargin}" />
      <StackPanel Grid.Row="1" Grid.Column="1" VerticalAlignment="Center">
        <Button x:Name="buttonUp" x:Uid="buttonUp" Margin="{DynamicResource AspenVerticalRelativeControlMargin}" Style="{StaticResource imageButtonStyle}">
          <ButtonBase.Command>
            <Binding Path="MoveUpCommand" />
          </ButtonBase.Command>
          <Image Stretch="None">
            <Image.Source>
              <Binding Source="{StaticResource shellImages}" Path="MoveUp_16" />
            </Image.Source>
          </Image>
        </Button>
        <Button x:Name="buttonDown" x:Uid="buttonDown" Style="{StaticResource imageButtonStyle}">
          <ButtonBase.Command>
            <Binding Path="MoveDownCommand" />
          </ButtonBase.Command>
          <Image Stretch="None">
            <Image.Source>
              <Binding Source="{StaticResource shellImages}" Path="MoveDown_16" />
            </Image.Source>
          </Image>
        </Button>
      </StackPanel>
    </Grid>
    <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right">
      <Button x:Name="buttonOK" IsDefault="True" VerticalAlignment="Center" MinWidth="70" Content="{x:Static lp:GridFormsResources.StreamSummaryTemplate_FindProperties_OK}" Margin="{DynamicResource AspenHorizontalRelativeControlMargin}">
        <ButtonBase.Command>
          <Binding Path="OKCommand" />
        </ButtonBase.Command>
      </Button>
      <Button x:Name="buttonCancel" IsCancel="True" MinWidth="70" VerticalAlignment="Center" Margin="0" Content="{x:Static lp:GridFormsResources.StreamSummaryTemplate_FindProperties_Cancel}" />
    </StackPanel>
  </Grid>
</Window>
