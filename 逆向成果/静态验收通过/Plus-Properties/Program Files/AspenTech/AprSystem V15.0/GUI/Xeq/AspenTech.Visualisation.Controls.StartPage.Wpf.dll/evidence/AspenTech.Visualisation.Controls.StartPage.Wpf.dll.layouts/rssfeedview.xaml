<?xml version='1.0' encoding='utf-8'?>
<UserControl xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:atSupport="http://schemas.aspentech.com/xaml/presentation/visualisation/support" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:my="clr-namespace:AspenTech.Visualisation.Controls.StartPage" xmlns:myProperties="clr-namespace:AspenTech.Visualisation.Controls.StartPage.Properties" Name="_root" x:Class="AspenTech.Visualisation.Controls.StartPage.RssFeedView">
  <FrameworkElement.DataContext>
    <Binding ElementName="_root" Path="RssFeed" />
  </FrameworkElement.DataContext>
  <FrameworkElement.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <atSupport:AspenCommonResources />
        <atSupport:AspenCommonStyles />
      </ResourceDictionary.MergedDictionaries>
      <my:StartPageUriConverter x:Key="uriConverter" />
      <BooleanToVisibilityConverter x:Key="booleanToVisibilityConverter" />
      <atSupport:EmptyStringToVisibilityConverter x:Key="emptyStringToVisibilityConverter" />
      <atSupport:EmptyCollectionToVisibilityConverter x:Key="emptyCollectionToVisibilityConverter" />
      <Style x:Key="urlText" TargetType="{x:Type TextBlock}">
        <Style.Triggers>
          <Trigger Property="UIElement.IsMouseOver" Value="True">
            <Setter Property="TextElement.Foreground" Value="#FF483D8B" />
            <Setter Property="Inline.TextDecorations" Value="Underline" />
          </Trigger>
        </Style.Triggers>
        <Setter Property="TextElement.Foreground" Value="#FF006DFF" />
        <Setter Property="Inline.TextDecorations">
          <Setter.Value>
            <x:Null />
          </Setter.Value>
        </Setter>
        <Setter Property="TextBlock.TextWrapping" Value="Wrap" />
      </Style>
      <Style x:Key="rssPubDateText" TargetType="{x:Type TextBlock}">
        <Style.Triggers>
          <Trigger Property="TextBlock.Text">
            <Trigger.Value>
              <x:Null />
            </Trigger.Value>
            <Setter Property="UIElement.Visibility" Value="Collapsed" />
          </Trigger>
          <Trigger Property="TextBlock.Text" Value="">
            <Setter Property="UIElement.Visibility" Value="Collapsed" />
          </Trigger>
        </Style.Triggers>
        <Setter Property="TextBlock.TextWrapping" Value="Wrap" />
        <Setter Property="FrameworkElement.Margin" Value="10,0,0,0" />
        <Setter Property="TextElement.FontSize" Value="10" />
        <Setter Property="TextElement.Foreground" Value="#FF808080" />
      </Style>
      <Style x:Key="rssDescriptionText" TargetType="{x:Type TextBlock}">
        <Style.Triggers>
          <Trigger Property="TextBlock.Text">
            <Trigger.Value>
              <x:Null />
            </Trigger.Value>
            <Setter Property="UIElement.Visibility" Value="Collapsed" />
          </Trigger>
          <Trigger Property="TextBlock.Text" Value="">
            <Setter Property="UIElement.Visibility" Value="Collapsed" />
          </Trigger>
        </Style.Triggers>
        <Setter Property="TextBlock.TextWrapping" Value="Wrap" />
        <Setter Property="FrameworkElement.Margin" Value="10,0,0,0" />
      </Style>
      <DataTemplate x:Key="rssLinkTemplate">
        <StackPanel>
          <TextBlock Margin="5,10,0,0">
            <Hyperlink Click="RssLink_Click" TextDecorations="None">
              <Hyperlink.NavigateUri>
                <Binding Path="Link" />
              </Hyperlink.NavigateUri>
              <FrameworkContentElement.ToolTip>
                <Binding Path="Link" />
              </FrameworkContentElement.ToolTip>
              <InlineUIContainer>
                <TextBlock Style="{DynamicResource urlText}">
                  <TextBlock.Text>
                    <Binding Path="Title" />
                  </TextBlock.Text>
                </TextBlock>
              </InlineUIContainer>
            </Hyperlink>
          </TextBlock>
          <TextBlock Style="{DynamicResource rssPubDateText}">
            <TextBlock.Text>
              <Binding Path="PubDate" />
            </TextBlock.Text>
          </TextBlock>
          <TextBlock Style="{DynamicResource rssDescriptionText}">
            <TextBlock.Text>
              <Binding Path="Description" />
            </TextBlock.Text>
          </TextBlock>
        </StackPanel>
      </DataTemplate>
    </ResourceDictionary>
  </FrameworkElement.Resources>
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>
    <Grid Grid.Row="0">
      <UIElement.Visibility>
        <Binding Path="CanEditFeed" Converter="{StaticResource booleanToVisibilityConverter}" />
      </UIElement.Visibility>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="auto" />
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="auto" />
      </Grid.ColumnDefinitions>
      <Label Grid.Column="0" Margin="5" Content="{x:Static myProperties:Resources.FeedLabel}" />
      <TextBox Name="_feedUriTextBox" Grid.Column="1" Margin="5">
        <TextBox.Text>
          <Binding Path="FeedUri" Mode="TwoWay" Converter="{StaticResource uriConverter}" />
        </TextBox.Text>
      </TextBox>
      <atSupport:ImageButton Grid.Column="2" ImageMargin="2" ImageSource="images/Refresh_16.png">
        <ButtonBase.Command>
          <Binding Path="RefreshFeedCommand" />
        </ButtonBase.Command>
      </atSupport:ImageButton>
    </Grid>
    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
      <UIElement.Visibility>
        <Binding Path="FeedItems" Converter="{StaticResource emptyCollectionToVisibilityConverter}" />
      </UIElement.Visibility>
      <ItemsControl ItemTemplate="{StaticResource rssLinkTemplate}">
        <ItemsControl.ItemsSource>
          <Binding Path="FeedItems" />
        </ItemsControl.ItemsSource>
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate>
            <StackPanel />
          </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
      </ItemsControl>
    </ScrollViewer>
    <TextBlock Grid.Row="1" FontStyle="Italic" HorizontalAlignment="Center" VerticalAlignment="Center">
      <UIElement.Visibility>
        <Binding Path="StatusMessage" Converter="{StaticResource emptyStringToVisibilityConverter}" />
      </UIElement.Visibility>
      <TextBlock.Text>
        <Binding Path="StatusMessage" />
      </TextBlock.Text>
    </TextBlock>
    <Grid Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center">
      <UIElement.Visibility>
        <Binding Path="CredentialsInputRequired" Converter="{StaticResource booleanToVisibilityConverter}" />
      </UIElement.Visibility>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="auto" />
        <ColumnDefinition Width="300" />
      </Grid.ColumnDefinitions>
      <Grid.RowDefinitions>
        <RowDefinition Height="auto" />
        <RowDefinition Height="3" />
        <RowDefinition Height="auto" />
        <RowDefinition Height="3" />
        <RowDefinition Height="auto" />
        <RowDefinition Height="3" />
        <RowDefinition Height="auto" />
      </Grid.RowDefinitions>
      <TextBlock Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2" Text="{x:Static myProperties:Resources.EnterCredentialsHelp}" TextWrapping="Wrap" />
      <Label Content="{x:Static myProperties:Resources.CredentialsUserNameLabel}" Grid.Row="2" Grid.Column="0" HorizontalAlignment="Left" VerticalAlignment="Center" />
      <TextBox Name="_txtBoxUserName" Grid.Row="2" Grid.Column="1">
        <TextBox.Text>
          <Binding Path="CredentialsUserName" />
        </TextBox.Text>
      </TextBox>
      <Label Content="{x:Static myProperties:Resources.CredentialsPasswordLabel}" Grid.Row="4" Grid.Column="0" HorizontalAlignment="Left" VerticalAlignment="Center" />
      <PasswordBox Name="_txtBoxPassword" Grid.Row="4" Grid.Column="1" />
      <Button Content="{x:Static myProperties:Resources.ButtonRefresh}" Grid.Row="6" Grid.Column="1" HorizontalAlignment="Left" VerticalAlignment="Center">
        <ButtonBase.Command>
          <Binding Path="RefreshFeedCommand" />
        </ButtonBase.Command>
      </Button>
    </Grid>
  </Grid>
</UserControl>
