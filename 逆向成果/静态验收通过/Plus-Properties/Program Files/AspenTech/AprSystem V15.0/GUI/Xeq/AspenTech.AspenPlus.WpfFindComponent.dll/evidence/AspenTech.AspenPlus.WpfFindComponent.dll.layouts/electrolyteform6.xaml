<?xml version='1.0' encoding='utf-8'?>
<mlc:WizardControlItem xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:mm="clr-namespace:AspenTech.AspenPlus.MMControls;assembly=AspenTech.AspenPlus.MMControls" xmlns:lp="clr-namespace:AspenTech.AspenPlus.Localization;assembly=AspenTech.AspenPlus.Localization" xmlns:mlc="clr-namespace:AspenTech.AspenPlus.ModelLibrary.Controls;assembly=AspenTech.AspenPlus.ModelLibrary.Controls" x:Uid="mlc_WizardControlItem_1" mm:MMHelp.HelpFile="cmpnts.chm" mm:MMHelp.HelpId="142" UseScrollViewerInside="True" Title="{x:Static lp:WpfFindComponentResources.Form6Title}" x:Class="AspenTech.AspenPlus.WpfFindComponent.ElectrolyteForm6">
  <Grid x:Uid="Grid_1">
    <Grid.RowDefinitions>
      <RowDefinition x:Uid="RowDefinition_1" Height="Auto" />
      <RowDefinition x:Uid="RowDefinition_2" Height="*" />
    </Grid.RowDefinitions>
    <Grid x:Uid="Grid_2" Grid.Row="0" Margin="{DynamicResource AspenDialogOuterMargin}">
      <Grid.RowDefinitions>
        <RowDefinition x:Uid="RowDefinition_3" Height="Auto" />
        <RowDefinition x:Uid="RowDefinition_4" Height="Auto" />
        <RowDefinition x:Uid="RowDefinition_5" Height="Auto" />
      </Grid.RowDefinitions>
      <GroupBox Name="grpProperties" x:Uid="grpProperties" Header="{x:Static lp:WpfFindComponentResources.PropertySpec}" Grid.Row="0" Margin="{DynamicResource AspenVerticalIrrelativeControlMargin}">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition x:Uid="RowDefinition_6" Height="Auto" />
            <RowDefinition x:Uid="RowDefinition_7" Height="Auto" />
          </Grid.RowDefinitions>
          <Grid.ColumnDefinitions>
            <ColumnDefinition x:Uid="ColumnDefinition_4" Width="Auto" />
            <ColumnDefinition x:Uid="ColumnDefinition_5" Width="Auto" />
            <ColumnDefinition x:Uid="ColumnDefinition_8" Width="8" />
            <ColumnDefinition x:Uid="ColumnDefinition_6" Width="Auto" />
            <ColumnDefinition x:Uid="ColumnDefinition_7" Width="Auto" />
          </Grid.ColumnDefinitions>
          <Label Name="lblPM" x:Uid="lblPM" Grid.Row="0" Grid.Column="0" MinWidth="60" Margin="{DynamicResource AspenVerticalRelativeControlMargin}" Content="{x:Static lp:WpfFindComponentResources.PropertyMethod}" />
          <TextBox Name="txtBaseOption" x:Uid="txtBaseOption" IsReadOnly="True" Grid.Row="0" Grid.Column="1" MinWidth="180" Margin="{DynamicResource AspenVerticalRelativeControlMargin}" />
          <Label Name="lblSM" x:Uid="lblSM" Grid.Row="1" Grid.Column="0" MinWidth="60" Content="{x:Static lp:WpfFindComponentResources.SimuApproach}" />
          <TextBox Name="txtSimApproach" x:Uid="txtSimApproach" IsReadOnly="True" Grid.Row="1" Grid.Column="1" MinWidth="180" />
          <Label Name="lblCID" x:Uid="lblCID" Grid.Row="0" Grid.Column="3" MinWidth="60" Margin="{DynamicResource AspenVerticalRelativeControlMargin}" Content="{x:Static lp:WpfFindComponentResources.ChemistryID}" />
          <TextBox Name="txtChemID" x:Uid="txtChemID" IsReadOnly="True" Grid.Row="0" Grid.Column="4" MinWidth="70" Margin="{DynamicResource AspenVerticalRelativeControlMargin}" />
          <Label Name="lblHID" x:Uid="lblHID" Grid.Row="1" Grid.Column="3" MinWidth="60" Content="{x:Static lp:WpfFindComponentResources.HenryCompsID}" />
          <TextBox Name="txtHenryID" x:Uid="txtHenryID" IsReadOnly="True" Grid.Row="1" Grid.Column="4" MinWidth="70" />
        </Grid>
      </GroupBox>
      <GroupBox x:Uid="GroupBox_1" Header="{x:Static lp:WpfFindComponentResources.ComAndDatabank}" Grid.Row="1" Margin="{DynamicResource AspenVerticalIrrelativeControlMargin}">
        <TextBlock Name="lblFinishElec" x:Uid="lblFinishElec" TextWrapping="Wrap" HorizontalAlignment="Left" LineHeight="20" MaxWidth="800" />
      </GroupBox>
      <StackPanel x:Uid="StackPanel_1" Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center">
        <Button Click="btnReviewHenryList_Click" Name="btnReviewHenryList" x:Uid="btnReviewHenryList" HorizontalAlignment="Right" Margin="{DynamicResource AspenHorizontalRelativeControlMargin}" Content="{x:Static lp:WpfFindComponentResources.ReviewHenryCom}" />
        <Button Click="btnModifyAddRxns_Click" Name="btnModifyAddRxns" x:Uid="btnModifyAddRxns" HorizontalAlignment="Left" Content="{x:Static lp:WpfFindComponentResources.ReviewChemistry}" />
      </StackPanel>
    </Grid>
    <Label Name="lblStatus" x:Uid="lblStatus" Grid.Row="1" VerticalAlignment="Bottom" Content="{x:Static lp:WpfFindComponentResources.WizardToExit}" />
  </Grid>
</mlc:WizardControlItem>
