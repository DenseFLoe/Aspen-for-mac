<?xml version='1.0' encoding='utf-8'?>
<MMTabPagePastable x:Class="AspenTech.AspenPlus.MMForms.PhysicalProperties.Regression.MMRegress_Inp_Params" xmlns="http://schemas.aspentech.com/xaml/presentation/aspenplus" xmlns:res="clr-namespace:AspenTech.AspenPlus.Localization;assembly=AspenTech.AspenPlus.Localization" xmlns:av="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Uid="MMTabPage_1" MinWidth="520" MinHeight="340" xmlns:aes="http://schemas.aspentech.com/xaml/presentation/engineering">
  <av:Grid VerticalAlignment="Top">
    <av:Grid.RowDefinitions>
      <av:RowDefinition Height="*" />
      <av:RowDefinition Height="Auto" />
    </av:Grid.RowDefinitions>
    <av:Grid.ColumnDefinitions>
      <av:ColumnDefinition Width="*" />
    </av:Grid.ColumnDefinitions>
    <MMGroupBox Name="fraParameters" x:Uid="MMGroupBox_1" Header="{x:Static res:ApwnResources.MMRegress_Inp_Params_MMFHeader0}" Margin="8,8,0,16">
      <MMScrollAreaMS Name="grdParameters" x:Uid="MMScrollArea_1" DataProperty="grdParameters_GridData" LabelWidth="96" DataOrientation="Horizontal" DelayPasting="True">
        <MMScrollAreaMS.SelectedFieldIds>
          <av:Binding Path="SelectedRowIndexes" Mode="TwoWay" />
        </MMScrollAreaMS.SelectedFieldIds>
        <MMScrollAreaMS.MMFields>
          <MMScrollAreaComboValueField x:Uid="MMScrollAreaComboValueField_1" PropertyPath="cboType_MultiMap" Label="{x:Static res:ApwnResources.MMRegress_Inp_Params_MMFLabel0}" />
          <MMScrollAreaComboValueField x:Uid="MMScrollAreaComboValueField_2" VariableDataMember="Value" PropertyPath="cboParamname_var1" Label="{x:Static res:ApwnResources.MMRegress_Inp_Params_MMFLabel1}" />
          <MMScrollAreaValueField x:Uid="MMScrollAreaValueField_1" PropertyPath="txtElemno_var1" Mask="None" Label="{x:Static res:ApwnResources.MMRegress_Inp_Params_MMFLabel2}" />
          <MMScrollAreaComboValueField x:Uid="MMScrollAreaComboValueField_3" VariableDataMember="Value" PropertyPath="cboCIDI_var1" Label="{x:Static res:ApwnResources.MMRegress_Inp_Params_MMFLabel3}" />
          <MMScrollAreaComboValueField x:Uid="MMScrollAreaComboValueField_4" VariableDataMember="Value" PropertyPath="cboCIDJ_var1" Label="{x:Static res:ApwnResources.MMRegress_Inp_Params_MMFLabel4}" />
          <MMScrollAreaComboValueField x:Uid="MMScrollAreaComboValueField_5" VariableDataMember="Value" PropertyPath="cboPCIDI_var1" />
          <MMScrollAreaComboValueField x:Uid="MMScrollAreaComboValueField_6" VariableDataMember="Value" PropertyPath="cboPCIDJ_var1" />
          <MMScrollAreaComboValueField x:Uid="MMScrollAreaComboValueField_7" PropertyPath="cboUsage_MultiMap" Label="{x:Static res:ApwnResources.MMRegress_Inp_Params_MMFLabel5}" />
          <MMScrollAreaValueField x:Uid="MMScrollAreaValueField_2" PropertyPath="txtPinit_var1" Label="{x:Static res:ApwnResources.MMRegress_Inp_Params_MMFLabel6}" />
          <MMScrollAreaValueField x:Uid="MMScrollAreaValueField_3" PropertyPath="txtLower_var1" Label="{x:Static res:ApwnResources.MMRegress_Inp_Params_MMFLabel7}" />
          <MMScrollAreaValueField x:Uid="MMScrollAreaValueField_4" PropertyPath="txtUpper_var1" Label="{x:Static res:ApwnResources.MMRegress_Inp_Params_MMFLabel8}" />
          <MMScrollAreaValueField x:Uid="MMScrollAreaValueField_5" PropertyPath="txtScale_var1" Label="{x:Static res:ApwnResources.MMRegress_Inp_Params_MMFLabel9}" />
          <MMScrollAreaComboValueField x:Uid="MMScrollAreaComboValueField_8" PropertyPath="cboSet_MultiMap" Label="{x:Static res:ApwnResources.MMRegress_Inp_Params_MMFLabel10}" />
        </MMScrollAreaMS.MMFields>
      </MMScrollAreaMS>
    </MMGroupBox>
    <av:StackPanel av:Grid.Row="1" VerticalAlignment="Top" Orientation="Horizontal">
      <MMCmdButton Name="cmdCopy" MinWidth="70" av:Grid.Column="3" Margin="8,0,0,0" HorizontalAlignment="Stretch" Content="{x:Static res:ApwnResources.MMRegress_Inp_Params_Copy}" x:Uid="cmdCopy">
        <aes:AesCmdButton.Command>
          <av:Binding Path="cmdCopy_Command" />
        </aes:AesCmdButton.Command>
      </MMCmdButton>
      <MMCmdButton Name="cmdPaste" MinWidth="70" av:Grid.Column="4" Margin="8,0,0,0" HorizontalAlignment="Stretch" Content="{x:Static res:ApwnResources.MMRegress_Inp_Params_Paste}" x:Uid="cmdPaste">
        <aes:AesCmdButton.Command>
          <av:Binding Path="cmdPaste_Command" />
        </aes:AesCmdButton.Command>
      </MMCmdButton>
      <MMCmdButton Name="MMCmdClear" x:Uid="MMCmdButton_1" MinWidth="73" Margin="8,0,0,0" HorizontalAlignment="Stretch" Content="{x:Static res:ApwnResources.MMRegress_Inp_Params_MMF_Content0}">
        <aes:AesCmdButton.Command>
          <av:Binding Path="MMCmdClear_Command" />
        </aes:AesCmdButton.Command>
      </MMCmdButton>
    </av:StackPanel>
  </av:Grid>
</MMTabPagePastable>
