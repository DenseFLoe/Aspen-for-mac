<?xml version='1.0' encoding='utf-8'?>
<local:WizardPage x:Class="AspenTech.AspenPlus.MMDialogs.EOExportFile" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:lp="clr-namespace:AspenTech.AspenPlus.Localization;assembly=AspenTech.AspenPlus.Localization" xmlns:local="clr-namespace:AspenTech.AspenPlus.MMDialogs" x:Uid="local_WizardPage_1">
  <FrameworkElement.Resources>
    <ResourceDictionary>
      <local:FileTypeConverter x:Key="FileConver" x:Uid="local_FileTypeConverter_1" />
      <local:RadioBoolToIntConverter x:Key="RadioConver" x:Uid="local_RadioBoolToIntConverter_1" />
    </ResourceDictionary>
  </FrameworkElement.Resources>
  <StackPanel x:Uid="StackPanel_1" Margin="{StaticResource AspenDialogOuterMargin}">
    <GroupBox x:Uid="GroupBox_1" Header="{x:Static lp:WpfMMDialogResources.FileType}">
      <StackPanel x:Uid="StackPanel_2" Margin="{StaticResource AspenVerticalRelativeControlMargin}">
        <RadioButton x:Uid="RadioButton_1" GroupName="FileType" Content="{x:Static lp:WpfMMDialogResources.X_Vector_File}" Margin="{StaticResource AspenVerticalRelativeControlMargin}">
          <ToggleButton.IsChecked>
            <Binding Path="CppCode.m_nXFile" Converter="{StaticResource RadioConver}" ConverterParameter="0" />
          </ToggleButton.IsChecked>
        </RadioButton>
        <RadioButton x:Uid="RadioButton_2" GroupName="FileType" Content="{x:Static lp:WpfMMDialogResources.Variable_File}">
          <ToggleButton.IsChecked>
            <Binding Path="CppCode.m_nXFile" Converter="{StaticResource RadioConver}" ConverterParameter="1" />
          </ToggleButton.IsChecked>
        </RadioButton>
      </StackPanel>
    </GroupBox>
    <GroupBox x:Uid="GroupBox_2" Header="{x:Static lp:WpfMMDialogResources.FileLocation}">
      <local:FileInputBox FileNameChanged="FileNameChanged" x:Uid="local_FileInputBox_1">
        <local:FileInputBox.DlgType>
          <Binding Path="CppCode.m_nImport" />
        </local:FileInputBox.DlgType>
        <local:FileInputBox.Filter>
          <Binding Path="CppCode.m_nXFile" Converter="{StaticResource FileConver}" />
        </local:FileInputBox.Filter>
      </local:FileInputBox>
    </GroupBox>
  </StackPanel>
</local:WizardPage>
