<?xml version='1.0' encoding='utf-8'?>
<Window x:Class="AspenTech.Visualisation.CommonShell.RibbonTools.ManageSavedLayoutsDialog" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:atSupport="http://schemas.aspentech.com/xaml/presentation/visualisation/support" xmlns:atShell="http://schemas.aspentech.com/xaml/presentation/visualisation/commonshell" xmlns:igEditors="http://infragistics.com/Editors" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" x:Name="root" MinWidth="310" MinHeight="280" Title="{x:Static atShell:CommonShellResources.ManageSavedLayouts_DialogTitle}" Background="{DynamicResource AspenDialogBackgroundBrush}" ShowInTaskbar="False" ResizeMode="CanResize" WindowStartupLocation="CenterOwner" SizeToContent="WidthAndHeight">
  <FrameworkElement.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <atSupport:AspenCommonResources />
        <atSupport:AspenCommonProperties />
        <atSupport:AspenCommonStyles />
        <atSupport:AspenDefaultStyles />
      </ResourceDictionary.MergedDictionaries>
      <BooleanToVisibilityConverter x:Key="boolToVisConverter" />
    </ResourceDictionary>
  </FrameworkElement.Resources>
  <Grid Margin="{StaticResource AspenDialogOuterMargin}">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="*" MinWidth="150" />
      <ColumnDefinition Width="Auto" />
    </Grid.ColumnDefinitions>
    <Label Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2" Margin="0,4,0,2" VerticalAlignment="Center" HorizontalAlignment="Left" Target="{Binding ElementName=_listBox}">
      <AccessText Text="{x:Static atShell:CommonShellResources.ManageSavedLayouts_ListLabel}" />
    </Label>
    <ListBox SelectionChanged="_listBox_SelectionChanged" x:Name="_listBox" Grid.Row="1" Grid.Column="0" SelectionMode="Extended" ItemsSource="{Binding ElementName=root, Path=ShellWindow.Application.RootWorkspaceFolder.Workspaces}">
      <ItemsControl.ItemTemplate>
        <DataTemplate>
          <TextBlock Text="{Binding Name}" />
        </DataTemplate>
      </ItemsControl.ItemTemplate>
    </ListBox>
    <Grid Grid.Row="1" Grid.Column="1" VerticalAlignment="Center">
      <Grid.RowDefinitions>
        <RowDefinition Height="auto" />
        <RowDefinition Height="auto" />
        <RowDefinition Height="auto" />
        <RowDefinition Height="auto" />
        <RowDefinition Height="auto" />
        <RowDefinition Height="auto" />
      </Grid.RowDefinitions>
      <Button x:Name="_renameButton" Grid.Row="0" Content="{x:Static atShell:CommonShellResources.ManageSavedLayouts_RenameButton}" Margin="4" Command="{Binding ElementName=root, Path=RenameCommand, Mode=OneWay}" />
      <Button x:Name="_moveUpButton" Grid.Row="1" Content="{x:Static atShell:CommonShellResources.ManageSavedLayouts_MoveUpButton}" Margin="4" Command="{Binding ElementName=root, Path=MoveUpCommand, Mode=OneWay}" />
      <Button x:Name="_moveDownButton" Grid.Row="2" Content="{x:Static atShell:CommonShellResources.ManageSavedLayouts_MoveDownButton}" Margin="4" Command="{Binding ElementName=root, Path=MoveDownCommand, Mode=OneWay}" />
      <Button x:Name="_deleteButton" Grid.Row="3" Content="{x:Static atShell:CommonShellResources.ManageSavedLayouts_DeleteButton}" Margin="4" Command="{Binding ElementName=root, Path=DeleteCommand, Mode=OneWay}" />
      <Button x:Name="_importButton" Grid.Row="4" Content="{x:Static atShell:CommonShellResources.ManageSavedLayouts_ImportButton}" Margin="4" Command="{Binding ElementName=root, Path=ImportCommand, Mode=OneWay}" Visibility="{Binding Source={x:Static atShell:CommonShellPreferences.AllowImportExportLayouts}, Converter={StaticResource boolToVisConverter}}" />
      <Button x:Name="_exportButton" Grid.Row="5" Content="{x:Static atShell:CommonShellResources.ManageSavedLayouts_ExportButton}" Margin="4" Command="{Binding ElementName=root, Path=ExportCommand, Mode=OneWay}" Visibility="{Binding Source={x:Static atShell:CommonShellPreferences.AllowImportExportLayouts}, Converter={StaticResource boolToVisConverter}}" />
    </Grid>
    <Button Click="_closeButton_Click" x:Name="_closeButton" Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2" HorizontalAlignment="Right" VerticalAlignment="Center" Content="{x:Static atShell:CommonShellResources.ManageSavedLayouts_CloseButton}" Margin="4" IsCancel="true" />
  </Grid>
</Window>
