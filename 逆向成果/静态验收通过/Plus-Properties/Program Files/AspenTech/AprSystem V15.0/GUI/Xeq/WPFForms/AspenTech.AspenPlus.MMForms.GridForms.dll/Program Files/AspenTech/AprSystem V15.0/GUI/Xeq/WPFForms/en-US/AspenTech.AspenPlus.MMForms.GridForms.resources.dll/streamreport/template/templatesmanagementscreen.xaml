<?xml version='1.0' encoding='utf-8'?>
<shell:ScreenContentControl x:Class="AspenTech.AspenPlus.MMForms.GridForms.StreamReport.Template.TemplatesManagementScreen" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:shell="http://schemas.aspentech.com/xaml/presentation/visualisation/commonshell" xmlns:mm="http://schemas.aspentech.com/xaml/presentation/aspenplus" xmlns:gc="clr-namespace:AspenTech.Engineering.GridControls;assembly=AspenTech.Engineering.GridControls" xmlns:res="clr-namespace:AspenTech.AspenPlus.Localization;assembly=AspenTech.AspenPlus.Localization" xmlns:mmctrl="clr-namespace:AspenTech.AspenPlus.MMControls;assembly=AspenTech.AspenPlus.MMControls" mmctrl:MMHelp.HelpFile="results.chm" mmctrl:MMHelp.HelpId="1000" Header="{x:Static res:GridFormsResources.StreamTemplate_ManageTemplates}" ShouldApplyZoomToTransform="True">
  <Grid Margin="7">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>
    <mmctrl:MMFlatButton Grid.Row="0" CornerRadius="7" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="0,0,0,7" Height="25">
      <StackPanel Orientation="Horizontal">
        <mmctrl:MMFlatButton x:Name="cmdNew" CornerRadius="7,0,0,7" BorderThickness="0" Height="25" MinWidth="80" Content="{x:Static res:GridFormsResources.ManageStreamTemplate_New}">
          <ButtonBase.Command>
            <Binding Path="cmdNew_Command" />
          </ButtonBase.Command>
        </mmctrl:MMFlatButton>
        <mmctrl:MMFlatButton x:Name="cmdDuplicate" BorderThickness="0" Height="25" MinWidth="80" Content="{x:Static res:GridFormsResources.ManageStreamTemplate_Duplicate}">
          <ButtonBase.Command>
            <Binding Path="cmdDuplicate_Command" />
          </ButtonBase.Command>
        </mmctrl:MMFlatButton>
        <mmctrl:MMFlatButton x:Name="cmdEdit" BorderThickness="0" Height="25" MinWidth="80" Content="{x:Static res:GridFormsResources.ManageStreamTemplate_Edit}">
          <ButtonBase.Command>
            <Binding Path="cmdEdit_Command" />
          </ButtonBase.Command>
        </mmctrl:MMFlatButton>
        <mmctrl:MMFlatButton x:Name="cmdImport" BorderThickness="0" Height="25" MinWidth="80" Content="{x:Static res:GridFormsResources.ManageStreamTemplate_Import}">
          <ButtonBase.Command>
            <Binding Path="cmdImport_Command" />
          </ButtonBase.Command>
        </mmctrl:MMFlatButton>
        <mmctrl:MMFlatButton x:Name="cmdExport" CornerRadius="0,7,7,0" BorderThickness="0" Height="25" MinWidth="80" Content="{x:Static res:GridFormsResources.ManageStreamTemplate_Export}">
          <ButtonBase.Command>
            <Binding Path="cmdExport_Command" />
          </ButtonBase.Command>
        </mmctrl:MMFlatButton>
        <mmctrl:MMFlatButton x:Name="cmdCssTemplates" CornerRadius="0,7,7,0" Padding="2,0" BorderThickness="0" Height="25" MinWidth="80" Content="{x:Static res:GridFormsResources.ManageStreamTemplate_CssTemplates}">
          <ButtonBase.Command>
            <Binding Path="cmdCssTemplates_Command" />
          </ButtonBase.Command>
        </mmctrl:MMFlatButton>
      </StackPanel>
    </mmctrl:MMFlatButton>
    <gc:GridControl SelectionChanged="gridTemplates_SelectionChanged" CellValueChanged="gridTemplates_CellValueChanged" CellValueQueried="gridTemplates_CellValueQueried" x:Name="gridTemplates" Grid.Row="1" HorizontalAlignment="Left" AllowRecordFiltering="False" ScrollViewer.VerticalScrollBarVisibility="Auto" SelectionMode="Single" AllowSelectAll="False" AllowColumnChooser="False" />
  </Grid>
</shell:ScreenContentControl>
