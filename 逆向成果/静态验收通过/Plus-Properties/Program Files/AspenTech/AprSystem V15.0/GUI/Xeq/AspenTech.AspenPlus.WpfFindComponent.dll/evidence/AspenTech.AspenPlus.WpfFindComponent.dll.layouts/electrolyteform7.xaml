<?xml version='1.0' encoding='utf-8'?>
<mlc:WizardControlItem xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:av="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:mm="clr-namespace:AspenTech.AspenPlus.MMControls;assembly=AspenTech.AspenPlus.MMControls" xmlns:lp="clr-namespace:AspenTech.AspenPlus.Localization;assembly=AspenTech.AspenPlus.Localization" xmlns:mlc="clr-namespace:AspenTech.AspenPlus.ModelLibrary.Controls;assembly=AspenTech.AspenPlus.ModelLibrary.Controls" x:Uid="mlc_WizardControlItem_1" mm:MMHelp.HelpFile="cmpnts.chm" mm:MMHelp.HelpId="138" UseScrollViewerInside="True" Title="{x:Static lp:WpfFindComponentResources.Form7Title}" x:Class="AspenTech.AspenPlus.WpfFindComponent.ElectrolyteForm7">
  <av:Grid x:Uid="Grid_1">
    <av:Grid.RowDefinitions>
      <av:RowDefinition x:Uid="RowDefinition_1" Height="Auto" />
      <av:RowDefinition x:Uid="RowDefinition_2" Height="*" />
    </av:Grid.RowDefinitions>
    <av:Grid x:Uid="Grid_2" av:Grid.Row="0" Margin="{av:DynamicResource AspenDialogOuterMargin}">
      <av:Grid.RowDefinitions>
        <av:RowDefinition x:Uid="RowDefinition_3" Height="Auto" />
        <av:RowDefinition x:Uid="RowDefinition_4" Height="Auto" />
      </av:Grid.RowDefinitions>
      <av:GroupBox x:Uid="GroupBox_1" av:Grid.Row="0" Margin="{av:DynamicResource AspenVerticalIrrelativeControlMargin}">
        <av:TextBlock x:Uid="TextBlock_1" TextWrapping="Wrap" HorizontalAlignment="Left" LineHeight="20" MaxWidth="800" Text="{x:Static lp:WpfFindComponentResources.WelcomeElecWizard}" />
      </av:GroupBox>
      <av:GroupBox Name="grpDBank" x:Uid="grpDBank" av:Grid.Row="1">
        <av:Grid x:Uid="Grid_3">
          <av:Grid.RowDefinitions>
            <av:RowDefinition x:Uid="RowDefinition_5" Height="Auto" />
            <av:RowDefinition x:Uid="RowDefinition_6" Height="Auto" />
          </av:Grid.RowDefinitions>
          <av:Grid.ColumnDefinitions>
            <av:ColumnDefinition x:Uid="ColumnDefinition_1" Width="Auto" />
            <av:ColumnDefinition x:Uid="ColumnDefinition_2" Width="7" />
            <av:ColumnDefinition x:Uid="ColumnDefinition_3" Width="Auto" />
          </av:Grid.ColumnDefinitions>
          <av:Label Name="lblSelDatabase" x:Uid="lblSelDatabase" av:Grid.Row="0" av:Grid.Column="0" Margin="{av:DynamicResource AspenVerticalRelativeControlMargin}" />
          <av:ComboBox SelectionChanged="cboDBSelect_SelectionChanged" Name="cboDBSelect" x:Uid="cboDBSelect" av:Grid.Row="0" av:Grid.Column="2" MinWidth="100" Margin="{av:DynamicResource AspenVerticalRelativeControlMargin}" />
          <av:Label Name="lblRefState" x:Uid="lblRefState" Content="{x:Static lp:WpfFindComponentResources.RefForIonicCom}" av:Grid.Row="1" av:Grid.Column="0" Margin="{av:DynamicResource AspenVerticalRelativeControlMargin}" />
          <av:ComboBox SelectionChanged="cboRefStateSelect_SelectionChanged" Name="cboRefStateSelect" x:Uid="cboRefStateSelect" av:Grid.Row="1" av:Grid.Column="2" MinWidth="100" />
        </av:Grid>
      </av:GroupBox>
    </av:Grid>
    <av:TextBlock Name="LinkTip" x:Uid="LinkTip" VerticalAlignment="Bottom" av:Grid.Row="1">
      <av:TextBlock.Inlines xml:space="preserve"><av:Run Text="{x:Static lp:WpfFindComponentResources.NextToStep}" x:Uid="Label_1" /> <av:Hyperlink x:Uid="Hyperlink_1" Command="{x:Static av:ApplicationCommands.Help}"><av:TextBlock Text="{x:Static lp:WpfFindComponentResources.NextTo_HyperLink}" x:Uid="Hyperlink_2" /></av:Hyperlink></av:TextBlock.Inlines>
    </av:TextBlock>
  </av:Grid>
</mlc:WizardControlItem>
