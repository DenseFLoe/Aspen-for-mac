<?xml version='1.0' encoding='utf-8'?>
<local:MMDialog x:Class="AspenTech.AspenPlus.MMDialogs.ResultsInconsistentDlg" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:AspenTech.AspenPlus.MMDialogs" xmlns:res="clr-namespace:AspenTech.AspenPlus.Localization;assembly=AspenTech.AspenPlus.Localization" xmlns:atSupport="http://schemas.aspentech.com/xaml/presentation/visualisation/support" x:Uid="dlg" ShowInTaskbar="False" SizeToContent="WidthAndHeight" MinHeight="100" MinWidth="300" MaxWidth="600" ResizeMode="NoResize" FontSize="{StaticResource AspenDefaultFontSize}" FontFamily="{StaticResource AspenDefaultFontFamily}">
  <Border x:Uid="Border_1">
    <Grid x:Uid="Grid_1" Margin="{StaticResource AspenDialogOuterMargin}">
      <Grid.RowDefinitions>
        <RowDefinition x:Uid="RowDefinition_0" />
        <RowDefinition x:Uid="RowDefinition_1" />
      </Grid.RowDefinitions>
      <Grid x:Uid="Grid_2" Grid.Row="0" Margin="{StaticResource AspenVerticalIrrelativeControlMargin}">
        <Grid.ColumnDefinitions>
          <ColumnDefinition x:Uid="ColumnDefinition_0" Width="Auto" />
          <ColumnDefinition x:Uid="ColumnDefinition_1" Width="Auto" />
        </Grid.ColumnDefinitions>
        <Image x:Uid="Image_1" Source="Images\Exclamation.PNG" Height="32" Width="32" />
        <TextBlock x:Uid="TextBlock_1" Text="{x:Static res:WpfMMDialogResources.txtResultsInconsistentMsg}" Grid.Column="1" VerticalAlignment="Center" TextWrapping="Wrap" MinHeight="20" MaxWidth="500" Margin="10,0,0,0" />
      </Grid>
      <Grid x:Name="buttonsPanel" x:Uid="buttonsPanel" VerticalAlignment="Bottom" HorizontalAlignment="Right" Grid.Row="1">
        <Grid.ColumnDefinitions>
          <ColumnDefinition x:Uid="ColumnDefinition_2" Width="Auto" />
          <ColumnDefinition x:Uid="ColumnDefinition_3" Width="Auto" />
        </Grid.ColumnDefinitions>
        <Button Click="btnRun_Click" x:Name="btnRun" x:Uid="btnRun" Content="{x:Static res:WpfMMDialogResources._Run}" ToolTip="{x:Static res:WpfMMDialogResources.ToolTip_Run}" MinWidth="80" Margin="{StaticResource AspenHorizontalRelativeControlMargin}" Grid.Column="0" />
        <Button Click="btnCancel_Click" x:Name="btnCancel" x:Uid="btnCancel" Content="{x:Static res:WpfMMDialogResources._Cancel}" ToolTip="{x:Static res:WpfMMDialogResources.ToolTip_Cancel}" MinWidth="80" Margin="{StaticResource AspenHorizontalRelativeControlMargin}" Grid.Column="1" />
      </Grid>
    </Grid>
  </Border>
</local:MMDialog>
