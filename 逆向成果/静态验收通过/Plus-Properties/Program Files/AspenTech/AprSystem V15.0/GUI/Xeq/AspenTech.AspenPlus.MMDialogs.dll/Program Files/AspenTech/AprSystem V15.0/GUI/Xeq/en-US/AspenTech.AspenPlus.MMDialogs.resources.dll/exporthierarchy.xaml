<?xml version='1.0' encoding='utf-8'?>
<Window x:Class="AspenTech.AspenPlus.MMDialogs.ExportHierarchy" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:lp="clr-namespace:AspenTech.AspenPlus.Localization;assembly=AspenTech.AspenPlus.Localization" xmlns:mm="clr-namespace:AspenTech.AspenPlus.MMControls;assembly=AspenTech.AspenPlus.MMControls" x:Uid="Window_1" mm:MMHelp.HelpFile="userguide1.chm" mm:MMHelp.HelpId="1328" Title="{x:Static lp:WpfSimdllResources.PageFile_ExportTitle}" ShowInTaskbar="False" SizeToContent="WidthAndHeight" Style="{StaticResource MMDialogStyle}">
  <StackPanel x:Uid="StackPanel_1" Margin="{StaticResource AspenDialogOuterMargin}">
    <GroupBox x:Uid="GroupBox_1" Header="{x:Static lp:WpfSimdllResources.FileLocation}" Margin="{StaticResource AspenVerticalRelativeControlMargin}">
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
          <ColumnDefinition x:Uid="col_1" Width="80*" />
          <ColumnDefinition x:Uid="col_2" Width="Auto" />
        </Grid.ColumnDefinitions>
        <TextBox TextChanged="TxtFileLocation_TextChanged" Name="TxtFileLocation" x:Uid="TxtFileLocation" Grid.Row="0" Grid.Column="0" MinWidth="240" Margin="{StaticResource AspenHorizontalRelativeControlMargin}" />
        <Button Click="BtnBrowser_Click" Name="BtnBrowser" x:Uid="BtnBrowser" Grid.Row="0" Grid.Column="1" Content="{x:Static lp:WpfSimdllResources.BtnBrowse}" Width="72" />
      </Grid>
    </GroupBox>
    <StackPanel x:Uid="StackPanel_3" Orientation="Horizontal" HorizontalAlignment="Center">
      <Button Click="BtnNext_Click" Name="BtnNext" x:Uid="BtnNext" Margin="{StaticResource AspenHorizontalRelativeControlMargin}" Content="{x:Static lp:WpfSimdllResources.BtnNext}" />
      <Button Click="Cancel_Click" Name="Cancel" x:Uid="Cancel" Content="{x:Static lp:WpfSimdllResources.BtnCancel}" />
    </StackPanel>
  </StackPanel>
</Window>
