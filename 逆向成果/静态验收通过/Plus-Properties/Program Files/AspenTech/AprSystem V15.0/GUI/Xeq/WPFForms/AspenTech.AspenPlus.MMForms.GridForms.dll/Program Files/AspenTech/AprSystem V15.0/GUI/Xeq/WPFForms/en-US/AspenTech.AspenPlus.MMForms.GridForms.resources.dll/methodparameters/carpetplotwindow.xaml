<?xml version='1.0' encoding='utf-8'?>
<Window x:Class="AspenTech.AspenPlus.MMForms.GridForms.MethodParameters.CarpetPlotWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:grid="clr-namespace:AspenTech.Engineering.GridControls;assembly=AspenTech.Engineering.GridControls" xmlns:local="clr-namespace:AspenTech.AspenPlus.MMForms.GridForms.MethodParameters" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:mm="clr-namespace:AspenTech.AspenPlus.MMControls.Ads.ViewModelProperties;assembly=AspenTech.AspenPlus.MMControls" xmlns:res="clr-namespace:AspenTech.AspenPlus.Localization;assembly=AspenTech.AspenPlus.Localization" Loaded="Window_Loaded" Title="{x:Static res:WpfFormsResources.CarpertPlotWindow_Title}" MinWidth="100" MinHeight="100" SizeToContent="WidthAndHeight" Background="#FFEEF5FF">
  <FrameworkElement.Resources>
    <ResourceDictionary>
      <DataTemplate x:Key="firstColumnHeaderCell">
        <Grid Name="grid1">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <TextBlock Grid.Column="0" Margin="1,2,0,0" Text="i" TextAlignment="Left" />
          <TextBlock Grid.Column="2" Margin="2,0,0,2" Text="j" TextAlignment="Right" />
          <Canvas Name="canvas1" Grid.Column="1">
            <Line Stroke="#FF808080" StrokeThickness="0.5" X1="0" Y1="0">
              <Line.X2>
                <Binding ElementName="canvas1" Path="ActualWidth" />
              </Line.X2>
              <Line.Y2>
                <Binding ElementName="canvas1" Path="ActualHeight" />
              </Line.Y2>
            </Line>
          </Canvas>
        </Grid>
      </DataTemplate>
    </ResourceDictionary>
  </FrameworkElement.Resources>
  <Grid Margin="10">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="*" />
    </Grid.ColumnDefinitions>
    <Grid Grid.Row="0" Grid.Column="0" HorizontalAlignment="Left">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition />
      </Grid.RowDefinitions>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <TextBlock Grid.Row="0" Grid.ColumnSpan="2" Margin="4" HorizontalAlignment="Center" FontWeight="Bold" Text="{x:Static res:GridFormsResources.GridForm_CarpetPlot_LegendTitle}" />
      <Rectangle Grid.Row="1" Grid.Column="0" Width="30" Height="10" Margin="0,0,5,0" Fill="#FF7BDAF9" Stroke="#FFD3D3D3" StrokeThickness="0.5" />
      <TextBlock Grid.Row="1" Grid.Column="1" Text="{x:Static res:GridFormsResources.GridForm_CarpetPlot_Type_DataBase}" />
      <Rectangle Grid.Row="2" Grid.Column="0" Width="30" Height="10" Margin="0,0,5,0" Fill="#FF51E888" Stroke="#FFD3D3D3" StrokeThickness="0.5" />
      <TextBlock Grid.Row="2" Grid.Column="1" Text="{x:Static res:GridFormsResources.GridForm_CarpetPlot_Type_User}" />
      <Rectangle Grid.Row="3" Grid.Column="0" Width="30" Height="10" Margin="0,0,5,0" Fill="#FFF9E9E7" Stroke="#FFD3D3D3" StrokeThickness="0.5" />
      <TextBlock Grid.Row="3" Grid.Column="1" Text="{x:Static res:GridFormsResources.GridForm_CarpetPlot_Type_Regressed}" />
      <Rectangle Grid.Row="4" Grid.Column="0" Width="30" Height="10" Margin="0,0,5,0" Fill="#FFFFF2CC" Stroke="#FFD3D3D3" StrokeThickness="0.5" />
      <TextBlock Grid.Row="4" Grid.Column="1" Text="{x:Static res:GridFormsResources.GridForm_CarpetPlot_Type_Estimated}" />
    </Grid>
    <grid:GridControl Name="grid1" Grid.Row="1" Grid.Column="0" Margin="0,10,0,0" AllowColumnChooser="False" AllowRecordFiltering="False" AlternatingRowBackground="#FFFFFFFF" SortingMode="NotAllowed" />
  </Grid>
</Window>
