<?xml version='1.0' encoding='utf-8'?>
<Window x:Class="AspenTech.AspenPlus.ModelLibrary.ModelTypeWizard" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:AspenTech.AspenPlus.ModelLibrary" xmlns:lp="clr-namespace:AspenTech.AspenPlus.Localization;assembly=AspenTech.AspenPlus.Localization" xmlns:mc="clr-namespace:AspenTech.AspenPlus.ModelLibrary.Controls;assembly=AspenTech.AspenPlus.ModelLibrary.Controls" xmlns:mm="clr-namespace:AspenTech.AspenPlus.MMControls;assembly=AspenTech.AspenPlus.MMControls" x:Uid="Window_1" mm:MMHelp.HelpFile="userguide1.chm" mm:MMHelp.HelpId="1558" Title="{x:Static lp:ModelLibraryResources.WizardWindowTitle}" ResizeMode="NoResize" ShowInTaskbar="False" Width="670" Height="430" WindowStartupLocation="CenterOwner" Background="{DynamicResource AspenDialogBackgroundBrush}">
  <Grid x:Uid="Grid_1" Margin="{DynamicResource AspenDialogOuterMargin}">
    <Grid.RowDefinitions>
      <RowDefinition x:Uid="RowDefinition_1" Height="Auto" />
      <RowDefinition x:Uid="RowDefinition_2" Height="{DynamicResource AspenVerticalRelativeLength}" />
      <RowDefinition x:Uid="RowDefinition_3" Height="Auto" />
      <RowDefinition x:Uid="RowDefinition_4" Height="{DynamicResource AspenVerticalRelativeLength}" />
      <RowDefinition x:Uid="RowDefinition_5" Height="*" />
      <RowDefinition x:Uid="RowDefinition_6" Height="{DynamicResource AspenVerticalRelativeLength}" />
      <RowDefinition x:Uid="RowDefinition_7" Height="Auto" />
      <RowDefinition x:Uid="RowDefinition_8" Height="{DynamicResource AspenVerticalRelativeLength}" />
      <RowDefinition x:Uid="RowDefinition_9" Height="Auto" />
    </Grid.RowDefinitions>
    <Border x:Uid="Border_1" Grid.Row="0">
      <Label x:Uid="Label_1" FontWeight="Medium" Content="{Binding ElementName=theWizard, Path=CurrentItem.Title, Mode=OneWay}" />
    </Border>
    <Border x:Uid="Border_2" Grid.Row="2">
      <Separator x:Uid="Separator_1" />
    </Border>
    <Border x:Uid="Border_3" Grid.Row="4">
      <mc:WizardControl Finished="theWizard_Finished" x:Name="theWizard" x:Uid="theWizard" Margin="10,0">
        <local:ModelTypeWizardItemWelcome x:Name="WelcomePage" x:Uid="WelcomePage" />
        <local:ModelTypeWizardItemSelectLibrary x:Name="SelectLibraryPage" x:Uid="SelectLibraryPage" />
        <local:ModelTypeWizardItemSelectCategory x:Name="SelectCategoryPage" x:Uid="SelectCategoryPage" />
        <local:ModelTypeWizardItemSelectModelType x:Name="SelectModelTypePage" x:Uid="SelectModelTypePage" />
        <local:ModelTypeWizardItemModelTypeOptions x:Name="ModelTypeOptionsPage" x:Uid="ModelTypeOptionsPage" />
        <local:ModelTypeWizardItemSingleBlock x:Name="SingleBlockPage" x:Uid="SingleBlockPage" />
        <local:ModelTypeWizardItemSelectAdditionalRecords x:Name="SelectAdditionalRecordsPage" x:Uid="SelectAdditionalRecordsPage" />
      </mc:WizardControl>
    </Border>
    <Border x:Uid="Border_4" Grid.Row="6">
      <Separator x:Uid="Separator_2" />
    </Border>
    <StackPanel x:Uid="StackPanel_1" Grid.Row="8" Orientation="Horizontal" HorizontalAlignment="Right">
      <Button x:Uid="Button_1" Command="{x:Static mc:WizardControl.BackwardCommand}" Content="{x:Static lp:ModelLibraryResources.WizardWindowButtonBackward}" CommandTarget="{Binding ElementName=theWizard}" />
      <Button x:Uid="Button_2" Command="{x:Static mc:WizardControl.ForwardCommand}" Content="{x:Static lp:ModelLibraryResources.WizardWindowButtonForward}" CommandTarget="{Binding ElementName=theWizard}" />
      <Button x:Uid="Button_3" Command="{x:Static mc:WizardControl.FinishCommand}" Content="{x:Static lp:ModelLibraryResources.WizardWindowButtonFinish}" CommandTarget="{Binding ElementName=theWizard}" />
      <Button Click="buttonCancel_Click" x:Name="buttonCancel" x:Uid="buttonCancel" Margin="0" IsCancel="True" Content="{x:Static lp:ModelLibraryResources.WizardWindowButtonCancel}" />
    </StackPanel>
  </Grid>
</Window>
