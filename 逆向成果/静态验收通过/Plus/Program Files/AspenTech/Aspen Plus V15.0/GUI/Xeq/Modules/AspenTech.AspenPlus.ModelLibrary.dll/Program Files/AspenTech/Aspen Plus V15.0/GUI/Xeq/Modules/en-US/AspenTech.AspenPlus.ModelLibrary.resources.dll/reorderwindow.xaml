<?xml version='1.0' encoding='utf-8'?>
<Window x:Class="AspenTech.AspenPlus.ModelLibrary.ReorderWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:AspenTech.AspenPlus.ModelLibrary" xmlns:lp="clr-namespace:AspenTech.AspenPlus.Localization;assembly=AspenTech.AspenPlus.Localization" x:Uid="Window_1" Title="{x:Static lp:ModelLibraryResources.ReorderWindowTitleOfCategories}" SizeToContent="WidthAndHeight" ShowInTaskbar="False" ResizeMode="NoResize" WindowStartupLocation="CenterOwner" Background="{DynamicResource AspenDialogBackgroundBrush}">
  <FrameworkElement.Resources>
    <ResourceDictionary>
      <Style x:Key="imageButtonStyle" x:Uid="Style_1" TargetType="{x:Type Button}" BasedOn="{StaticResource {x:Type Button}}">
        <Setter x:Uid="Setter_1" Property="FrameworkElement.MinWidth" Value="0" />
        <Setter x:Uid="Setter_2" Property="FrameworkElement.MinHeight" Value="0" />
        <Setter x:Uid="Setter_3" Property="FrameworkElement.HorizontalAlignment" Value="Center" />
        <Setter x:Uid="Setter_4" Property="FrameworkElement.Margin" Value="0" />
        <Style.Triggers>
          <Trigger x:Uid="Trigger_1" Property="UIElement.IsEnabled" Value="False">
            <Setter x:Uid="Setter_5" Property="UIElement.Opacity" Value="0.5" />
          </Trigger>
        </Style.Triggers>
      </Style>
    </ResourceDictionary>
  </FrameworkElement.Resources>
  <Grid x:Uid="Grid_1" Margin="{DynamicResource AspenDialogOuterMargin}">
    <Grid.RowDefinitions>
      <RowDefinition x:Uid="RowDefinition_1" Height="Auto" />
      <RowDefinition x:Uid="RowDefinition_2" Height="{DynamicResource AspenVerticalRelativeLength}" />
      <RowDefinition x:Uid="RowDefinition_3" Height="Auto" />
    </Grid.RowDefinitions>
    <GroupBox x:Name="theGroupBox" x:Uid="theGroupBox" Header="{x:Static lp:ModelLibraryResources.ReorderWindowGroupHeaderOfCategories}">
      <Grid x:Uid="Grid_2">
        <Grid.ColumnDefinitions>
          <ColumnDefinition x:Uid="ColumnDefinition_1" Width="Auto" />
          <ColumnDefinition x:Uid="ColumnDefinition_2" Width="{DynamicResource AspenHorizontalRelativeLength}" />
          <ColumnDefinition x:Uid="ColumnDefinition_3" Width="Auto" />
        </Grid.ColumnDefinitions>
        <ListBox x:Name="theListBox" x:Uid="theListBox" Grid.Column="0" MinWidth="200" MinHeight="250" SelectionMode="Single" ItemsSource="{Binding RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=Window}, Path=Items, Mode=OneWay}" />
        <StackPanel x:Uid="StackPanel_1" Grid.Column="2" Orientation="Vertical" VerticalAlignment="Center" HorizontalAlignment="Center">
          <Button x:Name="buttonUp" x:Uid="buttonUp" Margin="{DynamicResource AspenVerticalRelativeControlMargin}" Style="{StaticResource imageButtonStyle}" Command="{x:Static local:ModelLibraryCommands.MoveUpCommand}">
            <Image x:Uid="Image_1" Source="Images/MoveUp_16.png" />
          </Button>
          <Button x:Name="buttonDown" x:Uid="buttonDown" Style="{StaticResource imageButtonStyle}" Command="{x:Static local:ModelLibraryCommands.MoveDownCommand}">
            <Image x:Uid="Image_2" Source="Images/MoveDown_16.png" />
          </Button>
        </StackPanel>
      </Grid>
    </GroupBox>
    <StackPanel x:Uid="StackPanel_2" Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
      <Button Click="buttonOK_Click" x:Name="buttonOK" x:Uid="buttonOK" IsDefault="True" Content="{x:Static lp:ModelLibraryResources.ReorderWindowButtonOK}" />
      <Button Click="buttonCancel_Click" x:Name="buttonCancel" x:Uid="buttonCancel" Margin="0" IsCancel="True" Content="{x:Static lp:ModelLibraryResources.ReorderWindowButtonCancel}" />
    </StackPanel>
  </Grid>
</Window>
