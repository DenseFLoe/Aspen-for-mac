<?xml version='1.0' encoding='utf-8'?>
<infra:ApwnPanelControl x:Class="AspenTech.AspenPlus.ModelLibrary.ModelCategoriesManagerWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:shell="http://schemas.aspentech.com/xaml/presentation/visualisation/commonshell" xmlns:infra="clr-namespace:AspenTech.AspenPlus.Infrastructure;assembly=AspenTech.AspenPlus.Infrastructure" xmlns:local="clr-namespace:AspenTech.AspenPlus.ModelLibrary" xmlns:lp="clr-namespace:AspenTech.AspenPlus.Localization;assembly=AspenTech.AspenPlus.Localization" xmlns:mm="clr-namespace:AspenTech.AspenPlus.MMControls;assembly=AspenTech.AspenPlus.MMControls" x:Uid="infra_ApwnPanelControl_1" mm:MMHelp.HelpFile="userguide1.chm" mm:MMHelp.HelpId="1557" MinWidth="360" MinHeight="300" IsDocumentScreen="False" Header="{x:Static lp:ModelLibraryResources.CategoryManagerWindowTitle}" Background="{DynamicResource AspenDialogBackgroundBrush}">
  <FrameworkElement.Resources>
    <ResourceDictionary>
      <Style x:Key="imageButtonStyle" x:Uid="Style_1" TargetType="{x:Type Button}" BasedOn="{StaticResource {x:Type Button}}">
        <Setter x:Uid="Setter_1" Property="FrameworkElement.MinWidth" Value="0" />
        <Setter x:Uid="Setter_2" Property="FrameworkElement.MinHeight" Value="0" />
        <Setter x:Uid="Setter_3" Property="FrameworkElement.HorizontalAlignment" Value="Center" />
        <Setter x:Uid="Setter_4" Property="FrameworkElement.Margin" Value="0" />
        <Style.Triggers>
          <Trigger x:Uid="Trigger_1" Property="UIElement.IsEnabled" Value="False">
            <Setter x:Uid="Setter_5" Property="UIElement.Opacity" Value="0.5" />
          </Trigger>
        </Style.Triggers>
      </Style>
    </ResourceDictionary>
  </FrameworkElement.Resources>
  <Grid x:Uid="Grid_1" Margin="{DynamicResource AspenDialogOuterMargin}">
    <GroupBox x:Uid="GroupBox_1" Grid.Row="0" Header="{x:Static lp:ModelLibraryResources.CategoryManagerWindowGroupHeader}">
      <Grid x:Uid="Grid_2">
        <Grid.ColumnDefinitions>
          <ColumnDefinition x:Uid="ColumnDefinition_1" Width="*" />
          <ColumnDefinition x:Uid="ColumnDefinition_2" Width="{DynamicResource AspenHorizontalRelativeLength}" />
          <ColumnDefinition x:Uid="ColumnDefinition_3" Width="Auto" />
        </Grid.ColumnDefinitions>
        <DataGrid x:Name="theDataGrid" x:Uid="theDataGrid" Grid.Column="0" AutoGenerateColumns="False" SelectionMode="Single" CanUserAddRows="False" ItemsSource="{Binding RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=shell:ScreenContentControl}, Path=CategoryInfos, Mode=OneWay}">
          <DataGrid.Columns>
            <DataGridTemplateColumn x:Uid="DataGridTemplateColumn_1" Header="{x:Static lp:ModelLibraryResources.CategoryManagerWindowGridHeaderIsInUse}" IsReadOnly="True">
              <DataGridTemplateColumn.CellTemplate>
                <DataTemplate x:Uid="DataTemplate_1" DataType="local:UserModelLibrary">
                  <Border x:Uid="Border_1" VerticalAlignment="Center" HorizontalAlignment="Center">
                    <CheckBox x:Name="checkBoxIsInUse" Click="checkBoxIsInUse_Click" x:Uid="checkBoxIsInUse" MinWidth="0" Tag="{Binding }" IsChecked="{Binding Path=IsInUse, Mode=OneWay}" />
                  </Border>
                </DataTemplate>
              </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>
            <DataGridTemplateColumn x:Uid="DataGridTemplateColumn_2" Header="{x:Static lp:ModelLibraryResources.CategoryManagerWindowGridHeaderName}" IsReadOnly="True" MinWidth="150">
              <DataGridTemplateColumn.CellTemplate>
                <DataTemplate x:Uid="DataTemplate_2" DataType="local:UserModelLibrary">
                  <Border x:Uid="Border_2" VerticalAlignment="Center" HorizontalAlignment="Left">
                    <Label x:Uid="Label_1" Content="{Binding Path=Header, Mode=OneWay}" />
                  </Border>
                </DataTemplate>
              </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>
          </DataGrid.Columns>
        </DataGrid>
        <StackPanel x:Uid="StackPanel_1" Grid.Column="2" Orientation="Vertical" VerticalAlignment="Center" HorizontalAlignment="Center">
          <Button x:Name="buttonUp" x:Uid="buttonUp" Style="{StaticResource imageButtonStyle}" Command="{x:Static local:ModelLibraryCommands.MoveUpCommand}">
            <Image x:Uid="Image_1" Source="Images/MoveUp_16.png" />
          </Button>
          <Label x:Uid="Label_2" Content="{x:Static lp:ModelLibraryResources.CategoryManagerWindowPriorityLabel}" Margin="0,4" HorizontalAlignment="Center" />
          <Button x:Name="buttonDown" x:Uid="buttonDown" Style="{StaticResource imageButtonStyle}" Command="{x:Static local:ModelLibraryCommands.MoveDownCommand}">
            <Image x:Uid="Image_2" Source="Images/MoveDown_16.png" />
          </Button>
        </StackPanel>
      </Grid>
    </GroupBox>
  </Grid>
</infra:ApwnPanelControl>
