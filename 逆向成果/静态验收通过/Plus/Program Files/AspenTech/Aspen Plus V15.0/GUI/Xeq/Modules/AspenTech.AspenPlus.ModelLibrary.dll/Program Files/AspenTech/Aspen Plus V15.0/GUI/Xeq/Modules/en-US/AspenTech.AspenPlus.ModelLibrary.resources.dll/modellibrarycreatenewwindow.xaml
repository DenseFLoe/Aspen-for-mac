<?xml version='1.0' encoding='utf-8'?>
<Window x:Class="AspenTech.AspenPlus.ModelLibrary.ModelLibraryCreateNewWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:lp="clr-namespace:AspenTech.AspenPlus.Localization;assembly=AspenTech.AspenPlus.Localization" xmlns:mm="clr-namespace:AspenTech.AspenPlus.MMControls;assembly=AspenTech.AspenPlus.MMControls" x:Uid="Window_1" mm:MMHelp.HelpFile="userguide1.chm" mm:MMHelp.HelpId="1553" ShowInTaskbar="False" ResizeMode="NoResize" SizeToContent="WidthAndHeight" WindowStartupLocation="CenterOwner" Title="{x:Static lp:ModelLibraryResources.CreateNewWindowTitle}" Background="{DynamicResource AspenDialogBackgroundBrush}">
  <StackPanel x:Uid="StackPanel_1" Margin="{DynamicResource AspenDialogOuterMargin}">
    <Grid x:Uid="Grid_1" Margin="{DynamicResource AspenVerticalRelativeControlMargin}">
      <Grid.RowDefinitions>
        <RowDefinition x:Uid="RowDefinition_1" Height="Auto" />
        <RowDefinition x:Uid="RowDefinition_2" Height="{DynamicResource AspenVerticalRelativeLength}" />
        <RowDefinition x:Uid="RowDefinition_3" Height="Auto" />
      </Grid.RowDefinitions>
      <Grid.ColumnDefinitions>
        <ColumnDefinition x:Uid="ColumnDefinition_1" Width="Auto" />
        <ColumnDefinition x:Uid="ColumnDefinition_2" Width="*" />
      </Grid.ColumnDefinitions>
      <Label x:Uid="Label_1" Grid.Row="0" Grid.Column="0" Content="{x:Static lp:ModelLibraryResources.CreateNewWindowLabelLibraryName}" />
      <TextBox TextChanged="theLibraryName_TextChanged" x:Name="theLibraryName" x:Uid="theLibraryName" Grid.Row="0" Grid.Column="1" Width="120" HorizontalAlignment="Left" />
      <Label x:Uid="Label_2" Grid.Row="2" Grid.Column="0" Content="{x:Static lp:ModelLibraryResources.CreateNewWindowLabelFileName}" />
      <StackPanel x:Uid="StackPanel_2" Grid.Row="2" Grid.Column="1" Orientation="Horizontal">
        <TextBox TextChanged="theFilePath_TextChanged" x:Name="theFilePath" x:Uid="theFilePath" Margin="{DynamicResource AspenHorizontalRelativeControlMargin}" Width="250" />
        <Button Click="buttonBrowse_Click" x:Name="buttonBrowse" x:Uid="buttonBrowse" Margin="0" Content="{x:Static lp:ModelLibraryResources.CreateNewWindowButtonBrowse}" />
      </StackPanel>
    </Grid>
    <StackPanel x:Uid="StackPanel_3" Orientation="Horizontal" HorizontalAlignment="Right">
      <Button Click="buttonOK_Click" x:Name="buttonOK" x:Uid="buttonOK" IsDefault="True" IsEnabled="False" Content="{x:Static lp:ModelLibraryResources.CreateNewWindowButtonCreate}" />
      <Button Click="buttonCancel_Click" x:Name="buttonCancel" x:Uid="buttonCancel" IsCancel="True" Content="{x:Static lp:ModelLibraryResources.CreateNewWindowButtonCancel}" Margin="0" />
    </StackPanel>
  </StackPanel>
</Window>
