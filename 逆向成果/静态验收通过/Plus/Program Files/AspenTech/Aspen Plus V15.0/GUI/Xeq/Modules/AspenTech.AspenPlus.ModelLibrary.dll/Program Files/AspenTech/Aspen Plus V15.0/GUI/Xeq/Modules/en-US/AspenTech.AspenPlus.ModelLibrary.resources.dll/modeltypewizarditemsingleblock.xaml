<?xml version='1.0' encoding='utf-8'?>
<local:ModelTypeWizardItem x:Class="AspenTech.AspenPlus.ModelLibrary.ModelTypeWizardItemSingleBlock" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:local="clr-namespace:AspenTech.AspenPlus.ModelLibrary" xmlns:lp="clr-namespace:AspenTech.AspenPlus.Localization;assembly=AspenTech.AspenPlus.Localization" xmlns:mlc="clr-namespace:AspenTech.AspenPlus.ModelLibrary.Controls;assembly=AspenTech.AspenPlus.ModelLibrary.Controls" x:Uid="local_ModelTypeWizardItem_1" Title="{x:Static lp:ModelLibraryResources.WizardItemSignleBlockTitle}">
  <StackPanel x:Uid="StackPanel_1" DataContext="{Binding RelativeSource={RelativeSource AncestorType=local:ModelTypeWizardItem, Mode=FindAncestor}}">
    <TextBlock x:Uid="TextBlock_1" Text="{x:Static lp:ModelLibraryResources.WizardItemSignleBlockLabel}" TextWrapping="Wrap" Margin="{DynamicResource AspenVerticalRelativeControlMargin}" />
    <GroupBox x:Uid="GroupBox_1" Header="{x:Static lp:ModelLibraryResources.WizardItemSignleBlockGroupHeader}" Margin="{DynamicResource AspenVerticalRelativeControlMargin}">
      <StackPanel x:Uid="StackPanel_2">
        <RadioButton x:Uid="RadioButton_1" Margin="{DynamicResource AspenVerticalRelativeControlMargin}" Content="{x:Static lp:ModelLibraryResources.WizardItemSignleBlockSingleBlockChoice}" IsChecked="{Binding Path=IsSingleBlock, Mode=TwoWay}" />
        <RadioButton x:Name="radioButtonMultiRecord" x:Uid="radioButtonMultiRecord" Margin="{DynamicResource AspenVerticalRelativeControlMargin}" Content="{x:Static lp:ModelLibraryResources.WizardItemSignleBlockMultipleRecordChoice}" IsChecked="{Binding Path=IsMultiRecord, Mode=TwoWay}" />
        <Border x:Uid="Border_1" Margin="{DynamicResource AspenVerticalRelativeControlMargin}">
          <CheckBox x:Uid="CheckBox_1" Margin="15,0,0,0" MinWidth="0" Content="{x:Static lp:ModelLibraryResources.WizardItemSignleBlockWithoutHierarchyLabel}" IsChecked="{Binding Path=IsToCreateWithoutHierarchy, Mode=TwoWay}" IsEnabled="{Binding ElementName=radioButtonMultiRecord, Path=IsChecked, Mode=OneWay}" />
        </Border>
      </StackPanel>
    </GroupBox>
  </StackPanel>
</local:ModelTypeWizardItem>
