<?xml version='1.0' encoding='utf-8'?>
<Window x:Class="AspenTech.AspenPlus.ModelLibrary.EnterNewNameWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:AspenTech.AspenPlus.ModelLibrary" xmlns:lp="clr-namespace:AspenTech.AspenPlus.Localization;assembly=AspenTech.AspenPlus.Localization" x:Uid="Window_1" Title="{x:Static lp:ModelLibraryResources.EnterNewNameWindowTitle}" SizeToContent="WidthAndHeight" ShowInTaskbar="False" ResizeMode="NoResize" WindowStartupLocation="CenterOwner" Background="{DynamicResource AspenDialogBackgroundBrush}">
  <Grid x:Uid="Grid_1" Margin="{DynamicResource AspenDialogOuterMargin}">
    <Grid.RowDefinitions>
      <RowDefinition x:Uid="RowDefinition_1" Height="Auto" />
      <RowDefinition x:Uid="RowDefinition_2" Height="{DynamicResource AspenVerticalRelativeLength}" />
      <RowDefinition x:Uid="RowDefinition_3" Height="Auto" />
    </Grid.RowDefinitions>
    <StackPanel x:Uid="StackPanel_1" Grid.Row="0" Orientation="Horizontal">
      <Label x:Name="theLabel" x:Uid="theLabel" Content="{x:Static lp:ModelLibraryResources.EnterNewCategoryNameWindowNameLabel}" />
      <TextBox TextChanged="textBoxNewName_TextChanged" x:Name="textBoxNewName" x:Uid="textBoxNewName" Width="200" MaxLength="{Binding Path=MaxLength, RelativeSource={RelativeSource AncestorType=Window, Mode=FindAncestor}}" />
    </StackPanel>
    <StackPanel x:Uid="StackPanel_2" Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
      <Button Click="buttonOK_Click" x:Name="buttonOK" x:Uid="buttonOK" IsDefault="True" IsEnabled="False" Content="{x:Static lp:ModelLibraryResources.EnterNewNameWindowButtonOK}" />
      <Button Click="buttonCancel_Click" x:Name="buttonCancel" x:Uid="buttonCancel" Margin="0" IsCancel="True" Content="{x:Static lp:ModelLibraryResources.EnterNewNameWindowButtonCancel}" />
    </StackPanel>
  </Grid>
</Window>
