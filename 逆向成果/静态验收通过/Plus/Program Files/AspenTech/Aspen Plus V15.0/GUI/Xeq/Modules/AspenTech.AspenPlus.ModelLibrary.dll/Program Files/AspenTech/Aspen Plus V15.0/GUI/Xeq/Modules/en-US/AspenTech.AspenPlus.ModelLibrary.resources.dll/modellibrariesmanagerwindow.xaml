<?xml version='1.0' encoding='utf-8'?>
<infra:ApwnPanelControl x:Class="AspenTech.AspenPlus.ModelLibrary.ModelLibrariesManagerWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:shell="http://schemas.aspentech.com/xaml/presentation/visualisation/commonshell" xmlns:infra="clr-namespace:AspenTech.AspenPlus.Infrastructure;assembly=AspenTech.AspenPlus.Infrastructure" xmlns:local="clr-namespace:AspenTech.AspenPlus.ModelLibrary" xmlns:lp="clr-namespace:AspenTech.AspenPlus.Localization;assembly=AspenTech.AspenPlus.Localization" xmlns:mm="clr-namespace:AspenTech.AspenPlus.MMControls;assembly=AspenTech.AspenPlus.MMControls" x:Uid="infra_ApwnPanelControl_1" mm:MMHelp.HelpFile="userguide1.chm" mm:MMHelp.HelpId="1551" MinWidth="600" MinHeight="200" IsDocumentScreen="False" Header="{x:Static lp:ModelLibraryResources.ManagerWindowTitle}" Background="{DynamicResource AspenDialogBackgroundBrush}">
  <Grid x:Uid="Grid_1" Margin="{DynamicResource AspenDialogOuterMargin}">
    <GroupBox x:Uid="GroupBox_1" Grid.Row="0" Header="{x:Static lp:ModelLibraryResources.ManagerWindowGroupBoxHeader}">
      <Grid x:Uid="Grid_2">
        <Grid.RowDefinitions>
          <RowDefinition x:Uid="RowDefinition_1" Height="*" />
          <RowDefinition x:Uid="RowDefinition_2" Height="Auto" />
        </Grid.RowDefinitions>
        <DataGrid x:Name="theDataGrid" x:Uid="theDataGrid" Grid.Row="0" AutoGenerateColumns="False" SelectionMode="Single" CanUserAddRows="False" Margin="{DynamicResource AspenVerticalRelativeControlMargin}" ItemsSource="{Binding RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=shell:ScreenContentControl}, Path=UserModelLibraries, Mode=OneWay}">
          <DataGrid.Columns>
            <DataGridTemplateColumn x:Uid="DataGridTemplateColumn_1" Header="{x:Static lp:ModelLibraryResources.ManagerWindowGridHeaderIsInUse}" IsReadOnly="True">
              <DataGridTemplateColumn.CellTemplate>
                <DataTemplate x:Uid="DataTemplate_1" DataType="local:UserModelLibrary">
                  <Border x:Uid="Border_1" VerticalAlignment="Center" HorizontalAlignment="Center">
                    <CheckBox x:Name="checkBoxIsInUse" Click="checkBoxIsInUse_Click" x:Uid="checkBoxIsInUse" MinWidth="0" Tag="{Binding }" IsChecked="{Binding Path=IsInUse, Mode=OneWay}" />
                  </Border>
                </DataTemplate>
              </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>
            <DataGridTemplateColumn x:Uid="DataGridTemplateColumn_2" Header="{x:Static lp:ModelLibraryResources.ManagerWindowGridHeaderName}" IsReadOnly="True" MinWidth="150">
              <DataGridTemplateColumn.CellTemplate>
                <DataTemplate x:Uid="DataTemplate_2" DataType="local:UserModelLibrary">
                  <Border x:Uid="Border_2" VerticalAlignment="Center" HorizontalAlignment="Left">
                    <TextBlock x:Uid="Label_1" Text="{Binding Path=DisplayName, Mode=OneWay}" />
                  </Border>
                </DataTemplate>
              </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>
            <DataGridTemplateColumn x:Uid="DataGridTemplateColumn_3" Header="{x:Static lp:ModelLibraryResources.ManagerWindowGridHeaderDetail}" IsReadOnly="True">
              <DataGridTemplateColumn.CellTemplate>
                <DataTemplate x:Uid="DataTemplate_3" DataType="local:UserModelLibrary">
                  <Button x:Name="buttonViewDetail" Click="buttonViewDetail_Click" x:Uid="buttonViewDetail" HorizontalAlignment="Center" VerticalAlignment="Center" Tag="{Binding }" IsEnabled="{Binding Path=IsInUse}" Content="{Binding Path=DetailButtonText, Mode=OneWay}" />
                </DataTemplate>
              </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>
            <DataGridTemplateColumn x:Uid="DataGridTemplateColumn_4" Header="{x:Static lp:ModelLibraryResources.ManagerWindowGridHeaderLocation}" IsReadOnly="True" MinWidth="270">
              <DataGridTemplateColumn.CellTemplate>
                <DataTemplate x:Uid="DataTemplate_4" DataType="local:UserModelLibrary">
                  <Border x:Uid="Border_3" VerticalAlignment="Center" HorizontalAlignment="Left">
                    <TextBlock x:Uid="Label_2" Text="{Binding Path=LocationButtonText, Mode=OneWay}" />
                  </Border>
                </DataTemplate>
              </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>
          </DataGrid.Columns>
        </DataGrid>
        <StackPanel x:Uid="StackPanel_1" Grid.Row="1" Orientation="Horizontal">
          <Button Click="buttonNew_Click" x:Name="buttonNew" x:Uid="buttonNew" Content="{x:Static lp:ModelLibraryResources.ManagerWindowGridNewButton}" />
          <Button Click="buttonImport_Click" x:Name="buttonImport" x:Uid="buttonImport" Content="{x:Static lp:ModelLibraryResources.ManagerWindowGridImportButton}" />
        </StackPanel>
      </Grid>
    </GroupBox>
    <mm:MMInContextGuidanceButton Margin="0,-6,-2,0" />
  </Grid>
</infra:ApwnPanelControl>
