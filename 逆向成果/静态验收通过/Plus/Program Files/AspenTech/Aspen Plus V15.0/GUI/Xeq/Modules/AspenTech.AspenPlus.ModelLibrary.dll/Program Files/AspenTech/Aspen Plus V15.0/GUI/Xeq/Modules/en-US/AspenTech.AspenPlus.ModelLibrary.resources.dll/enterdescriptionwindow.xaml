<?xml version='1.0' encoding='utf-8'?>
<Window x:Class="AspenTech.AspenPlus.ModelLibrary.EnterDescriptionWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:AspenTech.AspenPlus.ModelLibrary" xmlns:lp="clr-namespace:AspenTech.AspenPlus.Localization;assembly=AspenTech.AspenPlus.Localization" x:Uid="Window_1" SizeToContent="WidthAndHeight" ShowInTaskbar="False" ResizeMode="NoResize" WindowStartupLocation="CenterOwner" Title="{x:Static lp:ModelLibraryResources.EnterDescriptionWindowTitle}" Background="{DynamicResource AspenDialogBackgroundBrush}">
  <Grid x:Uid="Grid_1" Margin="{DynamicResource AspenDialogOuterMargin}">
    <Grid.RowDefinitions>
      <RowDefinition x:Uid="RowDefinition_1" Height="Auto" />
      <RowDefinition x:Uid="RowDefinition_2" Height="{DynamicResource AspenVerticalRelativeLength}" />
      <RowDefinition x:Uid="RowDefinition_3" Height="Auto" />
    </Grid.RowDefinitions>
    <Grid x:Uid="Grid_2" Grid.Row="0">
      <Grid.RowDefinitions>
        <RowDefinition x:Uid="RowDefinition_4" Height="Auto" />
        <RowDefinition x:Uid="RowDefinition_5" Height="{DynamicResource AspenVerticalRelativeLength}" />
        <RowDefinition x:Uid="RowDefinition_6" Height="Auto" />
      </Grid.RowDefinitions>
      <Grid.ColumnDefinitions>
        <ColumnDefinition x:Uid="ColumnDefinition_1" Width="Auto" />
        <ColumnDefinition x:Uid="ColumnDefinition_2" Width="300" />
      </Grid.ColumnDefinitions>
      <Label x:Uid="Label_1" Grid.Row="0" Grid.Column="0" Content="{x:Static lp:ModelLibraryResources.EnterDescriptionWindowModelTypeLabel}" />
      <Label x:Uid="Label_2" Grid.Row="0" Grid.Column="1" Content="{Binding RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=Window}, Path=ModelTypeName}" />
      <Label x:Uid="Label_3" Grid.Row="2" Grid.Column="0" VerticalAlignment="Top" Content="{x:Static lp:ModelLibraryResources.EnterDescriptionWindowDescriptionLabel}" />
      <TextBox x:Name="textBoxDescription" x:Uid="textBoxDescription" Grid.Row="2" Grid.Column="1" IsReadOnly="False" MinHeight="100" AcceptsReturn="True" VerticalScrollBarVisibility="Visible" Text="{Binding RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=Window}, Path=Description, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}" />
    </Grid>
    <StackPanel x:Uid="StackPanel_1" Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
      <Button Click="buttonOK_Click" x:Name="buttonOK" x:Uid="buttonOK" IsDefault="True" Content="{x:Static lp:ModelLibraryResources.EnterDescriptionWindowButtonOK}" />
      <Button Click="buttonCancel_Click" x:Name="buttonCancel" x:Uid="buttonCancel" Margin="0" IsCancel="True" Content="{x:Static lp:ModelLibraryResources.EnterDescriptionWindowButtonCancel}" />
    </StackPanel>
  </Grid>
</Window>
