new file mode 100644
--- /dev/null
+++ b/lib/execution/hardware.js
@@ -0,0 +1,39 @@
+import { InvocationDeadlineError } from '../lifecycle/invocations.js';
+
+export function workerResourceManager(ctx) {
+    if (process.platform !== 'win32') return undefined;
+    const manager = ctx.get('dshHardwareResourceManager');
+    return typeof manager?.wrapWorker === 'function' ? manager : undefined;
+}
+
+export async function prepareWorkerResources(ctx, argv, signal, operation) {
+    const manager = workerResourceManager(ctx);
+    if (!manager) return undefined;
+    const permit = await manager.acquire(signal, operation);
+    let timer;
+    try {
+        const deadline = new AbortController();
+        const combined = AbortSignal.any([signal, permit.signal, deadline.signal]);
+        combined.throwIfAborted();
+        const options = { argv: manager.wrapWorker(argv, permit), signal: combined };
+        if (process.versions.electron && argv[0].toLowerCase() === process.execPath.toLowerCase())
+            options.env = { ELECTRON_RUN_AS_NODE: '1' };
+        return {
+            signal: combined,
+            execute(timeoutMs) {
+                combined.throwIfAborted();
+                timer = setTimeout(() => deadline.abort(new InvocationDeadlineError()), timeoutMs);
+                timer.unref?.();
+                return options;
+            },
+            release() {
+                clearTimeout(timer);
+                permit.release();
+            },
+        };
+    }
+    catch (error) {
+        permit.release();
+        throw error;
+    }
+}
