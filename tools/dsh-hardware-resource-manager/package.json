{
  "name": "dsh-hardware-resource-manager",
  "version": "0.5.0-beta.12",
  "description": "DSH 硬件资源管理器。按 FIFO 调度 Windows 工具进程树并限制 CPU 和内存。",
  "author": "铁头喵",
  "type": "module",
  "main": "./index.js",
  "exports": {
    ".": "./index.js",
    "./pwsh": "./pwsh.js",
    "./ptc": "./ptc.js",
    "./package.json": "./package.json"
  },
  "os": ["win32"],
  "cpu": ["x64"],
  "engines": { "node": ">=22" },
  "scripts": { "test": "node --test test/fifo.test.mjs" },
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" }
  },
  "files": ["index.js", "host-queue.js", "authority.js", "pwsh.js", "ptc.js", "native/", "compat/", "cordis.patch.yml", "README.md"]
}
