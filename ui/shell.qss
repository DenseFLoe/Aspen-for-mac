QWidget { font-size: 12px; color: #172532; }
QMainWindow { background: #d6e4f3; }
QToolButton { border: 1px solid transparent; border-radius: 2px; padding: 3px 5px; }
QToolButton:hover { border-color: #8fb4d2; background: #e8f4ff; }
QToolButton:pressed, QToolButton:checked { border-color: #d0ab53; background: #ffe5a3; }
QToolButton:disabled { color: #9ba6ad; }
QToolButton#FileButton { background: #1567ae; color: white; padding: 5px 17px; }
QWidget#QuickBar { background: #f7fafc; }
QTabWidget#Ribbon::pane { border: 1px solid #a9bacd; background: #e3edf7; }
QTabBar::tab { background: #edf3f8; border: 1px solid #b2c3d2; padding: 5px 13px; }
QTabBar::tab:selected { background: #d9e9f8; border-bottom-color: #d9e9f8; }
QTabBar::tab:hover { background: #e8f4ff; }
QFrame#RibbonGroup { border-right: 1px solid #bdcddd; }
QLabel#GroupTitle { color: #667b8f; font-size: 11px; }
QScrollArea { border: none; background: transparent; }
QWidget#RibbonContent { background: qlineargradient(x1:0,y1:0,x2:0,y2:1,stop:0 #f0f6fc,stop:1 #d8e6f5); }
QTreeWidget { background: white; border: 1px solid #a9bacd; outline: none; }
QTreeWidget::item { height: 22px; }
QTreeWidget::item:selected { background: #d6e9fa; color: #172532; }
QToolButton#NavigationMode { text-align: left; padding: 7px; }
QToolButton#ActiveMode { background: #ffda8e; text-align: left; padding: 7px; }
QWidget#ComponentPage { background: qlineargradient(x1:0,y1:0,x2:0,y2:1,stop:0 #eef6ff,stop:1 #d5e4f3); }
QTableWidget { background: #f8fbfd; border: 1px solid #afc0ce; gridline-color: #d9e0e6; }
QHeaderView::section { background: #f7fafc; padding: 7px; border: 1px solid #d8e0e7; }
QToolButton#FormButton { border: 1px solid #8e9da9; background: #eef2f5; padding: 4px 11px; }
QToolButton#FormButton:hover { background: #dcefff; }
QToolButton#FormButton:disabled { color: #a8afb4; border-color: #c2c9cf; }
QStatusBar { background: #c2d4e6; }
QLabel#Incomplete { background: #ed6d6d; color: #541c1c; padding: 3px; }
QMenu { background: #fbfcfe; border: 1px solid #93a5b7; padding: 4px; }
QMenu::item { padding: 5px 28px 5px 22px; }
QMenu::item:selected { background: #d9ecfd; color: #172532; }
QMenu::item:disabled { color: #9ba6ad; }
QMenu::separator { height: 1px; background: #cdd9e4; margin: 4px; }
QWidget#FilePage { background: white; }
QWidget#FileRail { background: #b5c7d9; }
QToolButton#FileEntry { text-align: left; padding: 9px 15px; }
QToolButton#FileEntry:checked { background: #8faecb; }
QToolButton#FileCommand { background: #007cb9; color: white; text-align: left; padding: 14px; }
QToolButton#FileCommand:disabled { background: #eff1f3; color: #adb2b7; }
QLabel#PanelHeading { font-size: 20px; font-weight: 600; padding: 15px 0; }
QLineEdit { background: white; border: 1px solid #a8bacb; padding: 3px; }

/* Observed V15 density: compact ribbon rows, 19px tree items, inset form tabs. */
QToolButton { padding: 1px 3px; border-radius: 0px; }
QToolButton[largeRibbon="true"] { padding: 2px 5px; }
QTabWidget#Ribbon QTabBar::tab { padding: 4px 15px; background: #f5f7fa; border-color: #a5b7c9; }
QTabWidget#Ribbon QTabBar::tab:selected { background: #e6f1fc; }
QWidget#RibbonContent { background: qlineargradient(x1:0,y1:0,x2:0,y2:1,stop:0 #eff6fd,stop:1 #d5e3f3); }
QLabel#GroupTitle { font-size: 11px; color: #697988; padding: 2px 0px; }
QTreeWidget::item { height: 19px; }
QTreeWidget::item:selected { border: 1px solid #9db9d7; background: qlineargradient(x1:0,y1:0,x2:0,y2:1,stop:0 #eaf4ff,stop:1 #c7ddf5); }
QWidget#ComponentWorkspace { background: #d6e4f2; }
QWidget#DocumentBar { background: #c4d7eb; min-height: 22px; max-height: 22px; }
QLabel#DocumentTitle { padding: 2px 6px; background: #dceafb; border: 1px solid #a2b6cb; }
QWidget#FormCanvas { background: qlineargradient(x1:0,y1:0,x2:0,y2:1,stop:0 #eff7ff,stop:1 #d6e5f4); }
QScrollArea#FormScroll { border: 1px solid #94a9bc; }
QWidget#ComponentWorkspace QTabWidget::pane { border: 1px solid #9eafc1; }
QWidget#ComponentWorkspace QTabBar::tab { padding: 3px 8px; border: 1px solid #9ba9b7; background: qlineargradient(x1:0,y1:0,x2:0,y2:1,stop:0 #ffffff,stop:1 #d5d9df); }
QWidget#ComponentWorkspace QTabBar::tab:selected { background: #edf6ff; border-bottom-color: #edf6ff; }
QTabBar::tab:disabled { color: #9a9a9a; background: #e8e8e8; }
QGroupBox { border: 1px solid #93a6ba; border-radius: 3px; margin-top: 7px; padding-top: 4px; }
QGroupBox::title { subcontrol-origin: margin; subcontrol-position: top left; left: 7px; padding: 0px 2px; }
QPushButton[formButton="true"] { min-height: 21px; border: 1px solid #8b929b; border-radius: 3px; padding: 0px 6px; background: qlineargradient(x1:0,y1:0,x2:0,y2:1,stop:0 #fafafa,stop:0.45 #e5e5e5,stop:0.5 #dadada,stop:1 #eeeeee); }
QPushButton[formButton="true"]:hover { border-color: #499bc1; background: #dceefa; }
QPushButton[formButton="true"]:pressed { background: #c2e3f4; }
QPushButton[formButton="true"]:disabled { color: #a6a6a6; border-color: #b9b9b9; background: #eeeeee; }
QTableWidget { background: #f8fbfd; border: 1px solid #92a8bb; gridline-color: #d1d7de; }
QTableWidget::item:selected { background: #fff2ae; color: #172532; }
QHeaderView::section { background: qlineargradient(x1:0,y1:0,x2:0,y2:1,stop:0 #ffffff,stop:1 #f0f1f3); border: 1px solid #d3d9e0; padding: 2px; }
QLineEdit, QComboBox, QSpinBox { min-height: 19px; border: 1px solid #adb8c6; background: white; padding: 0px 3px; }
QLineEdit:disabled, QComboBox:disabled, QSpinBox:disabled { background: #e9e9ef; color: #96969d; border-color: #d5d5dc; }
QTextEdit, QListWidget { background: white; border: 1px solid #94a4b6; }
QListWidget#available-databanks, QListWidget#selected-databanks { color: #0000a0; font-weight: bold; }
QToolButton#ActiveMode { background: qlineargradient(x1:0,y1:0,x2:0,y2:1,stop:0 #ffedbe,stop:0.4 #ffbd6a,stop:0.55 #ffd15a,stop:1 #ffe69b); border: 1px solid #e6a64d; padding: 2px 3px; }
QToolButton#NavigationMode { padding: 2px 3px; }
QStatusBar { background: #b6c8da; }
QLabel#Incomplete { background: #f11b1b; color: #151515; padding: 1px; }

QWidget#RibbonContent QToolButton { font-size: 11px; padding: 0px 2px; }
QWidget#FormCanvas QLineEdit { color: #0000ad; font-style: italic; }
