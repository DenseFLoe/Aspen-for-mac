QWidget { font-size: 12px; color: #172532; }
QMainWindow { background: #d6e4f3; }
QToolButton { border: 1px solid transparent; border-radius: 2px; padding: 3px 5px; }
QToolButton:hover { border-color: #8fb4d2; background: #e8f4ff; }
QToolButton:pressed, QToolButton:checked { border-color: #d0ab53; background: #ffe5a3; }
QToolButton:disabled { color: #9ba6ad; }
QToolButton#FileButton { background: #1567ae; color: white; padding: 5px 17px; }
QWidget#QuickBar { background: #f7fafc; }
QTabWidget#Ribbon::pane { border: 1px solid #a9bacd; background: #e3edf7; }
QTabBar::tab { background: #edf3f8; border: 1px solid #b2c3d2; padding: 5px 13px; }
QTabBar::tab:selected { background: #d9e9f8; border-bottom-color: #d9e9f8; }
QTabBar::tab:hover { background: #e8f4ff; }
QFrame#RibbonGroup { border-right: 1px solid #bdcddd; }
QLabel#GroupTitle { color: #667b8f; font-size: 11px; }
QScrollArea { border: none; background: transparent; }
QWidget#RibbonContent { background: qlineargradient(x1:0,y1:0,x2:0,y2:1,stop:0 #f0f6fc,stop:1 #d8e6f5); }
QTreeWidget { background: white; border: 1px solid #a9bacd; outline: none; }
QTreeWidget::item { height: 22px; }
QTreeWidget::item:selected { background: #d6e9fa; color: #172532; }
QToolButton#NavigationMode { text-align: left; padding: 7px; }
QToolButton#ActiveMode { background: #ffda8e; text-align: left; padding: 7px; }
QWidget#ComponentPage { background: qlineargradient(x1:0,y1:0,x2:0,y2:1,stop:0 #eef6ff,stop:1 #d5e4f3); }
QTableWidget { background: #f8fbfd; border: 1px solid #afc0ce; gridline-color: #d9e0e6; }
QHeaderView::section { background: #f7fafc; padding: 7px; border: 1px solid #d8e0e7; }
QToolButton#FormButton { border: 1px solid #8e9da9; background: #eef2f5; padding: 4px 11px; }
QToolButton#FormButton:hover { background: #dcefff; }
QToolButton#FormButton:disabled { color: #a8afb4; border-color: #c2c9cf; }
QStatusBar { background: #c2d4e6; }
QLabel#Incomplete { background: #ed6d6d; color: #541c1c; padding: 3px; }
QMenu { background: #fbfcfe; border: 1px solid #93a5b7; padding: 4px; }
QMenu::item { padding: 5px 28px 5px 22px; }
QMenu::item:selected { background: #d9ecfd; color: #172532; }
QMenu::item:disabled { color: #9ba6ad; }
QMenu::separator { height: 1px; background: #cdd9e4; margin: 4px; }
QWidget#FilePage { background: white; }
QWidget#FileRail { background: #b5c7d9; }
QToolButton#FileEntry { text-align: left; padding: 9px 15px; }
QToolButton#FileEntry:checked { background: #8faecb; }
QToolButton#FileCommand { background: #007cb9; color: white; text-align: left; padding: 14px; }
QToolButton#FileCommand:disabled { background: #eff1f3; color: #adb2b7; }
QLabel#PanelHeading { font-size: 20px; font-weight: 600; padding: 15px 0; }
QLineEdit { background: white; border: 1px solid #a8bacb; padding: 3px; }
