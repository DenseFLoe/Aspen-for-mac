<?xml version='1.0' encoding='utf-8'?>
<MMTabPage x:Class="AspenTech.AspenPlus.MMForms.Setup.MMSetup_Units_Search" xmlns="http://schemas.aspentech.com/xaml/presentation/aspenplus" xmlns:res="clr-namespace:AspenTech.AspenPlus.Localization;assembly=AspenTech.AspenPlus.Localization" xmlns:av="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Uid="MMTabPage_1" MinWidth="520" MinHeight="400" xmlns:aes="http://schemas.aspentech.com/xaml/presentation/engineering">
  <av:Grid x:Uid="av_Grid_1">
    <av:Grid.ColumnDefinitions>
      <av:ColumnDefinition x:Uid="av_ColumnDefinition_1" Width="*" />
    </av:Grid.ColumnDefinitions>
    <av:Grid.RowDefinitions>
      <av:RowDefinition x:Uid="av_RowDefinition_1" Height="*" />
      <av:RowDefinition x:Uid="av_RowDefinition_2" Height="8" />
      <av:RowDefinition x:Uid="av_RowDefinition_3" Height="Auto" />
    </av:Grid.RowDefinitions>
    <MMScrollArea Name="scrSearch" x:Uid="MMScrollArea_1" DataProperty="scrSearch_GridData">
      <MMScrollArea.MMFields>
        <MMScrollAreaValueField x:Uid="MMScrollAreaValueField_1" PropertyPath="MMLBUText1_unitlabel" FieldName="MMLBUText1_value" Width="303" Label="{x:Static res:ApwnResources.MMSetup_Units_Search_MMFLabel0}" />
        <MMScrollAreaComboValueField x:Uid="MMScrollAreaComboValueField_1" VariableDataMember="Value" PropertyPath="MMLBUText1_unitname" Width="150" Label="{x:Static res:ApwnResources.MMSetup_Units_Search_MMFLabel1}" />
      </MMScrollArea.MMFields>
    </MMScrollArea>
    <MMCmdButton Name="cmdClose" x:Uid="MMCmdButton_1" Margin="0,0,0,7" HorizontalAlignment="Center" av:Grid.Row="2" Content="{x:Static res:ApwnResources.MMSetup_Units_Search_MMF_Content0}">
      <aes:AesCmdButton.Command>
        <av:Binding Path="cmdClose_Command" />
      </aes:AesCmdButton.Command>
    </MMCmdButton>
  </av:Grid>
</MMTabPage>
