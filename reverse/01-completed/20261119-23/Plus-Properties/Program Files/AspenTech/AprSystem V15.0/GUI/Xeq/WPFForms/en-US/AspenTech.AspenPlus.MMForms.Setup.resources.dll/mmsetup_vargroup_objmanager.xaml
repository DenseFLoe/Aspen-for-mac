<?xml version='1.0' encoding='utf-8'?>
<MMTabPage x:Class="AspenTech.AspenPlus.MMForms.Setup.MMSetup_VarGroup_ObjManager" xmlns="http://schemas.aspentech.com/xaml/presentation/aspenplus" xmlns:res="clr-namespace:AspenTech.AspenPlus.Localization;assembly=AspenTech.AspenPlus.Localization" xmlns:av="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Uid="MMTabPage_1" MinWidth="520" MinHeight="340" MMHelp.HelpFile="plotwiz.chm" MMHelp.HelpId="113">
  <av:Grid Margin="7">
    <av:Grid.RowDefinitions>
      <av:RowDefinition Height="Auto" />
      <av:RowDefinition Height="*" />
    </av:Grid.RowDefinitions>
    <MMFlatButton CornerRadius="7" Height="25" HorizontalAlignment="Left">
      <av:StackPanel Orientation="Horizontal" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
        <MMFlatButton Name="cmdNew" x:Uid="cmdNew" Height="25" MinWidth="80" CornerRadius="7,0,0,7" BorderBrush="#00FFFFFF" BorderThickness="0" Content="{x:Static res:ApwnResources.MMSetup_StreamGroups_ObjManager_New}" Margin="0" Padding="2">
          <av:ButtonBase.Command>
            <av:Binding Path="cmdAdd_Command" />
          </av:ButtonBase.Command>
        </MMFlatButton>
        <MMFlatButton Name="cmdEdit" x:Uid="cmdEdit" Height="25" MinWidth="80" BorderBrush="#00FFFFFF" BorderThickness="0" Content="{x:Static res:ApwnResources.MMSetup_StreamGroups_ObjManager_Edit}" Margin="0" Padding="2">
          <av:ButtonBase.Command>
            <av:Binding Path="cmdEdit_Command" />
          </av:ButtonBase.Command>
        </MMFlatButton>
        <MMFlatButton Name="cmdCopy" x:Uid="cmdCopy" Height="25" MinWidth="80" BorderBrush="#00FFFFFF" BorderThickness="0" Content="{x:Static res:ApwnResources.MMSetup_StreamGroups_ObjManager_Copy}" Margin="0" Padding="2">
          <av:ButtonBase.Command>
            <av:Binding Path="cmdCopy_Command" />
          </av:ButtonBase.Command>
        </MMFlatButton>
        <MMFlatButton Name="cmdPaste" x:Uid="cmdPaste" Height="25" MinWidth="80" BorderBrush="#00FFFFFF" BorderThickness="0" Content="{x:Static res:ApwnResources.MMSetup_StreamGroups_ObjManager_Paste}" Margin="0" Padding="2">
          <av:ButtonBase.Command>
            <av:Binding Path="cmdPaste_Command" />
          </av:ButtonBase.Command>
        </MMFlatButton>
        <MMFlatButton Name="cmdDuplicate" x:Uid="cmdDuplicate" Height="25" MinWidth="80" BorderBrush="#00FFFFFF" BorderThickness="0" Content="{x:Static res:ApwnResources.MMSetup_StreamGroups_ObjManager_Duplicate}" Margin="0" Padding="2">
          <av:ButtonBase.Command>
            <av:Binding Path="cmdDuplicate_Command" />
          </av:ButtonBase.Command>
        </MMFlatButton>
        <MMFlatButton Name="cmdExport" x:Uid="cmdExport" Height="25" MinWidth="80" CornerRadius="0,7,7,0" BorderThickness="0" Content="{x:Static res:ApwnResources.MMSetup_StreamGroups_ObjManager_Export}" Margin="0" Padding="2">
          <av:ButtonBase.Command>
            <av:Binding Path="cmdExport_Command" />
          </av:ButtonBase.Command>
        </MMFlatButton>
      </av:StackPanel>
    </MMFlatButton>
    <MMScrollAreaMS Name="grdChild" x:Uid="MMScrollArea_1" DataProperty="grdChild_GridData" av:Grid.Row="1" MinHeight="80" Margin="0,7,0,7" VerticalAlignment="Top" HorizontalAlignment="Left">
      <MMScrollAreaMS.SelectedRowsCount>
        <av:Binding Path="AllSelectedRecordsCount" Mode="TwoWay" />
      </MMScrollAreaMS.SelectedRowsCount>
      <MMScrollAreaMS.SelectedRowIds>
        <av:Binding Path="SelectedRowIndexes" Mode="TwoWay" />
      </MMScrollAreaMS.SelectedRowIds>
      <MMScrollAreaMS.RowDoubleClickCommand>
        <av:Binding Path="grid_RowDoubleClickCommand" />
      </MMScrollAreaMS.RowDoubleClickCommand>
      <MMScrollAreaMS.DeleteRowCommand>
        <av:Binding Path="cmdDelete_Command" />
      </MMScrollAreaMS.DeleteRowCommand>
      <MMScrollAreaMS.MMFields>
        <MMScrollAreaValueField x:Uid="MMScrollAreaValueField_1" PropertyPath="txtName_var1" Mask="Id" MaxLength="8" Width="95" Label="{x:Static res:ApwnResources.MMSetup_StreamGroups_ObjManager_Name}" />
        <MMScrollAreaValueField x:Uid="MMScrollAreaValueField_2" PropertyPath="txtDescription_var1" Width="400" Mask="None" MaxLength="256" Label="{x:Static res:ApwnResources.MMSetup_StreamGroups_ObjManager_Description}" />
        <MMScrollAreaCheckBoxField PropertyPath="Active_var" Width="100" Label="{x:Static res:ApwnResources.MMGeneric_List2D_Active}" />
        <MMScrollAreaDeleteButtonField x:Uid="MMScrollAreaValueField_4" CommandPath="cmdDelete_Command" CommandParameterPath="txtName_var1.Value" PropertyPath="cmdDelete_var1" Label="{x:Static res:ApwnResources.MMSetup_StreamGroups_ObjManager_Delete}" Width="90" />
      </MMScrollAreaMS.MMFields>
    </MMScrollAreaMS>
  </av:Grid>
</MMTabPage>
