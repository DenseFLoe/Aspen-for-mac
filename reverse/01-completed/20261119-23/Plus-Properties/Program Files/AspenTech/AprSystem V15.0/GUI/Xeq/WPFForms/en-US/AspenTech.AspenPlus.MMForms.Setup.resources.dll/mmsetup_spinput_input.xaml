<?xml version='1.0' encoding='utf-8'?>
<MMTabPage x:Class="AspenTech.AspenPlus.MMForms.Setup.MMSetup_SPInput_Input" xmlns="http://schemas.aspentech.com/xaml/presentation/aspenplus" xmlns:res="clr-namespace:AspenTech.AspenPlus.Localization;assembly=AspenTech.AspenPlus.Localization" xmlns:av="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Uid="MMTabPage_1" MinWidth="520" MinHeight="340" xmlns:aes="http://schemas.aspentech.com/xaml/presentation/engineering">
  <MMGroupBox Name="frmStrPrice" x:Uid="MMGroupBox_1" Header="{x:Static res:ApwnResources.MMSetup_SPInput_Input_MMFHeader0}" MinWidth="504" Margin="8,8,8,8">
    <MMStretchGrid x:Uid="MMStretchGrid_1">
      <av:Grid.ColumnDefinitions>
        <av:ColumnDefinition x:Uid="av_ColumnDefinition_1" Width="*" />
      </av:Grid.ColumnDefinitions>
      <av:Grid.RowDefinitions>
        <av:RowDefinition x:Uid="av_RowDefinition_1" Height="*" />
        <av:RowDefinition x:Uid="av_RowDefinition_2" Height="Auto" />
      </av:Grid.RowDefinitions>
      <MMScrollArea Name="grdStreamPrice" x:Uid="MMScrollArea_1" DataProperty="grdStreamPrice_GridData" av:Grid.Column="0" av:Grid.Row="0" Plotable="False">
        <MMScrollArea.MMFields>
          <MMScrollAreaComboValueField x:Uid="MMScrollAreaComboValueField_1" VariableDataMember="Value" PropertyPath="MMComboBox1_var1" Width="242" Label="{x:Static res:ApwnResources.MMSetup_SPInput_Input_MMFLabel0}" IsFieldFixed="True" />
          <MMScrollAreaValueField x:Uid="MMScrollAreaValueField_1" PropertyPath="MMTextBox1_var1" Width="130" Label="{x:Static res:ApwnResources.MMSetup_SPInput_Input_MMFLabel1}" />
          <MMScrollAreaValueField x:Uid="MMScrollAreaValueField_2" PropertyPath="MMTextBox3_var1" Width="130" Label="{x:Static res:ApwnResources.MMSetup_SPInput_Input_MMFLabel2}" />
          <MMScrollAreaBasisField x:Uid="MMScrollAreaBasisField_1" PropertyPath="MMLBUText1_var1" FieldName="MMLBUText1_basis" Width="93" Label="{x:Static res:ApwnResources.MMSetup_SPInput_Input_MMFLabel3}" />
          <MMScrollAreaValueField x:Uid="MMScrollAreaValueField_3" PropertyPath="MMLBUText1_var1" FieldName="MMLBUText1_value" Width="93" Label="{x:Static res:ApwnResources.MMSetup_SPInput_Input_MMFLabel4}" />
          <MMScrollAreaUnitsField x:Uid="MMScrollAreaUnitsField_1" PropertyPath="MMLBUText1_var1" FieldName="MMLBUText1_units" Width="93" Label="{x:Static res:ApwnResources.MMSetup_SPInput_Input_MMFLabel5}" />
        </MMScrollArea.MMFields>
      </MMScrollArea>
      <av:Grid x:Uid="av_Grid_1" Margin="0,8,0,0" av:Grid.Column="0" av:Grid.Row="1">
        <av:Grid.ColumnDefinitions>
          <av:ColumnDefinition x:Uid="av_ColumnDefinition_2" Width="Auto" />
          <av:ColumnDefinition x:Uid="av_ColumnDefinition_3" Width="Auto" />
        </av:Grid.ColumnDefinitions>
        <av:Grid.RowDefinitions>
          <av:RowDefinition x:Uid="av_RowDefinition_3" Height="Auto" />
        </av:Grid.RowDefinitions>
        <MMCmdButton Name="cmdAddFeedStream" x:Uid="MMCmdButton_1" MinWidth="97" av:Grid.Column="0" av:Grid.Row="0" Content="{x:Static res:ApwnResources.MMSetup_SPInput_Input_MMF_Content0}">
          <aes:AesCmdButton.Command>
            <av:Binding Path="cmdAddFeedStream_Command" />
          </aes:AesCmdButton.Command>
        </MMCmdButton>
        <MMCmdButton Name="cmdAddProdStream" x:Uid="MMCmdButton_2" MinWidth="113" Margin="11,0,0,0" av:Grid.Column="1" av:Grid.Row="0" Content="{x:Static res:ApwnResources.MMSetup_SPInput_Input_MMF_Content1}">
          <aes:AesCmdButton.Command>
            <av:Binding Path="cmdAddProdStream_Command" />
          </aes:AesCmdButton.Command>
        </MMCmdButton>
      </av:Grid>
    </MMStretchGrid>
  </MMGroupBox>
</MMTabPage>
