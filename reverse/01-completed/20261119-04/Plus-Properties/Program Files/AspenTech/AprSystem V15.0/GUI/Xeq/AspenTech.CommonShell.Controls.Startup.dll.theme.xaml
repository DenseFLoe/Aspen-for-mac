<?xml version='1.0' encoding='utf-8'?>
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:AspenTech.CommonShell.Controls.Startup" xmlns:primitive="clr-namespace:AspenTech.CommonShell.Controls.Startup.Primitive">
  <primitive:FileItemsToVisibilityConverter x:Key="listBoxVisibilityConverter" IsPositiveCheck="True" />
  <primitive:FileItemsToVisibilityConverter x:Key="placeholderVisibilityConverter" IsPositiveCheck="False" />
  <primitive:MouseOverToBackgroundConverter x:Key="itemBackgroundConverter" />
  <primitive:FileItemModifiedTimeDisplayConverter x:Key="timeDisplayConverter" />
  <primitive:DialogTitleTextConverter x:Key="titleTextConverter" />
  <primitive:DialogTitleBackgroundConverter x:Key="titleBackgroundConverter" />
  <Style x:Key="closeButtonStyle" TargetType="{x:Type Button}">
    <Setter Property="Control.Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type Button}">
          <Grid Height="Auto" Width="Auto">
            <Border Name="Bd" BorderThickness="0" Height="20" VerticalAlignment="Top" HorizontalAlignment="Right" Width="32" Margin="0" CornerRadius="0,0,2,2" Background="#00FFFFFF">
              <Path Data="M6,0L9,0 9,6.0000001 15,6.0000001 15,9 9,9 9,15 6,15 6,9 0,9 0,6.0000001 6,6.0000001z" Fill="#FFF4F4F5" HorizontalAlignment="Center" Height="15" Margin="0" RenderTransformOrigin="0.5,0.5" Stretch="Fill" StrokeThickness="0" VerticalAlignment="Center" Width="15">
                <Shape.Stroke>
                  <x:Null />
                </Shape.Stroke>
                <UIElement.RenderTransform>
                  <TransformGroup>
                    <ScaleTransform />
                    <SkewTransform />
                    <RotateTransform Angle="45" />
                    <TranslateTransform />
                  </TransformGroup>
                </UIElement.RenderTransform>
              </Path>
            </Border>
          </Grid>
          <ControlTemplate.Triggers>
            <MultiTrigger>
              <MultiTrigger.Conditions>
                <Condition Property="UIElement.IsMouseOver" Value="True" />
                <Condition Property="UIElement.IsEnabled" Value="True" />
              </MultiTrigger.Conditions>
              <Setter TargetName="Bd" Property="Panel.Background" Value="#FFBCC6C5" />
            </MultiTrigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style x:Key="{x:Type primitive:IconButton}" TargetType="{x:Type primitive:IconButton}">
    <Setter Property="Control.Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type primitive:IconButton}">
          <Border Name="border" BorderThickness="1.5" CornerRadius="0" ClipToBounds="False" Width="Auto" Height="Auto" Background="#00FFFFFF">
            <Border.BorderBrush>
              <x:Null />
            </Border.BorderBrush>
            <Grid HorizontalAlignment="Stretch" Height="Auto" VerticalAlignment="Stretch" Width="Auto">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition />
              </Grid.ColumnDefinitions>
              <Image Source="{TemplateBinding primitive:IconButton.Icon}" Margin="5,0,4,0" Width="32" Height="32" />
              <TextBlock Margin="6,4,8,4" TextWrapping="NoWrap" Text="{TemplateBinding primitive:IconButton.Caption}" FontSize="13.333" VerticalAlignment="Center" HorizontalAlignment="Center" Grid.Column="2" />
            </Grid>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="UIElement.IsMouseOver" Value="True">
              <Setter TargetName="border" Property="Border.BorderBrush" Value="#FFE5C365" />
              <Setter TargetName="border" Property="Panel.Background">
                <Setter.Value>
                  <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0">
                    <GradientStop Color="#FFFFF7E0" Offset="0.007" />
                    <GradientStop Color="#FFF9E096" Offset="1" />
                  </LinearGradientBrush>
                </Setter.Value>
              </Setter>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style x:Key="{x:Type primitive:RecentFileListControl}" TargetType="{x:Type primitive:RecentFileListControl}">
    <Setter Property="Control.Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type primitive:RecentFileListControl}">
          <Border Background="{TemplateBinding Panel.Background}" BorderBrush="{TemplateBinding Border.BorderBrush}" BorderThickness="{TemplateBinding Border.BorderThickness}">
            <Grid>
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
              </Grid.RowDefinitions>
              <TextBlock Grid.Row="0" FontWeight="Bold" FontSize="16" Margin="0,0,0,3" HorizontalAlignment="Left" Text="{TemplateBinding primitive:RecentFileListControl.RecentFilesListCaption}" />
              <Grid Grid.Row="1" Background="#FFDCDCDC">
                <TextBlock HorizontalAlignment="Left" VerticalAlignment="Top" Margin="10,8,0,0" FontSize="13.333" Text="{TemplateBinding primitive:RecentFileListControl.RecentFilesPlaceholderText}">
                  <UIElement.Visibility>
                    <Binding Path="RecentFiles" Converter="{StaticResource placeholderVisibilityConverter}">
                      <Binding.RelativeSource>
                        <RelativeSource Mode="TemplatedParent" />
                      </Binding.RelativeSource>
                    </Binding>
                  </UIElement.Visibility>
                </TextBlock>
                <ListBox SelectionMode="Single" Background="#00FFFFFF" ItemsSource="{TemplateBinding primitive:RecentFileListControl.RecentFiles}" HorizontalContentAlignment="Stretch" ScrollViewer.VerticalScrollBarVisibility="Auto">
                  <ItemsControl.ItemContainerStyleSelector>
                    <x:Null />
                  </ItemsControl.ItemContainerStyleSelector>
                  <UIElement.Visibility>
                    <Binding Path="RecentFiles" Converter="{StaticResource listBoxVisibilityConverter}">
                      <Binding.RelativeSource>
                        <RelativeSource Mode="TemplatedParent" />
                      </Binding.RelativeSource>
                    </Binding>
                  </UIElement.Visibility>
                  <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type primitive:RecentFileItem}">
                      <Border HorizontalAlignment="Stretch" Background="#FFDCDCDC">
                        <FrameworkElement.ToolTip>
                          <Binding Path="FilePath" />
                        </FrameworkElement.ToolTip>
                        <Border>
                          <Border.Background>
                            <Binding Path="IsMouseOver" Converter="{StaticResource itemBackgroundConverter}" ConverterParameter="#FFF1F6FD" FallbackValue="Transparent">
                              <Binding.RelativeSource>
                                <RelativeSource Mode="Self" />
                              </Binding.RelativeSource>
                            </Binding>
                          </Border.Background>
                          <Grid Name="itemGrid" Margin="4,4,0,4">
                            <Grid.ColumnDefinitions>
                              <ColumnDefinition Width="Auto" />
                              <ColumnDefinition Width="*" SharedSizeGroup="DetailedColumn" />
                            </Grid.ColumnDefinitions>
                            <Border BorderThickness="1" Margin="0,0,10,0" Width="64" Height="64" Background="#FFFFFFFF" CornerRadius="8" BorderBrush="#00FFFFFF">
                              <Image Margin="0" Width="Auto" HorizontalAlignment="Center" VerticalAlignment="Center" Stretch="None">
                                <Image.Source>
                                  <Binding Path="FileIcon" />
                                </Image.Source>
                              </Image>
                            </Border>
                            <Grid Grid.Column="1" Margin="15,0,0,0" VerticalAlignment="Center">
                              <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                              </Grid.RowDefinitions>
                              <TextBlock>
                                <TextBlock.Text>
                                  <Binding Path="FileName" />
                                </TextBlock.Text>
                              </TextBlock>
                              <TextBlock Grid.Row="1" Margin="0,5,0,0">
                                <TextBlock.Text>
                                  <Binding Path="ModifiedTime" Converter="{StaticResource timeDisplayConverter}" />
                                </TextBlock.Text>
                              </TextBlock>
                            </Grid>
                          </Grid>
                        </Border>
                      </Border>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                  <ItemsControl.ItemContainerStyle>
                    <Style TargetType="{x:Type ListBoxItem}">
                      <Setter Property="Panel.Background" Value="#00FFFFFF" />
                      <Setter Property="Control.Padding" Value="0" />
                    </Style>
                  </ItemsControl.ItemContainerStyle>
                </ListBox>
              </Grid>
            </Grid>
          </Border>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style x:Key="{x:Type primitive:StartupControl}" TargetType="{x:Type primitive:StartupControl}">
    <Setter Property="Control.Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type primitive:StartupControl}">
          <Border BorderBrush="#FFA3AEB9" BorderThickness="1" CornerRadius="3" Background="#FFF3F7FA">
            <Grid>
              <FrameworkElement.DataContext>
                <Binding Path="Options">
                  <Binding.RelativeSource>
                    <RelativeSource Mode="TemplatedParent" />
                  </Binding.RelativeSource>
                </Binding>
              </FrameworkElement.DataContext>
              <Grid.RowDefinitions>
                <RowDefinition Height="25" />
                <RowDefinition Height="*" />
              </Grid.RowDefinitions>
              <Grid>
                <Panel.Background>
                  <MultiBinding Converter="{StaticResource titleBackgroundConverter}">
                    <Binding Path="TitleBackground" />
                    <Binding Path="ApplicationName" />
                  </MultiBinding>
                </Panel.Background>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Margin="5,0,0,0" HorizontalAlignment="Left" VerticalAlignment="Center" FontSize="13.333">
                  <TextBlock.Foreground>
                    <Binding Path="TitleForeground" />
                  </TextBlock.Foreground>
                  <TextBlock.Text>
                    <MultiBinding Converter="{StaticResource titleTextConverter}">
                      <Binding Path="DialogTitle" />
                      <Binding Path="ApplicationName" />
                    </MultiBinding>
                  </TextBlock.Text>
                </TextBlock>
                <Button Grid.Column="1" Margin="0,0,5,0" VerticalAlignment="Top" Command="{TemplateBinding primitive:StartupControl.CloseCommand}" Style="{StaticResource closeButtonStyle}" />
              </Grid>
              <Border BorderBrush="#FF9EABB7" BorderThickness="0.5" Margin="4,2,4,4" Grid.Row="1" Background="#FFFFFFFF">
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="150" />
                    <ColumnDefinition Width="*" />
                  </Grid.ColumnDefinitions>
                  <StackPanel Margin="10" Orientation="Vertical" VerticalAlignment="Top">
                    <primitive:IconButton Icon="pack://application:,,,/AspenTech.CommonShell.Controls.Startup;component/Images/open_32.png">
                      <primitive:IconButton.Caption>
                        <Binding Path="ButtonOpenCaption" />
                      </primitive:IconButton.Caption>
                      <ButtonBase.Command>
                        <Binding Path="OpenCommand">
                          <Binding.RelativeSource>
                            <RelativeSource Mode="TemplatedParent" />
                          </Binding.RelativeSource>
                        </Binding>
                      </ButtonBase.Command>
                    </primitive:IconButton>
                    <primitive:IconButton Icon="pack://application:,,,/AspenTech.CommonShell.Controls.Startup;component/Images/new_32.png" Margin="0,4,0,0">
                      <primitive:IconButton.Caption>
                        <Binding Path="ButtonNewCaption" />
                      </primitive:IconButton.Caption>
                      <ButtonBase.Command>
                        <Binding Path="NewCommand">
                          <Binding.RelativeSource>
                            <RelativeSource Mode="TemplatedParent" />
                          </Binding.RelativeSource>
                        </Binding>
                      </ButtonBase.Command>
                    </primitive:IconButton>
                  </StackPanel>
                  <primitive:RecentFileListControl Grid.Column="1" Margin="0,20,80,45">
                    <primitive:RecentFileListControl.RecentFilesListCaption>
                      <Binding Path="RecentFilesListCaption" />
                    </primitive:RecentFileListControl.RecentFilesListCaption>
                    <primitive:RecentFileListControl.RecentFilesPlaceholderText>
                      <Binding Path="RecentFilesPlaceholderText" />
                    </primitive:RecentFileListControl.RecentFilesPlaceholderText>
                    <primitive:RecentFileListControl.RecentFiles>
                      <Binding Path="RecentFiles" />
                    </primitive:RecentFileListControl.RecentFiles>
                    <primitive:RecentFileListControl.RecentFileCommand>
                      <Binding Path="RecentFileCommand">
                        <Binding.RelativeSource>
                          <RelativeSource Mode="TemplatedParent" />
                        </Binding.RelativeSource>
                      </Binding>
                    </primitive:RecentFileListControl.RecentFileCommand>
                  </primitive:RecentFileListControl>
                </Grid>
              </Border>
            </Grid>
          </Border>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style x:Key="{x:Type local:StartupDialog}" TargetType="{x:Type local:StartupDialog}">
    <Setter Property="Control.Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type local:StartupDialog}">
          <Border Background="{TemplateBinding Panel.Background}" BorderBrush="{TemplateBinding Border.BorderBrush}" BorderThickness="{TemplateBinding Border.BorderThickness}">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="100*" />
                <ColumnDefinition Width="800*" MinWidth="600" />
                <ColumnDefinition Width="100*" />
              </Grid.ColumnDefinitions>
              <primitive:StartupControl Grid.Column="1" Options="{TemplateBinding local:StartupDialog.Options}">
                <primitive:StartupControl.CloseCommand>
                  <Binding Path="CloseCommand">
                    <Binding.RelativeSource>
                      <RelativeSource Mode="TemplatedParent" />
                    </Binding.RelativeSource>
                  </Binding>
                </primitive:StartupControl.CloseCommand>
              </primitive:StartupControl>
            </Grid>
          </Border>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
</ResourceDictionary>