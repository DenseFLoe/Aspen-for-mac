<?xml version='1.0' encoding='utf-8'?>
<Window x:Class="AspenTech.AspenPlus.MMControls.MMScrollAreaReorder" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:igWindows="http://infragistics.com/Windows" xmlns:resources="clr-namespace:AspenTech.AspenPlus.MMControls.Properties" Loaded="ReorderWindow_Loaded" Name="ReorderWindow" x:Uid="ReorderWindow" Title="{x:Static resources:Resources.ReorderTitle}" Width="350" Height="400" WindowStartupLocation="CenterScreen">
  <Grid Margin="5">
    <Grid.RowDefinitions>
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>
    <GroupBox x:Uid="GroupBox_1" Header="{x:Static resources:Resources.ReorderHeader}">
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="*" />
          <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <ListBox SelectionChanged="ListBox_SelectionChanged" Name="List" x:Uid="List" Grid.RowSpan="2" Margin="3" DisplayMemberPath="DisplayValue">
          <ItemsControl.ItemsSource>
            <Binding ElementName="ReorderWindow" Path="DataSource" />
          </ItemsControl.ItemsSource>
        </ListBox>
        <Button Click="MoveUp_Click" Name="MoveUp" x:Uid="MoveUp" Grid.Column="1" Margin="4,2" Padding="0" VerticalAlignment="Bottom" FontWeight="Bold">
          <igWindows:AutoDisabledImage Width="16" Height="16" Source="..\Images\up.png" />
        </Button>
        <Button Click="MoveDown_Click" Name="MoveDown" x:Uid="MoveDown" Grid.Row="1" Grid.Column="1" Margin="4,2" Padding="0" VerticalAlignment="Top">
          <igWindows:AutoDisabledImage Width="16" Height="16" Source="..\Images\down.png" />
        </Button>
      </Grid>
    </GroupBox>
    <Button Click="Close_Click" x:Uid="Button_1" Grid.Row="1" Margin="5" Padding="15,3" HorizontalAlignment="Center" Content="{x:Static resources:Resources.Close}" />
  </Grid>
</Window>
