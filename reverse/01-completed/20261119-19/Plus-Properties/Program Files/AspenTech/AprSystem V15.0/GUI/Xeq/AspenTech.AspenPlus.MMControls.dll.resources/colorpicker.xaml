<?xml version='1.0' encoding='utf-8'?>
<UserControl x:Class="AspenTech.AspenPlus.MMControls.ColorPicker" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:local="clr-namespace:AspenTech.AspenPlus.MMControls">
  <FrameworkElement.Resources>
    <ResourceDictionary>
      <Style x:Key="{x:Type ToggleButton}" TargetType="{x:Type ToggleButton}">
        <Setter Property="Control.Template">
          <Setter.Value>
            <ControlTemplate TargetType="{x:Type ToggleButton}">
              <Border BorderThickness="{TemplateBinding Border.BorderThickness}" BorderBrush="{TemplateBinding Border.BorderBrush}" Background="{TemplateBinding Panel.Background}" Padding="{TemplateBinding Control.Padding}" CornerRadius="0">
                <ContentControl Content="{TemplateBinding ContentControl.Content}" HorizontalAlignment="Center" VerticalAlignment="Center" />
              </Border>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>
    </ResourceDictionary>
  </FrameworkElement.Resources>
  <Grid Name="grdContainer">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="Auto" />
      <ColumnDefinition Width="Auto" />
      <ColumnDefinition Width="Auto" />
      <ColumnDefinition Width="Auto" />
      <ColumnDefinition Width="Auto" />
      <ColumnDefinition Width="Auto" />
      <ColumnDefinition Width="Auto" />
      <ColumnDefinition Width="Auto" />
    </Grid.ColumnDefinitions>
    <ToggleButton Click="ToggleButton_Click" Grid.Row="0" Grid.Column="0" Margin="0,0,2,2" Tag="0" Background="#FF000000" Width="20" Height="20" IsChecked="True" BorderBrush="#FFFF0000" BorderThickness="2" />
    <ToggleButton Click="ToggleButton_Click" Grid.Row="0" Grid.Column="1" Margin="0,0,2,2" Tag="8" Background="#FFA9A9A9" Width="20" Height="20" />
    <ToggleButton Click="ToggleButton_Click" Grid.Row="0" Grid.Column="2" Margin="0,0,2,2" Tag="12" Background="#FFFF0000" Width="20" Height="20" />
    <ToggleButton Click="ToggleButton_Click" Grid.Row="0" Grid.Column="3" Margin="0,0,2,2" Tag="6" Background="#FF556B2F" Width="20" Height="20" />
    <ToggleButton Click="ToggleButton_Click" Grid.Row="0" Grid.Column="4" Margin="0,0,2,2" Tag="2" Background="#FF008000" Width="20" Height="20" />
    <ToggleButton Click="ToggleButton_Click" Grid.Row="0" Grid.Column="5" Margin="0,0,2,2" Tag="3" Background="#FF008080" Width="20" Height="20" />
    <ToggleButton Click="ToggleButton_Click" Grid.Row="0" Grid.Column="6" Margin="0,0,2,2" Tag="1" Background="#FF000080" Width="20" Height="20" />
    <ToggleButton Click="ToggleButton_Click" Grid.Row="0" Grid.Column="7" Margin="0,0,2,2" Tag="5" Background="#FF800080" Width="20" Height="20" />
    <ToggleButton Click="ToggleButton_Click" Grid.Row="1" Grid.Column="0" Margin="0,0,2,2" Tag="15" Background="#FFD3D3D3" Width="20" Height="20" />
    <ToggleButton Click="ToggleButton_Click" Grid.Row="1" Grid.Column="1" Margin="0,0,2,2" Tag="7" Background="#FF808080" Width="20" Height="20" />
    <ToggleButton Click="ToggleButton_Click" Grid.Row="1" Grid.Column="2" Margin="0,0,2,2" Tag="4" Background="#FFA52A2A" Width="20" Height="20" />
    <ToggleButton Click="ToggleButton_Click" Grid.Row="1" Grid.Column="3" Margin="0,0,2,2" Tag="14" Background="#FFFFFF00" Width="20" Height="20" />
    <ToggleButton Click="ToggleButton_Click" Grid.Row="1" Grid.Column="4" Margin="0,0,2,2" Tag="10" Background="#FF90EE90" Width="20" Height="20" />
    <ToggleButton Click="ToggleButton_Click" Grid.Row="1" Grid.Column="5" Margin="0,0,2,2" Tag="11" Background="#FF87CEEB" Width="20" Height="20" />
    <ToggleButton Click="ToggleButton_Click" Grid.Row="1" Grid.Column="6" Margin="0,0,2,2" Tag="9" Background="#FF0000FF" Width="20" Height="20" />
    <ToggleButton Click="ToggleButton_Click" Grid.Row="1" Grid.Column="7" Margin="0,0,2,2" Tag="13" Background="#FFFF00FF" Width="20" Height="20" />
  </Grid>
</UserControl>
