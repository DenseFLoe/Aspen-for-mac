<?xml version='1.0' encoding='utf-8'?>
<Window x:Class="AspenTech.AspenPlus.MMControls.Dialogs.LineFormatEditor" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:mm="clr-namespace:AspenTech.AspenPlus.MMControls" xmlns:res="clr-namespace:AspenTech.AspenPlus.MMControls.Properties" xmlns:ig="clr-namespace:Infragistics.Controls.Editors;assembly=InfragisticsWPF.Controls.Editors.XamColorPicker" xmlns:local="clr-namespace:AspenTech.AspenPlus.MMControls.Dialogs" Title="{x:Static res:Resources.LineFormatEditor}" SizeToContent="WidthAndHeight" WindowStartupLocation="Manual" ResizeMode="NoResize">
  <Grid Margin="8">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>
    <Label Content="{x:Static res:Resources.OutlineColor}" Grid.Row="0" Margin="0,0,0,5" />
    <ig:XamColorPicker Name="LineColorPicker" x:Uid="LineColorPicker" Grid.Row="1" Grid.Column="1" ShowAdvancedEditorButton="False" ShowDerivedColorPalettes="True" DerivedPalettesCount="10" Width="175" Height="25" HorizontalAlignment="Left" CurrentColorCaption="{x:Static res:Resources.CurrentColorCaption}" CurrentPaletteCaption="{x:Static res:Resources.CurrentPaletteCaption}" RecentColorPaletteCaption="{x:Static res:Resources.RecentColorPaletteCaption}" DerivedColorPalettesCaption="{x:Static res:Resources.DerivedColorPalettesCaption}">
      <ig:XamColorPicker.SelectedColor>
        <Binding Path="LineColor" Mode="TwoWay" />
      </ig:XamColorPicker.SelectedColor>
      <FrameworkElement.Resources>
        <ResourceDictionary>
          <Style x:Key="{x:Type Button}" TargetType="{x:Type Button}">
            <Setter Property="FrameworkElement.MinWidth" Value="0" />
          </Style>
        </ResourceDictionary>
      </FrameworkElement.Resources>
    </ig:XamColorPicker>
    <Grid Row="2" Margin="0,20,0,20">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="14" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <Label Content="{x:Static res:Resources.Weight}" Grid.Row="0" Grid.Column="0" />
      <mm:LineWeightPicker Name="lieghtWeightPicker1" Grid.Row="1" Grid.Column="0">
        <mm:LineWeightPicker.SelectedWeight>
          <Binding Path="LineWeight" />
        </mm:LineWeightPicker.SelectedWeight>
      </mm:LineWeightPicker>
      <Label Content="{x:Static res:Resources.Style}" Grid.Row="0" Grid.Column="3" />
      <mm:LineStylePicker Name="lineStylePicker1" Grid.Row="1" Grid.Column="3">
        <mm:LineStylePicker.SelectedStyle>
          <Binding Path="LineStyle" />
        </mm:LineStylePicker.SelectedStyle>
      </mm:LineStylePicker>
    </Grid>
    <UniformGrid Grid.Row="3" Columns="2" HorizontalAlignment="Center">
      <Button Click="btnOK_Click" Name="btnOK" x:Uid="btnOK" Content="{x:Static res:Resources.strOK}" IsDefault="True" />
      <Button Click="btnCancel_Click" Name="btnCancel" x:Uid="btnCancel" Content="{x:Static res:Resources.strCancel}" />
    </UniformGrid>
  </Grid>
</Window>
