<?xml version='1.0' encoding='utf-8'?>
<UserControl x:Class="AspenTech.AspenPlus.MMControls.LineWeightPicker" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:local="clr-namespace:AspenTech.AspenPlus.MMControls">
  <FrameworkElement.Resources>
    <ResourceDictionary>
      <Style x:Key="{x:Type ToggleButton}" TargetType="{x:Type ToggleButton}">
        <Setter Property="Panel.Background" Value="#00FFFFFF" />
        <Setter Property="Control.Template">
          <Setter.Value>
            <ControlTemplate TargetType="{x:Type ToggleButton}">
              <Border BorderThickness="{TemplateBinding Border.BorderThickness}" BorderBrush="{TemplateBinding Border.BorderBrush}" Background="{TemplateBinding Panel.Background}" Padding="{TemplateBinding Control.Padding}" CornerRadius="0">
                <ContentControl Content="{TemplateBinding ContentControl.Content}" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="3" />
              </Border>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
        <Style.Triggers>
          <Trigger Property="ToggleButton.IsChecked" Value="True">
            <Setter Property="Border.BorderBrush" Value="#FFFF0000" />
            <Setter Property="Border.BorderThickness" Value="2" />
          </Trigger>
          <Trigger Property="ToggleButton.IsChecked" Value="False">
            <Setter Property="Border.BorderBrush" Value="#FF808080" />
            <Setter Property="Border.BorderThickness" Value="2" />
          </Trigger>
        </Style.Triggers>
      </Style>
    </ResourceDictionary>
  </FrameworkElement.Resources>
  <StackPanel Name="grdContainer" Orientation="Vertical">
    <ToggleButton Click="ToggleButton_Click" Name="btn1" Width="80" Height="20" Margin="0,0,0,1" ToolTip="1" IsChecked="True">
      <Line Stroke="#FF000000" StrokeThickness="1" X1="0" X2="70" HorizontalAlignment="Stretch" />
    </ToggleButton>
    <ToggleButton Click="ToggleButton_Click" Name="btn2" Width="80" Height="20" Margin="0,0,0,1" ToolTip="2">
      <Line Stroke="#FF000000" StrokeThickness="2" X1="0" X2="70" HorizontalAlignment="Stretch" />
    </ToggleButton>
    <ToggleButton Click="ToggleButton_Click" Name="btn3" Width="80" Height="20" Margin="0,0,0,1" ToolTip="3">
      <Line Stroke="#FF000000" StrokeThickness="3" X1="0" X2="70" HorizontalAlignment="Stretch" />
    </ToggleButton>
    <ToggleButton Click="ToggleButton_Click" Name="btn4" Width="80" Height="20" Margin="0,0,0,1" ToolTip="4">
      <Line Stroke="#FF000000" StrokeThickness="4" X1="0" X2="70" HorizontalAlignment="Stretch" />
    </ToggleButton>
    <ToggleButton Click="ToggleButton_Click" Name="btn5" Width="80" Height="20" Margin="0,0,0,1" ToolTip="5">
      <Line Stroke="#FF000000" StrokeThickness="5" X1="0" X2="70" HorizontalAlignment="Stretch" />
    </ToggleButton>
  </StackPanel>
</UserControl>
