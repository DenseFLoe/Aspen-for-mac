<?xml version='1.0' encoding='utf-8'?>
<Window x:Class="AspenTech.AspenPlus.MMControls.Dialogs.OneIdDialog" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:mm="clr-namespace:AspenTech.AspenPlus.MMControls" xmlns:local="clr-namespace:AspenTech.AspenPlus.MMControls.Dialogs" xmlns:igEditors="http://infragistics.com/Editors" xmlns:atSupport="http://schemas.aspentech.com/xaml/presentation/visualisation/support" xmlns:cvt="clr-namespace:AspenTech.AspenPlus.MMControls.Converters" xmlns:resources="clr-namespace:AspenTech.AspenPlus.MMControls.Properties" Loaded="OneIDDialog_Loaded" Name="oneIdDialog" Width="288" WindowState="Normal" ShowInTaskbar="False" ResizeMode="NoResize" WindowStartupLocation="CenterOwner" SizeToContent="Height" TextOptions.TextFormattingMode="Display" x:Uid="oneIdDialog">
  <FrameworkElement.Resources>
    <ResourceDictionary x:Uid="ResourceDictionary_1">
      <ResourceDictionary.MergedDictionaries>
        <atSupport:AspenCommonResources />
        <atSupport:AspenCommonProperties x:Uid="atSupport_AspenCommonProperties_1" />
        <atSupport:AspenCommonStyles />
        <atSupport:AspenDefaultStyles />
      </ResourceDictionary.MergedDictionaries>
      <cvt:OneDialogInputDisplayCvt x:Key="OneDialogInputDisplayCvt" x:Uid="cvt_OneDialogInputDisplayCvt_1" />
    </ResourceDictionary>
  </FrameworkElement.Resources>
  <StackPanel Name="stackPanel1" Orientation="Vertical" VerticalAlignment="Bottom" Margin="{StaticResource AspenDialogOuterMargin}">
    <Grid>
      <TextBlock Visibility="Hidden" Margin="0,0,60,0" x:Uid="TextBlock_1">
        <TextBlock.Text>
          <Binding ElementName="oneIdDialog" Path="Title" />
        </TextBlock.Text>
      </TextBlock>
      <TextBlock Name="textBlkPrompt" VerticalAlignment="Stretch" TextWrapping="WrapWithOverflow" Margin="{StaticResource AspenVerticalRelativeControlMargin}" x:Uid="textBlkPrompt" />
    </Grid>
    <TextBox TextChanged="On_tbTextChanged" PreviewTextInput="tbText_PreviewTextInput" PreviewKeyDown="tbText_PreviewKeyDown" Name="tbText" Margin="{StaticResource AspenVerticalIrrelativeControlMargin}" CharacterCasing="Upper" MaxLength="24" x:Uid="tbText">
      <TextBox.Text>
        <MultiBinding Converter="{StaticResource OneDialogInputDisplayCvt}" UpdateSourceTrigger="PropertyChanged">
          <Binding Path="NewID" Mode="TwoWay">
            <Binding.RelativeSource>
              <RelativeSource Mode="FindAncestor" AncestorType="{x:Type local:OneIdDialog}" />
            </Binding.RelativeSource>
          </Binding>
          <Binding Mode="OneTime">
            <Binding.RelativeSource>
              <RelativeSource Mode="FindAncestor" AncestorType="{x:Type local:OneIdDialog}" />
            </Binding.RelativeSource>
          </Binding>
        </MultiBinding>
      </TextBox.Text>
      <UIElement.CommandBindings>
        <CommandBinding CanExecute="Paste_CanExecute" Executed="Paste_Executed" Command="Paste" />
      </UIElement.CommandBindings>
    </TextBox>
    <StackPanel Name="panelRecord" Margin="{StaticResource AspenVerticalIrrelativeControlMargin}" Orientation="Vertical" VerticalAlignment="Bottom">
      <TextBlock Name="textRecordPrompt" Text="{x:Static resources:Resources.strSelectType}" Margin="{StaticResource AspenVerticalRelativeControlMargin}" x:Uid="textRecordPrompt" />
      <ComboBox SelectionChanged="cbRecord_SelectionChanged" Name="cbRecord" HorizontalAlignment="Stretch" x:Uid="cbRecord" />
    </StackPanel>
    <UniformGrid Columns="2" HorizontalAlignment="Right" x:Uid="UniformGrid_1">
      <Button Click="Ok_Click" Name="btnOK" Margin="{StaticResource AspenHorizontalRelativeControlMargin}" IsDefault="True" Content="{x:Static resources:Resources.strOK}" x:Uid="btnOK" />
      <Button Name="btnCancel" IsCancel="True" Content="{x:Static resources:Resources.strCancel}" Margin="0" x:Uid="btnCancel" />
    </UniformGrid>
  </StackPanel>
</Window>
