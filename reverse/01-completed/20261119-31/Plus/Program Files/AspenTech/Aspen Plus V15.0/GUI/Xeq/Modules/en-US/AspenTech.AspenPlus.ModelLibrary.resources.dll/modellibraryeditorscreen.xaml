<?xml version='1.0' encoding='utf-8'?>
<infra:ApwnPanelControl x:Class="AspenTech.AspenPlus.ModelLibrary.ModelLibraryEditorScreen" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:shell="http://schemas.aspentech.com/xaml/presentation/visualisation/commonshell" xmlns:infra="clr-namespace:AspenTech.AspenPlus.Infrastructure;assembly=AspenTech.AspenPlus.Infrastructure" xmlns:local="clr-namespace:AspenTech.AspenPlus.ModelLibrary" xmlns:igDock="http://infragistics.com/DockManager" xmlns:lp="clr-namespace:AspenTech.AspenPlus.Localization;assembly=AspenTech.AspenPlus.Localization" xmlns:controls="clr-namespace:AspenTech.AspenPlus.ModelLibrary.Controls;assembly=AspenTech.AspenPlus.ModelLibrary.Controls" xmlns:mm="clr-namespace:AspenTech.AspenPlus.MMControls;assembly=AspenTech.AspenPlus.MMControls" x:Uid="infra_ApwnPanelControl_1" mm:MMHelp.HelpFile="userguide1.chm" mm:MMHelp.HelpId="1551" Header="{x:Static lp:ModelLibraryResources.LibraryEditorWindowTitle}" IsDocumentScreen="False" Background="{DynamicResource AspenDialogBackgroundBrush}">
  <UIElement.CommandBindings>
    <CommandBinding Executed="CreateNewCategory_Executed" CanExecute="CreateNewCategory_CanExecute" x:Uid="CreateNewCategory" x:Name="CreateNewCategory" Command="local:ModelLibraryCommands.CreateNewCategory" />
    <CommandBinding Executed="DeleteCurrentCategory_Executed" CanExecute="DeleteCurrentCategory_CanExecute" x:Uid="DeleteCurrentCategory" x:Name="DeleteCurrentCategory" Command="local:ModelLibraryCommands.DeleteCurrentCategory" />
    <CommandBinding Executed="RenameCurrentCategory_Executed" CanExecute="RenameCurrentCategory_CanExecute" x:Uid="RenameCurrentCategory" x:Name="RenameCurrentCategory" Command="local:ModelLibraryCommands.RenameCurrentCategory" />
    <CommandBinding Executed="ReorderCategories_Executed" CanExecute="ReorderCategories_CanExecute" x:Uid="ReorderCategories" x:Name="ReorderCategories" Command="local:ModelLibraryCommands.ReorderCategories" />
    <CommandBinding Executed="ReorderModelsInCurrentCategory_Executed" CanExecute="ReorderModelsInCurrentCategory_CanExecute" x:Uid="ReorderModelsInCurrentCategory" x:Name="ReorderModelsInCurrentCategory" Command="local:ModelLibraryCommands.ReorderModelsInCurrentCategory" />
    <CommandBinding Executed="DeleteCurrentModel_Executed" CanExecute="DeleteCurrentModel_CanExecute" x:Uid="DeleteCurrentModel" x:Name="DeleteCurrentModel" Command="local:ModelLibraryCommands.DeleteCurrentModel" />
    <CommandBinding Executed="RenameCurrentModel_Executed" CanExecute="RenameCurrentModel_CanExecute" x:Uid="RenameCurrentModel" x:Name="RenameCurrentModel" Command="local:ModelLibraryCommands.RenameCurrentModel" />
    <CommandBinding Executed="MoveCurrentModel_Executed" CanExecute="MoveCurrentModel_CanExecute" x:Uid="MoveCurrentModel" x:Name="MoveCurrentModel" Command="local:ModelLibraryCommands.MoveCurrentModel" />
    <CommandBinding Executed="CopyCurrentModel_Executed" CanExecute="CopyCurrentModel_CanExecute" x:Uid="CopyCurrentModel" x:Name="CopyCurrentModel" Command="local:ModelLibraryCommands.CopyCurrentModel" />
    <CommandBinding Executed="EditDescriptionForCurrentModel_Executed" CanExecute="EditDescriptionForCurrentModel_CanExecute" x:Uid="EditDescriptionForCurrentModel" x:Name="EditDescriptionForCurrentModel" Command="local:ModelLibraryCommands.EditDescriptionForCurrentModel" />
    <CommandBinding Executed="EditUserConfiguration_Executed" CanExecute="EditUserConfiguration_CanExecute" x:Uid="EditUserConfiguration" x:Name="EditUserConfiguration" Command="local:ModelLibraryCommands.EditUserConfiguration" />
    <CommandBinding Executed="ClearUserConfiguration_Executed" CanExecute="ClearUserConfiguration_CanExecute" x:Uid="ClearUserConfiguration" x:Name="ClearUserConfiguration" Command="local:ModelLibraryCommands.ClearUserConfiguration" />
    <CommandBinding Executed="EditCurrentIcon_Executed" CanExecute="EditCurrentIcon_CanExecute" x:Uid="EditCurrentIcon" x:Name="EditCurrentIcon" Command="local:ModelLibraryCommands.EditCurrentIcon" />
    <CommandBinding Executed="CreateNewIcon_Executed" CanExecute="CreateNewIcon_CanExecute" x:Uid="CreateNewIcon" x:Name="CreateNewIcon" Command="local:ModelLibraryCommands.CreateNewIcon" />
    <CommandBinding Executed="DeleteCurrentIcon_Executed" CanExecute="DeleteCurrentIcon_CanExecute" x:Uid="DeleteCurrentIcon" x:Name="DeleteCurrentIcon" Command="local:ModelLibraryCommands.DeleteCurrentIcon" />
    <CommandBinding Executed="ReorderIconsInCurrentModel_Executed" CanExecute="ReorderIconsInCurrentModel_CanExecute" x:Uid="ReorderIconsInCurrentModel" x:Name="ReorderIconsInCurrentModel" Command="local:ModelLibraryCommands.ReorderIconsInCurrentModel" />
  </UIElement.CommandBindings>
  <StackPanel>
    <controls:BlockTableControl x:Name="theBlockTableControl" x:Uid="theBlockTableControl" Grid.Row="2" CheckedButtonBackground="#FFFFFFFF">
      <controls:BlockTableControl.DefaultButtonBackground>
        <SolidColorBrush x:Uid="SolidColorBrush_1">
          <SolidColorBrush.Color>
            <Color x:Uid="Color_1" A="255" R="222" G="231" B="247" />
          </SolidColorBrush.Color>
        </SolidColorBrush>
      </controls:BlockTableControl.DefaultButtonBackground>
      <controls:BlockTableControl.Dock>
        <MultiBinding x:Uid="MultiBinding_1" Mode="OneWay">
          <MultiBinding.Converter>
            <local:ScreenDockConverter x:Uid="local_ScreenDockConverter_1" />
          </MultiBinding.Converter>
          <Binding x:Uid="Binding_1" Path="(igDock:XamDockManager.PaneLocation)" RelativeSource="{RelativeSource Mode=FindAncestor, AncestorType=igDock:ContentPane, AncestorLevel=1}" />
          <Binding x:Uid="Binding_2" Path="ActualWidth" RelativeSource="{RelativeSource Mode=FindAncestor, AncestorType=shell:ScreenContentControl, AncestorLevel=1}" />
          <Binding x:Uid="Binding_3" Path="ActualHeight" RelativeSource="{RelativeSource Mode=FindAncestor, AncestorType=shell:ScreenContentControl, AncestorLevel=1}" />
        </MultiBinding>
      </controls:BlockTableControl.Dock>
      <FrameworkElement.Style>
        <Style x:Uid="Style_1" TargetType="{x:Type controls:BlockTableControl}">
          <Style.Triggers>
            <Trigger x:Uid="Trigger_1" Property="controls:BlockTableControl.Dock" Value="Top">
              <Setter x:Uid="Setter_1" Property="FrameworkElement.VerticalAlignment" Value="Top" />
            </Trigger>
            <Trigger x:Uid="Trigger_2" Property="controls:BlockTableControl.Dock" Value="Bottom">
              <Setter x:Uid="Setter_2" Property="FrameworkElement.VerticalAlignment" Value="Top" />
            </Trigger>
            <Trigger x:Uid="Trigger_3" Property="controls:BlockTableControl.Dock" Value="Left">
              <Setter x:Uid="Setter_3" Property="FrameworkElement.HorizontalAlignment" Value="Left" />
            </Trigger>
            <Trigger x:Uid="Trigger_4" Property="controls:BlockTableControl.Dock" Value="Right">
              <Setter x:Uid="Setter_4" Property="FrameworkElement.HorizontalAlignment" Value="Left" />
            </Trigger>
          </Style.Triggers>
        </Style>
      </FrameworkElement.Style>
    </controls:BlockTableControl>
    <Button Click="btnSave_Click" x:Name="btnSave" x:Uid="btnSave" Content="{x:Static lp:ModelLibraryResources.Save}" HorizontalAlignment="Left" Margin="7" />
  </StackPanel>
</infra:ApwnPanelControl>
