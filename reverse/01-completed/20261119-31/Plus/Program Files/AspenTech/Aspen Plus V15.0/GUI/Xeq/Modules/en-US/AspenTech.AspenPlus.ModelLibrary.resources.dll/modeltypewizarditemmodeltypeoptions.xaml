<?xml version='1.0' encoding='utf-8'?>
<local:ModelTypeWizardItem x:Class="AspenTech.AspenPlus.ModelLibrary.ModelTypeWizardItemModelTypeOptions" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:local="clr-namespace:AspenTech.AspenPlus.ModelLibrary" xmlns:lp="clr-namespace:AspenTech.AspenPlus.Localization;assembly=AspenTech.AspenPlus.Localization" xmlns:mlc="clr-namespace:AspenTech.AspenPlus.ModelLibrary.Controls;assembly=AspenTech.AspenPlus.ModelLibrary.Controls" x:Uid="local_ModelTypeWizardItem_1" Title="{x:Static lp:ModelLibraryResources.WizardItemModelTypeOptionsTitle}">
  <FrameworkElement.Resources>
    <ResourceDictionary>
      <Style x:Key="textBoxInError" TargetType="{x:Type TextBox}">
        <Style.Triggers>
          <Trigger Property="Validation.HasError" Value="True">
            <Setter Property="FrameworkElement.ToolTip" Value="{Binding RelativeSource={x:Static RelativeSource.Self}, Path=(Validation.Errors)[0].ErrorContent}" />
          </Trigger>
        </Style.Triggers>
      </Style>
    </ResourceDictionary>
  </FrameworkElement.Resources>
  <StackPanel x:Uid="StackPanel_1" DataContext="{Binding RelativeSource={RelativeSource AncestorType=local:ModelTypeWizardItem, Mode=FindAncestor}}">
    <GroupBox x:Uid="GroupBox_1" Header="{x:Static lp:ModelLibraryResources.WizardItemModelTypeOptionsEnterNameHeader}" Margin="{DynamicResource AspenVerticalRelativeControlMargin}">
      <StackPanel x:Uid="StackPanel_2" Orientation="Horizontal">
        <Label x:Uid="Label_1" Content="{x:Static lp:ModelLibraryResources.WizardItemModelTypeOptionsEnterNameLabel}" />
        <TextBox KeyDown="textBoxModelTypeName_KeyDown" PreviewTextInput="textBoxModelTypeName_PreviewTextInput" x:Name="textBoxModelTypeName" x:Uid="textBoxModelTypeName" Width="160" Height="20" Margin="{DynamicResource AspenHorizontalRelativeControlMargin}" MaxLength="63" Style="{StaticResource textBoxInError}">
          <TextBox.Text>
            <Binding Path="ModelTypeName" Mode="TwoWay" UpdateSourceTrigger="PropertyChanged">
              <Binding.ValidationRules>
                <local:ModelTypeValicationRule />
              </Binding.ValidationRules>
            </Binding>
          </TextBox.Text>
        </TextBox>
        <TextBlock x:Name="checkModelTypeNameLabel" x:Uid="checkModelTypeNameLabel" Width="240" Visibility="Hidden" TextWrapping="WrapWithOverflow" Text="{x:Static lp:ModelLibraryResources.WizardItemModelTypeOptionsNameExistTooltip}" Foreground="#FFFF0000" />
      </StackPanel>
    </GroupBox>
    <GroupBox x:Uid="GroupBox_2" Header="{x:Static lp:ModelLibraryResources.WizardItemModelTypeOptionsIconsCopyHeader}" Margin="{DynamicResource AspenVerticalRelativeControlMargin}">
      <StackPanel x:Uid="StackPanel_3">
        <RadioButton x:Uid="RadioButton_1" Margin="{DynamicResource AspenVerticalRelativeControlMargin}" Content="{x:Static lp:ModelLibraryResources.WizardItemModelTypeOptionsIconsCopyDefault}" IsChecked="{Binding Path=IsToCopyDefaultIcon, Mode=TwoWay}" IsEnabled="{Binding Path=IsToCopyDefaultIconEnabled, Mode=OneWay}" />
        <RadioButton x:Uid="RadioButton_2" Margin="{DynamicResource AspenVerticalRelativeControlMargin}" Content="{x:Static lp:ModelLibraryResources.WizardItemModelTypeOptionsIconsCopyCurrent}" IsChecked="{Binding Path=IsToCopyCurrentIcon, Mode=TwoWay}" IsEnabled="{Binding Path=IsToCopyCurrentIconEnabled, Mode=OneWay}" />
        <RadioButton x:Uid="RadioButton_3" Margin="{DynamicResource AspenVerticalRelativeControlMargin}" Content="{x:Static lp:ModelLibraryResources.WizardItemModelTypeOptionsIconsCopyAll}" IsChecked="{Binding Path=IsToCopyAllIcon, Mode=TwoWay}" IsEnabled="{Binding Path=IsToCopyAllIconEnabled, Mode=OneWay}" />
      </StackPanel>
    </GroupBox>
    <GroupBox x:Uid="GroupBox_3" Header="{x:Static lp:ModelLibraryResources.WizardItemModelTypeOptionsOthersHeader}" Margin="{DynamicResource AspenVerticalRelativeControlMargin}">
      <StackPanel x:Uid="StackPanel_4">
        <CheckBox x:Uid="CheckBox_1" Margin="{DynamicResource AspenVerticalRelativeControlMargin}" MinWidth="0" Content="{x:Static lp:ModelLibraryResources.WizardItemModelTypeOptionsTemplate}" IsChecked="{Binding Path=IsToCopyTemplate, Mode=TwoWay}" IsEnabled="{Binding Path=IsToCopyTemplateEnabled, Mode=OneWay}" />
        <CheckBox x:Uid="CheckBox_2" Margin="{DynamicResource AspenVerticalRelativeControlMargin}" MinWidth="0" Content="{x:Static lp:ModelLibraryResources.WizardItemModelTypeOptionsConfiguration}" IsChecked="{Binding Path=IsToCopyUserConfiguration, Mode=TwoWay}" IsEnabled="{Binding Path=IsToCopyUserConfigurationEnabled, Mode=OneWay}" />
      </StackPanel>
    </GroupBox>
  </StackPanel>
</local:ModelTypeWizardItem>
