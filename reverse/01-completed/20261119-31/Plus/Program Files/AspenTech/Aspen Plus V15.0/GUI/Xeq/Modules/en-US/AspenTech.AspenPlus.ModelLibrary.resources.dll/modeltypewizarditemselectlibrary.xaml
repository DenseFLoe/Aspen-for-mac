<?xml version='1.0' encoding='utf-8'?>
<local:ModelTypeWizardItem x:Class="AspenTech.AspenPlus.ModelLibrary.ModelTypeWizardItemSelectLibrary" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:local="clr-namespace:AspenTech.AspenPlus.ModelLibrary" xmlns:lp="clr-namespace:AspenTech.AspenPlus.Localization;assembly=AspenTech.AspenPlus.Localization" xmlns:mlc="clr-namespace:AspenTech.AspenPlus.ModelLibrary.Controls;assembly=AspenTech.AspenPlus.ModelLibrary.Controls" x:Uid="local_ModelTypeWizardItem_1" Title="{x:Static lp:ModelLibraryResources.WizardItemSelectLibraryTitle}">
  <StackPanel x:Uid="StackPanel_1" DataContext="{Binding RelativeSource={RelativeSource AncestorType=local:ModelTypeWizardItem, Mode=FindAncestor}}">
    <TextBlock x:Uid="TextBlock_1" Text="{x:Static lp:ModelLibraryResources.WizardItemSelectLibraryLabel}" TextWrapping="Wrap" Margin="{DynamicResource AspenVerticalRelativeControlMargin}" />
    <GroupBox x:Uid="GroupBox_1" Header="{x:Static lp:ModelLibraryResources.WizardItemSelectLibraryGroupHeader}" Margin="{DynamicResource AspenVerticalRelativeControlMargin}">
      <ListBox x:Name="theListBox" x:Uid="theListBox" MinWidth="200" MinHeight="210" SelectionMode="Single" SelectedItem="{Binding Path=SelectedLibrary, Mode=TwoWay}" ItemsSource="{Binding Path=UserModelLibraries, Mode=OneWay}">
        <ItemsControl.ItemTemplate>
          <DataTemplate x:Uid="DataTemplate_1" DataType="local:UserModelLibrary">
            <Label x:Uid="Label_1" Content="{Binding Path=DisplayName}" />
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ListBox>
    </GroupBox>
  </StackPanel>
</local:ModelTypeWizardItem>
