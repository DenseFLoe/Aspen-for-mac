<?xml version='1.0' encoding='utf-8'?>
<local:ModelTypeWizardItem x:Class="AspenTech.AspenPlus.ModelLibrary.ModelTypeWizardItemWelcome" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:local="clr-namespace:AspenTech.AspenPlus.ModelLibrary" xmlns:lp="clr-namespace:AspenTech.AspenPlus.Localization;assembly=AspenTech.AspenPlus.Localization" xmlns:mlc="clr-namespace:AspenTech.AspenPlus.ModelLibrary.Controls;assembly=AspenTech.AspenPlus.ModelLibrary.Controls" x:Uid="local_ModelTypeWizardItem_1" MaxWidth="680" MaxHeight="300" Title="{x:Static lp:ModelLibraryResources.WizardItemWelcomeTitle}">
  <StackPanel x:Uid="StackPanel_1" DataContext="{Binding RelativeSource={RelativeSource AncestorType=mlc:WizardControlItem, Mode=FindAncestor}}">
    <TextBlock x:Uid="TextBlock_1" Text="{x:Static lp:ModelLibraryResources.WizardItemWelcomeLabel}" TextWrapping="Wrap" Margin="{DynamicResource AspenVerticalRelativeControlMargin}" />
    <GroupBox x:Uid="GroupBox_1" Header="{x:Static lp:ModelLibraryResources.WizardItemWelcomeGroupHeader}" Margin="{DynamicResource AspenVerticalRelativeControlMargin}">
      <StackPanel x:Uid="StackPanel_2">
        <RadioButton x:Name="radionButtonAdd" x:Uid="radionButtonAdd" Margin="{DynamicResource AspenVerticalRelativeControlMargin}" IsChecked="{Binding Path=IsAddChecked, Mode=TwoWay}" IsEnabled="{Binding Path=CanAdd, Mode=OneWay}">
          <ContentControl.ContentTemplate>
            <DataTemplate>
              <TextBlock x:Uid="TextBlock_2" Text="{x:Static lp:ModelLibraryResources.WizardItemWelcomeOptionAdd}" TextWrapping="WrapWithOverflow" />
            </DataTemplate>
          </ContentControl.ContentTemplate>
        </RadioButton>
        <RadioButton x:Name="radionButtonAppend" x:Uid="radionButtonAppend" IsChecked="{Binding Path=IsAppendChecked, Mode=TwoWay}" IsEnabled="{Binding Path=CanAppend, Mode=OneWay}">
          <ContentControl.ContentTemplate>
            <DataTemplate>
              <TextBlock x:Uid="TextBlock_3" Text="{x:Static lp:ModelLibraryResources.WizardItemWelcomeOptionAppend}" TextWrapping="WrapWithOverflow" />
            </DataTemplate>
          </ContentControl.ContentTemplate>
        </RadioButton>
      </StackPanel>
    </GroupBox>
  </StackPanel>
</local:ModelTypeWizardItem>
