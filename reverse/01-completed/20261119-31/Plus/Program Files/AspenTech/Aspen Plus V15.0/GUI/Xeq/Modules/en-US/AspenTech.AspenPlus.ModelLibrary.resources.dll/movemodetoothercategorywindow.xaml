<?xml version='1.0' encoding='utf-8'?>
<Window x:Class="AspenTech.AspenPlus.ModelLibrary.MoveModeToOtherCategoryWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:AspenTech.AspenPlus.ModelLibrary" xmlns:lp="clr-namespace:AspenTech.AspenPlus.Localization;assembly=AspenTech.AspenPlus.Localization" xmlns:controls="clr-namespace:AspenTech.AspenPlus.ModelLibrary.Controls;assembly=AspenTech.AspenPlus.ModelLibrary.Controls" x:Uid="Window_1" SizeToContent="WidthAndHeight" ShowInTaskbar="False" ResizeMode="NoResize" WindowStartupLocation="CenterOwner" Title="{x:Static lp:ModelLibraryResources.MoveModelWindowTitle}" Background="{DynamicResource AspenDialogBackgroundBrush}">
  <Grid x:Uid="Grid_1" Margin="{DynamicResource AspenDialogOuterMargin}">
    <Grid.RowDefinitions>
      <RowDefinition x:Uid="RowDefinition_1" Height="Auto" />
      <RowDefinition x:Uid="RowDefinition_2" Height="{DynamicResource AspenVerticalRelativeLength}" />
      <RowDefinition x:Uid="RowDefinition_3" Height="Auto" />
    </Grid.RowDefinitions>
    <GroupBox x:Name="theGroupBox" x:Uid="theGroupBox" Header="{x:Static lp:ModelLibraryResources.MoveModelWindowGroupHeader}">
      <ListBox x:Name="theListBox" x:Uid="theListBox" Grid.Column="0" MinWidth="200" MinHeight="250" SelectionMode="Single" SelectedItem="{Binding RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=Window}, Path=SelectedCategory, Mode=TwoWay}" ItemsSource="{Binding RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=Window}, Path=AvailableCategories, Mode=OneWay}">
        <ItemsControl.ItemTemplate>
          <DataTemplate x:Uid="DataTemplate_1" DataType="controls:Category">
            <Label x:Uid="Label_1" Content="{Binding Path=Header}" />
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ListBox>
    </GroupBox>
    <StackPanel x:Uid="StackPanel_1" Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
      <Button Click="buttonOK_Click" x:Name="buttonOK" x:Uid="buttonOK" IsDefault="True" IsEnabled="False" Content="{x:Static lp:ModelLibraryResources.MoveModelWindowButtonOK}" />
      <Button Click="buttonCancel_Click" x:Name="buttonCancel" x:Uid="buttonCancel" Margin="0" IsCancel="True" Content="{x:Static lp:ModelLibraryResources.MoveModelWindowButtonCancel}" />
    </StackPanel>
  </Grid>
</Window>
