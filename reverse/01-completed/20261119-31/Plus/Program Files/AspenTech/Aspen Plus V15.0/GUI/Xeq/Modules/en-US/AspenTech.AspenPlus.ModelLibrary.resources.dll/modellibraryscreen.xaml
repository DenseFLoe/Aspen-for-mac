<?xml version='1.0' encoding='utf-8'?>
<infra:ApwnPanelControl x:Class="AspenTech.AspenPlus.ModelLibrary.ModelLibraryScreen" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:shell="http://schemas.aspentech.com/xaml/presentation/visualisation/commonshell" xmlns:local="clr-namespace:AspenTech.AspenPlus.ModelLibrary" xmlns:lp="clr-namespace:AspenTech.AspenPlus.Localization;assembly=AspenTech.AspenPlus.Localization" xmlns:igDock="http://infragistics.com/DockManager" xmlns:controls="clr-namespace:AspenTech.AspenPlus.ModelLibrary.Controls;assembly=AspenTech.AspenPlus.ModelLibrary.Controls" xmlns:infra="clr-namespace:AspenTech.AspenPlus.Infrastructure;assembly=AspenTech.AspenPlus.Infrastructure" x:Uid="infra_ApwnPanelControl_1" Header="{x:Static lp:ModelLibraryResources.PaletteWindowTitle}" IsDocumentScreen="False" Background="{DynamicResource AspenDialogBackgroundBrush}">
  <Grid x:Uid="Grid_1">
    <controls:ModelLibraryControl x:Name="theLibraryControl" x:Uid="theLibraryControl" CheckedButtonBackground="#FFFFFFFF">
      <controls:ModelLibraryControl.DefaultButtonBackground>
        <SolidColorBrush x:Uid="SolidColorBrush_1">
          <SolidColorBrush.Color>
            <Color x:Uid="Color_1" A="255" R="222" G="231" B="247" />
          </SolidColorBrush.Color>
        </SolidColorBrush>
      </controls:ModelLibraryControl.DefaultButtonBackground>
      <controls:ModelLibraryControl.Dock>
        <MultiBinding x:Uid="MultiBinding_1" Mode="OneWay">
          <MultiBinding.Converter>
            <local:ScreenDockConverter x:Uid="local_ScreenDockConverter_1" />
          </MultiBinding.Converter>
          <Binding x:Uid="Binding_1" Path="(igDock:XamDockManager.PaneLocation)" RelativeSource="{RelativeSource Mode=FindAncestor, AncestorType=igDock:ContentPane, AncestorLevel=1}" />
          <Binding x:Uid="Binding_2" Path="ActualWidth" RelativeSource="{RelativeSource Mode=FindAncestor, AncestorType=shell:ScreenContentControl, AncestorLevel=1}" />
          <Binding x:Uid="Binding_3" Path="ActualHeight" RelativeSource="{RelativeSource Mode=FindAncestor, AncestorType=shell:ScreenContentControl, AncestorLevel=1}" />
        </MultiBinding>
      </controls:ModelLibraryControl.Dock>
      <FrameworkElement.Style>
        <Style x:Uid="Style_1" TargetType="{x:Type controls:ModelLibraryControl}">
          <Style.Triggers>
            <Trigger x:Uid="Trigger_1" Property="controls:ModelLibraryControl.Dock" Value="Top">
              <Setter x:Uid="Setter_1" Property="FrameworkElement.VerticalAlignment" Value="Top" />
            </Trigger>
            <Trigger x:Uid="Trigger_2" Property="controls:ModelLibraryControl.Dock" Value="Bottom">
              <Setter x:Uid="Setter_2" Property="FrameworkElement.VerticalAlignment" Value="Top" />
            </Trigger>
            <Trigger x:Uid="Trigger_3" Property="controls:ModelLibraryControl.Dock" Value="Left">
              <Setter x:Uid="Setter_3" Property="FrameworkElement.HorizontalAlignment" Value="Left" />
            </Trigger>
            <Trigger x:Uid="Trigger_4" Property="controls:ModelLibraryControl.Dock" Value="Right">
              <Setter x:Uid="Setter_4" Property="FrameworkElement.HorizontalAlignment" Value="Left" />
            </Trigger>
          </Style.Triggers>
        </Style>
      </FrameworkElement.Style>
    </controls:ModelLibraryControl>
  </Grid>
</infra:ApwnPanelControl>
