<?xml version='1.0' encoding='utf-8'?>
<local:ModelTypeWizardItem x:Class="AspenTech.AspenPlus.ModelLibrary.ModelTypeWizardItemSelectAdditionalRecords" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:local="clr-namespace:AspenTech.AspenPlus.ModelLibrary" xmlns:lp="clr-namespace:AspenTech.AspenPlus.Localization;assembly=AspenTech.AspenPlus.Localization" xmlns:mlc="clr-namespace:AspenTech.AspenPlus.ModelLibrary.Controls;assembly=AspenTech.AspenPlus.ModelLibrary.Controls" x:Uid="local_ModelTypeWizardItem_1" Title="{x:Static lp:ModelLibraryResources.WizardItemSelectAdditionalRecordsTitle}">
  <StackPanel x:Uid="StackPanel_1" DataContext="{Binding RelativeSource={RelativeSource AncestorType=local:ModelTypeWizardItem, Mode=FindAncestor}}">
    <TextBlock x:Uid="TextBlock_1" Text="{x:Static lp:ModelLibraryResources.WizardItemSelectAdditionalRecordsLabel}" TextWrapping="Wrap" Margin="{DynamicResource AspenVerticalRelativeControlMargin}" />
    <GroupBox x:Uid="GroupBox_1" Header="{x:Static lp:ModelLibraryResources.WizardItemSelectAdditionalRecordsGroupHeader}" Margin="{DynamicResource AspenVerticalRelativeControlMargin}">
      <DockPanel x:Uid="DockPanel_1" Height="210">
        <CheckBox x:Name="checkHideDisabled" x:Uid="checkHideDisabled" DockPanel.Dock="Bottom" MinWidth="0" Content="{x:Static lp:ModelLibraryResources.WizardItemSelectAdditionalRecordsHideDisabled}" />
        <TreeView x:Name="theTreeView" x:Uid="theTreeView" Margin="{DynamicResource AspenVerticalRelativeControlMargin}" ItemsSource="{Binding Path=RootNodes, Mode=OneWay}">
          <FrameworkElement.Resources>
            <ResourceDictionary>
              <HierarchicalDataTemplate x:Uid="HierarchicalDataTemplate_1" DataType="{x:Type local:ModelTypeWizardRecordNode}" ItemsSource="{Binding Path=Children, Mode=OneWay}">
                <CheckBox x:Uid="CheckBox_1" IsThreeState="True" VerticalAlignment="Center" MinWidth="0" Tag="{Binding Mode=OneWay}" IsChecked="{Binding Path=IsChecked, Mode=TwoWay}" IsEnabled="{Binding Path=IsEnabled, Mode=OneWay}" Content="{Binding Path=DisplayName, Mode=OneWay}" />
              </HierarchicalDataTemplate>
            </ResourceDictionary>
          </FrameworkElement.Resources>
          <ItemsControl.ItemContainerStyle>
            <Style x:Uid="Style_1" TargetType="{x:Type TreeViewItem}">
              <Setter x:Uid="Setter_1" Property="TreeViewItem.IsExpanded" Value="{Binding Path=IsExpanded, Mode=TwoWay}" />
              <Setter x:Uid="Setter_2" Property="UIElement.Visibility">
                <Setter.Value>
                  <MultiBinding x:Uid="MultiBinding_1" Mode="OneWay">
                    <MultiBinding.Converter>
                      <local:RecordNodeIsEnabledToVisibilityConverter x:Uid="local_RecordNodeIsEnabledToVisibilityConverter_1" />
                    </MultiBinding.Converter>
                    <Binding x:Uid="Binding_1" Path="IsEnabled" />
                    <Binding x:Uid="Binding_2" ElementName="checkHideDisabled" Path="IsChecked" />
                  </MultiBinding>
                </Setter.Value>
              </Setter>
            </Style>
          </ItemsControl.ItemContainerStyle>
        </TreeView>
      </DockPanel>
    </GroupBox>
  </StackPanel>
</local:ModelTypeWizardItem>
