<?xml version='1.0' encoding='utf-8'?>
<Window x:Class="AspenTech.AspenPlus.ModelLibrary.HybridModelManagerDialog" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:shell="http://schemas.aspentech.com/xaml/presentation/visualisation/commonshell" xmlns:infra="clr-namespace:AspenTech.AspenPlus.Infrastructure;assembly=AspenTech.AspenPlus.Infrastructure" xmlns:local="clr-namespace:AspenTech.AspenPlus.ModelLibrary" xmlns:lp="clr-namespace:AspenTech.AspenPlus.Localization;assembly=AspenTech.AspenPlus.Localization" xmlns:mm="clr-namespace:AspenTech.AspenPlus.MMControls;assembly=AspenTech.AspenPlus.MMControls" mm:MMHelp.HelpFile="apwn.chm" mm:MMHelp.HelpId="41500" Background="{DynamicResource AspenDialogBackgroundBrush}" WindowStartupLocation="CenterOwner" ResizeMode="CanResizeWithGrip" ShowInTaskbar="False" Title="{x:Static lp:ModelLibraryResources.TitleHybridModelManager}" Width="820" Height="600" MinWidth="400" MinHeight="400">
  <Grid x:Uid="Grid_1" Margin="7">
    <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" Margin="0,0,10,10" VerticalAlignment="Top">
      <Label x:Name="AvailableHModels" Content="{x:Static lp:ModelLibraryResources.AvailableHybridModels}" HorizontalAlignment="Left" Width="Auto" Margin="5" />
    </StackPanel>
    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Bottom">
      <Button Click="ButtonUpdateModel_Click" x:Name="buttonUpdateModel" x:Uid="buttonUpdateModel" IsDefault="True" Margin="5" IsEnabled="True" Content="{x:Static lp:ModelLibraryResources.BrowseforAvailableModelBtn}" />
      <Button Click="ButtonRemoveModel_Click" x:Name="buttonRemoveModel" x:Uid="buttonRemoveModel" DockPanel.Dock="Right" Margin="5" IsEnabled="False" Content="{x:Static lp:ModelLibraryResources.RemoveModelBtn}" />
    </StackPanel>
    <DataGrid x:Name="dataModelList" IsReadOnly="True" RowHeaderWidth="0" CanUserAddRows="False" GridLinesVisibility="All" AutoGenerateColumns="False" Margin="10,33,10,40" Background="#FFFFFFFF" CanUserReorderColumns="False">
      <FrameworkElement.Resources>
        <ResourceDictionary>
          <Style x:Key="{x:Type DataGridCell}" TargetType="{x:Type DataGridCell}">
            <Setter Property="Border.BorderThickness" Value="0" />
            <Setter Property="FrameworkElement.FocusVisualStyle">
              <Setter.Value>
                <x:Null />
              </Setter.Value>
            </Setter>
          </Style>
        </ResourceDictionary>
      </FrameworkElement.Resources>
      <DataGrid.Columns>
        <DataGridTemplateColumn x:Uid="Col1">
          <DataGridTemplateColumn.CellTemplate>
            <DataTemplate>
              <CheckBox Checked="CheckBox_Checked" Unchecked="CheckBox_Unchecked" IsChecked="{Binding Val, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding ValEnable, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
            </DataTemplate>
          </DataGridTemplateColumn.CellTemplate>
        </DataGridTemplateColumn>
        <DataGridTextColumn Header="{x:Static lp:ModelLibraryResources.DeployedModel}" Width="Auto" Binding="{Binding Model}" />
        <DataGridTemplateColumn x:Uid="ColInUse" Header="{x:Static lp:ModelLibraryResources.InUse}">
          <DataGridTemplateColumn.CellTemplate>
            <DataTemplate>
              <CheckBox IsEnabled="False" IsChecked="{Binding ValUse, UpdateSourceTrigger=PropertyChanged}" />
            </DataTemplate>
          </DataGridTemplateColumn.CellTemplate>
        </DataGridTemplateColumn>
        <DataGridTextColumn Header="{x:Static lp:ModelLibraryResources.Type3}" Width="Auto" Binding="{Binding LocalizedType}" />
        <DataGridTextColumn Header="{x:Static lp:ModelLibraryResources.Version4}" Binding="{Binding Version}" />
        <DataGridTextColumn Header="{x:Static lp:ModelLibraryResources.LastModified5}" Width="Auto" Binding="{Binding TimeStamp}" />
        <DataGridTextColumn Header="{x:Static lp:ModelLibraryResources.Description6}" Width="Auto" Binding="{Binding Description}">
          <DataGridBoundColumn.ElementStyle>
            <Style TargetType="{x:Type TextBlock}">
              <Setter Property="TextBlock.TextWrapping" Value="Wrap" />
              <Setter Property="FrameworkElement.MaxHeight" Value="1000" />
              <Setter Property="TextBlock.TextTrimming" Value="WordEllipsis" />
              <Setter Property="FrameworkElement.Height" Value="20" />
              <Setter Property="FrameworkElement.VerticalAlignment" Value="Center" />
              <Setter Property="FrameworkElement.Margin" Value="5,0,5,0" />
            </Style>
          </DataGridBoundColumn.ElementStyle>
        </DataGridTextColumn>
      </DataGrid.Columns>
      <DataGrid.CellStyle>
        <Style TargetType="{x:Type DataGridCell}">
          <Setter Property="FrameworkElement.ToolTip" Value="{Binding RelativeSource={RelativeSource Self}, Path=Content.Text}" />
        </Style>
      </DataGrid.CellStyle>
    </DataGrid>
  </Grid>
</Window>
