<?xml version='1.0' encoding='utf-8'?>
<infra:ApwnDocumentControl x:Class="AspenTech.AspenPlus.ModelLibrary.ModelTypeUserConfigurationScreen" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:shell="http://schemas.aspentech.com/xaml/presentation/visualisation/commonshell" xmlns:infra="clr-namespace:AspenTech.AspenPlus.Infrastructure;assembly=AspenTech.AspenPlus.Infrastructure" xmlns:local="clr-namespace:AspenTech.AspenPlus.ModelLibrary" xmlns:igDock="http://infragistics.com/DockManager" xmlns:lp="clr-namespace:AspenTech.AspenPlus.Localization;assembly=AspenTech.AspenPlus.Localization" xmlns:ld="clr-namespace:System.Collections;assembly=mscorlib" xmlns:controls="clr-namespace:AspenTech.AspenPlus.ModelLibrary.Controls;assembly=AspenTech.AspenPlus.ModelLibrary.Controls" xmlns:mm="clr-namespace:AspenTech.AspenPlus.MMControls;assembly=AspenTech.AspenPlus.MMControls" Loaded="ScreenContentControl_Loaded" x:Name="root" x:Uid="root" mm:MMHelp.HelpFile="user2.chm" mm:MMHelp.HelpId="22" Header="{x:Static lp:ModelLibraryResources.ConfigurationScreenTitle}" IsDocumentScreen="False" Background="{DynamicResource AspenDialogBackgroundBrush}">
  <FrameworkElement.Resources>
    <ResourceDictionary>
      <ld:ArrayList x:Key="myTypelist" x:Uid="ld_ArrayList_1">
        <x:StaticExtension x:Uid="x_Static_1" Member="lp:ModelLibraryResources.UserConfigTypeInt" />
        <x:StaticExtension x:Uid="x_Static_2" Member="lp:ModelLibraryResources.UserConfigTypeReal" />
        <x:StaticExtension x:Uid="x_Static_3" Member="lp:ModelLibraryResources.UserConfigTypeCh" />
        <x:StaticExtension x:Uid="x_Static_4" Member="lp:ModelLibraryResources.UserConfigTypeStr" />
      </ld:ArrayList>
      <ld:ArrayList x:Key="myDimensionlist" x:Uid="ld_ArrayList_2">
        <x:StaticExtension x:Uid="x_Static_5" Member="lp:ModelLibraryResources.UserConfigDimScalar" />
        <x:StaticExtension x:Uid="x_Static_6" Member="lp:ModelLibraryResources.UserConfigDimComponets" />
        <x:StaticExtension x:Uid="x_Static_7" Member="lp:ModelLibraryResources.UserConfigDimInlet" />
        <x:StaticExtension x:Uid="x_Static_8" Member="lp:ModelLibraryResources.UserConfigDimMaterialInlet" />
        <x:StaticExtension x:Uid="x_Static_9" Member="lp:ModelLibraryResources.UserConfigDimHeatInlet" />
        <x:StaticExtension x:Uid="x_Static_10" Member="lp:ModelLibraryResources.UserConfigDimWorkInlet" />
        <x:StaticExtension x:Uid="x_Static_11" Member="lp:ModelLibraryResources.UserConfigDimOutlet" />
        <x:StaticExtension x:Uid="x_Static_12" Member="lp:ModelLibraryResources.UserConfigDimMaterialOutlet" />
        <x:StaticExtension x:Uid="x_Static_13" Member="lp:ModelLibraryResources.UserConfigDimHeatOutlet" />
        <x:StaticExtension x:Uid="x_Static_14" Member="lp:ModelLibraryResources.UserConfigDimWorkOutlet" />
      </ld:ArrayList>
      <ld:ArrayList x:Key="myIolist" x:Uid="ld_ArrayList_3">
        <x:StaticExtension x:Uid="x_Static_15" Member="lp:ModelLibraryResources.UserConfigIoInput" />
        <x:StaticExtension x:Uid="x_Static_16" Member="lp:ModelLibraryResources.UserConfigIoOutput" />
        <x:StaticExtension x:Uid="x_Static_17" Member="lp:ModelLibraryResources.UserConfigIoBoth" />
      </ld:ArrayList>
      <local:MyColorConverter x:Key="ColorConverter" x:Uid="local_MyColorConverter_1" />
      <ContextMenu x:Key="PopContextMenu" x:Uid="ContextMenu_1">
        <MenuItem Click="InsertRow_Click" x:Uid="MenuItem_1" Header="{x:Static lp:ModelLibraryResources.UserConfigMenuInsert}" />
        <MenuItem Click="DeleteRow_Click" x:Uid="MenuItem_2" Header="{x:Static lp:ModelLibraryResources.UserConfigMenuDelete}" />
      </ContextMenu>
    </ResourceDictionary>
  </FrameworkElement.Resources>
  <Grid x:Uid="Grid_1" Margin="{DynamicResource AspenDialogOuterMargin}">
    <Grid.RowDefinitions>
      <RowDefinition x:Uid="RowDefinition_1" Height="*" />
      <RowDefinition x:Uid="RowDefinition_2" Height="{DynamicResource AspenVerticalRelativeLength}" />
      <RowDefinition x:Uid="RowDefinition_3" Height="Auto" />
    </Grid.RowDefinitions>
    <GroupBox x:Uid="GroupBox_1" Grid.Row="0" Header="{x:Static lp:ModelLibraryResources.UserConDesignHeader}">
      <Grid x:Uid="Grid_2">
        <Grid.RowDefinitions>
          <RowDefinition x:Uid="RowDefinition_4" Height="*" />
        </Grid.RowDefinitions>
        <DataGrid SelectedCellsChanged="ConfigGrid_SelectedCellsChanged" x:Uid="ConfigGrid" Grid.Row="0" Name="ConfigGrid" AutoGenerateColumns="False" CanUserSortColumns="False" SelectionMode="Single" RowHeight="25" ItemsSource="{Binding ListAllDatas, ElementName=root}">
          <FrameworkElement.Resources>
            <ResourceDictionary>
              <Style x:Key="{x:Type DataGridCell}" x:Uid="Style_1" TargetType="{x:Type DataGridCell}">
                <Style.Triggers>
                  <Trigger x:Uid="Trigger_1" Property="DataGridCell.IsSelected" Value="True">
                    <Setter x:Uid="Setter_1" Property="Panel.Background" Value="{StaticResource AspenActiveItemBackgroundBrush}" />
                    <Setter x:Uid="Setter_2" Property="TextElement.Foreground" Value="#FF0000FF" />
                  </Trigger>
                  <Trigger x:Uid="Trigger_2" Property="DataGridCell.IsEditing" Value="True">
                    <Setter x:Uid="Setter_3" Property="TextElement.FontStyle" Value="Italic" />
                    <Setter x:Uid="Setter_4" Property="TextElement.FontWeight" Value="Heavy" />
                  </Trigger>
                </Style.Triggers>
              </Style>
            </ResourceDictionary>
          </FrameworkElement.Resources>
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate x:Uid="ItemsPanelTemplate_1">
              <VirtualizingStackPanel x:Uid="VirtualizingStackPanel_1" ContextMenu="{StaticResource PopContextMenu}" />
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <DataGrid.Columns>
            <DataGridTemplateColumn x:Uid="DataGridTemplateColumn_1" Header=" " CanUserResize="False" MaxWidth="25" MinWidth="12">
              <DataGridTemplateColumn.CellTemplate>
                <DataTemplate x:Uid="DataTemplate_1">
                  <Ellipse x:Uid="Ellipse_1" Height="10" Width="12" Fill="{Binding Path=ComStatus, Converter={StaticResource ColorConverter}}" />
                </DataTemplate>
              </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>
            <DataGridTextColumn x:Uid="DataGridTextColumn_1" Header="{x:Static lp:ModelLibraryResources.UserConfigVarName}" MinWidth="40" Width="180" Binding="{Binding Name}" />
            <DataGridComboBoxColumn x:Uid="DataGridComboBoxColumn_1" Header="{x:Static lp:ModelLibraryResources.UserConfigVarType}" MinWidth="40" Width="100" ItemsSource="{Binding Source={StaticResource myTypelist}}" SelectedItemBinding="{Binding Type}" />
            <DataGridComboBoxColumn x:Uid="DataGridComboBoxColumn_2" Header="{x:Static lp:ModelLibraryResources.UserConfigVarDim}" MinWidth="80" Width="150">
              <DataGridComboBoxColumn.ElementStyle>
                <Style TargetType="{x:Type ComboBox}">
                  <Setter Property="ItemsControl.ItemsSource" Value="{Binding Path=DimensionList}" />
                  <Setter Property="Selector.SelectedItem" Value="{Binding Path=Dimension}" />
                </Style>
              </DataGridComboBoxColumn.ElementStyle>
              <DataGridComboBoxColumn.EditingElementStyle>
                <Style TargetType="{x:Type ComboBox}">
                  <Setter Property="ItemsControl.ItemsSource" Value="{Binding Path=DimensionList}" />
                  <Setter Property="Selector.SelectedItem" Value="{Binding Path=Dimension}" />
                </Style>
              </DataGridComboBoxColumn.EditingElementStyle>
            </DataGridComboBoxColumn>
            <DataGridTextColumn x:Uid="DataGridTextColumn_2" Header="{x:Static lp:ModelLibraryResources.UserConfigVarDepth}" MinWidth="45" Width="90" Binding="{Binding Depth}" />
            <DataGridComboBoxColumn x:Uid="DataGridComboBoxColumn_3" Width="180" Header="{x:Static lp:ModelLibraryResources.UserConfigVarIO}" MinWidth="120" ItemsSource="{Binding Source={StaticResource myIolist}}" SelectedItemBinding="{Binding IO}" />
          </DataGrid.Columns>
        </DataGrid>
      </Grid>
    </GroupBox>
    <StackPanel x:Uid="StackPanel_1" Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
      <Button Click="btnImport_Click" x:Name="btnImport" x:Uid="btnImport">
        <ContentControl.Content>
          <TextBlock x:Uid="TextBlock_1" Text="{x:Static lp:ModelLibraryResources.UserConfigBtnImport}" />
        </ContentControl.Content>
      </Button>
      <Button Click="btnExport_Click" x:Name="btnExport" x:Uid="btnExport">
        <ContentControl.Content>
          <TextBlock x:Uid="TextBlock_2" Text="{x:Static lp:ModelLibraryResources.UserConfigBtnExport}" />
        </ContentControl.Content>
      </Button>
      <Button Click="btnApply_Click" x:Name="btnApply" x:Uid="btnApply">
        <ContentControl.Content>
          <TextBlock x:Uid="TextBlock_3" Text="{x:Static lp:ModelLibraryResources.UserConfigBtnApply}" />
        </ContentControl.Content>
      </Button>
      <Button Click="btnCancel_Click" x:Name="btnCancel" x:Uid="btnCancel">
        <ContentControl.Content>
          <TextBlock x:Uid="TextBlock_4" Text="{x:Static lp:ModelLibraryResources.UserConfigBtnCancel}" />
        </ContentControl.Content>
      </Button>
    </StackPanel>
  </Grid>
</infra:ApwnDocumentControl>
