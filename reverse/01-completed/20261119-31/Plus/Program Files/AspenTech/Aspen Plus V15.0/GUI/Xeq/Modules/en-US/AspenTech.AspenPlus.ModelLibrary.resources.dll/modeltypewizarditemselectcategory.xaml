<?xml version='1.0' encoding='utf-8'?>
<local:ModelTypeWizardItem x:Class="AspenTech.AspenPlus.ModelLibrary.ModelTypeWizardItemSelectCategory" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:local="clr-namespace:AspenTech.AspenPlus.ModelLibrary" xmlns:lp="clr-namespace:AspenTech.AspenPlus.Localization;assembly=AspenTech.AspenPlus.Localization" xmlns:mlc="clr-namespace:AspenTech.AspenPlus.ModelLibrary.Controls;assembly=AspenTech.AspenPlus.ModelLibrary.Controls" x:Uid="local_ModelTypeWizardItem_1" Title="{x:Static lp:ModelLibraryResources.WizardItemSelectCategoryTitle}">
  <Grid x:Uid="Grid_1" DataContext="{Binding RelativeSource={RelativeSource AncestorType=local:ModelTypeWizardItem, Mode=FindAncestor}}">
    <Grid.RowDefinitions>
      <RowDefinition x:Uid="RowDefinition_1" Height="auto" />
      <RowDefinition x:Uid="RowDefinition_2" Height="*" />
      <RowDefinition x:Uid="RowDefinition_3" Height="auto" />
    </Grid.RowDefinitions>
    <TextBlock x:Uid="TextBlock_1" TextWrapping="Wrap" Margin="{DynamicResource AspenVerticalRelativeControlMargin}" Text="{Binding Path=IntroductionText, Mode=OneWay}" />
    <GroupBox x:Uid="GroupBox_1" Grid.Row="1" Header="{x:Static lp:ModelLibraryResources.WizardItemSelectCategoryGroupHeader}" Margin="{DynamicResource AspenVerticalRelativeControlMargin}">
      <ListBox x:Name="theListBox" x:Uid="theListBox" MinWidth="200" MinHeight="160" SelectionMode="Single" SelectedItem="{Binding Path=SelectedCategory, Mode=TwoWay}" ItemsSource="{Binding Path=AvailableCategories, Mode=OneWay}">
        <ItemsControl.ItemTemplate>
          <DataTemplate x:Uid="DataTemplate_1" DataType="mlc:Category">
            <Label x:Uid="Label_1" Content="{Binding Path=Header}" />
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ListBox>
    </GroupBox>
    <Button Click="buttonCreateNewCategory_Click" x:Name="buttonCreateNewCategory" x:Uid="buttonCreateNewCategory" Grid.Row="2" Margin="0" HorizontalAlignment="Left" Content="{x:Static lp:ModelLibraryResources.WizardItemSelectCategoryButtonCreateNewCategory}" />
  </Grid>
</local:ModelTypeWizardItem>
