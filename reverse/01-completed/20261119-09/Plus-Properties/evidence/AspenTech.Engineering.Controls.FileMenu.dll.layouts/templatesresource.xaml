<?xml version='1.0' encoding='utf-8'?>
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:sys="clr-namespace:System;assembly=mscorlib" xmlns:local="clr-namespace:AspenTech.Engineering.Controls.FileMenu">
  <SolidColorBrush x:Key="ItemBackgroundBlue" Color="#003057" />
  <SolidColorBrush x:Key="DropdownBackgroundGray" Color="#F0F2F5" />
  <sys:Double x:Key="ItemWidth">400</sys:Double>
  <sys:Double x:Key="FontSize">20</sys:Double>
  <sys:Double x:Key="ImageSize">90</sys:Double>
  <local:TooltipDisplayConverter x:Key="tdc" />
  <local:FileMenuItemTemplateSelector x:Key="FileMenuItemTemplateSelector" />
  <DataTemplate x:Key="CommandButtonTemplate">
    <StackPanel HorizontalAlignment="Left">
      <Button Margin="0,10" HorizontalContentAlignment="Left" HorizontalAlignment="Left">
        <FrameworkElement.Height>
          <Binding Path="Height" />
        </FrameworkElement.Height>
        <FrameworkElement.Width>
          <Binding Path="Width" />
        </FrameworkElement.Width>
        <ContentControl.Content>
          <Binding Path="Title" />
        </ContentControl.Content>
        <ToolTipService.IsEnabled>
          <Binding Path="Tooltip" Converter="{StaticResource tdc}" />
        </ToolTipService.IsEnabled>
        <ButtonBase.Command>
          <Binding Path="Command" />
        </ButtonBase.Command>
        <ButtonBase.CommandParameter>
          <Binding Path="CommandParameter" />
        </ButtonBase.CommandParameter>
        <UIElement.Uid>
          <Binding Path="Uid" />
        </UIElement.Uid>
        <FrameworkElement.Style>
          <Style TargetType="{x:Type Button}">
            <Setter Property="Control.Template">
              <Setter.Value>
                <ControlTemplate TargetType="{x:Type Button}">
                  <Border Background="{TemplateBinding Panel.Background}" BorderBrush="{TemplateBinding Border.BorderBrush}" BorderThickness="{TemplateBinding Border.BorderThickness}">
                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                  </Border>
                </ControlTemplate>
              </Setter.Value>
            </Setter>
            <Style.Triggers>
              <Trigger Property="UIElement.IsMouseOver" Value="True">
                <Setter Property="Border.BorderThickness" Value="2" />
                <Setter Property="Border.BorderBrush" Value="#FFADD8E6" />
              </Trigger>
              <Trigger Property="UIElement.IsEnabled" Value="False">
                <Setter Property="Panel.Background" Value="#FFF4F4F4" />
                <Setter Property="TextElement.Foreground" Value="#FFA9A9A9" />
                <Setter Property="Border.BorderThickness" Value="2" />
                <Setter Property="Border.BorderBrush" Value="#00FFFFFF" />
              </Trigger>
              <Trigger Property="UIElement.IsEnabled" Value="True">
                <Setter Property="Panel.Background" Value="#FF0078C9" />
                <Setter Property="TextElement.Foreground" Value="#FFFFFFFF" />
              </Trigger>
            </Style.Triggers>
          </Style>
        </FrameworkElement.Style>
        <ContentControl.ContentTemplate>
          <DataTemplate>
            <DockPanel>
              <FrameworkElement.Width>
                <Binding Path="Width">
                  <Binding.RelativeSource>
                    <RelativeSource AncestorType="{x:Type Button}" />
                  </Binding.RelativeSource>
                </Binding>
              </FrameworkElement.Width>
              <TextBlock Background="#00FFFFFF" Margin="10,0,0,0" HorizontalAlignment="Left">
                <TextBlock.Text>
                  <Binding Path="Content">
                    <Binding.RelativeSource>
                      <RelativeSource AncestorType="{x:Type Button}" />
                    </Binding.RelativeSource>
                  </Binding>
                </TextBlock.Text>
                <TextBlock.Foreground>
                  <Binding Path="Foreground">
                    <Binding.RelativeSource>
                      <RelativeSource AncestorType="{x:Type Button}" />
                    </Binding.RelativeSource>
                  </Binding>
                </TextBlock.Foreground>
                <TextBlock.FontSize>
                  <Binding Path="DataContext.FontSize">
                    <Binding.RelativeSource>
                      <RelativeSource AncestorType="{x:Type Button}" />
                    </Binding.RelativeSource>
                  </Binding>
                </TextBlock.FontSize>
              </TextBlock>
              <TextBlock Text="►" Margin="0,0,10,0" FontFamily="Arial Black" HorizontalAlignment="Right" Background="#00FFFFFF">
                <TextBlock.FontSize>
                  <Binding Path="DataContext.FontSize">
                    <Binding.RelativeSource>
                      <RelativeSource AncestorType="{x:Type Button}" />
                    </Binding.RelativeSource>
                  </Binding>
                </TextBlock.FontSize>
              </TextBlock>
            </DockPanel>
          </DataTemplate>
        </ContentControl.ContentTemplate>
        <FrameworkElement.ToolTip>
          <StackPanel Orientation="Vertical" MinHeight="50" Width="210">
            <TextBlock FontWeight="Bold" Margin="0,5,5,0" FontFamily="Segoe UI" TextWrapping="Wrap">
              <TextBlock.Text>
                <Binding Path="TooltipTitle" />
              </TextBlock.Text>
            </TextBlock>
            <TextBlock Margin="7,3,5,3" TextWrapping="Wrap">
              <TextBlock.Text>
                <Binding Path="Tooltip" />
              </TextBlock.Text>
            </TextBlock>
          </StackPanel>
        </FrameworkElement.ToolTip>
      </Button>
      <TextBlock Margin="20,0,0,0" FontWeight="Normal" MaxWidth="570" TextWrapping="Wrap">
        <TextBlock.Text>
          <Binding Path="Description" />
        </TextBlock.Text>
        <TextBlock.FontSize>
          <Binding Path="FontSize" />
        </TextBlock.FontSize>
      </TextBlock>
    </StackPanel>
  </DataTemplate>
  <local:FilePathConverter x:Key="fpc" />
  <local:SyncWidthConverter x:Key="swc" />
  <DataTemplate x:Key="ListViewItemWithImageTemplate">
    <Button HorizontalAlignment="Left" BorderBrush="#00FFFFFF" BorderThickness="0" VerticalAlignment="Stretch">
      <FrameworkElement.Width>
        <Binding Path="Width" />
      </FrameworkElement.Width>
      <ButtonBase.Command>
        <Binding Path="Command" />
      </ButtonBase.Command>
      <ButtonBase.CommandParameter>
        <Binding Path="CommandParameter" />
      </ButtonBase.CommandParameter>
      <FrameworkElement.Style>
        <Style TargetType="{x:Type Button}">
          <Setter Property="Control.Template">
            <Setter.Value>
              <ControlTemplate TargetType="{x:Type Button}">
                <Border Background="{TemplateBinding Panel.Background}">
                  <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Stretch" />
                </Border>
              </ControlTemplate>
            </Setter.Value>
          </Setter>
          <Style.Triggers>
            <Trigger Property="UIElement.IsMouseOver" Value="True">
              <Setter Property="Panel.Background" Value="#00FFFFFF" />
              <Setter Property="Border.BorderBrush" Value="#00FFFFFF" />
            </Trigger>
            <Trigger Property="UIElement.IsEnabled" Value="False">
              <Setter Property="Panel.Background" Value="#00FFFFFF" />
            </Trigger>
            <Trigger Property="UIElement.IsEnabled" Value="True">
              <Setter Property="Panel.Background" Value="#00FFFFFF" />
            </Trigger>
          </Style.Triggers>
        </Style>
      </FrameworkElement.Style>
      <DockPanel HorizontalAlignment="Left" LastChildFill="True">
        <UIElement.Uid>
          <Binding Path="Uid" />
        </UIElement.Uid>
        <Grid Background="{StaticResource ItemBackgroundBlue}" DockPanel.Dock="Top">
          <FrameworkElement.Width>
            <Binding Path="Width" />
          </FrameworkElement.Width>
          <FrameworkElement.Height>
            <Binding Path="Height" />
          </FrameworkElement.Height>
          <Image Height="{StaticResource ImageSize}" HorizontalAlignment="Center" VerticalAlignment="Center">
            <Image.Source>
              <Binding Path="Image" />
            </Image.Source>
          </Image>
        </Grid>
        <StackPanel Orientation="Vertical">
          <TextBlock TextAlignment="Left" TextWrapping="Wrap" Margin="20,10,0,10" HorizontalAlignment="Left" FontWeight="Bold">
            <TextBlock.Text>
              <Binding Path="Title" />
            </TextBlock.Text>
            <TextBlock.FontSize>
              <Binding Path="FontSize" />
            </TextBlock.FontSize>
          </TextBlock>
          <TextBlock TextAlignment="Left" TextWrapping="Wrap" Margin="20,5,0,10" HorizontalAlignment="Left">
            <TextBlock.Text>
              <Binding Path="Description" />
            </TextBlock.Text>
            <TextBlock.FontSize>
              <Binding Path="FontSize" />
            </TextBlock.FontSize>
          </TextBlock>
        </StackPanel>
      </DockPanel>
    </Button>
  </DataTemplate>
  <DataTemplate x:Key="ListViewItemWithImageAndMouseOverTemplate">
    <Grid>
      <UIElement.Uid>
        <Binding Path="Uid" />
      </UIElement.Uid>
      <UIElement.InputBindings>
        <MouseBinding MouseAction="LeftClick">
          <InputBinding.Command>
            <Binding Path="Command" />
          </InputBinding.Command>
          <InputBinding.CommandParameter>
            <Binding Path="CommandParameter" />
          </InputBinding.CommandParameter>
        </MouseBinding>
      </UIElement.InputBindings>
      <DockPanel HorizontalAlignment="Left" LastChildFill="True" VerticalAlignment="Top">
        <FrameworkElement.Width>
          <Binding Path="Width" />
        </FrameworkElement.Width>
        <Grid Background="{StaticResource ItemBackgroundBlue}" DockPanel.Dock="Top">
          <FrameworkElement.Width>
            <Binding Path="Width" />
          </FrameworkElement.Width>
          <FrameworkElement.Height>
            <Binding Path="Height" />
          </FrameworkElement.Height>
          <Image Height="{StaticResource ImageSize}" HorizontalAlignment="Center" VerticalAlignment="Center">
            <Image.Source>
              <Binding Path="Image" />
            </Image.Source>
          </Image>
          <local:FileMenuListView Name="CommandList" BorderThickness="0" ItemTemplateSelector="{StaticResource FileMenuItemTemplateSelector}" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed" Background="#00FFFFFF">
            <ItemsControl.ItemsSource>
              <Binding Path="Children" />
            </ItemsControl.ItemsSource>
            <FrameworkElement.Style>
              <Style>
                <Setter Property="ItemsControl.ItemContainerStyle">
                  <Setter.Value>
                    <Style TargetType="{x:Type ListViewItem}">
                      <Setter Property="Control.Padding" Value="0" />
                      <Setter Property="Control.HorizontalContentAlignment" Value="Stretch" />
                      <Setter Property="Control.Template">
                        <Setter.Value>
                          <ControlTemplate TargetType="{x:Type ListViewItem}">
                            <Border Name="Bd" Background="{TemplateBinding Panel.Background}" BorderBrush="{TemplateBinding Border.BorderBrush}" BorderThickness="{TemplateBinding Border.BorderThickness}" Padding="{TemplateBinding Control.Padding}" SnapsToDevicePixels="True">
                              <ContentPresenter HorizontalAlignment="{TemplateBinding Control.HorizontalContentAlignment}" VerticalAlignment="{TemplateBinding Control.VerticalContentAlignment}" SnapsToDevicePixels="{TemplateBinding UIElement.SnapsToDevicePixels}" />
                            </Border>
                          </ControlTemplate>
                        </Setter.Value>
                      </Setter>
                      <Style.Triggers>
                        <Trigger Property="ListBoxItem.IsSelected" Value="True">
                          <Setter Property="Panel.Background" Value="#00FFFFFF" />
                        </Trigger>
                      </Style.Triggers>
                    </Style>
                  </Setter.Value>
                </Setter>
              </Style>
            </FrameworkElement.Style>
          </local:FileMenuListView>
        </Grid>
        <TextBlock TextAlignment="Left" TextWrapping="Wrap" Margin="20,10,0,10" FontWeight="Bold">
          <TextBlock.Text>
            <Binding Path="Title" />
          </TextBlock.Text>
          <TextBlock.FontSize>
            <Binding Path="FontSize" />
          </TextBlock.FontSize>
        </TextBlock>
      </DockPanel>
    </Grid>
    <DataTemplate.Triggers>
      <DataTrigger Value="True">
        <DataTrigger.Binding>
          <Binding Path="IsMouseOver">
            <Binding.RelativeSource>
              <RelativeSource Mode="FindAncestor" AncestorType="ListViewItem" />
            </Binding.RelativeSource>
          </Binding>
        </DataTrigger.Binding>
        <Setter TargetName="CommandList" Property="UIElement.Visibility" Value="Visible" />
      </DataTrigger>
    </DataTemplate.Triggers>
  </DataTemplate>
  <DataTemplate x:Key="ListViewItemWithImageAndCheckBoxAndMouseOverTemplate">
    <Grid>
      <UIElement.Uid>
        <Binding Path="Uid" />
      </UIElement.Uid>
      <UIElement.InputBindings>
        <MouseBinding MouseAction="LeftClick">
          <InputBinding.Command>
            <Binding Path="Command" />
          </InputBinding.Command>
          <InputBinding.CommandParameter>
            <Binding Path="CommandParameter" />
          </InputBinding.CommandParameter>
        </MouseBinding>
      </UIElement.InputBindings>
      <DockPanel HorizontalAlignment="Left" LastChildFill="True" VerticalAlignment="Top">
        <FrameworkElement.Width>
          <Binding Path="Width" />
        </FrameworkElement.Width>
        <Grid Background="{StaticResource ItemBackgroundBlue}" DockPanel.Dock="Top">
          <FrameworkElement.Width>
            <Binding Path="Width" />
          </FrameworkElement.Width>
          <FrameworkElement.Height>
            <Binding Path="Height" />
          </FrameworkElement.Height>
          <Image Height="{StaticResource ImageSize}" HorizontalAlignment="Center" VerticalAlignment="Center">
            <Image.Source>
              <Binding Path="Image" />
            </Image.Source>
          </Image>
          <Viewbox HorizontalAlignment="Right" Margin="0,20,20,0" Height="41" VerticalAlignment="Top" Width="41">
            <Path Stroke="#FFFFFFFF" StrokeThickness="3">
              <Path.Data>
                <GeometryGroup>
                  <PathGeometry Figures="M 9,20 17,29 33,12" />
                  <EllipseGeometry RadiusX="20" RadiusY="20" Center="20,20" />
                </GeometryGroup>
              </Path.Data>
            </Path>
          </Viewbox>
          <local:FileMenuListView Name="CommandList" BorderThickness="0" ItemTemplateSelector="{StaticResource FileMenuItemTemplateSelector}" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed" Background="#00FFFFFF">
            <ItemsControl.ItemsSource>
              <Binding Path="Children" />
            </ItemsControl.ItemsSource>
            <FrameworkElement.Style>
              <Style>
                <Setter Property="ItemsControl.ItemContainerStyle">
                  <Setter.Value>
                    <Style TargetType="{x:Type ListViewItem}">
                      <Setter Property="Control.Padding" Value="0" />
                      <Setter Property="Control.HorizontalContentAlignment" Value="Stretch" />
                      <Setter Property="Control.Template">
                        <Setter.Value>
                          <ControlTemplate TargetType="{x:Type ListViewItem}">
                            <Border Name="Bd" Background="{TemplateBinding Panel.Background}" BorderBrush="{TemplateBinding Border.BorderBrush}" BorderThickness="{TemplateBinding Border.BorderThickness}" Padding="{TemplateBinding Control.Padding}" SnapsToDevicePixels="True">
                              <ContentPresenter HorizontalAlignment="{TemplateBinding Control.HorizontalContentAlignment}" VerticalAlignment="{TemplateBinding Control.VerticalContentAlignment}" SnapsToDevicePixels="{TemplateBinding UIElement.SnapsToDevicePixels}" />
                            </Border>
                          </ControlTemplate>
                        </Setter.Value>
                      </Setter>
                      <Style.Triggers>
                        <Trigger Property="UIElement.IsMouseOver" Value="True">
                          <Setter Property="Panel.Background" Value="#00FFFFFF" />
                          <Setter Property="Border.BorderBrush" Value="#00FFFFFF" />
                        </Trigger>
                        <Trigger Property="ListBoxItem.IsSelected" Value="True">
                          <Setter Property="Panel.Background" Value="#00FFFFFF" />
                        </Trigger>
                      </Style.Triggers>
                    </Style>
                  </Setter.Value>
                </Setter>
              </Style>
            </FrameworkElement.Style>
          </local:FileMenuListView>
        </Grid>
        <TextBlock TextAlignment="Left" TextWrapping="Wrap" Margin="20,10,0,10" FontWeight="Bold">
          <TextBlock.Text>
            <Binding Path="Title" />
          </TextBlock.Text>
          <TextBlock.FontSize>
            <Binding Path="FontSize" />
          </TextBlock.FontSize>
        </TextBlock>
      </DockPanel>
    </Grid>
    <DataTemplate.Triggers>
      <DataTrigger Value="True">
        <DataTrigger.Binding>
          <Binding Path="IsMouseOver">
            <Binding.RelativeSource>
              <RelativeSource Mode="FindAncestor" AncestorType="ListViewItem" />
            </Binding.RelativeSource>
          </Binding>
        </DataTrigger.Binding>
        <Setter TargetName="CommandList" Property="UIElement.Visibility" Value="Visible" />
      </DataTrigger>
    </DataTemplate.Triggers>
  </DataTemplate>
  <DataTemplate x:Key="ListViewItemWithImageAndCheckTemplate">
    <DockPanel HorizontalAlignment="Left" LastChildFill="True">
      <FrameworkElement.Width>
        <Binding Path="Width" />
      </FrameworkElement.Width>
      <UIElement.Uid>
        <Binding Path="Uid" />
      </UIElement.Uid>
      <UIElement.InputBindings>
        <MouseBinding MouseAction="LeftClick">
          <InputBinding.Command>
            <Binding Path="Command" />
          </InputBinding.Command>
          <InputBinding.CommandParameter>
            <Binding Path="CommandParameter" />
          </InputBinding.CommandParameter>
        </MouseBinding>
      </UIElement.InputBindings>
      <Grid Background="#FF003057" DockPanel.Dock="Top">
        <FrameworkElement.Width>
          <Binding Path="Width" />
        </FrameworkElement.Width>
        <FrameworkElement.Height>
          <Binding Path="Height" />
        </FrameworkElement.Height>
        <Image Height="{StaticResource ImageSize}" HorizontalAlignment="Center" VerticalAlignment="Center">
          <Image.Source>
            <Binding Path="Image" />
          </Image.Source>
        </Image>
        <Viewbox HorizontalAlignment="Right" Margin="0,20,20,0" Height="41" VerticalAlignment="Top" Width="41">
          <Path Stroke="#FFFFFFFF" StrokeThickness="3">
            <Path.Data>
              <GeometryGroup>
                <PathGeometry Figures="M 9,20 17,29 33,12" />
                <EllipseGeometry RadiusX="20" RadiusY="20" Center="20,20" />
              </GeometryGroup>
            </Path.Data>
          </Path>
        </Viewbox>
      </Grid>
      <TextBlock TextAlignment="Left" TextWrapping="Wrap" Margin="20,20,0,0" FontWeight="Bold">
        <TextBlock.Text>
          <Binding Path="Title" />
        </TextBlock.Text>
        <TextBlock.FontSize>
          <Binding Path="FontSize" />
        </TextBlock.FontSize>
      </TextBlock>
    </DockPanel>
  </DataTemplate>
  <DataTemplate x:Key="ListViewItemWithTextTemplate">
    <DockPanel HorizontalAlignment="Left" LastChildFill="True">
      <FrameworkElement.Width>
        <Binding Path="Width" />
      </FrameworkElement.Width>
      <UIElement.Uid>
        <Binding Path="Uid" />
      </UIElement.Uid>
      <UIElement.InputBindings>
        <MouseBinding MouseAction="LeftClick">
          <InputBinding.Command>
            <Binding Path="Command" />
          </InputBinding.Command>
          <InputBinding.CommandParameter>
            <Binding Path="CommandParameter" />
          </InputBinding.CommandParameter>
        </MouseBinding>
      </UIElement.InputBindings>
      <StackPanel Background="#FF003057" DockPanel.Dock="Top">
        <FrameworkElement.Width>
          <Binding Path="Width" />
        </FrameworkElement.Width>
        <FrameworkElement.Height>
          <Binding Path="Height" />
        </FrameworkElement.Height>
        <TextBlock Margin="20,20" Foreground="#FFFFFFFF">
          <TextBlock.Text>
            <Binding Path="Title" />
          </TextBlock.Text>
          <TextBlock.FontSize>
            <Binding Path="FontSize" />
          </TextBlock.FontSize>
        </TextBlock>
      </StackPanel>
      <TextBlock FontWeight="Bold" TextAlignment="Left" Margin="20,10,0,0" TextWrapping="Wrap">
        <TextBlock.Text>
          <Binding Path="Description" />
        </TextBlock.Text>
        <TextBlock.FontSize>
          <Binding Path="FontSize" />
        </TextBlock.FontSize>
      </TextBlock>
    </DockPanel>
  </DataTemplate>
  <DataTemplate x:Key="WrapPanelListTemplate">
    <StackPanel HorizontalAlignment="Left" Orientation="Vertical" Margin="0,10,0,10">
      <UIElement.Uid>
        <Binding Path="Uid" />
      </UIElement.Uid>
      <FrameworkElement.Width>
        <Binding Path="ActualWidth" Converter="{StaticResource swc}">
          <Binding.RelativeSource>
            <RelativeSource AncestorType="local:FileMenuControl" />
          </Binding.RelativeSource>
        </Binding>
      </FrameworkElement.Width>
      <TextBlock Margin="0,0,0,0" FontWeight="Bold">
        <TextBlock.Text>
          <Binding Path="Title" />
        </TextBlock.Text>
        <TextBlock.FontSize>
          <Binding Path="FontSize" />
        </TextBlock.FontSize>
      </TextBlock>
      <Border Margin="2,5,0,0" Width="200" Height="2" BorderBrush="#FFD3D3D3" BorderThickness="1" HorizontalAlignment="Left" />
      <local:FileMenuListView Margin="2,10,0,0" ScrollViewer.HorizontalScrollBarVisibility="Disabled" BorderThickness="0" MinHeight="100" ItemTemplateSelector="{StaticResource FileMenuItemTemplateSelector}">
        <ItemsControl.ItemsSource>
          <Binding Path="Children" />
        </ItemsControl.ItemsSource>
        <ItemsControl.ItemContainerStyle>
          <Style TargetType="{x:Type ListViewItem}">
            <Setter Property="Control.VerticalContentAlignment" Value="Stretch" />
          </Style>
        </ItemsControl.ItemContainerStyle>
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate>
            <WrapPanel IsItemsHost="True" Orientation="Horizontal" />
          </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
      </local:FileMenuListView>
    </StackPanel>
  </DataTemplate>
  <DataTemplate x:Key="WrapPanelTemplate">
    <StackPanel HorizontalAlignment="Left" Orientation="Vertical" Margin="0,10,0,10">
      <UIElement.Uid>
        <Binding Path="Uid" />
      </UIElement.Uid>
      <Label Margin="20,0,0,0" FontWeight="Bold">
        <ContentControl.Content>
          <Binding Path="Title" />
        </ContentControl.Content>
        <Control.FontSize>
          <Binding Path="FontSize" />
        </Control.FontSize>
      </Label>
      <Border Margin="20,5,0,0" Width="200" Height="2" BorderBrush="#FFD3D3D3" BorderThickness="1" HorizontalAlignment="Left" />
      <ItemsControl Margin="20,10,0,0" ItemTemplateSelector="{StaticResource FileMenuItemTemplateSelector}">
        <ItemsControl.ItemsSource>
          <Binding Path="Children" />
        </ItemsControl.ItemsSource>
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate>
            <WrapPanel IsItemsHost="True" Orientation="Horizontal" />
          </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
      </ItemsControl>
    </StackPanel>
  </DataTemplate>
  <DataTemplate x:Key="DropDownListTemplate">
    <DockPanel Margin="0,0,40,0" Height="300" LastChildFill="True">
      <UIElement.Uid>
        <Binding Path="Uid" />
      </UIElement.Uid>
      <DockPanel DockPanel.Dock="Top" HorizontalAlignment="Stretch" LastChildFill="True" Background="{StaticResource DropdownBackgroundGray}">
        <Label DockPanel.Dock="Left" FontWeight="Bold" Background="{StaticResource DropdownBackgroundGray}">
          <ContentControl.Content>
            <Binding Path="Title" />
          </ContentControl.Content>
          <Control.FontSize>
            <Binding Path="FontSize" />
          </Control.FontSize>
        </Label>
      </DockPanel>
      <local:FileMenuListView DockPanel.Dock="Bottom" BorderThickness="0" ItemTemplateSelector="{StaticResource FileMenuItemTemplateSelector}">
        <ItemsControl.ItemsSource>
          <Binding Path="Children" />
        </ItemsControl.ItemsSource>
        <FrameworkElement.Style>
          <Style>
            <Setter Property="ItemsControl.ItemContainerStyle">
              <Setter.Value>
                <Style TargetType="{x:Type ListViewItem}">
                  <Setter Property="Control.HorizontalContentAlignment" Value="Stretch" />
                  <Setter Property="Control.Template">
                    <Setter.Value>
                      <ControlTemplate TargetType="{x:Type ListViewItem}">
                        <Border Name="Bd" Background="{TemplateBinding Panel.Background}" BorderBrush="{TemplateBinding Border.BorderBrush}" BorderThickness="{TemplateBinding Border.BorderThickness}" Padding="{TemplateBinding Control.Padding}" SnapsToDevicePixels="True">
                          <ContentPresenter HorizontalAlignment="{TemplateBinding Control.HorizontalContentAlignment}" VerticalAlignment="{TemplateBinding Control.VerticalContentAlignment}" SnapsToDevicePixels="{TemplateBinding UIElement.SnapsToDevicePixels}" />
                        </Border>
                      </ControlTemplate>
                    </Setter.Value>
                  </Setter>
                  <Style.Triggers>
                    <Trigger Property="UIElement.IsMouseOver" Value="True">
                      <Setter Property="Panel.Background" Value="#FFE5F3FB" />
                      <Setter Property="Border.BorderBrush" Value="#FF70C0E7" />
                    </Trigger>
                    <Trigger Property="ListBoxItem.IsSelected" Value="True">
                      <Setter Property="Panel.Background" Value="#00FFFFFF" />
                    </Trigger>
                  </Style.Triggers>
                </Style>
              </Setter.Value>
            </Setter>
          </Style>
        </FrameworkElement.Style>
      </local:FileMenuListView>
    </DockPanel>
  </DataTemplate>
  <local:BoolToTextConverter x:Key="BoolToTextConverter" />
  <local:ImageFormatConverter x:Key="ImageFormatConverter" />
  <local:BoolToExpandTextConverter x:Key="BoolToExpandTextConverter" />
  <DataTemplate x:Key="ImageAndTextListViewItemTemplate">
    <Button BorderThickness="0" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left">
      <ButtonBase.Command>
        <Binding Path="Command" />
      </ButtonBase.Command>
      <ToolTipService.IsEnabled>
        <Binding Path="Tooltip" Converter="{StaticResource tdc}" />
      </ToolTipService.IsEnabled>
      <UIElement.Uid>
        <Binding Path="Uid" />
      </UIElement.Uid>
      <ButtonBase.CommandParameter>
        <Binding Path="CommandParameter" />
      </ButtonBase.CommandParameter>
      <FrameworkElement.ToolTip>
        <StackPanel Orientation="Vertical" MinHeight="50" Width="210">
          <TextBlock FontWeight="Bold" Margin="0,5,5,0" FontFamily="Segoe UI" TextWrapping="Wrap">
            <TextBlock.Text>
              <Binding Path="TooltipTitle" />
            </TextBlock.Text>
          </TextBlock>
          <TextBlock Margin="7,3,5,3" TextWrapping="Wrap">
            <TextBlock.Text>
              <Binding Path="Tooltip" />
            </TextBlock.Text>
          </TextBlock>
        </StackPanel>
      </FrameworkElement.ToolTip>
      <FrameworkElement.Style>
        <Style>
          <Setter Property="Panel.Background" Value="#00FFFFFF" />
          <Setter Property="TextElement.Foreground" Value="#FF00008B" />
          <Setter Property="Control.Template">
            <Setter.Value>
              <ControlTemplate TargetType="{x:Type Button}">
                <Grid Background="{TemplateBinding Panel.Background}">
                  <ContentPresenter Name="MyContentPresenter" Content="{TemplateBinding ContentControl.Content}" HorizontalAlignment="Left" VerticalAlignment="Center" />
                </Grid>
              </ControlTemplate>
            </Setter.Value>
          </Setter>
          <Style.Triggers>
            <Trigger Property="UIElement.IsEnabled" Value="False">
              <Setter Property="Panel.Background" Value="#00FFFFFF" />
