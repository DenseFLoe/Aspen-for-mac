<?xml version='1.0' encoding='utf-8'?>
<UserControl x:Class="AspenTech.AspenPlus.MMForms.CustomForms.CustomFormControl" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:controls="clr-namespace:AspenTech.Engineering.GridControls;assembly=AspenTech.Engineering.GridControls" xmlns:res="clr-namespace:AspenTech.AspenPlus.Localization;assembly=AspenTech.AspenPlus.Localization" xmlns:controlsInternal="clr-namespace:AspenTech.Engineering.GridControls.Internal;assembly=AspenTech.Engineering.GridControls" x:Uid="UserControl_1">
  <controls:GridControlPanel x:Name="thePanel" x:Uid="thePanel">
    <controls:GridControlPanel.HeaderContextMenu>
      <ContextMenu x:Uid="ContextMenu_1">
        <MenuItem Header="{x:Static res:CustomFormsResources.TabContextMenu_New}" Command="{x:Static controls:GridControlPanel.AddNewGridCommand}" x:Uid="MenuItem_1">
          <MenuItem.Icon>
            <Image Source="{x:Static controlsInternal:ImageSourceHelper.FileNew32}" Height="16" Width="16" x:Uid="Image_1" />
          </MenuItem.Icon>
        </MenuItem>
        <MenuItem Header="{x:Static res:CustomFormsResources.TabContextMenu_Rename}" Command="{x:Static controls:GridControlPanel.RenameCurrentGridCommand}" x:Uid="MenuItem_2" />
        <MenuItem Header="{x:Static res:CustomFormsResources.TabContextMenu_Delete}" Command="{x:Static controls:GridControlPanel.RemoveCurrentGridCommand}" x:Uid="MenuItem_3" />
      </ContextMenu>
    </controls:GridControlPanel.HeaderContextMenu>
  </controls:GridControlPanel>
</UserControl>
