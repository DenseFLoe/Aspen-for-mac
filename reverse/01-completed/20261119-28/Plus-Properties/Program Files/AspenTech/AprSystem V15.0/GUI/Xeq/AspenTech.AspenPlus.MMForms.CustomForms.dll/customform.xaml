<?xml version='1.0' encoding='utf-8'?>
<MMTabPage x:Class="AspenTech.AspenPlus.MMForms.CustomForms.CustomForm" xmlns="http://schemas.aspentech.com/xaml/presentation/aspenplus" xmlns:av="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:res="clr-namespace:AspenTech.AspenPlus.Localization;assembly=AspenTech.AspenPlus.Localization" xmlns:local="clr-namespace:AspenTech.AspenPlus.MMForms.CustomForms" MMHelp.HelpId="3" MMHelp.HelpFile="flowsheet.chm" x:Uid="MMTabPage_1" xmlns:aes="http://schemas.aspentech.com/xaml/presentation/engineering">
  <av:Grid x:Uid="StretchGrid1">
    <av:Grid.ColumnDefinitions>
      <av:ColumnDefinition x:Uid="av_ColumnDefinition_1" Width="*" />
    </av:Grid.ColumnDefinitions>
    <av:Grid.RowDefinitions>
      <av:RowDefinition x:Uid="av_RowDefinition_1" Height="Auto" />
      <av:RowDefinition x:Uid="av_RowDefinition_2" Height="*" />
    </av:Grid.RowDefinitions>
    <av:Grid x:Uid="av_Grid_1" Margin="4,4,4,0" av:Grid.Column="0" av:Grid.Row="0">
      <av:Grid.ColumnDefinitions>
        <av:ColumnDefinition x:Uid="av_ColumnDefinition_2" Width="Auto" />
        <av:ColumnDefinition x:Uid="av_ColumnDefinition_3" Width="Auto" />
        <av:ColumnDefinition x:Uid="av_ColumnDefinition_4" Width="Auto" />
        <av:ColumnDefinition x:Uid="av_ColumnDefinition_5" Width="Auto" />
      </av:Grid.ColumnDefinitions>
      <av:Grid.RowDefinitions>
        <av:RowDefinition x:Uid="av_RowDefinition_4" Height="Auto" />
      </av:Grid.RowDefinitions>
      <MMCmdButton Name="MMBtnPT" x:Uid="MMCmdButton_1" MinWidth="120" Margin="{av:StaticResource AspenVerticalRelativeControlMargin}" av:Grid.Column="0" av:Grid.Row="0" Content="{x:Static res:CustomFormsResources.ContextMenuItem_PlaceFormOnFlowsheet}">
        <aes:AesCmdButton.Command>
          <av:Binding Path="CmdPlaceFormOnFlowsheet" />
        </aes:AesCmdButton.Command>
      </MMCmdButton>
      <MMCmdButton Name="MMBtnPI" x:Uid="MMCmdButton_2" MinWidth="120" Margin="{av:StaticResource AspenVerticalRelativeControlMargin}" av:Grid.Column="1" av:Grid.Row="0" Content="{x:Static res:CustomFormsResources.ContextMenuItem_PlaceAsIconOnFlowsheet}">
        <aes:AesCmdButton.Command>
          <av:Binding Path="CmdPlaceAsIconOnFlowsheet" />
        </aes:AesCmdButton.Command>
      </MMCmdButton>
      <MMCmdButton Name="MMBtnSendToExcel" x:Uid="MMCmdButton_3" MinWidth="120" Margin="{av:StaticResource AspenVerticalRelativeControlMargin}" av:Grid.Column="2" av:Grid.Row="0" Content="{x:Static res:CustomFormsResources.SendToExcel}">
        <aes:AesCmdButton.Command>
          <av:Binding Path="CmdSendToExcel" />
        </aes:AesCmdButton.Command>
      </MMCmdButton>
      <MMCmdButton Name="MMBtnSendToMultiCase" x:Uid="MMCmdButton_4" MinWidth="120" Margin="{av:StaticResource AspenVerticalRelativeControlMargin}" av:Grid.Column="3" av:Grid.Row="0" Content="{x:Static res:CustomFormsResources.SendToMultiCase}">
        <aes:AesCmdButton.Command>
          <av:Binding Path="CmdSendToMultiCase" />
        </aes:AesCmdButton.Command>
      </MMCmdButton>
    </av:Grid>
    <local:CustomFormControl x:Name="theCustomFormControl" av:Grid.Column="0" av:Grid.Row="1" x:Uid="theCustomFormControl" />
  </av:Grid>
</MMTabPage>
