<?xml version='1.0' encoding='utf-8'?>
<Window x:Class="AspenTech.AspenPlus.MMDialogs.ConvertDlg" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:mm="http://schemas.aspentech.com/xaml/presentation/aspenplus" xmlns:local="clr-namespace:AspenTech.AspenPlus.MMDialogs" xmlns:lp="clr-namespace:AspenTech.AspenPlus.Localization;assembly=AspenTech.AspenPlus.Localization" xmlns:atSupport="http://schemas.aspentech.com/xaml/presentation/visualisation/support" x:Uid="Window_1" mm:MMHelp.HelpId="1" ShowInTaskbar="False" SizeToContent="Height" Width="380" ResizeMode="NoResize" Title="{x:Static lp:WpfMMDialogResources.ConvertTo_Title}" Style="{StaticResource MMDialogStyle}">
  <mm:MMHelp.HelpFile>
    <Binding Path="HelpFile" FallbackValue="gendbhlp.chm" />
  </mm:MMHelp.HelpFile>
  <FrameworkElement.Resources>
    <ResourceDictionary x:Uid="ResourceDictionary_1">
      <ResourceDictionary.MergedDictionaries>
        <atSupport:AspenCommonResources />
        <atSupport:AspenCommonProperties x:Uid="atSupport_AspenCommonProperties_1" />
        <atSupport:AspenCommonStyles />
        <atSupport:AspenDefaultStyles />
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </FrameworkElement.Resources>
  <StackPanel Name="stackPanel1" x:Uid="stackPanel1" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Margin="{StaticResource AspenDialogOuterMargin}">
    <TextBlock Name="DescriptionTextBlock" x:Uid="DescriptionTextBlock" HorizontalAlignment="Stretch" Margin="0,0" VerticalAlignment="Stretch" TextWrapping="Wrap">
      <TextBlock.Text>
        <Binding Path="CppCode.Description" />
      </TextBlock.Text>
    </TextBlock>
    <Grid Name="grid1" x:Uid="grid1" HorizontalAlignment="Center" VerticalAlignment="Stretch" Margin="0,8,0,0">
      <Grid.ColumnDefinitions>
        <ColumnDefinition x:Uid="ColumnDefinition_1" Width="*" />
        <ColumnDefinition x:Uid="ColumnDefinition_2" Width="*" />
      </Grid.ColumnDefinitions>
      <Button Click="OkButton_Click" Name="OkButton" x:Uid="OkButton" IsDefault="True" Content="{x:Static lp:WpfMMDialogResources.Ok}" Grid.Column="0" Margin="5,5" />
      <Button Name="CancelButton" x:Uid="CancelButton" IsCancel="True" Content="{x:Static lp:WpfMMDialogResources.Cancel}" Grid.Column="1" Margin="5,5" />
    </Grid>
  </StackPanel>
</Window>
