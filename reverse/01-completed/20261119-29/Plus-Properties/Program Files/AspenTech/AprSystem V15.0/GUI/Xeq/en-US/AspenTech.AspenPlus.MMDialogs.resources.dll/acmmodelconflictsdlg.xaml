<?xml version='1.0' encoding='utf-8'?>
<local:MMDialog x:Class="AspenTech.AspenPlus.MMDialogs.ACMModelConflictsDlg" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:AspenTech.AspenPlus.MMDialogs" xmlns:lp="clr-namespace:AspenTech.AspenPlus.Localization;assembly=AspenTech.AspenPlus.Localization" xmlns:mm="http://schemas.aspentech.com/xaml/presentation/aspenplus" xmlns:atSupport="http://schemas.aspentech.com/xaml/presentation/visualisation/support" x:Name="dlg" x:Uid="dlg" ResizeMode="NoResize" SizeToContent="WidthAndHeight" ShowInTaskbar="False" Title="{x:Static lp:WpfMMDialogResources.ACMModelConflicts_Title}" Style="{StaticResource MMDialogStyle}">
  <mm:MMHelp.HelpFile>
    <Binding Path="HelpFile" />
  </mm:MMHelp.HelpFile>
  <mm:MMHelp.HelpId>
    <Binding Path="HelpId" />
  </mm:MMHelp.HelpId>
  <Grid Name="grid1" x:Uid="grid1" Margin="{StaticResource AspenDialogOuterMargin}">
    <Grid.RowDefinitions>
      <RowDefinition x:Uid="RowDefinition_1" Height="Auto" />
      <RowDefinition x:Uid="RowDefinition_2" Height="Auto" />
      <RowDefinition x:Uid="RowDefinition_3" Height="Auto" />
      <RowDefinition x:Uid="RowDefinition_4" Height="Auto" />
      <RowDefinition x:Uid="RowDefinition_5" Height="Auto" />
    </Grid.RowDefinitions>
    <Grid.ColumnDefinitions>
      <ColumnDefinition x:Uid="ColumnDefinition_1" Width="*" />
      <ColumnDefinition x:Uid="ColumnDefinition_2" Width="*" />
    </Grid.ColumnDefinitions>
    <Label Name="DeployN" x:Uid="Deploy" Grid.Row="0" Grid.Column="0" Content="{x:Static lp:WpfMMDialogResources.ACMDeployed_Models}" HorizontalAlignment="Left" IsEnabled="True" />
    <Label Name="EditN" x:Uid="Edit" Grid.Row="2" Grid.Column="0" Content="{x:Static lp:WpfMMDialogResources.ACMEdited_Models}" HorizontalAlignment="Left" IsEnabled="True" />
    <Button Click="Ok_Click" Name="Ok" x:Uid="Ok" Grid.Row="4" Grid.Column="0" Content="{x:Static lp:WpfMMDialogResources.Ok}" Margin="10" HorizontalAlignment="Center" IsEnabled="True" />
    <Button Name="Cancel" x:Uid="Cancel" Grid.Row="4" Grid.Column="1" Content="{x:Static lp:WpfMMDialogResources.Cancel}" Margin="10" IsCancel="True" HorizontalAlignment="Center" IsEnabled="True" />
    <DataGrid Name="dgConflictList" x:Uid="ModelConflictList" Grid.Row="1" Grid.ColumnSpan="2" AutoGenerateColumns="False" CanUserAddRows="False" CanUserSortColumns="False" SelectionUnit="Cell">
      <DataGrid.Columns>
        <DataGridTextColumn Header="{x:Static lp:WpfMMDialogResources.ACMModelConflicts_Model}" IsReadOnly="True">
          <DataGridBoundColumn.Binding>
            <Binding Path="Model" />
          </DataGridBoundColumn.Binding>
        </DataGridTextColumn>
        <DataGridTextColumn Header="{x:Static lp:WpfMMDialogResources.ACMModelConflicts_DeploydVersion}" IsReadOnly="True">
          <DataGridBoundColumn.Binding>
            <Binding Path="Installed" />
          </DataGridBoundColumn.Binding>
        </DataGridTextColumn>
        <DataGridTextColumn Header="{x:Static lp:WpfMMDialogResources.ACMModelConflicts_CaseVersion}" IsReadOnly="True">
          <DataGridBoundColumn.Binding>
            <Binding Path="Case" />
          </DataGridBoundColumn.Binding>
        </DataGridTextColumn>
        <DataGridCheckBoxColumn Header="{x:Static lp:WpfMMDialogResources.ACMModelConflicts_DeployCase}">
          <DataGridBoundColumn.Binding>
            <Binding Path="Action" />
          </DataGridBoundColumn.Binding>
        </DataGridCheckBoxColumn>
      </DataGrid.Columns>
    </DataGrid>
    <DataGrid Name="dgConflictListE" x:Uid="ModelConflictListE" Grid.Row="3" Grid.ColumnSpan="2" AutoGenerateColumns="False" CanUserAddRows="False" CanUserSortColumns="False" SelectionUnit="Cell">
      <DataGrid.Columns>
        <DataGridTextColumn Header="{x:Static lp:WpfMMDialogResources.ACMModelConflicts_Model}" IsReadOnly="True">
          <DataGridBoundColumn.Binding>
            <Binding Path="Model" />
          </DataGridBoundColumn.Binding>
        </DataGridTextColumn>
        <DataGridTextColumn Header="{x:Static lp:WpfMMDialogResources.ACMModelConflicts_EditedVersion}" IsReadOnly="True">
          <DataGridBoundColumn.Binding>
            <Binding Path="Installed" />
          </DataGridBoundColumn.Binding>
        </DataGridTextColumn>
        <DataGridTextColumn Header="{x:Static lp:WpfMMDialogResources.ACMModelConflicts_CaseVersion}" IsReadOnly="True">
          <DataGridBoundColumn.Binding>
            <Binding Path="Case" />
          </DataGridBoundColumn.Binding>
        </DataGridTextColumn>
        <DataGridCheckBoxColumn Header="{x:Static lp:WpfMMDialogResources.ACMModelConflicts_RestoreCase}">
          <DataGridBoundColumn.Binding>
            <Binding Path="Action" />
          </DataGridBoundColumn.Binding>
        </DataGridCheckBoxColumn>
      </DataGrid.Columns>
    </DataGrid>
  </Grid>
</local:MMDialog>
