<?xml version='1.0' encoding='utf-8'?>
<Window x:Class="AspenTech.AspenPlus.MMDialogs.RevealDlg" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:res="clr-namespace:AspenTech.AspenPlus.Localization;assembly=AspenTech.AspenPlus.Localization" x:Uid="Window_1" Title="{x:Static res:WpfMMDialogResources.Reveal}" ResizeMode="NoResize" ShowInTaskbar="False" SizeToContent="WidthAndHeight" Style="{StaticResource MMDialogStyle}">
  <Grid Name="grid1" x:Uid="grid1" Height="293" Width="458">
    <Grid.RowDefinitions>
      <RowDefinition x:Uid="RowDefinition_1" />
      <RowDefinition x:Uid="RowDefinition_2" />
      <RowDefinition x:Uid="RowDefinition_3" />
      <RowDefinition x:Uid="RowDefinition_4" />
      <RowDefinition x:Uid="RowDefinition_5" />
      <RowDefinition x:Uid="RowDefinition_6" />
    </Grid.RowDefinitions>
    <Grid.ColumnDefinitions>
      <ColumnDefinition x:Uid="ColumnDefinition_1" />
      <ColumnDefinition x:Uid="ColumnDefinition_2" Width="120" />
    </Grid.ColumnDefinitions>
    <Button Name="Replace" x:Uid="Replace" Grid.Column="1" Content="{x:Static res:WpfSimdllResources.BtnOk}" IsDefault="True" Height="27" HorizontalAlignment="Left" Margin="10,10,0,0" VerticalAlignment="Top" Width="100" />
    <Button Name="Merge" x:Uid="Merge" Grid.Row="1" Grid.Column="1" Content="{x:Static res:WpfMMDialogResources.Remove}" Height="27" HorizontalAlignment="Left" Margin="10,10,0,0" VerticalAlignment="Top" Width="100" />
    <Button Name="EditID" x:Uid="EditID" Grid.Row="2" Grid.Column="1" Content="{x:Static res:WpfMMDialogResources.Export}" Height="27" HorizontalAlignment="Left" Margin="10,10,0,0" VerticalAlignment="Top" Width="100" />
    <Button Name="AddPrefix" x:Uid="AddPrefix" Grid.Row="3" Grid.Column="1" Content="{x:Static res:WpfMMDialogResources.Undo}" Height="27" HorizontalAlignment="Left" Margin="10,10,0,0" VerticalAlignment="Top" Width="100" />
    <Button Name="AddSuffix" x:Uid="AddSuffix" Grid.Row="4" Grid.Column="1" Content="{x:Static res:WpfSimdllResources.BtnCancel}" IsCancel="True" Height="27" HorizontalAlignment="Left" Margin="10,10,0,0" VerticalAlignment="Top" Width="100" />
    <Button Name="Ignore" x:Uid="Ignore" Grid.Row="5" Grid.Column="1" Content="{x:Static res:WpfSimdllResources.BtnHelp}" Height="27" HorizontalAlignment="Left" Margin="10,10,0,0" VerticalAlignment="Top" Width="100" />
    <ListView Name="ConflictIDList" x:Uid="ConflictIDList" Height="269" HorizontalAlignment="Left" Margin="12,12,0,0" VerticalAlignment="Top" Width="316" Grid.RowSpan="6">
      <ItemsControl.ItemsSource>
        <Binding Path="Items" />
      </ItemsControl.ItemsSource>
      <ListView.View>
        <GridView x:Uid="GridView_1" />
      </ListView.View>
    </ListView>
  </Grid>
</Window>
