<?xml version='1.0' encoding='utf-8'?>
<mmd:MMDialog x:Class="AspenTech.AspenPlus.MMDialogs.OpenMessageBox" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:mmd="clr-namespace:AspenTech.AspenPlus.MMDialogs" xmlns:res="clr-namespace:AspenTech.AspenPlus.Localization;assembly=AspenTech.AspenPlus.Localization" xmlns:atSupport="http://schemas.aspentech.com/xaml/presentation/visualisation/support" x:Uid="mmd_MMDialog_1" ShowInTaskbar="False" MinHeight="100" MinWidth="300" MaxWidth="600" SizeToContent="WidthAndHeight" ResizeMode="NoResize" WindowStartupLocation="CenterOwner" FontSize="{StaticResource AspenDefaultFontSize}" FontFamily="{StaticResource AspenDefaultFontFamily}">
  <FrameworkElement.Resources>
    <ResourceDictionary x:Uid="ResourceDictionary_1">
      <ResourceDictionary.MergedDictionaries>
        <atSupport:AspenCommonResources />
        <atSupport:AspenCommonProperties x:Uid="atSupport_AspenCommonProperties_1" />
        <atSupport:AspenCommonStyles />
        <atSupport:AspenDefaultStyles />
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </FrameworkElement.Resources>
  <Border x:Uid="Border_1">
    <Grid x:Uid="Grid_1" Margin="{StaticResource AspenDialogOuterMargin}">
      <Grid.RowDefinitions>
        <RowDefinition x:Uid="RowDefinition_1" Height="Auto" />
        <RowDefinition x:Uid="RowDefinition_2" Height="Auto" />
        <RowDefinition x:Uid="RowDefinition_3" Height="Auto" />
      </Grid.RowDefinitions>
      <Grid x:Uid="Grid_2" Grid.Row="0" Margin="{StaticResource AspenVerticalIrrelativeControlMargin}">
        <Grid.ColumnDefinitions>
          <ColumnDefinition x:Uid="ColumnDefinition_1" Width="Auto" />
        </Grid.ColumnDefinitions>
        <TextBlock x:Name="txtMessage" x:Uid="TextBlock_1" Grid.Column="0" VerticalAlignment="Center" TextWrapping="Wrap" MinHeight="20" MaxWidth="500" Margin="{StaticResource AspenHorizontalRelativeControlMargin}" />
      </Grid>
      <CheckBox x:Name="chkDontshow" x:Uid="chkDontshow" MinWidth="0" HorizontalAlignment="Left" Grid.Row="1" Margin="{StaticResource AspenVerticalRelativeControlMargin}" Content="{x:Static res:WpfMMDialogResources.MsgNotShowAgain}">
        <ToggleButton.IsChecked>
          <Binding Path="IsChecked" />
        </ToggleButton.IsChecked>
      </CheckBox>
      <Grid x:Name="buttonsPanel" x:Uid="buttonsPanel" VerticalAlignment="Bottom" HorizontalAlignment="Right" Grid.Row="2">
        <Grid.ColumnDefinitions>
          <ColumnDefinition x:Uid="ColumnDefinition_2" Width="Auto" />
          <ColumnDefinition x:Uid="ColumnDefinition_3" Width="Auto" />
          <ColumnDefinition x:Uid="ColumnDefinition_4" Width="Auto" />
          <ColumnDefinition x:Uid="ColumnDefinition_5" Width="Auto" />
        </Grid.ColumnDefinitions>
        <Button Click="btn0_Click" x:Name="btn0" x:Uid="btn0" MinWidth="80" Margin="{StaticResource AspenHorizontalRelativeControlMargin}" Grid.Column="0" />
        <Button Click="btn1_Click" x:Name="btn1" x:Uid="btn1" MinWidth="80" Margin="{StaticResource AspenHorizontalRelativeControlMargin}" Grid.Column="1" />
        <Button Click="btn2_Click" x:Name="btn2" x:Uid="btn2" MinWidth="80" Margin="{StaticResource AspenHorizontalRelativeControlMargin}" Grid.Column="2" />
        <Button Click="btn3_Click" x:Name="btn3" x:Uid="btn3" MinWidth="80" Margin="{StaticResource AspenHorizontalRelativeControlMargin}" Grid.Column="3" />
      </Grid>
    </Grid>
  </Border>
</mmd:MMDialog>
