<?xml version='1.0' encoding='utf-8'?>
<Window x:Class="AspenTech.AspenPlus.MMDialogs.Type2Dlg" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:res="clr-namespace:AspenTech.AspenPlus.Localization;assembly=AspenTech.AspenPlus.Localization" xmlns:atSupport="http://schemas.aspentech.com/xaml/presentation/visualisation/support" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Uid="Window_1" ShowInTaskbar="False" Title="{x:Static res:WpfMMDialogResources.EnterType}" Height="130" MinWidth="220" ResizeMode="NoResize" SizeToContent="Width" Style="{StaticResource MMDialogStyle}">
  <FrameworkElement.Resources>
    <ResourceDictionary x:Uid="ResourceDictionary_1">
      <ResourceDictionary.MergedDictionaries>
        <atSupport:AspenCommonResources />
        <atSupport:AspenCommonProperties x:Uid="atSupport_AspenCommonProperties_1" />
        <atSupport:AspenCommonStyles />
        <atSupport:AspenDefaultStyles />
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </FrameworkElement.Resources>
  <StackPanel x:Uid="StackPanel_1" Margin="{StaticResource AspenDialogOuterMargin}">
    <Label x:Uid="Label_1" Height="10" />
    <ComboBox SelectionChanged="cboType2_SelectionChanged" x:Name="cboType2" x:Uid="cboType2" MinWidth="100" HorizontalAlignment="Center" Margin="{DynamicResource AspenVerticalIrrelativeControlMargin}" />
    <UniformGrid x:Uid="UniformGrid_1" Columns="2" HorizontalAlignment="Center">
      <Button Click="btnOK_Click" Name="btnOK" x:Uid="btnOK" Content="{x:Static res:WpfSimdllResources.BtnOk}" IsDefault="True" Margin="{DynamicResource AspenHorizontalRelativeControlMargin}" />
      <Button Click="btnCancel_Click" Name="btnCancel" x:Uid="btnCancel" Content="{x:Static res:WpfSimdllResources.BtnCancel}" Margin="{DynamicResource AspenNoMargin}" IsCancel="True" />
    </UniformGrid>
  </StackPanel>
</Window>
