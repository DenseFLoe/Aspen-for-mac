<?xml version='1.0' encoding='utf-8'?>
<Window x:Class="AspenTech.AspenPlus.MMDialogs.ResolveStreamEOName" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:mm="clr-namespace:AspenTech.AspenPlus.MMControls;assembly=AspenTech.AspenPlus.MMControls" xmlns:res="clr-namespace:AspenTech.AspenPlus.Localization;assembly=AspenTech.AspenPlus.Localization" x:Uid="Window_1" ResizeMode="CanResize" WindowStartupLocation="CenterOwner" ShowInTaskbar="False" Style="{StaticResource MMDialogStyle}" MinHeight="200" MinWidth="500" Height="300" Width="720">
  <mm:MMHelp.HelpFile>
    <Binding Path="HelpFile" FallbackValue="apeoref.chm" />
  </mm:MMHelp.HelpFile>
  <mm:MMHelp.HelpId>
    <Binding Path="HelpID" />
  </mm:MMHelp.HelpId>
  <Window.Title>
    <Binding Path="WindowTitle" />
  </Window.Title>
  <Grid x:Uid="Grid_1" Margin="{StaticResource AspenDialogOuterMargin}">
    <Grid.ColumnDefinitions>
      <ColumnDefinition x:Uid="ColumnDefinition_1" Width="*" />
      <ColumnDefinition x:Uid="ColumnDefinition_2" Width="Auto" />
    </Grid.ColumnDefinitions>
    <DataGrid SelectionChanged="NameGrid_SelectionChanged" Name="NameGrid" x:Uid="NameGrid" Grid.Column="0" CanUserAddRows="False" AutoGenerateColumns="False" Margin="{StaticResource AspenHorizontalIrrelativeControlMargin}">
      <ItemsControl.ItemsSource>
        <Binding Path="AllEoStreamName" />
      </ItemsControl.ItemsSource>
      <DataGrid.Columns>
        <DataGridTextColumn x:Uid="DataGridTextColumn_1" IsReadOnly="True" MinWidth="120" Header="{x:Static res:WpfMMDialogResources.OldEOName}">
          <DataGridBoundColumn.Binding>
            <Binding Path="OldName" />
          </DataGridBoundColumn.Binding>
        </DataGridTextColumn>
        <DataGridTextColumn x:Uid="DataGridTextColumn_2" IsReadOnly="True" MinWidth="120" Header="{x:Static res:WpfMMDialogResources.NewEOName}">
          <DataGridBoundColumn.Binding>
            <Binding Path="NewName" />
          </DataGridBoundColumn.Binding>
        </DataGridTextColumn>
        <DataGridTextColumn x:Uid="DataGridTextColumn_3" IsReadOnly="True" MinWidth="120" Header="{x:Static res:WpfMMDialogResources.Status}">
          <DataGridBoundColumn.Binding>
            <Binding Path="Status" />
          </DataGridBoundColumn.Binding>
        </DataGridTextColumn>
      </DataGrid.Columns>
    </DataGrid>
    <StackPanel x:Uid="StackPanel_1" Orientation="Vertical" Grid.Column="1">
      <Button x:Uid="Button_1" Margin="{StaticResource AspenVerticalIrrelativeControlMargin}">
        <ButtonBase.Command>
          <Binding Path="CommandOnReplace" />
        </ButtonBase.Command>
        <ContentControl.Content>
          <Binding Path="BtnLabel" />
        </ContentControl.Content>
      </Button>
      <Button x:Uid="Button_2" Margin="{StaticResource AspenVerticalIrrelativeControlMargin}" Content="{x:Static res:WpfMMDialogResources.EditEOName}">
        <ButtonBase.Command>
          <Binding Path="CommandOnEdit" />
        </ButtonBase.Command>
        <UIElement.Visibility>
          <Binding Path="EditVisble" />
        </UIElement.Visibility>
      </Button>
      <Button x:Uid="Button_3" Margin="{StaticResource AspenVerticalIrrelativeControlMargin}" Content="{x:Static res:WpfMMDialogResources.Ignore}">
        <ButtonBase.Command>
          <Binding Path="CommandOnIgnore" />
        </ButtonBase.Command>
      </Button>
      <Button x:Uid="Button_4" Margin="{StaticResource AspenVerticalIrrelativeControlMargin}" Content="{x:Static res:WpfSimdllResources.BtnOk}">
        <ButtonBase.Command>
          <Binding Path="CommandOnOK" />
        </ButtonBase.Command>
      </Button>
      <Button x:Uid="Button_5" Command="ApplicationCommands.Help" Content="{x:Static res:WpfSimdllResources.BtnHelp}" />
    </StackPanel>
  </Grid>
</Window>
