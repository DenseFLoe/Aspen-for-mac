<?xml version='1.0' encoding='utf-8'?>
<mmd:MMDialog x:Class="AspenTech.AspenPlus.MMDialogs.ColumnHXIntegrationDlg" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:mmd="clr-namespace:AspenTech.AspenPlus.MMDialogs" xmlns:res="clr-namespace:AspenTech.AspenPlus.Localization;assembly=AspenTech.AspenPlus.Localization" xmlns:mm="http://schemas.aspentech.com/xaml/presentation/aspenplus" x:Uid="mmd_MMDialog_1" mm:MMHelp.HelpId="202" ShowInTaskbar="False" ResizeMode="NoResize" Title="{x:Static res:WpfMMDialogResources.ReboilerWizard}" SizeToContent="WidthAndHeight" Style="{StaticResource MMDialogStyle}">
  <mm:MMHelp.HelpFile>
    <Binding Path="HelpFile" FallbackValue="radfrac.chm" />
  </mm:MMHelp.HelpFile>
  <Grid x:Uid="Grid_1" Margin="{StaticResource AspenDialogOuterMargin}">
    <Grid.RowDefinitions>
      <RowDefinition x:Uid="RowDefinition_1" Height="Auto" />
      <RowDefinition x:Uid="RowDefinition_2" Height="{StaticResource AspenVerticalRelativeLength}" />
      <RowDefinition x:Uid="RowDefinition_3" Height="Auto" />
      <RowDefinition x:Uid="RowDefinition_4" Height="{StaticResource AspenVerticalRelativeLength}" />
      <RowDefinition x:Uid="RowDefinition_5" Height="Auto" />
      <RowDefinition x:Uid="RowDefinition_6" Height="{StaticResource AspenVerticalRelativeLength}" />
      <RowDefinition x:Uid="RowDefinition_7" Height="Auto" />
      <RowDefinition x:Uid="RowDefinition_8" Height="{StaticResource AspenVerticalRelativeLength}" />
      <RowDefinition x:Uid="RowDefinition_9" Height="Auto" />
      <RowDefinition x:Uid="RowDefinition_10" Height="{StaticResource AspenVerticalRelativeLength}" />
      <RowDefinition x:Uid="RowDefinition_11" Height="Auto" />
      <RowDefinition x:Uid="RowDefinition_12" Height="{StaticResource AspenVerticalRelativeLength}" />
      <RowDefinition x:Uid="RowDefinition_13" Height="Auto" />
      <RowDefinition x:Uid="RowDefinition_14" Height="{StaticResource AspenVerticalRelativeLength}" />
      <RowDefinition x:Uid="RowDefinition_15" Height="Auto" />
      <RowDefinition x:Uid="RowDefinition_16" Height="{StaticResource AspenVerticalRelativeLength}" />
      <RowDefinition x:Uid="RowDefinition_17" Height="Auto" />
      <RowDefinition x:Uid="RowDefinition_18" Height="{StaticResource AspenVerticalRelativeLength}" />
      <RowDefinition x:Uid="RowDefinition_19" Height="Auto" />
    </Grid.RowDefinitions>
    <Grid.ColumnDefinitions>
      <ColumnDefinition x:Uid="ColumnDefinition_1" Width="Auto" />
      <ColumnDefinition x:Uid="ColumnDefinition_2" Width="{StaticResource AspenHorizontalRelativeLength}" />
      <ColumnDefinition x:Uid="ColumnDefinition_3" Width="*" />
    </Grid.ColumnDefinitions>
    <Label x:Uid="Label_1" Content="{x:Static res:WpfMMDialogResources.ReboilerType}" Margin="12,0,0,0" Grid.Row="0" Grid.Column="0" />
    <Label x:Uid="Label_2" Content="{x:Static res:WpfMMDialogResources.PseudoStreamID}" Margin="12,0,0,0" Grid.Row="2" Grid.Column="0" VerticalAlignment="Top" />
    <TextBox Name="textBox1" x:Uid="textBox1" IsEnabled="False" Grid.Row="0" Grid.Column="2" HorizontalAlignment="Left" Width="195">
      <TextBox.Text>
        <Binding Path="ReboilerType" Mode="TwoWay" />
      </TextBox.Text>
    </TextBox>
    <TextBox LostFocus="textBox2_LostFocus" Name="textBox2" x:Uid="textBox2" Grid.Row="2" Grid.Column="2" HorizontalAlignment="Left" Width="195" CharacterCasing="Upper">
      <TextBox.Text>
        <Binding Path="ReboilerID" Mode="TwoWay" />
      </TextBox.Text>
      <UIElement.IsEnabled>
        <Binding Path="IsEableSTREAMID" />
      </UIElement.IsEnabled>
    </TextBox>
    <GroupBox Name="groupBox1" x:Uid="groupBox1" Header="{x:Static res:WpfMMDialogResources.HeatxSpec}" Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="3">
      <Grid x:Uid="Grid_2">
        <Grid.RowDefinitions>
          <RowDefinition x:Uid="RowDefinition_20" Height="Auto" />
          <RowDefinition x:Uid="RowDefinition_21" Height="{StaticResource AspenVerticalRelativeLength}" />
          <RowDefinition x:Uid="RowDefinition_22" Height="Auto" />
          <RowDefinition x:Uid="RowDefinition_23" Height="{StaticResource AspenVerticalRelativeLength}" />
          <RowDefinition x:Uid="RowDefinition_24" Height="Auto" />
          <RowDefinition x:Uid="RowDefinition_25" Height="{StaticResource AspenVerticalRelativeLength}" />
          <RowDefinition x:Uid="RowDefinition_26" Height="Auto" />
          <RowDefinition x:Uid="RowDefinition_27" Height="{StaticResource AspenVerticalRelativeLength}" />
          <RowDefinition x:Uid="RowDefinition_28" Height="Auto" />
          <RowDefinition x:Uid="RowDefinition_29" Height="{StaticResource AspenVerticalRelativeLength}" />
          <RowDefinition x:Uid="RowDefinition_30" Height="Auto" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
          <ColumnDefinition x:Uid="ColumnDefinition_4" Width="135" />
          <ColumnDefinition x:Uid="ColumnDefinition_5" Width="{StaticResource AspenVerticalRelativeLength}" />
          <ColumnDefinition x:Uid="ColumnDefinition_6" Width="*" />
        </Grid.ColumnDefinitions>
        <Label x:Uid="Label_3" Content="{x:Static res:WpfMMDialogResources.BlockID}" Grid.Column="0" Grid.Row="0" />
        <Label x:Uid="Label_4" Content="{x:Static res:WpfMMDialogResources.Type}" Grid.Column="0" Grid.Row="2" />
        <Label x:Uid="Label_5" Content="{x:Static res:WpfMMDialogResources.Mode}" Grid.Column="0" Grid.Row="4" />
        <Label x:Uid="Label_6" Content="{x:Static res:WpfMMDialogResources.CirculationType}" Grid.Column="0" Grid.Row="6" />
        <ComboBox LostFocus="ComboBox_LostFocus" Name="CmbBlockID" x:Uid="CmbBlockID" IsEditable="True" Grid.Column="2" Grid.Row="0" Width="195">
          <ItemsControl.ItemsSource>
            <Binding Path="BlockComboListID" />
          </ItemsControl.ItemsSource>
          <Selector.SelectedValue>
            <Binding Path="SelectedBlockID" Mode="TwoWay" />
          </Selector.SelectedValue>
          <ComboBox.Text>
            <Binding Path="BlockID" Mode="TwoWay" />
          </ComboBox.Text>
          <UIElement.IsEnabled>
            <Binding Path="IsEableHEATXID" />
          </UIElement.IsEnabled>
        </ComboBox>
        <ComboBox x:Uid="ComboBox_1" Grid.Column="2" Grid.Row="2" Width="195">
          <ItemsControl.ItemsSource>
            <Binding Path="BlockComboListType" />
          </ItemsControl.ItemsSource>
          <Selector.SelectedValue>
            <Binding Path="SelectedBlockType" Mode="TwoWay" />
          </Selector.SelectedValue>
          <ComboBox.Text>
            <Binding Path="BlockType" Mode="TwoWay" />
          </ComboBox.Text>
        </ComboBox>
        <ComboBox x:Uid="ComboBox_2" Grid.Column="2" Grid.Row="4" Width="195">
          <ItemsControl.ItemsSource>
            <Binding Path="BlockComboListMode" />
          </ItemsControl.ItemsSource>
          <Selector.SelectedValue>
            <Binding Path="BlockMode" Mode="TwoWay" />
          </Selector.SelectedValue>
        </ComboBox>
        <ComboBox x:Uid="ComboBox_3" Grid.Column="2" Grid.Row="6" Width="195">
          <ItemsControl.ItemsSource>
            <Binding Path="CirculationComboListType" />
          </ItemsControl.ItemsSource>
          <Selector.SelectedValue>
            <Binding Path="CirculationType" Mode="TwoWay" />
          </Selector.SelectedValue>
          <UIElement.IsEnabled>
            <Binding Path="IsEableHXFLOWTYPE" />
          </UIElement.IsEnabled>
        </ComboBox>
        <Label x:Uid="Label_7" Content="{x:Static res:WpfMMDialogResources.ReboilerWizardTip}" Grid.Column="0" Grid.Row="8" Grid.ColumnSpan="3" />
        <DockPanel x:Uid="DockPanel_1" LastChildFill="True" Grid.Column="0" Grid.Row="10" Grid.ColumnSpan="3">
          <Button x:Uid="Button_1" DockPanel.Dock="Right" Content="{x:Static res:WpfMMDialogResources.Browse}">
            <UIElement.IsEnabled>
              <Binding Path="IsEableInputFile" />
            </UIElement.IsEnabled>
            <ButtonBase.Command>
              <Binding Path="CommandOnBrowse" />
            </ButtonBase.Command>
          </Button>
          <TextBox x:Uid="TextBox_1" Margin="{StaticResource AspenHorizontalRelativeControlMargin}">
            <UIElement.IsEnabled>
              <Binding Path="IsEableInputFile" />
            </UIElement.IsEnabled>
            <TextBox.Text>
              <Binding Path="HxInputFile" />
            </TextBox.Text>
          </TextBox>
        </DockPanel>
      </Grid>
    </GroupBox>
    <Label x:Uid="Label_8" Content="{x:Static res:WpfMMDialogResources.FlashBlkID}" Margin="12,0,0,0" Grid.Row="6" Grid.Column="0" />
    <Label x:Uid="Label_9" Content="{x:Static res:WpfMMDialogResources.FirstCalcBlkID}" Margin="12,0,0,0" Grid.Row="8" Grid.Column="0" />
    <Label x:Uid="Label_10" Content="{x:Static res:WpfMMDialogResources.SecondCalcBlkID}" Margin="12,0,0,0" Grid.Row="10" Grid.Column="0" />
    <Label x:Uid="Label_11" Content="{x:Static res:WpfMMDialogResources.DampFactor}" Margin="12,0,0,0" Grid.Row="12" Grid.Column="0" />
    <ComboBox LostFocus="ComboBox_LostFocus_1" Name="CmbFlashBlockID" x:Uid="CmbFlashBlockID" IsEditable="True" Grid.Row="6" Grid.Column="2" HorizontalAlignment="Left" Width="195">
      <ItemsControl.ItemsSource>
        <Binding Path="FlashBlockComboListID" />
      </ItemsControl.ItemsSource>
      <Selector.SelectedValue>
        <Binding Path="SelectedFlashBlockID" Mode="TwoWay" />
      </Selector.SelectedValue>
      <ComboBox.Text>
        <Binding Path="FlashBlockID" Mode="TwoWay" />
      </ComboBox.Text>
      <UIElement.IsEnabled>
        <Binding Path="IsEableFLASHID" />
      </UIElement.IsEnabled>
    </ComboBox>
    <TextBox LostFocus="TextBox_LostFocus" x:Uid="TextBox_2" Grid.Row="8" Grid.Column="2" HorizontalAlignment="Left" Width="195" CharacterCasing="Upper">
      <TextBox.Text>
        <Binding Path="FirstblockID" Mode="TwoWay" />
      </TextBox.Text>
      <UIElement.IsEnabled>
        <Binding Path="IsEableCALCULATOR1ID" />
      </UIElement.IsEnabled>
    </TextBox>
    <TextBox LostFocus="TextBox_LostFocus_1" x:Uid="TextBox_3" Grid.Row="10" Grid.Column="2" HorizontalAlignment="Left" Width="195" CharacterCasing="Upper">
      <TextBox.Text>
        <Binding Path="SecondblockID" Mode="TwoWay" />
      </TextBox.Text>
      <UIElement.IsEnabled>
        <Binding Path="IsEableCALCULATOR2ID" />
      </UIElement.IsEnabled>
    </TextBox>
    <TextBox x:Uid="TextBox_4" Grid.Row="12" Grid.Column="2" HorizontalAlignment="Left" Width="195">
      <TextBox.Text>
        <Binding Path="Dampingfactor" Mode="TwoWay" />
      </TextBox.Text>
      <UIElement.IsEnabled>
        <Binding Path="IsEableDAMPINGFACTOR" />
      </UIElement.IsEnabled>
    </TextBox>
    <CheckBox x:Uid="CheckBox_1" MinWidth="0" Margin="12,0,0,0" Content="{x:Static res:WpfMMDialogResources.MoveToHierBlk}" Grid.Row="14" Grid.Column="0">
      <ToggleButton.IsChecked>
        <Binding Path="IsMoveToChecked" Mode="TwoWay" />
      </ToggleButton.IsChecked>
      <UIElement.IsEnabled>
        <Binding Path="IsEableMoveTo" />
      </UIElement.IsEnabled>
    </CheckBox>
    <ComboBox LostFocus="ComboBox_LostFocus_2" Name="CmbMoveToHierarchy" x:Uid="CmbMoveToHierarchy" IsEditable="True" Grid.Row="14" Grid.Column="2" HorizontalAlignment="Left" Width="195">
      <ItemsControl.ItemsSource>
        <Binding Path="MoveToComboListBlock" />
      </ItemsControl.ItemsSource>
      <ComboBox.Text>
        <Binding Path="MoveToBlock" Mode="TwoWay" />
      </ComboBox.Text>
      <Selector.SelectedValue>
        <Binding Path="SelectedMoveToBlock" Mode="TwoWay" />
      </Selector.SelectedValue>
      <UIElement.IsEnabled>
        <Binding Path="IsEableHIERID" />
      </UIElement.IsEnabled>
    </ComboBox>
    <CheckBox x:Uid="CheckBox_2" MinWidth="0" Margin="12,0,0,0" Content="{x:Static res:WpfMMDialogResources.MaintainLinkToBlk}" Grid.Row="16" Grid.ColumnSpan="3">
      <ToggleButton.IsChecked>
        <Binding Path="IsLinkToChecked" Mode="TwoWay" />
      </ToggleButton.IsChecked>
    </CheckBox>
    <StackPanel x:Uid="StackPanel_1" Grid.Row="18" Grid.Column="0" Grid.ColumnSpan="3" Orientation="Horizontal" HorizontalAlignment="Center">
      <Button x:Uid="Button_2" IsDefault="True" Content="{x:Static res:WpfMMDialogResources.Ok}" Margin="{StaticResource AspenHorizontalRelativeControlMargin}">
        <ButtonBase.Command>
          <Binding Path="CommandOnOK" />
        </ButtonBase.Command>
      </Button>
      <Button x:Uid="Button_3" IsCancel="True" Content="{x:Static res:WpfMMDialogResources.Cancel}" Margin="{StaticResource AspenHorizontalRelativeControlMargin}">
        <ButtonBase.Command>
          <Binding Path="CommandOnCancel" />
        </ButtonBase.Command>
      </Button>
      <Button x:Uid="Button_4" Command="ApplicationCommands.Help" Content="{x:Static res:WpfMMDialogResources.Help}" Margin="{StaticResource AspenNoMargin}" />
    </StackPanel>
  </Grid>
</mmd:MMDialog>
