<?xml version='1.0' encoding='utf-8'?>
<Window x:Class="AspenTech.AspenPlus.MMDialogs.MoveToDlg" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:local="clr-namespace:AspenTech.AspenPlus.MMDialogs" xmlns:mm="clr-namespace:AspenTech.AspenPlus.MMControls;assembly=AspenTech.AspenPlus.MMControls" xmlns:res="clr-namespace:AspenTech.AspenPlus.Localization;assembly=AspenTech.AspenPlus.Localization" x:Uid="Window_1" mm:MMHelp.HelpFile="gendbhlp.chm" mm:MMHelp.HelpId="101" ResizeMode="NoResize" Title="{x:Static res:WpfMMDialogResources.StrMoveToCap}" WindowStartupLocation="CenterScreen" ShowInTaskbar="False" SizeToContent="WidthAndHeight">
  <FrameworkElement.Resources>
    <ResourceDictionary>
      <local:RadioBoolToIntConverter x:Key="RadioSelectedConverter" x:Uid="local_RadioBoolToIntConverter_1" />
    </ResourceDictionary>
  </FrameworkElement.Resources>
  <DockPanel x:Uid="DockPanel_1" LastChildFill="True" Margin="{StaticResource AspenDialogOuterMargin}">
    <StackPanel x:Uid="StackPanel_1" DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
      <Button Click="BtnOK_Click" Name="button1" x:Uid="button1" Content="{x:Static res:WpfMMDialogResources.Ok}" Margin="{StaticResource AspenHorizontalRelativeControlMargin}" />
      <Button Name="button2" x:Uid="button2" Content="{x:Static res:WpfMMDialogResources.Cancel}" IsCancel="True" Margin="{StaticResource AspenNoMargin}" />
    </StackPanel>
    <StackPanel x:Uid="StackPanel_2" Orientation="Vertical" Margin="{StaticResource AspenVerticalRelativeControlMargin}">
      <DockPanel x:Uid="DockPanel_2" LastChildFill="True" Margin="{StaticResource AspenVerticalRelativeControlMargin}">
        <RadioButton Name="Rd1" x:Uid="Rd1" DockPanel.Dock="Left" Content="{x:Static res:WpfMMDialogResources.CreateNewHier}" Margin="{StaticResource AspenHorizontalRelativeControlMargin}" mm:MMHelp.HelpFile="gendbhlp.chm" mm:MMHelp.HelpId="101">
          <ToggleButton.IsChecked>
            <Binding Path="NRadioSelected" Converter="{StaticResource RadioSelectedConverter}" ConverterParameter="1" />
          </ToggleButton.IsChecked>
        </RadioButton>
        <TextBox KeyDown="TextBox_KeyDown" Name="text1" x:Uid="text1" Margin="{StaticResource AspenNoMargin}" Width="100" mm:MMHelp.HelpFile="gendbhlp.chm" mm:MMHelp.HelpId="102" CharacterCasing="Upper">
          <UIElement.IsEnabled>
            <Binding ElementName="Rd1" Path="IsChecked" />
          </UIElement.IsEnabled>
          <TextBox.Text>
            <Binding Path="StrNodeValue" />
          </TextBox.Text>
        </TextBox>
      </DockPanel>
      <RadioButton Name="Rd2" x:Uid="Rd2" Content="{x:Static res:WpfMMDialogResources.MoveToHier}" Margin="{StaticResource AspenVerticalRelativeControlMargin}" mm:MMHelp.HelpFile="gendbhlp.chm" mm:MMHelp.HelpId="103">
        <UIElement.IsEnabled>
          <Binding Path="BCanEnableRadio2" />
        </UIElement.IsEnabled>
        <ToggleButton.IsChecked>
          <Binding Path="NRadioSelected" Converter="{StaticResource RadioSelectedConverter}" ConverterParameter="0" />
        </ToggleButton.IsChecked>
      </RadioButton>
      <ComboBox Loaded="OnComboBoxLoaded" Name="Combox1" x:Uid="Combox1" VerticalAlignment="Top" DisplayMemberPath="SelectedValue.HierarchyID" Margin="{StaticResource AspenCommonIndentWithBottomMargin}" HorizontalAlignment="Stretch" mm:MMHelp.HelpFile="gendbhlp.chm" mm:MMHelp.HelpId="104">
        <UIElement.IsEnabled>
          <Binding ElementName="Rd2" Path="IsChecked" />
        </UIElement.IsEnabled>
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate x:Uid="ItemsPanelTemplate_1">
            <StackPanel x:Uid="StackPanel_3" Orientation="Vertical" IsItemsHost="True" />
          </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ComboBoxItem x:Uid="ComboBoxItem_1" HorizontalContentAlignment="Stretch" IsSelected="True">
          <TreeView Name="tree1" x:Uid="tree1">
            <ItemsControl.ItemsSource>
              <Binding Path="RootNodes" />
            </ItemsControl.ItemsSource>
            <TreeView.SelectedValuePath>
              <Binding Path="Name" />
            </TreeView.SelectedValuePath>
            <ItemsControl.ItemContainerStyle>
              <Style x:Uid="Style_1" TargetType="{x:Type TreeViewItem}">
                <Setter x:Uid="Setter_1" Property="TreeViewItem.IsExpanded">
                  <Setter.Value>
                    <Binding Path="IsExpanded" Mode="TwoWay" />
                  </Setter.Value>
                </Setter>
                <Setter x:Uid="Setter_2" Property="TreeViewItem.IsSelected">
                  <Setter.Value>
                    <Binding Path="IsSelected" Mode="TwoWay" />
                  </Setter.Value>
                </Setter>
                <Setter x:Uid="Setter_3" Property="TextElement.FontWeight" Value="Normal" />
                <Style.Triggers>
                  <Trigger x:Uid="Trigger_1" Property="TreeViewItem.IsSelected" Value="True">
                    <Setter x:Uid="Setter_4" Property="TextElement.FontWeight" Value="Bold" />
                  </Trigger>
                </Style.Triggers>
              </Style>
            </ItemsControl.ItemContainerStyle>
            <ItemsControl.ItemTemplate>
              <HierarchicalDataTemplate x:Uid="HierarchicalDataTemplate_1">
                <HierarchicalDataTemplate.ItemsSource>
                  <Binding Path="Children" />
                </HierarchicalDataTemplate.ItemsSource>
                <TextBlock x:Uid="TextBlock_1">
                  <TextBlock.Text>
                    <Binding Path="Name" />
                  </TextBlock.Text>
                </TextBlock>
              </HierarchicalDataTemplate>
            </ItemsControl.ItemTemplate>
          </TreeView>
        </ComboBoxItem>
      </ComboBox>
      <RadioButton Name="Rd3" x:Uid="Rd3" Content="{x:Static res:WpfMMDialogResources.ExtractHierContentDel}" Margin="{StaticResource AspenVerticalRelativeControlMargin}" mm:MMHelp.HelpFile="gendbhlp.chm" mm:MMHelp.HelpId="105">
        <UIElement.Visibility>
          <Binding Path="VisibilityRadio3" />
        </UIElement.Visibility>
        <ToggleButton.IsChecked>
          <Binding Path="NRadioSelected" Converter="{StaticResource RadioSelectedConverter}" ConverterParameter="2" />
        </ToggleButton.IsChecked>
      </RadioButton>
      <CheckBox Name="check1" x:Uid="check1" MinWidth="0" Content="{x:Static res:WpfMMDialogResources.ShowAdvSelDlg}" Margin="{StaticResource AspenVerticalRelativeControlMargin}" mm:MMHelp.HelpFile="gendbhlp.chm" mm:MMHelp.HelpId="106">
        <UIElement.Visibility>
          <Binding Path="VisibilityCheckBox" />
        </UIElement.Visibility>
        <ToggleButton.IsChecked>
          <Binding Path="IsCheckBoxChecked" />
        </ToggleButton.IsChecked>
        <UIElement.IsEnabled>
          <Binding Path="IsCheckBoxEnable" />
        </UIElement.IsEnabled>
      </CheckBox>
    </StackPanel>
  </DockPanel>
</Window>
