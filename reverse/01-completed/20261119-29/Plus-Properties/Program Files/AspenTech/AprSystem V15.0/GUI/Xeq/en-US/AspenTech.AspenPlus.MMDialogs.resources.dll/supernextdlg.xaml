<?xml version='1.0' encoding='utf-8'?>
<Window x:Class="AspenTech.AspenPlus.MMDialogs.SuperNextDlg" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:local="clr-namespace:AspenTech.AspenPlus.MMDialogs" xmlns:res="clr-namespace:AspenTech.AspenPlus.Localization;assembly=AspenTech.AspenPlus.Localization" xmlns:mm="clr-namespace:AspenTech.AspenPlus.MMControls;assembly=AspenTech.AspenPlus.MMControls" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:atSupport="http://schemas.aspentech.com/xaml/presentation/visualisation/support" xmlns:aes="http://schemas.aspentech.com/xaml/presentation/engineering" Name="WinSuperNext" x:Uid="WinSuperNext" mm:MMInContextGuidanceButton.UsedInTemplate="True" ResizeMode="NoResize" WindowStartupLocation="CenterScreen" SizeToContent="WidthAndHeight" ShowInTaskbar="False" Style="{StaticResource MMDialogStyle}">
  <mm:MMHelp.HelpFile>
    <Binding Path="HelpFile" FallbackValue="gendbhlp.chm" />
  </mm:MMHelp.HelpFile>
  <mm:MMHelp.HelpId>
    <Binding Path="HelpID" />
  </mm:MMHelp.HelpId>
  <FrameworkElement.Resources>
    <ResourceDictionary x:Uid="ResourceDictionary_1">
      <ResourceDictionary.MergedDictionaries>
        <atSupport:AspenCommonResources x:Uid="atSupport_AspenCommonResources_1" />
        <atSupport:AspenCommonProperties x:Uid="atSupport_AspenCommonProperties_1" />
        <atSupport:AspenCommonStyles x:Uid="atSupport_AspenCommonStyles_1" />
        <atSupport:AspenDefaultStyles x:Uid="atSupport_AspenDefaultStyles_1" />
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </FrameworkElement.Resources>
  <DockPanel x:Uid="DockPanel_1" LastChildFill="True" Margin="{StaticResource AspenDialogOuterMargin}">
    <StackPanel x:Uid="StackPanel_1" Orientation="Vertical" DockPanel.Dock="Top" Margin="{StaticResource AspenVerticalRelativeControlMargin}">
      <DockPanel x:Uid="DockPanel_2" LastChildFill="True">
        <Label Name="label1" x:Uid="label1" Margin="{StaticResource AspenVerticalRelativeControlMargin}" AllowDrop="False" Foreground="#FF000000">
          <Control.BorderBrush>
            <x:Null />
          </Control.BorderBrush>
        </Label>
      </DockPanel>
      <aes:AesGroupBox Name="AesGroupBox" x:Uid="AesGroupBox" Margin="{StaticResource AspenVerticalRelativeControlMargin}">
        <StackPanel Name="stackRadios" x:Uid="stackRadios">
          <RadioButton GotFocus="Rd_GotFocus" Name="Rd0" x:Uid="Rd0" DockPanel.Dock="Top" Margin="{StaticResource AspenVerticalRelativeControlMargin}" />
          <RadioButton GotFocus="Rd_GotFocus" Name="Rd1" x:Uid="Rd1" DockPanel.Dock="Top" Margin="{StaticResource AspenVerticalRelativeControlMargin}" />
          <RadioButton GotFocus="Rd_GotFocus" Name="Rd2" x:Uid="Rd2" DockPanel.Dock="Top" Margin="{StaticResource AspenVerticalRelativeControlMargin}" />
          <RadioButton GotFocus="Rd_GotFocus" Name="Rd3" x:Uid="Rd3" DockPanel.Dock="Top" Margin="{StaticResource AspenVerticalRelativeControlMargin}" />
          <RadioButton GotFocus="Rd_GotFocus" Name="Rd4" x:Uid="Rd4" DockPanel.Dock="Top" Margin="{StaticResource AspenVerticalRelativeControlMargin}" />
          <RadioButton GotFocus="Rd_GotFocus" Name="Rd5" x:Uid="Rd5" DockPanel.Dock="Top" Margin="{StaticResource AspenVerticalRelativeControlMargin}" />
          <RadioButton GotFocus="Rd_GotFocus" Name="Rd6" x:Uid="Rd6" DockPanel.Dock="Top" Margin="{StaticResource AspenVerticalRelativeControlMargin}" />
        </StackPanel>
      </aes:AesGroupBox>
    </StackPanel>
    <StackPanel x:Uid="StackPanel_2" DockPanel.Dock="Top" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
      <Button Click="BtnOK_Click" Name="OK" x:Uid="OK" Content="{x:Static res:WpfSimdllResources.BtnOk}" MinWidth="96" Margin="{StaticResource AspenHorizontalRelativeControlMargin}" IsDefault="True" />
      <Button Click="Cancel_Click" Name="Cancel" x:Uid="Cancel" Content="{x:Static res:WpfSimdllResources.BtnCancel}" Margin="{StaticResource AspenNoMargin}" IsCancel="True" MinWidth="96" />
    </StackPanel>
    <StackPanel Margin="0,10,0,0">
      <CheckBox Checked="ChkBoxDontShow_CheckedChanged" Unchecked="ChkBoxDontShow_UnCheckedChanged" x:Name="ChkBox_DontShow" x:Uid="ChkBox_DontShow" MinWidth="0" Foreground="#FF000000" HorizontalAlignment="Left" Content="{x:Static res:WpfSimdllResources.CheckBox_DontShowAgain}">
        <ToggleButton.IsChecked>
          <Binding Path="DontShowMessageAgain" />
        </ToggleButton.IsChecked>
      </CheckBox>
    </StackPanel>
    <Label Name="LblTitle" x:Uid="LblTitle" Height="0">
      <ContentControl.Content>
        <Binding ElementName="WinSuperNext" Path="Title" />
      </ContentControl.Content>
    </Label>
  </DockPanel>
</Window>
