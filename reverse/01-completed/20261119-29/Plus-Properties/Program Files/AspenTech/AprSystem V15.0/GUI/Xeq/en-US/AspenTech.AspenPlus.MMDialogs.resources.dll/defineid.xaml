<?xml version='1.0' encoding='utf-8'?>
<Window x:Class="AspenTech.AspenPlus.MMDialogs.DefineID" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" x:Uid="Window_1" ResizeMode="NoResize" Title="Dialog" ShowInTaskbar="False" SizeToContent="WidthAndHeight" Style="{StaticResource MMDialogStyle}">
  <StackPanel x:Uid="StackPanel_1" Height="459">
    <FrameworkElement.Resources>
      <ResourceDictionary>
        <Style x:Key="{x:Type Button}" x:Uid="Style_1" TargetType="{x:Type Button}">
          <Setter x:Uid="Setter_1" Property="FrameworkElement.Height" Value="27" />
          <Setter x:Uid="Setter_2" Property="FrameworkElement.Margin" Value="5,5" />
        </Style>
      </ResourceDictionary>
    </FrameworkElement.Resources>
    <Label x:Uid="Label_1" Content="Objects With ID" Height="28" />
    <StackPanel x:Uid="StackPanel_2" HorizontalAlignment="Left" Height="210" Width="504" Orientation="Horizontal">
      <ListView x:Uid="ListView_1" Width="399" VerticalAlignment="Stretch" />
      <UniformGrid x:Uid="UniformGrid_1" Rows="5" Margin="5,5" Width="93">
        <Button x:Uid="Button_1" Content="Edit ID" Width="80" />
        <Button x:Uid="Button_2" Content="Add Prefix" Width="80" />
        <Button x:Uid="Button_3" Content="Add Suffix" Width="80" />
        <Button x:Uid="Button_4" Content="Remove" Width="80" />
        <Button x:Uid="Button_5" Content="Undo" Width="80" />
      </UniformGrid>
    </StackPanel>
    <Label x:Uid="Label_2" Content="Parameter Labels" Height="28" />
    <StackPanel x:Uid="StackPanel_3" HorizontalAlignment="Left" Height="154" Width="504" Orientation="Horizontal">
      <ListView x:Uid="ListView_2" Width="399" VerticalAlignment="Stretch" />
      <UniformGrid x:Uid="UniformGrid_2" Rows="1" Margin="5,5" Width="93">
        <Button x:Uid="Button_6" Content="Edit Label" Width="80" Margin="5,5" VerticalAlignment="Top" Height="27" />
      </UniformGrid>
    </StackPanel>
    <UniformGrid x:Uid="UniformGrid_3" Columns="3" HorizontalAlignment="Right">
      <Button x:Uid="Button_7" Grid.Column="4" Content="OK" Width="80" />
      <Button x:Uid="Button_8" Content="Cancel" Width="80" />
      <Button x:Uid="Button_9" Content="Help" Width="80" />
    </UniformGrid>
  </StackPanel>
</Window>
