<?xml version='1.0' encoding='utf-8'?>
<Window x:Class="AspenTech.AspenPlus.MMDialogs.DistillationSynthesis" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:res="clr-namespace:AspenTech.AspenPlus.Localization;assembly=AspenTech.AspenPlus.Localization" xmlns:mm="clr-namespace:AspenTech.AspenPlus.MMControls;assembly=AspenTech.AspenPlus.MMControls" x:Uid="Window_1" mm:MMHelp.HelpId="701" ShowInTaskbar="False" Title="{x:Static res:WpfMMDialogResources.DistillationSynthesis}" ResizeMode="NoResize" SizeToContent="WidthAndHeight" Style="{StaticResource MMDialogStyle}">
  <mm:MMHelp.HelpFile>
    <Binding Path="HelpFile" FallbackValue="userguide2.chm" />
  </mm:MMHelp.HelpFile>
  <StackPanel x:Uid="StackPanel_1" Margin="{StaticResource AspenDialogOuterMargin}">
    <TextBlock x:Uid="TextBlock_1" HorizontalAlignment="Left" Margin="{StaticResource AspenVerticalRelativeControlMargin}" Text="{x:Static res:WpfMMDialogResources.DistillationSynthesisTip}" />
    <StackPanel x:Uid="StackPanel_2" HorizontalAlignment="Center" Margin="{StaticResource AspenVerticalRelativeControlMargin}">
      <Button Name="BtnLm" x:Uid="BtnLm" Margin="{StaticResource AspenVerticalRelativeControlMargin}" HorizontalAlignment="Center" Command="ApplicationCommands.Help" Content="{x:Static res:WpfMMDialogResources.AboutDistillationSynthesis}" />
      <Button Click="BtnFa_Click" Name="BtnFa" x:Uid="BtnFa" Margin="{StaticResource AspenVerticalRelativeControlMargin}" Content="{x:Static res:WpfMMDialogResources.FindAzeotropes}" />
      <Button Click="BtnUds_Click" Name="BtnUds" x:Uid="BtnUds" Margin="{StaticResource AspenVerticalRelativeControlMargin}" Content="{x:Static res:WpfMMDialogResources.DistillationSynthesisMap}" />
      <Button Click="BtnCta_Click" Name="BtnCta" x:Uid="BtnCta" Margin="{StaticResource AspenVerticalRelativeControlMargin}" Content="{x:Static res:WpfMMDialogResources.ContinueToAPlus}" />
    </StackPanel>
    <CheckBox Checked="ChkDns_Checked" Unchecked="ChkDns_Checked" Name="ChkDns" x:Uid="ChkDns" MinWidth="0" Content="{x:Static res:WpfMMDialogResources.DoNotShowRecommendation}" />
  </StackPanel>
</Window>
