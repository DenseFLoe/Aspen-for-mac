<?xml version='1.0' encoding='utf-8'?>
<mmd:MMDialog x:Class="AspenTech.AspenPlus.MMDialogs.MarkBoxDlg" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:mmd="clr-namespace:AspenTech.AspenPlus.MMDialogs" x:Uid="mmd_MMDialog_1" ResizeMode="NoResize" Title="Dialog" ShowInTaskbar="False" MinHeight="300" MinWidth="430" SizeToContent="WidthAndHeight" Style="{StaticResource MMDialogStyle}">
  <Grid x:Uid="Grid_1" Margin="{DynamicResource AspenDialogOuterMargin}">
    <Grid.RowDefinitions>
      <RowDefinition x:Uid="RowDefinition_1" Height="Auto" />
      <RowDefinition x:Uid="RowDefinition_2" Height="Auto" />
    </Grid.RowDefinitions>
    <Grid x:Uid="Grid_2" Grid.Row="0" Margin="{DynamicResource AspenVerticalIrrelativeControlMargin}">
      <Grid.ColumnDefinitions>
        <ColumnDefinition x:Uid="ColumnDefinition_1" Width="Auto" />
        <ColumnDefinition x:Uid="ColumnDefinition_2" Width="Auto" />
      </Grid.ColumnDefinitions>
      <StackPanel x:Uid="StackPanel_1" Grid.Column="0" Margin="{DynamicResource AspenHorizontalRelativeControlMargin}">
        <ListView x:Name="lvMarklist" x:Uid="lvMarklist" Height="200" Width="300" Margin="{DynamicResource AspenVerticalRelativeControlMargin}">
          <ListView.View>
            <GridView x:Uid="GridView_1">
              <GridViewColumn x:Uid="GridViewColumn_1" Header="Select Objects to Remove" Width="300">
                <GridViewColumn.DisplayMemberBinding>
                  <Binding Path="Name" />
                </GridViewColumn.DisplayMemberBinding>
              </GridViewColumn>
            </GridView>
          </ListView.View>
        </ListView>
        <UniformGrid x:Uid="UniformGrid_1" Columns="2" HorizontalAlignment="Center">
          <Button Name="btnDependencies" x:Uid="btnDependencies">Dependencies</Button>
          <Button Name="btnReferences" x:Uid="btnReferences">References</Button>
        </UniformGrid>
      </StackPanel>
      <StackPanel x:Uid="StackPanel_2" Orientation="Vertical" Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Center">
        <Button Name="btnUndo" x:Uid="btnUndo" Grid.Row="0" Margin="{DynamicResource AspenVerticalRelativeControlMargin}">Undo</Button>
        <Button Name="btnRemove" x:Uid="btnRemove" Grid.Row="1" Margin="{DynamicResource AspenVerticalRelativeControlMargin}">Remove</Button>
      </StackPanel>
    </Grid>
    <UniformGrid x:Uid="UniformGrid_2" Grid.Row="1" Columns="2" HorizontalAlignment="Center" VerticalAlignment="Bottom">
      <Button Name="btnOK" x:Uid="btnOK" Content="OK" IsDefault="True" Margin="{StaticResource AspenHorizontalRelativeControlMargin}">
        <ButtonBase.Command>
          <Binding Path="CommandOnOK" />
        </ButtonBase.Command>
        <ButtonBase.CommandParameter>
          <Binding ElementName="findPropertyWindow" />
        </ButtonBase.CommandParameter>
      </Button>
      <Button Name="btnCancel" x:Uid="btnCancel" Content="Cancel" Margin="{StaticResource AspenHorizontalRelativeControlMargin}">
        <ButtonBase.Command>
          <Binding Path="CommandOnCancel" />
        </ButtonBase.Command>
        <ButtonBase.CommandParameter>
          <Binding ElementName="findPropertyWindow" />
        </ButtonBase.CommandParameter>
      </Button>
    </UniformGrid>
  </Grid>
</mmd:MMDialog>
