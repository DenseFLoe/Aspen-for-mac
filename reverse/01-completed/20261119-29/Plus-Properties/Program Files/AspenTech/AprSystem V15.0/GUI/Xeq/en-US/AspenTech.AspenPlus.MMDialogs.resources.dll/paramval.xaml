<?xml version='1.0' encoding='utf-8'?>
<mmd:MMDialog x:Class="AspenTech.AspenPlus.MMDialogs.ParamVal" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:mmd="clr-namespace:AspenTech.AspenPlus.MMDialogs" xmlns:mm="clr-namespace:AspenTech.AspenPlus.MMControls;assembly=AspenTech.AspenPlus.MMControls" xmlns:res="clr-namespace:AspenTech.AspenPlus.Localization;assembly=AspenTech.AspenPlus.Localization" x:Uid="mmd_MMDialog_1" mm:MMHelp.HelpId="91" ShowInTaskbar="False" ResizeMode="NoResize" Title="{x:Static res:WpfMMDialogResources.ParameterValues}" SizeToContent="WidthAndHeight" Style="{StaticResource MMDialogStyle}">
  <mm:MMHelp.HelpFile>
    <Binding Path="HelpFile" FallbackValue="gendbhlp.chm" />
  </mm:MMHelp.HelpFile>
  <StackPanel x:Uid="StackPanel_1" Margin="{StaticResource AspenDialogOuterMargin}">
    <Label x:Uid="Label_1" Content="{x:Static res:WpfMMDialogResources.SelectParaToEdit}" />
    <StackPanel x:Uid="StackPanel_2" Orientation="Horizontal">
      <DataGrid SelectionChanged="NameGrid_SelectionChanged" MouseDoubleClick="NameGrid_MouseDoubleClick" Name="NameGrid" x:Uid="NameGrid" Grid.Column="0" Height="200" Width="600" CanUserAddRows="False" AutoGenerateColumns="False" Margin="{StaticResource AspenHorizontalRelativeControlMargin}">
        <ItemsControl.ItemsSource>
          <Binding Path="AllParamVals" />
        </ItemsControl.ItemsSource>
        <FrameworkElement.Resources>
          <ResourceDictionary>
            <Style x:Key="{x:Type DataGridCell}" x:Uid="Style_1" TargetType="{x:Type DataGridCell}">
              <Style.Triggers>
                <Trigger x:Uid="Trigger_1" Property="DataGridCell.IsSelected" Value="True">
                  <Setter x:Uid="Setter_1" Property="Panel.Background" Value="{StaticResource AspenActiveItemBackgroundBrush}" />
                  <Setter x:Uid="Setter_2" Property="TextElement.Foreground" Value="#FF0000FF" />
                </Trigger>
              </Style.Triggers>
            </Style>
          </ResourceDictionary>
        </FrameworkElement.Resources>
        <DataGrid.Columns>
          <DataGridTextColumn x:Uid="DataGridTextColumn_1" IsReadOnly="True" Width="*" Header="{x:Static res:WpfMMDialogResources.Parameter}">
            <DataGridBoundColumn.Binding>
              <Binding Path="OldName" />
            </DataGridBoundColumn.Binding>
          </DataGridTextColumn>
          <DataGridTextColumn x:Uid="DataGridTextColumn_2" IsReadOnly="True" Width="Auto" Header="{x:Static res:WpfMMDialogResources.MaxLength}">
            <DataGridBoundColumn.Binding>
              <Binding Path="NewName" />
            </DataGridBoundColumn.Binding>
          </DataGridTextColumn>
          <DataGridTextColumn x:Uid="DataGridTextColumn_3" IsReadOnly="True" Width="*" Header="{x:Static res:WpfMMDialogResources.ParameterValue}">
            <DataGridBoundColumn.Binding>
              <Binding Path="Status" />
            </DataGridBoundColumn.Binding>
          </DataGridTextColumn>
        </DataGrid.Columns>
      </DataGrid>
      <UniformGrid x:Uid="UniformGrid_1" Rows="4" VerticalAlignment="Bottom">
        <Button Click="Button_Click_edit" x:Uid="Button_1" Content="{x:Static res:WpfMMDialogResources.EditValue}" Margin="{StaticResource AspenVerticalRelativeControlMargin}">
          <UIElement.IsEnabled>
            <Binding Path="CanEdit" />
          </UIElement.IsEnabled>
        </Button>
        <Button Click="Button_Click_OK" x:Uid="Button_2" Content="{x:Static res:WpfSimdllResources.BtnOk}" Margin="{StaticResource AspenVerticalRelativeControlMargin}" />
        <Button Click="Button_Click_Cancel" x:Uid="Button_3" Content="{x:Static res:WpfSimdllResources.BtnCancel}" IsCancel="True" Margin="{StaticResource AspenVerticalRelativeControlMargin}" />
        <Button x:Uid="Button_4" Content="{x:Static res:WpfSimdllResources.BtnHelp}" Command="ApplicationCommands.Help" Margin="{StaticResource AspenNoMargin}" />
      </UniformGrid>
    </StackPanel>
  </StackPanel>
</mmd:MMDialog>
