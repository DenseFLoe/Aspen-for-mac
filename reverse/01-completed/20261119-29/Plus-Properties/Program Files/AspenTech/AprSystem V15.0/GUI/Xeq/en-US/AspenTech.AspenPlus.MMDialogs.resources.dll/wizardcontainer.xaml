<?xml version='1.0' encoding='utf-8'?>
<Window x:Class="AspenTech.AspenPlus.MMDialogs.WizardContainer" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:AspenTech.AspenPlus.MMDialogs" xmlns:res="clr-namespace:AspenTech.AspenPlus.Localization;assembly=AspenTech.AspenPlus.Localization" xmlns:mm="http://schemas.aspentech.com/xaml/presentation/aspenplus" x:Name="ctrlWizard" x:Uid="ctrlWizard" SizeToContent="WidthAndHeight" mm:MMHelp.HelpFile="apeoref.chm" mm:MMHelp.HelpId="44" WindowStartupLocation="CenterOwner" ResizeMode="NoResize">
  <Window.Title>
    <Binding Path="current.Title" />
  </Window.Title>
  <Grid x:Uid="Grid_1" Margin="{StaticResource AspenDialogOuterMargin}">
    <Grid.ColumnDefinitions>
      <ColumnDefinition x:Uid="ColumnDefinition_1" Width="Auto" />
    </Grid.ColumnDefinitions>
    <Grid.RowDefinitions>
      <RowDefinition x:Uid="RowDefinition_1" Height="Auto" />
      <RowDefinition x:Uid="RowDefinition_2" Height="Auto" />
    </Grid.RowDefinitions>
    <ContentControl x:Name="WizardContent" x:Uid="WizardContent" Margin="{StaticResource AspenVerticalRelativeControlMargin}" />
    <StackPanel x:Uid="StackPanel_1" Grid.Column="0" Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{StaticResource AspenVerticalRelativeControlMargin}">
      <Button Click="btnPrev_Click" x:Name="btnPrev" x:Uid="btnPrev" Content="{x:Static res:WpfSimdllResources.BtnPrev}" Margin="{StaticResource AspenHorizontalRelativeControlMargin}">
        <UIElement.IsEnabled>
          <Binding Path="CanPrev" />
        </UIElement.IsEnabled>
      </Button>
      <Button Click="btnNext_Click" x:Name="btnNext" x:Uid="btnNext" Content="{x:Static res:WpfSimdllResources.BtnNext}" Margin="{StaticResource AspenHorizontalRelativeControlMargin}">
        <UIElement.IsEnabled>
          <Binding Path="CanNext" />
        </UIElement.IsEnabled>
      </Button>
      <Button Click="btnFinish_Click" x:Name="btnFinish" x:Uid="btnFinish" IsDefault="True" Content="{x:Static res:WpfSimdllResources.BtnFinish}" Margin="{StaticResource AspenHorizontalRelativeControlMargin}">
        <UIElement.IsEnabled>
          <Binding Path="CanFinish" />
        </UIElement.IsEnabled>
      </Button>
      <Button Click="btnCancel_Click" x:Name="btnCancel" x:Uid="btnCancel" IsCancel="True" Content="{x:Static res:WpfSimdllResources.BtnCancel}" Margin="{StaticResource AspenNoMargin}" />
    </StackPanel>
  </Grid>
</Window>
