<?xml version='1.0' encoding='utf-8'?>
<Window x:Class="AspenTech.AspenPlus.MMDialogs.ShowFileDlg" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:res="clr-namespace:AspenTech.AspenPlus.Localization;assembly=AspenTech.AspenPlus.Localization" xmlns:mm="clr-namespace:AspenTech.AspenPlus.MMControls;assembly=AspenTech.AspenPlus.MMControls" x:Uid="Window_1" MinHeight="280" MaxHeight="600" Width="500" ShowInTaskbar="False" WindowStartupLocation="CenterOwner" SizeToContent="Height" ResizeMode="NoResize" mm:MMHelp.HelpFile="apwn" Style="{StaticResource MMDialogStyle}">
  <Window.Title>
    <Binding Path="Title" />
  </Window.Title>
  <mm:MMHelp.HelpId>
    <Binding Path="HelpId" />
  </mm:MMHelp.HelpId>
  <Grid x:Uid="Grid_1" Margin="{StaticResource AspenDialogOuterMargin}">
    <Grid.RowDefinitions>
      <RowDefinition x:Uid="RowDefinition_1" Height="*" />
      <RowDefinition x:Uid="RowDefinition_2" Height="Auto" />
    </Grid.RowDefinitions>
    <TextBox x:Name="txtFileContent" x:Uid="txtFileContent" Grid.Row="0" IsReadOnly="True" Foreground="#FF000000" MinHeight="200" MinWidth="350" ScrollViewer.VerticalScrollBarVisibility="Auto" TextWrapping="Wrap" Margin="{StaticResource AspenVerticalIrrelativeControlMargin}">
      <TextBox.Text>
        <Binding Path="FileContent" />
      </TextBox.Text>
    </TextBox>
    <UniformGrid x:Uid="UniformGrid_1" Grid.Row="1" Columns="3" HorizontalAlignment="Center" Margin="{StaticResource AspenVerticalIrrelativeControlMargin}">
      <UIElement.Visibility>
        <Binding Path="CanCancel" />
      </UIElement.Visibility>
      <Button Click="OnClickOK" Name="btnOK" x:Uid="btnOK" Content="{x:Static res:WpfSimdllResources.BtnOk}" IsDefault="True" Margin="{StaticResource AspenHorizontalRelativeControlMargin}">
        <ButtonBase.Command>
          <Binding Path="CommandOnOK" />
        </ButtonBase.Command>
      </Button>
      <Button Click="OnClickCancel" Name="btnCancel" x:Uid="btnCancel" Content="{x:Static res:WpfSimdllResources.BtnCancel}" IsCancel="True" Margin="{StaticResource AspenHorizontalRelativeControlMargin}">
        <ButtonBase.Command>
          <Binding Path="CommandOnCancel" />
        </ButtonBase.Command>
      </Button>
      <Button Name="btnHelp" x:Uid="btnHelp" Content="{x:Static res:WpfSimdllResources.BtnHelp}" Command="ApplicationCommands.Help" />
    </UniformGrid>
  </Grid>
</Window>
