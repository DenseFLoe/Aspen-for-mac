<?xml version='1.0' encoding='utf-8'?>
<local:MMDialog x:Class="AspenTech.AspenPlus.MMDialogs.DontAskMB" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:AspenTech.AspenPlus.MMDialogs" xmlns:lp="clr-namespace:AspenTech.AspenPlus.Localization;assembly=AspenTech.AspenPlus.Localization" xmlns:atSupport="http://schemas.aspentech.com/xaml/presentation/visualisation/support" x:Uid="local_MMDialog_1" ResizeMode="NoResize" ShowInTaskbar="False" Title="{x:Static lp:WpfMMDialogResources.ProductName}" SizeToContent="WidthAndHeight" Style="{StaticResource MMDialogStyle}">
  <FrameworkElement.Resources>
    <ResourceDictionary x:Uid="ResourceDictionary_1">
      <ResourceDictionary.MergedDictionaries>
        <atSupport:AspenCommonResources />
        <atSupport:AspenCommonProperties x:Uid="atSupport_AspenCommonProperties_1" />
        <atSupport:AspenCommonStyles />
        <atSupport:AspenDefaultStyles />
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </FrameworkElement.Resources>
  <StackPanel x:Uid="StackPanel_1" Margin="{StaticResource AspenDialogOuterMargin}">
    <Label Name="label1" x:Uid="label1" Width="380" Margin="{StaticResource AspenVerticalRelativeControlMargin}">
      <ContentControl.Content>
        <TextBlock x:Uid="TextBlock_1" TextWrapping="Wrap">
          <TextBlock.Text>
            <Binding Path="Message" />
          </TextBlock.Text>
        </TextBlock>
      </ContentControl.Content>
    </Label>
    <CheckBox x:Uid="CheckBox_1" Content="{x:Static lp:WpfMMDialogResources.DontAskAgain}" Foreground="#FF0000FF" MinWidth="0" Margin="{StaticResource AspenVerticalIrrelativeControlMargin}">
      <ToggleButton.IsChecked>
        <Binding Path="DontAskAgain" />
      </ToggleButton.IsChecked>
    </CheckBox>
    <UniformGrid x:Uid="UniformGrid_1" HorizontalAlignment="Center">
      <UniformGrid.Columns>
        <Binding Path="ButtonNumber" />
      </UniformGrid.Columns>
      <Button Click="Button_Click" Name="Button1" x:Uid="Button1" Margin="{StaticResource AspenHorizontalRelativeControlMargin}">
        <ContentControl.Content>
          <Binding Path="Button1Text" />
        </ContentControl.Content>
        <Button.IsDefault>
          <Binding Path="Button1IsDefault" />
        </Button.IsDefault>
      </Button>
      <Button Click="Button_Click" Name="Button2" x:Uid="Button2" Margin="{StaticResource AspenHorizontalRelativeControlMargin}">
        <ContentControl.Content>
          <Binding Path="Button2Text" />
        </ContentControl.Content>
        <Button.IsDefault>
          <Binding Path="Button2IsDefault" />
        </Button.IsDefault>
        <UIElement.Visibility>
          <Binding Path="Button2Enabled" />
        </UIElement.Visibility>
      </Button>
      <Button Click="Button_Click" Name="Button3" x:Uid="Button3" Margin="{StaticResource AspenHorizontalRelativeControlMargin}">
        <ContentControl.Content>
          <Binding Path="Button3Text" />
        </ContentControl.Content>
        <Button.IsDefault>
          <Binding Path="Button3IsDefault" />
        </Button.IsDefault>
        <UIElement.Visibility>
          <Binding Path="Button3Enabled" />
        </UIElement.Visibility>
      </Button>
    </UniformGrid>
  </StackPanel>
</local:MMDialog>
