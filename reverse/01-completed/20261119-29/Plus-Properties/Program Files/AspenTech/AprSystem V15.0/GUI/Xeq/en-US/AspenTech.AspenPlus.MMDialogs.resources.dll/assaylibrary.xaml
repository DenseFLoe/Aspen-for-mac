<?xml version='1.0' encoding='utf-8'?>
<Window x:Class="AspenTech.AspenPlus.MMDialogs.AssayLibrary" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:res="clr-namespace:AspenTech.AspenPlus.Localization;assembly=AspenTech.AspenPlus.Localization" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" x:Uid="Window_1" Title="{x:Static res:WpfMMDialogResources.SelectAssayLib}" ShowInTaskbar="False" WindowStartupLocation="CenterScreen" SizeToContent="WidthAndHeight" ResizeMode="NoResize" WindowStyle="ToolWindow" Style="{StaticResource MMDialogStyle}">
  <StackPanel x:Uid="StackPanel_1" Margin="{StaticResource AspenDialogOuterMargin}">
    <GroupBox x:Uid="GroupBox_1" Header="{x:Static res:WpfMMDialogResources.SelectAssayLib}" Margin="{StaticResource AspenVerticalRelativeControlMargin}">
      <StackPanel x:Uid="StackPanel_2" Margin="{StaticResource AspenVerticalRelativeControlMargin}">
        <RadioButton Checked="Rbtn_OnChecked" Name="RbtnApal" x:Uid="RbtnApal" Margin="{StaticResource AspenVerticalRelativeControlMargin}" Content="{x:Static res:WpfMMDialogResources.APAssayLib}" />
        <RadioButton Checked="Rbtn_OnChecked" Name="RbtnPmal" x:Uid="RbtnPmal" Content="{x:Static res:WpfMMDialogResources.PAAssayLib}" />
      </StackPanel>
    </GroupBox>
    <StackPanel x:Uid="StackPanel_3" Orientation="Horizontal" HorizontalAlignment="Center">
      <Button Click="BtnOK_Click" Name="BtnOK" x:Uid="BtnOK" HorizontalAlignment="Center" Margin="{StaticResource AspenHorizontalRelativeControlMargin}" Content="{x:Static res:WpfMMDialogResources.Ok}" />
      <Button Click="BtnCancel_Click" Name="BtnCancel" x:Uid="BtnCancel" HorizontalAlignment="Center" Content="{x:Static res:WpfMMDialogResources.Cancel}" />
    </StackPanel>
  </StackPanel>
</Window>
