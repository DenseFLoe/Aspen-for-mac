<?xml version='1.0' encoding='utf-8'?>
<Window x:Class="AspenTech.AspenPlus.MMDialogs.IDBoxDlg2" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:mm="clr-namespace:AspenTech.AspenPlus.MMControls;assembly=AspenTech.AspenPlus.MMControls" xmlns:res="clr-namespace:AspenTech.AspenPlus.Localization;assembly=AspenTech.AspenPlus.Localization" x:Uid="Window_1" mm:MMHelp.HelpId="77" ShowInTaskbar="False" Title="{x:Static res:WpfMMDialogResources.EditEOStreamName}" SizeToContent="WidthAndHeight" ResizeMode="NoResize" WindowStartupLocation="CenterOwner" WindowStyle="ToolWindow" Style="{StaticResource MMDialogStyle}">
  <mm:MMHelp.HelpFile>
    <Binding Path="HelpFile" />
  </mm:MMHelp.HelpFile>
  <StackPanel x:Uid="StackPanel_1" Orientation="Vertical" Margin="{StaticResource AspenDialogOuterMargin}">
    <StackPanel x:Uid="StackPanel_2" Orientation="Horizontal" Margin="{StaticResource AspenVerticalRelativeControlMargin}">
      <Label x:Uid="Label_1" Content="{x:Static res:WpfMMDialogResources.NewEOName}" Margin="{StaticResource AspenHorizontalRelativeControlMargin}" />
      <TextBox x:Uid="TextBox_1" Width="200" MaxLength="256">
        <TextBox.Text>
          <Binding Path="NewName" />
        </TextBox.Text>
      </TextBox>
    </StackPanel>
    <UniformGrid x:Uid="UniformGrid_1" Columns="2" HorizontalAlignment="Center" Margin="{StaticResource AspenNoMargin}">
      <Button Click="BtnOk_Click" Name="BtnOk" x:Uid="BtnOk" Margin="{StaticResource AspenHorizontalRelativeControlMargin}" Content="{x:Static res:WpfSimdllResources.BtnOk}" />
      <Button Click="BtnCancel_Click" Name="BtnCancel" x:Uid="BtnCancel" IsCancel="True" Margin="{StaticResource AspenNoMargin}" Content="{x:Static res:WpfSimdllResources.BtnCancel}" />
    </UniformGrid>
  </StackPanel>
</Window>
