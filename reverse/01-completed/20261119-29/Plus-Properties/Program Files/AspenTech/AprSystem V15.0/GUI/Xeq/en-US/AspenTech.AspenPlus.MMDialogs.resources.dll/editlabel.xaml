<?xml version='1.0' encoding='utf-8'?>
<Window x:Class="AspenTech.AspenPlus.MMDialogs.EditLabel" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:res="clr-namespace:AspenTech.AspenPlus.Localization;assembly=AspenTech.AspenPlus.Localization" xmlns:atSupport="http://schemas.aspentech.com/xaml/presentation/visualisation/support" Loaded="DlgBox_Loaded" x:Name="root" x:Uid="root" WindowState="Normal" ShowInTaskbar="False" WindowStartupLocation="CenterOwner" MinWidth="320" ResizeMode="NoResize" Title="{x:Static res:WpfMMDialogResources.EditLabel}" SizeToContent="WidthAndHeight" Style="{StaticResource MMDialogStyle}">
  <FrameworkElement.Resources>
    <ResourceDictionary x:Uid="ResourceDictionary_1">
      <ResourceDictionary.MergedDictionaries>
        <atSupport:AspenCommonResources />
        <atSupport:AspenCommonProperties x:Uid="atSupport_AspenCommonProperties_1" />
        <atSupport:AspenCommonStyles />
        <atSupport:AspenDefaultStyles />
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </FrameworkElement.Resources>
  <StackPanel x:Uid="StackPanel_1" Margin="{StaticResource AspenDialogOuterMargin}">
    <Label x:Uid="Label_1" Content="{x:Static res:WpfMMDialogResources.EditLabelTip}" Margin="{StaticResource AspenVerticalIrrelativeControlMargin}" />
    <TextBox TextChanged="labelEditBox_TextChanged" Name="labelEditBox" x:Uid="labelEditBox" Margin="{StaticResource AspenVerticalIrrelativeControlMargin}" />
    <UniformGrid x:Uid="UniformGrid_1" Columns="2" HorizontalAlignment="Center">
      <Button Click="btnOK_Click" Name="btnOK" x:Uid="btnOK" Content="{x:Static res:WpfMMDialogResources.Ok}" IsDefault="True" Margin="{StaticResource AspenHorizontalRelativeControlMargin}">
        <UIElement.IsEnabled>
          <Binding Path="IsOKEnable" ElementName="root" Mode="OneWay" />
        </UIElement.IsEnabled>
      </Button>
      <Button Name="btnCancel" x:Uid="btnCancel" Content="{x:Static res:WpfMMDialogResources.Cancel}" IsCancel="True" Margin="{StaticResource AspenNoMargin}" />
    </UniformGrid>
  </StackPanel>
</Window>
