<?xml version='1.0' encoding='utf-8'?>
<Window x:Class="AspenTech.AspenPlus.MMDialogs.ExportHierarchyTree" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:AspenTech.AspenPlus.MMDialogs" xmlns:res="clr-namespace:AspenTech.AspenPlus.Localization;assembly=AspenTech.AspenPlus.Localization" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:mm="http://schemas.aspentech.com/xaml/presentation/aspenplus" x:Uid="Window_1" ShowInTaskbar="False" ResizeMode="NoResize" MinWidth="560" SizeToContent="WidthAndHeight" Style="{StaticResource MMDialogStyle}">
  <mm:MMHelp.HelpFile>
    <Binding Path="HelpFile" FallbackValue="userguide1.chm" />
  </mm:MMHelp.HelpFile>
  <mm:MMHelp.HelpId>
    <Binding Path="HelpId" FallbackValue="1328" />
  </mm:MMHelp.HelpId>
  <Window.Title>
    <Binding Path="WindowTitle" />
  </Window.Title>
  <StackPanel x:Uid="StackPanel_1" Orientation="Vertical" Margin="{StaticResource AspenDialogOuterMargin}">
    <StackPanel Orientation="Horizontal">
      <Label Name="LblTesting" Visibility="Hidden" x:Uid="LblTesting">
        <ContentControl.Content>
          <Binding Path="WindowTitle" />
        </ContentControl.Content>
      </Label>
      <Label Width="48" Visibility="Hidden" x:Uid="Label_1" />
    </StackPanel>
    <TreeView x:Name="theTreeView" x:Uid="theTreeView" Height="300" HorizontalAlignment="Stretch" VerticalAlignment="Top" Margin="{StaticResource AspenVerticalRelativeControlMargin}">
      <ItemsControl.ItemsSource>
        <Binding Path="RootNodes" Mode="OneWay" />
      </ItemsControl.ItemsSource>
      <FrameworkElement.Resources>
        <ResourceDictionary>
          <HierarchicalDataTemplate x:Uid="HierarchicalDataTemplate_1" DataType="{x:Type local:ExportHierarchyTreeViewModel}">
            <HierarchicalDataTemplate.ItemsSource>
              <Binding Path="Children" Mode="OneWay" />
            </HierarchicalDataTemplate.ItemsSource>
            <CheckBox x:Uid="CheckBox_1" VerticalAlignment="Center" MinWidth="0">
              <ToggleButton.IsThreeState>
                <Binding Path="IsThreeState" Mode="OneWay" />
              </ToggleButton.IsThreeState>
              <FrameworkElement.Tag>
                <Binding Mode="OneWay" />
              </FrameworkElement.Tag>
              <ToggleButton.IsChecked>
                <Binding Path="IsChecked" Mode="TwoWay" />
              </ToggleButton.IsChecked>
              <UIElement.IsEnabled>
                <Binding Path="IsEnabled" Mode="OneWay" />
              </UIElement.IsEnabled>
              <ContentControl.Content>
                <Binding Path="DisplayName" Mode="OneWay" />
              </ContentControl.Content>
            </CheckBox>
          </HierarchicalDataTemplate>
        </ResourceDictionary>
      </FrameworkElement.Resources>
      <ItemsControl.ItemContainerStyle>
        <Style x:Uid="Style_1" TargetType="{x:Type TreeViewItem}">
          <Setter x:Uid="Setter_1" Property="TreeViewItem.IsExpanded">
            <Setter.Value>
              <Binding Path="IsExpanded" Mode="TwoWay" />
            </Setter.Value>
          </Setter>
          <Setter x:Uid="Setter_2" Property="UIElement.Visibility">
            <Setter.Value>
              <MultiBinding x:Uid="MultiBinding_1" Mode="OneWay">
                <MultiBinding.Converter>
                  <local:RecordNodeIsEnabledToVisibilityConverter x:Uid="local_RecordNodeIsEnabledToVisibilityConverter_1" />
                </MultiBinding.Converter>
                <Binding x:Uid="Binding_1" Path="IsEnabled" />
                <Binding x:Uid="Binding_2" ElementName="checkHideDisabled" Path="IsChecked" />
              </MultiBinding>
            </Setter.Value>
          </Setter>
        </Style>
      </ItemsControl.ItemContainerStyle>
    </TreeView>
    <CheckBox x:Name="checkHideDisabled" x:Uid="checkHideDisabled" MinWidth="0" Content="{x:Static res:WpfMMDialogResources.HideDisableNode}" Margin="{StaticResource AspenVerticalRelativeControlMargin}" />
    <StackPanel x:Uid="StackPanel_2" Orientation="Horizontal" HorizontalAlignment="Center">
      <Button Click="BtnBack_Click" Name="BtnBack" x:Uid="BtnBack" Content="{x:Static res:WpfMMDialogResources.BtnBack}" Margin="{StaticResource AspenHorizontalRelativeControlMargin}" />
      <Button Click="BtnFinish_Click" x:Uid="Button_1" Content="{x:Static res:WpfSimdllResources.BtnFinish}" Margin="{StaticResource AspenHorizontalRelativeControlMargin}" />
      <Button Click="BtnCancel_Click" x:Uid="Button_2" Content="{x:Static res:WpfSimdllResources.BtnCancel}" Margin="{StaticResource AspenNoMargin}" />
    </StackPanel>
  </StackPanel>
</Window>
