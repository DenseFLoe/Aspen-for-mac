<?xml version='1.0' encoding='utf-8'?>
<local:WizardPage x:Class="AspenTech.AspenPlus.MMDialogs.ImportFromPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:res="clr-namespace:AspenTech.AspenPlus.Localization;assembly=AspenTech.AspenPlus.Localization" xmlns:local="clr-namespace:AspenTech.AspenPlus.MMDialogs" x:Uid="local_WizardPage_1">
  <FrameworkElement.Resources>
    <ResourceDictionary>
      <local:MoveToItemImageConvert x:Key="ImagePathConverter" x:Uid="local_MoveToItemImageConvert_1" />
    </ResourceDictionary>
  </FrameworkElement.Resources>
  <StackPanel x:Uid="StackPanel_1">
    <Label x:Uid="Label_1" Margin="{StaticResource AspenVerticalRelativeControlMargin}">
      <ContentControl.Content>
        <Binding Path="CppCode.m_strPrompt" />
      </ContentControl.Content>
    </Label>
    <TreeView SelectedItemChanged="TreeViewSelectedItemChanged" x:Uid="TreeView_1" Width="350" Height="250" Margin="{StaticResource AspenVerticalRelativeControlMargin}">
      <ItemsControl.ItemsSource>
        <Binding Path="CppCode.AllNodes" />
      </ItemsControl.ItemsSource>
      <ItemsControl.ItemTemplate>
        <HierarchicalDataTemplate x:Uid="HierarchicalDataTemplate_1">
          <HierarchicalDataTemplate.ItemsSource>
            <Binding Path="Children" />
          </HierarchicalDataTemplate.ItemsSource>
          <StackPanel x:Uid="StackPanel_2" Orientation="Horizontal">
            <Image x:Uid="Image_1" Margin="{StaticResource AspenHorizontalLabelMargin}">
              <Image.Source>
                <Binding Path="Image" Converter="{StaticResource ImagePathConverter}" Mode="OneWay" />
              </Image.Source>
            </Image>
            <TextBlock x:Uid="TextBlock_1" Width="Auto">
              <TextBlock.Text>
                <Binding Path="Name" />
              </TextBlock.Text>
            </TextBlock>
          </StackPanel>
        </HierarchicalDataTemplate>
      </ItemsControl.ItemTemplate>
    </TreeView>
    <CheckBox x:Name="cbRestore" x:Uid="CheckBox_1" MinWidth="0" Content="{x:Static res:WpfSimdllResources.LblSynSmWithImport}" Margin="{StaticResource AspenVerticalRelativeControlMargin}" />
  </StackPanel>
</local:WizardPage>
