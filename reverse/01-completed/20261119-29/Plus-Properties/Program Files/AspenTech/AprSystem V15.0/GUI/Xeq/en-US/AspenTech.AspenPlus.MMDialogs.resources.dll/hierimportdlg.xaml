      <Button Click="OnButtonClickBtnAbort" Name="BtnAbort" x:Uid="BtnAbort" Content="{x:Static res:WpfMMDialogResources.Abort}" IsCancel="True" HorizontalAlignment="Center" Margin="{StaticResource AspenHorizontalRelativeControlMargin}" VerticalAlignment="Top" MinWidth="72" />
