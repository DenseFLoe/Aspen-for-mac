<?xml version='1.0' encoding='utf-8'?>
<Window x:Class="AspenTech.AspenPlus.PfsDialogs.PFSMessageBoxDialog" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:my="clr-namespace:AspenTech.AspenPlus.PfsDialogs" xmlns:res="clr-namespace:AspenTech.AspenPlus.Localization;assembly=AspenTech.AspenPlus.Localization" x:Uid="Window_1" Title="{x:Static res:WpfPfsDialogsResources.RuntimeCaption}" MinWidth="200" SizeToContent="WidthAndHeight" ResizeMode="NoResize" ShowInTaskbar="False" Style="{StaticResource MMDialogStyle}">
  <StackPanel Name="stackPanel1" x:Uid="stackPanel1" Orientation="Horizontal" Margin="10,10,10,0">
    <Image Name="IconImage" x:Uid="IconImage" Source="/AspenTech.AspenPlus.PfsDialogs;component/Images/Stop.PNG" Width="36" Height="36" />
    <StackPanel Name="stackPanel2" x:Uid="stackPanel2">
      <TextBlock Name="Message" x:Uid="Message" Text="{x:Static res:WpfPfsDialogsResources.RuntimeMessage}" FontSize="12" />
      <StackPanel Name="ButtonsStackPanel" x:Uid="ButtonsStackPanel" Orientation="Horizontal" HorizontalAlignment="Center">
        <Button Click="OnClickOk" Name="OKButton" x:Uid="OKButton" Content="{x:Static res:WpfPfsDialogsResources.BtnOk}" Margin="10" MinWidth="75" IsDefault="True" />
        <Button Click="OnClickYes" Name="YesButton" x:Uid="YesButton" Content="{x:Static res:WpfPfsDialogsResources.BtnYes}" Margin="10" MinWidth="75" />
        <Button Click="OnClickNo" Name="NoButton" x:Uid="NoButton" Content="{x:Static res:WpfPfsDialogsResources.BtnNo}" Margin="10" MinWidth="75" />
        <Button Click="OnClickCancel" Name="CancelButton" x:Uid="CancelButton" Content="{x:Static res:WpfPfsDialogsResources.BtnCancel}" Margin="10" MinWidth="75" />
      </StackPanel>
    </StackPanel>
  </StackPanel>
</Window>
