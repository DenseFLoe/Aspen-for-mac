<?xml version='1.0' encoding='utf-8'?>
<Window x:Class="AspenTech.AspenPlus.PfsDialogs.PFSGridReminderDialog" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:res="clr-namespace:AspenTech.AspenPlus.Localization;assembly=AspenTech.AspenPlus.Localization" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:my="clr-namespace:AspenTech.AspenPlus.PfsDialogs" x:Uid="Window_1" Title="{x:Static res:WpfPfsDialogsResources.GridSizeWarn}" SizeToContent="WidthAndHeight" ResizeMode="NoResize" ShowInTaskbar="False" Style="{StaticResource MMDialogStyle}">
  <StackPanel Name="stackPanel1" x:Uid="stackPanel1" HorizontalAlignment="Left" Margin="10" VerticalAlignment="Top">
    <Label Name="label1" x:Uid="label1" Content="{x:Static res:WpfPfsDialogsResources.GridSpaceTip}" MinHeight="25" MinWidth="100" />
    <Label Name="label2" x:Uid="label2" Content="{x:Static res:WpfPfsDialogsResources.UseZoomIn}" MinHeight="25" MinWidth="100" />
    <CheckBox Click="OnClickDontShow" Name="checkBox1" x:Uid="checkBox1" Content="{x:Static res:WpfPfsDialogsResources.DlgNotShowAgain}" Margin="5" MinHeight="20" MinWidth="100" />
    <Button Click="OnClickOk" Name="btnOK" x:Uid="btnOK" Content="{x:Static res:WpfPfsDialogsResources.BtnOk}" IsDefault="True" Height="23" Width="75" />
  </StackPanel>
</Window>
