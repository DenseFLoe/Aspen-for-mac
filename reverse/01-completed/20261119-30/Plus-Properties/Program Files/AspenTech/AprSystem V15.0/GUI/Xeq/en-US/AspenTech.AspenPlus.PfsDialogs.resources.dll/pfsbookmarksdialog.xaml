<?xml version='1.0' encoding='utf-8'?>
<Window x:Class="AspenTech.AspenPlus.PfsDialogs.PFSBookmarksDialog" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:my="clr-namespace:AspenTech.AspenPlus.PfsDialogs" xmlns:res="clr-namespace:AspenTech.AspenPlus.Localization;assembly=AspenTech.AspenPlus.Localization" Loaded="OnDialogLoaded" x:Uid="Window_1" Title="{x:Static res:WpfPfsDialogsResources.ManageView}" Style="{StaticResource MMDialogStyle}" SizeToContent="WidthAndHeight" ResizeMode="NoResize" ShowInTaskbar="False">
  <StackPanel Name="stackPanel5" x:Uid="stackPanel5" Margin="10,10,10,10">
    <StackPanel Name="stackPanel1" x:Uid="stackPanel1" MinHeight="10" Orientation="Horizontal">
      <StackPanel Name="stackPanel2" x:Uid="stackPanel2">
        <StackPanel Name="stackPanel4" x:Uid="stackPanel4" Orientation="Horizontal">
          <Label Name="label1" x:Uid="label1" MinWidth="60" Content="{x:Static res:WpfPfsDialogsResources.LblName}" />
          <ComboBox Loaded="comboBox1_Loaded" SelectionChanged="OnComboSelectionChanged" KeyUp="OnTextChanged" Name="comboBox1" x:Uid="comboBox1" MinWidth="100" HorizontalAlignment="Stretch" IsEditable="True" DisplayMemberPath="Name" ItemsSource="{Binding RelativeSource={RelativeSource FindAncestor, AncestorType=my:PFSBookmarksDialog, AncestorLevel=1}, Path=BookmarkList}">
            <ComboBox.Text>
              <Binding Path="BookmarkName" RelativeSource="{RelativeSource FindAncestor, AncestorType=my:PFSBookmarksDialog, AncestorLevel=1}" />
            </ComboBox.Text>
          </ComboBox>
        </StackPanel>
        <ListBox SelectionChanged="OnListSelectionChanged" MouseDoubleClick="OnListDoubleClick" Name="listBox1" x:Uid="listBox1" MinWidth="160" MinHeight="100" MaxHeight="200" Margin="0,5,0,5" VerticalAlignment="Stretch" DisplayMemberPath="Name" ItemsSource="{Binding RelativeSource={RelativeSource FindAncestor, AncestorType=my:PFSBookmarksDialog, AncestorLevel=1}, Path=BookmarkList}" />
      </StackPanel>
      <StackPanel Name="stackPanel3" x:Uid="stackPanel3">
        <Button Click="OnClickAdd" Name="addBtn" x:Uid="addBtn" Content="{x:Static res:WpfPfsDialogsResources.BtnAdd}" Height="23" MinWidth="50" Margin="5" />
        <Button Click="OnClickClose" Name="closeBtn" x:Uid="closeBtn" Content="{x:Static res:WpfPfsDialogsResources.BtnClose}" Height="23" MinWidth="50" Margin="5" />
        <Button Click="OnClickDelete" Name="deleteBtn" x:Uid="deleteBtn" Content="{x:Static res:WpfPfsDialogsResources.BtnDelete}" Height="23" MinWidth="50" Margin="5" />
        <Button Click="OnClickGoTo" Name="gotoBtn" x:Uid="gotoBtn" Content="{x:Static res:WpfPfsDialogsResources.BtnGoTo}" Height="23" MinWidth="50" Margin="5" />
      </StackPanel>
    </StackPanel>
    <StackPanel Name="stackPanel6" x:Uid="stackPanel6" Orientation="Horizontal">
      <Label Name="label2" x:Uid="label2" MinWidth="60" Content="{x:Static res:WpfPfsDialogsResources.LblRegion}" />
      <Label Name="regionText" x:Uid="regionText" Content="" />
    </StackPanel>
  </StackPanel>
</Window>
