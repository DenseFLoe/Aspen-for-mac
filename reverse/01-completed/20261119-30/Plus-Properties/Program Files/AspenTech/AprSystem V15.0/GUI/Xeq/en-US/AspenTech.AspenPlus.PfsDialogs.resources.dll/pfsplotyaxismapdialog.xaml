<?xml version='1.0' encoding='utf-8'?>
<Window x:Class="AspenTech.AspenPlus.PfsDialogs.PFSPlotYAxisMapDialog" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:my="clr-namespace:AspenTech.AspenPlus.PfsDialogs" xmlns:res="clr-namespace:AspenTech.AspenPlus.Localization;assembly=AspenTech.AspenPlus.Localization" Loaded="OnDialogLoaded" x:Uid="Window_1" Title="{x:Static res:WpfPfsDialogsResources.YAxisMap}" SizeToContent="WidthAndHeight" ResizeMode="NoResize" MinWidth="700" MinHeight="450" MaxWidth="800" MaxHeight="650" Style="{StaticResource MMDialogStyle}" FontFamily="{StaticResource AspenDefaultFontFamily}">
  <Grid Name="Grid1" x:Uid="Grid1" Margin="{DynamicResource AspenDialogOuterMargin}">
    <Grid.ColumnDefinitions>
      <ColumnDefinition x:Uid="ColumnDefinition_1" Width="*" />
      <ColumnDefinition x:Uid="ColumnDefinition_2" Width="Auto" />
    </Grid.ColumnDefinitions>
    <Grid.RowDefinitions>
      <RowDefinition x:Uid="RowDefinition_1" Height="Auto" />
      <RowDefinition x:Uid="RowDefinition_2" Height="*" />
      <RowDefinition x:Uid="RowDefinition_3" Height="Auto" />
    </Grid.RowDefinitions>
    <TreeView SelectedItemChanged="mTreeView1_SelectedItemChanged" Name="mTreeView1" x:Uid="mTreeView1" Margin="5" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Grid.Row="1" />
    <StackPanel Margin="5" Orientation="Horizontal" VerticalAlignment="Top" HorizontalAlignment="Center">
      <Button Click="SingleYaxisBtn_Click" Name="SingleYaxisBtn" x:Uid="SingleYaxisBtn" Content="{x:Static res:WpfPfsDialogsResources.SingleYAxis}" Height="25" MinWidth="80" />
      <Button Click="IndividualYaxesBtn_Click" Name="IndividualYaxesBtn" x:Uid="IndividualYaxesBtn" Content="{x:Static res:WpfPfsDialogsResources.IndividualYAxis}" Height="25" Margin="10,0,10,0" MinWidth="80" />
    </StackPanel>
    <StackPanel Orientation="Vertical" Grid.Column="1" Grid.Row="1">
      <Button Click="AddAxisBtn_Click" Name="AddAxisBtn" x:Uid="AddAxisBtn" Content="{x:Static res:WpfPfsDialogsResources.BtnAddAxis}" Height="25" Margin="5,30,5,10" Width="175" />
      <Button Click="DeleteAxisBtn_Click" Name="DeleteAxisBtn" x:Uid="DeleteAxisBtn" Content="{x:Static res:WpfPfsDialogsResources.BtnDeleteAxis}" Height="25" Margin="5,30,5,10" Width="175" />
      <Button Click="UpBtn_Click" Name="UpBtn" x:Uid="UpBtn" Content="{x:Static res:WpfPfsDialogsResources.BtnUp}" Height="25" Margin="5,30,5,10" Width="175" />
      <Button Click="DownBtn_Click" Name="DownBtn" x:Uid="DownBtn" Content="{x:Static res:WpfPfsDialogsResources.BtnDown}" Height="25" Width="175" Margin="5,30,5,10" />
    </StackPanel>
    <StackPanel Grid.ColumnSpan="2" Grid.Row="2" Margin="5" Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Right">
      <Button Click="OkBtn_Click" Name="OkBtn" x:Uid="OkBtn" Content="{x:Static res:WpfPfsDialogsResources.BtnOk}" Height="25" />
      <Button Click="CancelBtn_Click" Name="CancelBtn" x:Uid="CancelBtn" Content="{x:Static res:WpfPfsDialogsResources.BtnCancel}" Height="25" Margin="10,0,20,0" />
    </StackPanel>
  </Grid>
</Window>
