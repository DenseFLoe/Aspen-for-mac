<?xml version='1.0' encoding='utf-8'?>
<Window x:Class="AspenTech.AspenPlus.PfsDialogs.PFSTextInputDialog" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:my="clr-namespace:AspenTech.AspenPlus.PfsDialogs" xmlns:res="clr-namespace:AspenTech.AspenPlus.Localization;assembly=AspenTech.AspenPlus.Localization" Loaded="OnDialogLoaded" x:Uid="Window_1" Title="{x:Static res:WpfPfsDialogsResources.RuntimeCaption}" MinWidth="300" Style="{StaticResource MMDialogStyle}" SizeToContent="WidthAndHeight" ResizeMode="NoResize" ShowInTaskbar="False" WindowStartupLocation="CenterOwner">
  <StackPanel Name="stackPanel1" x:Uid="stackPanel1" Margin="10,10,10,0">
    <TextBlock Name="inputPrompt" x:Uid="inputPrompt" Text="{x:Static res:WpfPfsDialogsResources.RuntimePrompt}" FontSize="12" Margin="0,0,0,5" />
    <TextBox TextChanged="OnTextChanged" Name="inputText" x:Uid="inputText" Margin="0" FontSize="12">
      <TextBox.Text>
        <Binding x:Uid="Binding_1" Path="StrInput" UpdateSourceTrigger="LostFocus" RelativeSource="{RelativeSource FindAncestor, AncestorType=my:PFSTextInputDialog, AncestorLevel=1}" />
      </TextBox.Text>
    </TextBox>
    <StackPanel Name="stackPanel2" x:Uid="stackPanel2" Orientation="Horizontal" HorizontalAlignment="Center">
      <Button Click="OnClickOk" Name="btnOK" x:Uid="btnOK" Content="{x:Static res:WpfPfsDialogsResources.BtnOk}" IsDefault="True" Margin="10" MinWidth="75" />
      <Button Click="OnClickCancel" Name="btnCancel" x:Uid="btnCancel" Content="{x:Static res:WpfPfsDialogsResources.BtnCancel}" Margin="10" MinWidth="75" />
    </StackPanel>
  </StackPanel>
</Window>
