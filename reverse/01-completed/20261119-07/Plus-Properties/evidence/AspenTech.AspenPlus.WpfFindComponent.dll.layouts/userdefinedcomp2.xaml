<?xml version='1.0' encoding='utf-8'?>
<mlc:WizardControlItem xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:mm="clr-namespace:AspenTech.AspenPlus.MMControls;assembly=AspenTech.AspenPlus.MMControls" xmlns:mlc="clr-namespace:AspenTech.AspenPlus.ModelLibrary.Controls;assembly=AspenTech.AspenPlus.ModelLibrary.Controls" xmlns:res="clr-namespace:AspenTech.AspenPlus.Localization;assembly=AspenTech.AspenPlus.Localization" x:Uid="mlc_WizardControlItem_1" mm:MMHelp.HelpFile="cmpnts.chm" mm:MMHelp.HelpId="146" Background="{DynamicResource AspenDialogBackgroundBrush}" x:Class="AspenTech.AspenPlus.WpfFindComponent.UserDefinedComp2">
  <Grid x:Uid="Grid_1" Margin="{DynamicResource AspenDialogOuterMargin}">
    <Grid.RowDefinitions>
      <RowDefinition x:Uid="RowDefinition_1" Height="Auto" />
      <RowDefinition x:Uid="RowDefinition_2" Height="Auto" />
    </Grid.RowDefinitions>
    <GroupBox x:Uid="GroupBox_1" Header="{x:Static res:WpfFindComponentResources.ComButtonSelect}" Margin="{DynamicResource AspenVerticalIrrelativeControlMargin}" Grid.Row="0">
      <Grid x:Uid="Grid_2">
        <Grid.ColumnDefinitions>
          <ColumnDefinition x:Uid="ColumnDefinition_1" Width="Auto" />
          <ColumnDefinition x:Uid="ColumnDefinition_2" Width="7" />
          <ColumnDefinition x:Uid="ColumnDefinition_3" Width="Auto" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
          <RowDefinition x:Uid="RowDefinition_3" Height="Auto" />
          <RowDefinition x:Uid="RowDefinition_4" Height="Auto" />
          <RowDefinition x:Uid="RowDefinition_5" Height="Auto" />
          <RowDefinition x:Uid="RowDefinition_6" Height="Auto" />
          <RowDefinition x:Uid="RowDefinition_7" Height="Auto" />
        </Grid.RowDefinitions>
        <Button Click="btnLRHO_Click" Name="btnLRHO" x:Uid="btnLRHO" MinWidth="30" Grid.Row="0" Grid.Column="0" Margin="{DynamicResource AspenVerticalRelativeControlMargin}">1</Button>
        <Button Click="btnVP_Click" Name="btnVP" x:Uid="btnVP" MinWidth="30" Grid.Row="1" Grid.Column="0" Margin="{DynamicResource AspenVerticalRelativeControlMargin}">2</Button>
        <Button Click="btnVPC_Click" Name="btnVPC" x:Uid="btnVPC" MinWidth="30" Grid.Row="2" Grid.Column="0" Margin="{DynamicResource AspenVerticalRelativeControlMargin}">3</Button>
        <Button Click="btnHC_Click" Name="btnHC" x:Uid="btnHC" MinWidth="30" Grid.Row="3" Grid.Column="0" Margin="{DynamicResource AspenVerticalRelativeControlMargin}">4</Button>
        <Button Click="btnHCC_Click" Name="btnHCC" x:Uid="btnHCC" MinWidth="30" Grid.Row="4" Grid.Column="0" Margin="{DynamicResource AspenVerticalRelativeControlMargin}">5</Button>
        <Label Name="lblLRHO" x:Uid="lblLRHO" Grid.Row="0" Grid.Column="2" Content="{x:Static res:WpfFindComponentResources.MolarVolumeData}" Margin="{DynamicResource AspenVerticalRelativeControlMargin}" />
        <Label Name="lblSVPD" x:Uid="lblSVPD" Grid.Row="1" Grid.Column="2" Content="{x:Static res:WpfFindComponentResources.VaporPressureData}" Margin="{DynamicResource AspenVerticalRelativeControlMargin}" />
        <Label Name="lblSVPC" x:Uid="lblSVPC" Grid.Row="2" Grid.Column="2" Content="{x:Static res:WpfFindComponentResources.SvpcText_Conv}" Margin="{DynamicResource AspenVerticalRelativeControlMargin}" />
        <Label Name="lblSHCD" x:Uid="lblSHCD" Grid.Row="3" Grid.Column="2" Margin="{DynamicResource AspenVerticalRelativeControlMargin}" />
        <Label Name="lblSHCC" x:Uid="lblSHCC" Grid.Row="4" Grid.Column="2" Margin="{DynamicResource AspenVerticalRelativeControlMargin}" />
      </Grid>
    </GroupBox>
    <GroupBox x:Uid="GroupBox_2" Grid.Row="1" Margin="{DynamicResource AspenVerticalIrrelativeControlMargin}">
      <Grid x:Uid="Grid_3">
        <Grid.RowDefinitions>
          <RowDefinition x:Uid="RowDefinition_8" Height="Auto" />
          <RowDefinition x:Uid="RowDefinition_9" Height="7" />
          <RowDefinition x:Uid="RowDefinition_10" Height="Auto" />
        </Grid.RowDefinitions>
        <StackPanel x:Uid="StackPanel_1" Orientation="Horizontal" Grid.Row="0">
          <RadioButton Click="radioEstde_Click" Name="radioEstde" x:Uid="radioEstde" GroupName="radioGroup1" Margin="{DynamicResource AspenHorizontalRelativeControlMargin}" Content="{x:Static res:WpfFindComponentResources.EvaluateTDE}" />
          <Button Click="btnTDE_Click" Name="btnTDE" x:Uid="btnTDE" Content="{x:Static res:WpfFindComponentResources.EvaluateNow}" />
        </StackPanel>
        <RadioButton Click="radioEsaspen_Click" Name="radioEsaspen" x:Uid="radioEsaspen" GroupName="radioGroup1" Grid.Row="3" Content="{x:Static res:WpfFindComponentResources.EstimatAspenPropEsys}" />
      </Grid>
    </GroupBox>
  </Grid>
</mlc:WizardControlItem>
