<?xml version='1.0' encoding='utf-8'?>
<mlc:WizardControlItem xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:mm="clr-namespace:AspenTech.AspenPlus.MMControls;assembly=AspenTech.AspenPlus.MMControls" xmlns:lp="clr-namespace:AspenTech.AspenPlus.Localization;assembly=AspenTech.AspenPlus.Localization" xmlns:mlc="clr-namespace:AspenTech.AspenPlus.ModelLibrary.Controls;assembly=AspenTech.AspenPlus.ModelLibrary.Controls" x:Uid="mlc_WizardControlItem_1" mm:MMHelp.HelpFile="cmpnts.chm" mm:MMHelp.HelpId="141" UseScrollViewerInside="True" Title="{x:Static lp:WpfFindComponentResources.Form10Title}" x:Class="AspenTech.AspenPlus.WpfFindComponent.ElectrolyteForm10">
  <Grid x:Uid="Grid_1">
    <Grid.RowDefinitions>
      <RowDefinition x:Uid="RowDefinition_1" Height="Auto" />
      <RowDefinition x:Uid="RowDefinition_2" Height="*" />
    </Grid.RowDefinitions>
    <Grid x:Uid="Grid_2" Grid.Row="0" Margin="{DynamicResource AspenDialogOuterMargin}">
      <Grid.RowDefinitions>
        <RowDefinition x:Uid="RowDefinition_3" Height="Auto" />
        <RowDefinition x:Uid="RowDefinition_4" Height="Auto" />
      </Grid.RowDefinitions>
      <GroupBox Name="grpSimID" x:Uid="grpSimID" Header="{x:Static lp:WpfFindComponentResources.SelElectrolyteSim}" Grid.Row="0" Margin="{DynamicResource AspenVerticalIrrelativeControlMargin}">
        <StackPanel x:Uid="StackPanel_1">
          <RadioButton Checked="radioTrueComponent_Checked" Name="radioTrueComponent" x:Uid="radioTrueComponent" GroupName="RGP01" Margin="{DynamicResource AspenVerticalRelativeControlMargin}" Content="{x:Static lp:WpfFindComponentResources.TrueComAppro}" />
          <RadioButton Checked="radioApparentComponent_Checked" Name="radioApparentComponent" x:Uid="radioApparentComponent" GroupName="RGP01" Content="{x:Static lp:WpfFindComponentResources.ApparentComAppro}" />
        </StackPanel>
      </GroupBox>
      <GroupBox Name="grpElecPID" x:Uid="grpElecPID" Header="{x:Static lp:WpfFindComponentResources.GeneReactionHenry}" Grid.Row="1">
        <Grid x:Uid="Grid_3">
          <Grid.RowDefinitions>
            <RowDefinition x:Uid="RowDefinition_5" Height="Auto" />
            <RowDefinition x:Uid="RowDefinition_6" Height="Auto" />
          </Grid.RowDefinitions>
          <Grid.ColumnDefinitions>
            <ColumnDefinition x:Uid="ColumnDefinition_1" Width="Auto" />
            <ColumnDefinition x:Uid="ColumnDefinition_2" Width="Auto" />
          </Grid.ColumnDefinitions>
          <Label x:Uid="Label_1" Grid.Row="0" Grid.Column="0" Margin="{DynamicResource AspenVerticalRelativeControlMargin}" Content="{x:Static lp:WpfFindComponentResources.ChemFormID}" />
          <Label x:Uid="Label_2" Grid.Row="1" Grid.Column="0" Content="{x:Static lp:WpfFindComponentResources.ComHenryFormID}" />
          <TextBox Name="txtChemID" x:Uid="txtChemID" Grid.Row="0" Grid.Column="1" IsReadOnly="True" MinWidth="80" HorizontalAlignment="Right" />
          <TextBox Name="txtHenryID" x:Uid="txtHenryID" Grid.Row="1" Grid.Column="1" IsReadOnly="True" MinWidth="80" HorizontalAlignment="Right" />
        </Grid>
      </GroupBox>
    </Grid>
    <Label Name="lblStatus" x:Uid="lblStatus" Grid.Row="1" VerticalAlignment="Bottom" Content="{x:Static lp:WpfFindComponentResources.NextToCreateChemHenry}" />
  </Grid>
</mlc:WizardControlItem>
