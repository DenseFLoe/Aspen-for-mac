<?xml version='1.0' encoding='utf-8'?>
<UserControl xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:res="clr-namespace:AspenTech.AspenPlus.Localization;assembly=AspenTech.AspenPlus.Localization" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:mm="http://schemas.aspentech.com/xaml/presentation/aspenplus" xmlns:local="clr-namespace:AspenTech.AspenPlus.WpfFindComponent" x:Uid="UserControl_1" mm:MMHelp.HelpFile="cmpnts.chm" mm:MMHelp.HelpId="149" x:Class="AspenTech.AspenPlus.WpfFindComponent.CompoundsTab">
  <FrameworkElement.Resources>
    <ResourceDictionary x:Uid="ResourceDictionary_1">
      <local:DoubleStringDisplayConverter x:Key="DoubleStringDisplayConverter" x:Uid="local_DoubleStringDisplayConverter_1" />
      <DataTemplate x:Key="HeaderTemplateArrowUp" x:Uid="DataTemplate_1">
        <DockPanel x:Uid="DockPanel_1">
          <TextBlock x:Uid="TextBlock_1" HorizontalAlignment="Center">
            <TextBlock.Text>
              <Binding />
            </TextBlock.Text>
          </TextBlock>
          <Path Name="arrow" x:Uid="arrow" StrokeThickness="1" Fill="#FF808080" Data="M5,10L15,10 10,5 5,10" />
        </DockPanel>
      </DataTemplate>
      <DataTemplate x:Key="HeaderTemplateArrowDown" x:Uid="DataTemplate_2">
        <DockPanel x:Uid="DockPanel_2">
          <TextBlock x:Uid="TextBlock_2" HorizontalAlignment="Center">
            <TextBlock.Text>
              <Binding />
            </TextBlock.Text>
          </TextBlock>
          <Path Name="arrow" x:Uid="Path_1" StrokeThickness="1" Fill="#FF808080" Data="M5,5L10,10 15,5 5,5" />
        </DockPanel>
      </DataTemplate>
    </ResourceDictionary>
  </FrameworkElement.Resources>
  <Grid x:Uid="Grid_1" Margin="{DynamicResource AspenDialogOuterMargin}">
    <Grid.RowDefinitions>
      <RowDefinition x:Uid="RowDefinition_1" Height="Auto" />
      <RowDefinition x:Uid="RowDefinition_2" Height="*" />
      <RowDefinition x:Uid="RowDefinition_3" Height="Auto" />
    </Grid.RowDefinitions>
    <Grid x:Uid="Grid_2" Grid.Row="0" Margin="{DynamicResource AspenVerticalIrrelativeControlMargin}">
      <Grid.ColumnDefinitions>
        <ColumnDefinition x:Uid="ColumnDefinition_1" Width="Auto" />
        <ColumnDefinition x:Uid="ColumnDefinition_2" Width="Auto" />
      </Grid.ColumnDefinitions>
      <GroupBox x:Uid="GroupBox_1" Header="{x:Static res:WpfMMDialogResources.LblSearchCriteria}" Grid.Column="0" Margin="{DynamicResource AspenHorizontalRelativeControlMargin}">
        <Grid x:Uid="Grid_3">
          <Grid.RowDefinitions>
            <RowDefinition x:Uid="RowDefinition_4" Height="Auto" />
            <RowDefinition x:Uid="RowDefinition_5" Height="Auto" />
            <RowDefinition x:Uid="RowDefinition_6" Height="Auto" />
          </Grid.RowDefinitions>
          <Grid x:Uid="Grid_4" Grid.Row="0" Margin="{DynamicResource AspenVerticalRelativeControlMargin}">
            <Grid.ColumnDefinitions>
              <ColumnDefinition x:Uid="ColumnDefinition_3" Width="Auto" />
              <ColumnDefinition x:Uid="ColumnDefinition_4" Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock x:Uid="TextBlock_3" Grid.Column="0" TextWrapping="Wrap" Width="130" VerticalAlignment="Center" Text="{x:Static res:WpfFindComponentResources.NameOrAlias}" />
            <Grid x:Uid="Grid_5" Grid.Column="1">
              <Grid.RowDefinitions>
                <RowDefinition x:Uid="RowDefinition_7" Height="Auto" />
                <RowDefinition x:Uid="RowDefinition_8" Height="Auto" />
                <RowDefinition x:Uid="RowDefinition_9" Height="Auto" />
              </Grid.RowDefinitions>
              <Grid.ColumnDefinitions>
                <ColumnDefinition x:Uid="ColumnDefinition_5" Width="Auto" />
                <ColumnDefinition x:Uid="ColumnDefinition_6" Width="7" />
                <ColumnDefinition x:Uid="ColumnDefinition_7" Width="Auto" />
              </Grid.ColumnDefinitions>
              <RadioButton Name="radioBeginWith" x:Uid="radioBeginWith" GroupName="RG001" Grid.Row="0" Margin="{DynamicResource AspenVerticalRelativeControlMargin}" Content="{x:Static res:WpfFindComponentResources.BeginsWith}">
                <ToggleButton.IsChecked>
                  <Binding Path="BeginWithChecked" />
                </ToggleButton.IsChecked>
              </RadioButton>
              <RadioButton Name="radioContains" x:Uid="radioContains" GroupName="RG001" Grid.Row="1" Margin="{DynamicResource AspenVerticalRelativeControlMargin}" Content="{x:Static res:WpfFindComponentResources.Contains}">
                <ToggleButton.IsChecked>
                  <Binding Path="ContainsChecked" />
                </ToggleButton.IsChecked>
              </RadioButton>
              <TextBox Name="txtContainValue" x:Uid="txtContainValue" Grid.Row="1" Grid.Column="2" Width="180" MaxLength="40" Margin="{DynamicResource AspenVerticalRelativeControlMargin}">
                <TextBox.Text>
                  <Binding Path="ComponentSearchText" Mode="TwoWay" UpdateSourceTrigger="PropertyChanged" />
                </TextBox.Text>
              </TextBox>
              <RadioButton Name="radioEquals" x:Uid="radioEquals" GroupName="RG001" Grid.Row="2" Content="{x:Static res:WpfFindComponentResources.Equal}">
                <ToggleButton.IsChecked>
                  <Binding Path="EqualsChecked" />
                </ToggleButton.IsChecked>
              </RadioButton>
            </Grid>
          </Grid>
          <Grid x:Uid="Grid_6" Grid.Row="1" Margin="{DynamicResource AspenVerticalRelativeControlMargin}">
            <Grid.ColumnDefinitions>
              <ColumnDefinition x:Uid="ColumnDefinition_8" Width="Auto" />
              <ColumnDefinition x:Uid="ColumnDefinition_9" Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock x:Uid="TextBlock_4" MinWidth="120" Grid.Column="0" Margin="{DynamicResource AspenHorizontalRelativeControlMargin}" Text="{x:Static res:WpfFindComponentResources.CompoundClass}" />
            <ComboBox Name="cboCompoundClass" x:Uid="cboCompoundClass" IsTextSearchEnabled="True" Grid.Column="1" MinWidth="140">
              <ItemsControl.ItemsSource>
                <Binding Path="CompClasses" />
              </ItemsControl.ItemsSource>
              <Selector.SelectedItem>
                <Binding Path="SelectedCompClass" />
              </Selector.SelectedItem>
            </ComboBox>
          </Grid>
          <Grid x:Uid="Grid_7" Grid.Row="2">
            <Grid.RowDefinitions>
              <RowDefinition x:Uid="RowDefinition_10" Height="Auto" />
              <RowDefinition x:Uid="RowDefinition_11" Height="7" />
              <RowDefinition x:Uid="RowDefinition_12" Height="Auto" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
              <ColumnDefinition x:Uid="ColumnDefinition_10" Width="Auto" />
              <ColumnDefinition x:Uid="ColumnDefinition_11" Width="Auto" />
              <ColumnDefinition x:Uid="ColumnDefinition_12" Width="Auto" />
              <ColumnDefinition x:Uid="ColumnDefinition_13" Width="Auto" />
              <ColumnDefinition x:Uid="ColumnDefinition_14" Width="Auto" />
              <ColumnDefinition x:Uid="ColumnDefinition_15" Width="Auto" />
            </Grid.ColumnDefinitions>
            <Label Name="lblMW" x:Uid="lblMW" MinWidth="100" Grid.Row="0" Grid.Column="0" Margin="{DynamicResource AspenHorizontalRelativeControlMargin}" Content="{x:Static res:WpfFindComponentResources.MolecularWeight}" />
            <Label x:Uid="Label_1" Grid.Row="0" Grid.Column="1" Margin="{DynamicResource AspenHorizontalRelativeControlMargin}" Content="{x:Static res:WpfFindComponentResources.From}" />
            <local:NullableTextBox Name="txtMWFrom" x:Uid="txtMWFrom" Width="50" Grid.Row="0" Grid.Column="2" Margin="{DynamicResource AspenHorizontalRelativeControlMargin}">
              <TextBox.Text>
                <Binding Path="MWFrom" />
              </TextBox.Text>
            </local:NullableTextBox>
            <Label x:Uid="Label_2" Grid.Row="0" Grid.Column="3" Margin="{DynamicResource AspenHorizontalRelativeControlMargin}" Content="{x:Static res:WpfFindComponentResources.To}" />
            <local:NullableTextBox Name="txtMWTo" x:Uid="txtMWTo" Width="50" Grid.Row="0" Grid.Column="4" Margin="{DynamicResource AspenHorizontalRelativeControlMargin}">
              <TextBox.Text>
                <Binding Path="MWTo" />
              </TextBox.Text>
            </local:NullableTextBox>
            <Label Name="lblTB" x:Uid="lblTB" MinWidth="100" Grid.Row="2" Grid.Column="0" Margin="{DynamicResource AspenHorizontalRelativeControlMargin}" Content="{x:Static res:WpfFindComponentResources.BoilingPoint}" />
            <Label x:Uid="Label_3" Grid.Row="2" Grid.Column="1" Margin="{DynamicResource AspenHorizontalRelativeControlMargin}" Content="{x:Static res:WpfFindComponentResources.From}" />
            <local:NullableTextBox Name="txtBPFrom" x:Uid="txtBPFrom" Width="50" Grid.Row="2" Grid.Column="2" Margin="{DynamicResource AspenHorizontalRelativeControlMargin}">
              <TextBox.Text>
                <Binding Path="BPFrom" />
              </TextBox.Text>
            </local:NullableTextBox>
            <Label x:Uid="Label_4" Grid.Row="2" Grid.Column="3" Margin="{DynamicResource AspenHorizontalRelativeControlMargin}" Content="{x:Static res:WpfFindComponentResources.To}" />
            <local:NullableTextBox Name="txtBPTo" x:Uid="txtBPTo" Width="50" Grid.Row="2" Grid.Column="4" Margin="{DynamicResource AspenHorizontalRelativeControlMargin}">
              <TextBox.Text>
                <Binding Path="BPTo" />
              </TextBox.Text>
            </local:NullableTextBox>
            <ComboBox Name="cboBpUnit" x:Uid="cboBpUnit" MinWidth="50" Grid.Row="2" Grid.Column="5" IsTextSearchEnabled="True">
              <ItemsControl.ItemsSource>
                <Binding Path="Units" />
              </ItemsControl.ItemsSource>
              <UIElement.IsEnabled>
                <Binding ElementName="btnFind" Path="IsEnabled" />
              </UIElement.IsEnabled>
              <Selector.SelectedItem>
                <Binding Path="SelectedUnit" />
              </Selector.SelectedItem>
            </ComboBox>
          </Grid>
        </Grid>
      </GroupBox>
      <StackPanel x:Uid="StackPanel_1" Orientation="Vertical" Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Center">
        <Button Name="btnFind" x:Uid="btnFind" IsDefault="True" Margin="{DynamicResource AspenVerticalRelativeControlMargin}" Content="{x:Static res:WpfFindComponentResources.FindNow}">
          <ButtonBase.Command>
            <Binding Path="FindCommand" />
          </ButtonBase.Command>
        </Button>
        <Button Name="btnNewSearch" x:Uid="btnNewSearch" Margin="{DynamicResource AspenVerticalRelativeControlMargin}" Content="{x:Static res:WpfFindComponentResources.NewSearch}">
          <ButtonBase.Command>
            <Binding Path="NewSearchCommand" />
          </ButtonBase.Command>
        </Button>
        <Button Name="btnHelp" x:Uid="btnHelp" Command="ApplicationCommands.Help" Margin="{DynamicResource AspenVerticalRelativeControlMargin}" Content="{x:Static res:WpfSimdllResources.BtnHelp}" />
      </StackPanel>
    </Grid>
    <GroupBox x:Uid="GroupBox_2" Grid.Row="1" Margin="{DynamicResource AspenVerticalIrrelativeControlMargin}">
      <HeaderedContentControl.Header>
        <StackPanel x:Uid="StackPanel_2" Orientation="Horizontal">
          <TextBlock x:Uid="TextBlock_5" Margin="{DynamicResource AspenHorizontalRelativeControlMargin}" Text="{x:Static res:WpfFindComponentResources.LblCompoundFind}" />
        </StackPanel>
      </HeaderedContentControl.Header>
      <ContentControl.Content>
        <Grid x:Uid="Grid_8">
          <Grid.RowDefinitions>
            <RowDefinition x:Uid="RowDefinition_13" Height="*" />
            <RowDefinition x:Uid="RowDefinition_14" Height="Auto" />
          </Grid.RowDefinitions>
          <local:ListViewEx ButtonBase.Click="ListView_ColumnHeaderClicked" Name="lstComps" x:Uid="lstComps" MinHeight="100" Grid.Row="0" Margin="{DynamicResource AspenVerticalRelativeControlMargin}">
            <ItemsControl.ItemsSource>
              <Binding Path="FoundComponents" />
            </ItemsControl.ItemsSource>
            <local:ListViewEx.BindableSelectedItems>
              <Binding Path="SelectedFoundComponents" Mode="TwoWay" />
            </local:ListViewEx.BindableSelectedItems>
            <ListView.View>
              <GridView x:Uid="GridView_1">
                <GridViewColumn x:Uid="GridViewColumn_1" Header="{x:Static res:WpfFindComponentResources.CompoundName}" Width="110">
                  <GridViewColumn.DisplayMemberBinding>
                    <Binding Path="DbName" />
                  </GridViewColumn.DisplayMemberBinding>
                </GridViewColumn>
                <GridViewColumn x:Uid="GridViewColumn_2" Header="{x:Static res:WpfFindComponentResources.Alias}" Width="80">
                  <GridViewColumn.DisplayMemberBinding>
                    <Binding Path="Formula" />
                  </GridViewColumn.DisplayMemberBinding>
                </GridViewColumn>
                <GridViewColumn x:Uid="GridViewColumn_3" Header="{x:Static res:WpfFindComponentResources.Databank}" Width="70">
                  <GridViewColumn.DisplayMemberBinding>
                    <Binding Path="Databank" />
                  </GridViewColumn.DisplayMemberBinding>
                </GridViewColumn>
                <GridViewColumn x:Uid="GridViewColumn_4" Header="{x:Static res:WpfFindComponentResources.AlternateName}" Width="90">
                  <GridViewColumn.DisplayMemberBinding>
                    <Binding Path="Synonym" />
                  </GridViewColumn.DisplayMemberBinding>
                </GridViewColumn>
                <GridViewColumn x:Uid="GridViewColumn_5" Header="{x:Static res:WpfFindComponentResources.MW}" Width="40">
                  <GridViewColumn.CellTemplate>
                    <DataTemplate x:Uid="DataTemplate_3">
                      <TextBlock x:Uid="TextBlock_6">
                        <TextBlock.Text>
                          <Binding Path=".MW" Mode="OneWay" Converter="{StaticResource DoubleStringDisplayConverter}" UpdateSourceTrigger="PropertyChanged" />
                        </TextBlock.Text>
                      </TextBlock>
                    </DataTemplate>
                  </GridViewColumn.CellTemplate>
                </GridViewColumn>
                <GridViewColumn x:Uid="GridViewColumn_6" Width="60">
                  <GridViewColumn.Header>
                    <Binding Path="BPHeader" />
                  </GridViewColumn.Header>
                  <GridViewColumn.CellTemplate>
                    <DataTemplate x:Uid="DataTemplate_4">
                      <TextBlock x:Uid="TextBlock_7">
                        <TextBlock.Text>
                          <Binding Path=".BP" Mode="OneWay" Converter="{StaticResource DoubleStringDisplayConverter}" UpdateSourceTrigger="PropertyChanged" />
                        </TextBlock.Text>
                      </TextBlock>
                    </DataTemplate>
                  </GridViewColumn.CellTemplate>
                </GridViewColumn>
                <GridViewColumn x:Uid="GridViewColumn_7" Header="{x:Static res:WpfFindComponentResources.CASNo}" Width="80">
                  <GridViewColumn.DisplayMemberBinding>
                    <Binding Path="Casno" />
                  </GridViewColumn.DisplayMemberBinding>
                </GridViewColumn>
                <GridViewColumn x:Uid="GridViewColumn_8" Header="{x:Static res:WpfFindComponentResources.CompoundClassHeader}" Width="100">
                  <GridViewColumn.DisplayMemberBinding>
                    <Binding Path="CompClass" />
                  </GridViewColumn.DisplayMemberBinding>
                </GridViewColumn>
              </GridView>
            </ListView.View>
            <ItemsControl.ItemContainerStyle>
              <Style x:Uid="Style_1" TargetType="{x:Type ListViewItem}">
                <EventSetter Event="Control.MouseDoubleClick" Handler="ListViewItem_MouseDoubleClick" />
              </Style>
            </ItemsControl.ItemContainerStyle>
          </local:ListViewEx>
          <Button Name="btnAdd" x:Uid="btnAdd" Grid.Row="1" HorizontalAlignment="Left" VerticalAlignment="Bottom" Content="{x:Static res:WpfFindComponentResources.AddSelCom}">
            <ButtonBase.Command>
              <Binding Path="AddCommand" />
            </ButtonBase.Command>
          </Button>
        </Grid>
      </ContentControl.Content>
    </GroupBox>
    <StatusBar x:Uid="StatusBar_1" Grid.Row="2" VerticalAlignment="Bottom">
      <StatusBarItem x:Uid="StatusBarItem_1">
        <TextBlock Name="txtStatus" x:Uid="txtStatus">
          <TextBlock.Text>
            <Binding Path="StatusText" />
          </TextBlock.Text>
        </TextBlock>
      </StatusBarItem>
    </StatusBar>
  </Grid>
</UserControl>
