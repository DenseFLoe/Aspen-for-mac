<?xml version='1.0' encoding='utf-8'?>
<mlc:WizardControlItem xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:mm="clr-namespace:AspenTech.AspenPlus.MMControls;assembly=AspenTech.AspenPlus.MMControls" xmlns:lp="clr-namespace:AspenTech.AspenPlus.Localization;assembly=AspenTech.AspenPlus.Localization" xmlns:mlc="clr-namespace:AspenTech.AspenPlus.ModelLibrary.Controls;assembly=AspenTech.AspenPlus.ModelLibrary.Controls" xmlns:local="clr-namespace:AspenTech.AspenPlus.WpfFindComponent;assembly=AspenTech.AspenPlus.WpfFindComponent" x:Uid="mlc_WizardControlItem_2" mm:MMHelp.HelpFile="cmpnts.chm" mm:MMHelp.HelpId="138" x:Class="AspenTech.AspenPlus.WpfFindComponent.SFEAssistantStep2">
  <Grid x:Uid="Grid_1" MinWidth="380" MinHeight="250">
    <Grid.RowDefinitions>
      <RowDefinition x:Uid="RowDefinition_1" Height="Auto" />
      <RowDefinition x:Uid="RowDefinition_2" Height="Auto" />
      <RowDefinition x:Uid="RowDefinition_3" Height="Auto" />
    </Grid.RowDefinitions>
    <GroupBox x:Uid="GroupBox_2" Header="{x:Static lp:WpfFindComponentResources.SFEAssistantGeneratedSpecies}" Grid.Row="0">
      <StackPanel x:Uid="StackPanel_1" Orientation="Horizontal">
        <DataGrid CommandManager.PreviewCanExecute="HandleCanExecute" CellEditEnding="grdSolidComponent_CellEditEnding" Name="grdSolidComponent" x:Uid="grdSolidComponent" CanUserAddRows="False" AutoGenerateColumns="False" VerticalAlignment="Stretch" Height="110" GridLinesVisibility="None" AlternationCount="2">
          <DataGrid.Columns>
            <DataGridTextColumn Header="{x:Static lp:WpfFindComponentResources.SFEAssistantFluidComponent}" ScrollViewer.VerticalScrollBarVisibility="Visible" IsReadOnly="True" MinWidth="150">
              <DataGridBoundColumn.Binding>
                <Binding Path="ComponentID" />
              </DataGridBoundColumn.Binding>
            </DataGridTextColumn>
            <DataGridTextColumn Header="{x:Static lp:WpfFindComponentResources.SFEAssistantSolidGridHeader}" ScrollViewer.VerticalScrollBarVisibility="Visible" IsReadOnly="False" MinWidth="150" Foreground="#FF0000FF" FontWeight="Bold">
              <DataGridBoundColumn.Binding>
                <Binding Path="SolidID" UpdateSourceTrigger="PropertyChanged" />
              </DataGridBoundColumn.Binding>
              <DataGridBoundColumn.EditingElementStyle>
                <Style TargetType="{x:Type TextBox}">
                  <Setter Property="TextBox.MaxLength" Value="8" />
                  <Setter Property="TextBox.CharacterCasing" Value="Upper" />
                  <EventSetter Event="UIElement.PreviewTextInput" Handler="TextBox_PreviewTextInput" />
                  <EventSetter Event="UIElement.PreviewKeyDown" Handler="TextBox_PreviewKeyDown" />
                  <EventSetter Event="TextBoxBase.TextChanged" Handler="TextBox_TextChanged" />
                </Style>
              </DataGridBoundColumn.EditingElementStyle>
              <DataGridColumn.CellStyle>
                <Style TargetType="{x:Type DataGridCell}">
                  <Style.Triggers>
                    <Trigger Property="DataGridCell.IsSelected" Value="True">
                      <Setter Property="Panel.Background" Value="#00FFFFFF" />
                      <Setter Property="Border.BorderBrush" Value="#FFFEDC00" />
                      <Setter Property="Border.BorderThickness" Value="2,2,2,2" />
                    </Trigger>
                  </Style.Triggers>
                </Style>
              </DataGridColumn.CellStyle>
            </DataGridTextColumn>
          </DataGrid.Columns>
          <DataGrid.RowStyle>
            <Style TargetType="{x:Type DataGridRow}">
              <Style.Triggers>
                <Trigger Property="DataGridRow.AlternationIndex" Value="1">
                  <Setter Property="Panel.Background" Value="#FFF4F9FD" />
                </Trigger>
              </Style.Triggers>
            </Style>
          </DataGrid.RowStyle>
        </DataGrid>
      </StackPanel>
    </GroupBox>
    <GroupBox x:Uid="GroupBox_5" Grid.Row="1" Header="{x:Static lp:WpfFindComponentResources.GenerateChemistry}" Margin="0,0,0,0">
      <Grid x:Uid="Grid_6">
        <Grid.ColumnDefinitions>
          <ColumnDefinition x:Uid="RowDefinition_1" />
          <ColumnDefinition x:Uid="RowDefinition_2" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
          <RowDefinition x:Uid="RowDefinition_1" />
          <RowDefinition x:Uid="RowDefinition_2" />
        </Grid.RowDefinitions>
        <RadioButton Click="radioNewChemistry_Click" Name="radioNewChemistry" x:Uid="radioNewChemistry" IsChecked="True" GroupName="RG1" Grid.Row="0" Grid.Column="0" Content="{x:Static lp:WpfFindComponentResources.Generatenew}" Margin="0,5,0,5" />
        <TextBox Name="txtChemName" x:Uid="txtChemName" Width="100" HorizontalAlignment="Left" Grid.Row="0" Grid.Column="1" CharacterCasing="Upper" MaxLength="8" Foreground="#FF0000FF" FontWeight="Bold">
          <TextBox.Text>
            <Binding Path="ChemName" />
          </TextBox.Text>
          <UIElement.IsEnabled>
            <Binding ElementName="radioNewChemistry" Path="IsChecked" UpdateSourceTrigger="PropertyChanged" Mode="OneWay" />
          </UIElement.IsEnabled>
        </TextBox>
        <RadioButton Click="radioExistChemistry_Click" Name="radioExistChemistry" x:Uid="radioExistChemistry" Grid.Row="1" Grid.Column="0" GroupName="RG1" Content="{x:Static lp:WpfFindComponentResources.Addtoexisting}" />
        <ComboBox SelectionChanged="cmbexistingChemistry_SelectionChanged" Name="cmbexistingChemistry" x:Uid="cmbexistingChemistry" HorizontalAlignment="Left" Grid.Row="1" Grid.Column="1" Width="100" SelectedIndex="0">
          <ItemsControl.ItemsSource>
            <Binding Path="ExistingChemistry" />
          </ItemsControl.ItemsSource>
          <Selector.SelectedValue>
            <Binding Path="ExistChemName" />
          </Selector.SelectedValue>
          <UIElement.IsEnabled>
            <Binding ElementName="radioExistChemistry" Path="IsChecked" UpdateSourceTrigger="PropertyChanged" Mode="OneWay" />
          </UIElement.IsEnabled>
        </ComboBox>
      </Grid>
    </GroupBox>
    <StackPanel Grid.Row="2">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition x:Uid="RowDefinition_1" Width="30" />
          <ColumnDefinition x:Uid="RowDefinition_2" />
        </Grid.ColumnDefinitions>
        <CheckBox Click="globalChecked_Click" Name="globalChecked" x:Uid="globalChecked" Margin="10,5,0,0" Grid.Column="0" />
        <Label Name="labelglobal" x:Uid="labelglobal" Grid.Column="1" Margin="0,0,0,0" Content="{x:Static lp:WpfFindComponentResources.SFEAssistantGlobalCheked}">
          <UIElement.IsEnabled>
            <Binding ElementName="globalChecked" Path="IsEnabled" Mode="OneWay" />
          </UIElement.IsEnabled>
        </Label>
      </Grid>
    </StackPanel>
  </Grid>
</mlc:WizardControlItem>
