<?xml version='1.0' encoding='utf-8'?>
<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:lp="clr-namespace:AspenTech.AspenPlus.Localization;assembly=AspenTech.AspenPlus.Localization" xmlns:mm="http://schemas.aspentech.com/xaml/presentation/aspenplus" Loaded="Window_Loaded" x:Uid="Window_1" Title="{x:Static lp:WpfFindComponentResources.UpwardComp1Title}" Width="500" mm:MMHelp.HelpId="1326" mm:MMInContextGuidanceButton.StaysInIsolatedColumn="False" ResizeMode="NoResize" SizeToContent="Height" Style="{StaticResource MMDialogStyle}" x:Class="AspenTech.AspenPlus.WpfFindComponent.UpwardComp1">
  <mm:MMHelp.HelpFile>
    <Binding Path="HelpFile" FallbackValue="userguide1.chm" />
  </mm:MMHelp.HelpFile>
  <StackPanel x:Uid="StackPanel_1" Margin="{StaticResource AspenDialogOuterMargin}">
    <Border x:Uid="Border_1" Margin="{StaticResource AspenVerticalIrrelativeControlMargin}" BorderBrush="#FF000000" BorderThickness="0,0,0,2">
      <StackPanel x:Uid="StackPanel_2">
