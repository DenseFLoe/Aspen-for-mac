<?xml version='1.0' encoding='utf-8'?>
<mlc:WizardControlItem xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:mm="clr-namespace:AspenTech.AspenPlus.MMControls;assembly=AspenTech.AspenPlus.MMControls" xmlns:lp="clr-namespace:AspenTech.AspenPlus.Localization;assembly=AspenTech.AspenPlus.Localization" xmlns:mlc="clr-namespace:AspenTech.AspenPlus.ModelLibrary.Controls;assembly=AspenTech.AspenPlus.ModelLibrary.Controls" x:Uid="mlc_WizardControlItem_1" mm:MMHelp.HelpFile="cmpnts.chm" mm:MMHelp.HelpId="140" UseScrollViewerInside="True" Title="{x:Static lp:WpfFindComponentResources.Form12Title}" x:Class="AspenTech.AspenPlus.WpfFindComponent.ElectrolyteForm12">
  <Grid x:Uid="Grid_1" Margin="{DynamicResource AspenHorizontalRelativeControlMargin}">
    <Grid.RowDefinitions>
      <RowDefinition x:Uid="RowDefinition_1" Height="*" />
      <RowDefinition x:Uid="RowDefinition_2" Height="Auto" />
    </Grid.RowDefinitions>
    <Grid x:Uid="Grid_2" Grid.Row="0">
      <Grid.RowDefinitions>
        <RowDefinition x:Uid="RowDefinition_3" Height="*" />
        <RowDefinition x:Uid="RowDefinition_4" Height="Auto" />
      </Grid.RowDefinitions>
      <GroupBox x:Uid="GroupBox_1" Header="{x:Static lp:WpfFindComponentResources.RemoveSpecReaction}">
        <Grid x:Uid="Grid_3">
          <Grid.RowDefinitions>
            <RowDefinition x:Uid="RowDefinition_5" Height="*" />
            <RowDefinition x:Uid="RowDefinition_6" Height="*" />
            <RowDefinition x:Uid="RowDefinition_7" Height="Auto" />
          </Grid.RowDefinitions>
          <Grid x:Uid="Grid_4" Grid.Row="0" MaxHeight="150">
            <Grid.ColumnDefinitions>
              <ColumnDefinition x:Uid="ColumnDefinition_1" Width="*" />
              <ColumnDefinition x:Uid="ColumnDefinition_2" Width="*" />
            </Grid.ColumnDefinitions>
            <GroupBox x:Uid="GroupBox_2" Header="{x:Static lp:WpfFindComponentResources.AqueousSpecies}" Grid.Column="0">
              <ListBox GotFocus="lstAqueousSpecies_GotFocus" Name="lstAqueousSpecies" x:Uid="lstAqueousSpecies" SelectionMode="Extended" MinWidth="130" MinHeight="100" ScrollViewer.VerticalScrollBarVisibility="Auto" VerticalAlignment="Stretch" />
            </GroupBox>
            <GroupBox x:Uid="GroupBox_3" Header="{x:Static lp:WpfFindComponentResources.Salts}" Grid.Column="1">
              <ListBox GotFocus="lstSalts_GotFocus" Name="lstSalts" x:Uid="lstSalts" SelectionMode="Extended" MinWidth="130" MinHeight="100" ScrollViewer.VerticalScrollBarVisibility="Auto" VerticalAlignment="Stretch" />
            </GroupBox>
          </Grid>
          <GroupBox x:Uid="GroupBox_4" Header="{x:Static lp:WpfFindComponentResources.Reactions}" Grid.Row="1">
            <ListBox GotFocus="lstReactions_GotFocus" Name="lstReactions" x:Uid="lstReactions" ScrollViewer.CanContentScroll="False" SelectionMode="Extended" MinWidth="130" MinHeight="110" MaxHeight="150" ScrollViewer.VerticalScrollBarVisibility="Auto" VerticalAlignment="Stretch" />
          </GroupBox>
          <Button Click="btnRemove_Click" Name="btnRemove" x:Uid="btnRemove" Margin="0,4,0,0" HorizontalAlignment="Right" VerticalAlignment="Bottom" Grid.Row="2" Content="{x:Static lp:WpfFindComponentResources.Remove}" />
        </Grid>
      </GroupBox>
      <GroupBox x:Uid="GroupBox_5" Header="{x:Static lp:WpfFindComponentResources.SetUpGPropM}" Grid.Row="1">
        <StackPanel x:Uid="StackPanel_1">
          <StackPanel x:Uid="StackPanel_2" Orientation="Horizontal">
            <RadioButton Checked="radioGenSpecRxns_Checked" Name="radioGenSpecRxns" x:Uid="radioGenSpecRxns" GroupName="SUGPM" Margin="{DynamicResource AspenVerticalRelativeControlMargin}">
              <TextBlock x:Uid="TextBlock_1" TextWrapping="Wrap" MaxWidth="430" Text="{x:Static lp:WpfFindComponentResources.SetUpPropM}" />
            </RadioButton>
            <ComboBox SelectionChanged="cboOptSet_SelectionChanged" Name="cboOptSet" x:Uid="cboOptSet" MinWidth="100" Margin="16,0,0,6">
              <UIElement.IsEnabled>
                <Binding ElementName="radioGenSpecRxns" Path="IsChecked" UpdateSourceTrigger="PropertyChanged" Mode="OneWay" />
              </UIElement.IsEnabled>
            </ComboBox>
          </StackPanel>
          <RadioButton Checked="radioGenChemHenry_Checked" Name="radioGenChemHenry" x:Uid="radioGenChemHenry" GroupName="SUGPM" Margin="{DynamicResource AspenVerticalRelativeControlMargin}">
            <TextBlock x:Uid="TextBlock_2" TextWrapping="Wrap" MaxWidth="430" Text="{x:Static lp:WpfFindComponentResources.AddGSpec}" />
          </RadioButton>
          <CheckBox Name="chkGenHenryChem" x:Uid="chkGenHenryChem" MinWidth="100" Margin="16,0,0,0" Content="{x:Static lp:WpfFindComponentResources.GeneChemHenryCom}">
            <UIElement.IsEnabled>
              <Binding ElementName="radioGenChemHenry" Path="IsChecked" UpdateSourceTrigger="PropertyChanged" Mode="OneWay" />
            </UIElement.IsEnabled>
            <ToggleButton.IsChecked>
              <Binding Path="IsGenHenryChemChecked" Mode="TwoWay" />
            </ToggleButton.IsChecked>
          </CheckBox>
        </StackPanel>
      </GroupBox>
    </Grid>
    <Label Name="lblStatus" x:Uid="lblStatus" Grid.Row="1" VerticalAlignment="Bottom" Content="{x:Static lp:WpfFindComponentResources.NextToStep}" />
  </Grid>
</mlc:WizardControlItem>
