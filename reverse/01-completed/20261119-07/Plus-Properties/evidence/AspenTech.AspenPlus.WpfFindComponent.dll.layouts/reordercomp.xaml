<?xml version='1.0' encoding='utf-8'?>
<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:lp="clr-namespace:AspenTech.AspenPlus.Localization;assembly=AspenTech.AspenPlus.Localization" Name="reorderCompWindow" x:Uid="Window_1" Height="350" Width="400" TextOptions.TextFormattingMode="Display" ResizeMode="CanResizeWithGrip" ShowInTaskbar="False" Title="{x:Static lp:WpfFindComponentResources.ReorderCompTitle}" WindowStartupLocation="CenterOwner" Style="{StaticResource MMDialogStyle}" x:Class="AspenTech.AspenPlus.WpfFindComponent.ReorderComp">
  <FrameworkElement.Resources>
    <ResourceDictionary>
      <Style x:Key="imageButtonStyle" x:Uid="Style_1" TargetType="{x:Type Button}" BasedOn="{StaticResource {x:Type Button}}">
        <Setter x:Uid="Setter_1" Property="FrameworkElement.MinWidth" Value="0" />
        <Setter x:Uid="Setter_2" Property="FrameworkElement.MinHeight" Value="0" />
        <Setter x:Uid="Setter_3" Property="FrameworkElement.HorizontalAlignment" Value="Center" />
        <Setter x:Uid="Setter_4" Property="FrameworkElement.Margin" Value="0" />
        <Style.Triggers>
          <Trigger x:Uid="Trigger_1" Property="UIElement.IsEnabled" Value="False">
            <Setter x:Uid="Setter_5" Property="UIElement.Opacity" Value="0.5" />
          </Trigger>
        </Style.Triggers>
      </Style>
    </ResourceDictionary>
  </FrameworkElement.Resources>
  <Grid x:Uid="StackPanel_1" Margin="{StaticResource AspenDialogOuterMargin}">
    <FrameworkElement.DataContext>
      <Binding Mode="OneWay">
        <Binding.RelativeSource>
          <RelativeSource AncestorType="Window" Mode="FindAncestor" />
        </Binding.RelativeSource>
      </Binding>
    </FrameworkElement.DataContext>
    <Grid.RowDefinitions>
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>
    <GroupBox x:Uid="GroupBox_1" Grid.Row="0" Header="{x:Static lp:WpfFindComponentResources.ComponentsOrder}" Margin="{StaticResource AspenVerticalIrrelativeControlMargin}" MinHeight="250">
      <Grid x:Uid="Grid_1">
        <Grid.ColumnDefinitions>
          <ColumnDefinition x:Uid="ColumnDefinition_1" Width="3*" />
          <ColumnDefinition x:Uid="ColumnDefinition_2" Width="Auto" />
        </Grid.ColumnDefinitions>
        <ListBox Name="lvSelectedComps" x:Uid="lvSelectedComps" ScrollViewer.VerticalScrollBarVisibility="Auto" SelectionMode="Extended" Grid.Column="0" Margin="{StaticResource AspenHorizontalRelativeControlMargin}">
          <ItemsControl.ItemsSource>
            <Binding Path="Components" />
          </ItemsControl.ItemsSource>
          <ItemsControl.ItemTemplate>
            <DataTemplate x:Uid="DataTemplate_1">
              <TextBlock x:Uid="TextBlock_1">
                <TextBlock.Text>
                  <Binding />
                </TextBlock.Text>
              </TextBlock>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ListBox>
        <StackPanel x:Uid="StackPanel_2" Grid.Column="1" Orientation="Vertical" VerticalAlignment="Center" Margin="{StaticResource AspenHorizontalRelativeControlMargin}">
          <Button Name="btnUp" x:Uid="btnUp" Margin="{StaticResource AspenVerticalRelativeControlMargin}" Style="{StaticResource imageButtonStyle}">
            <ButtonBase.Command>
              <Binding Path="MoveUpCommand" />
            </ButtonBase.Command>
            <Image x:Uid="Image_1" Source="Images\up.png" />
          </Button>
          <Button Name="btnDown" x:Uid="btnDown" Margin="{StaticResource AspenVerticalRelativeControlMargin}" Style="{StaticResource imageButtonStyle}">
            <ButtonBase.Command>
              <Binding Path="MoveDownCommand" />
            </ButtonBase.Command>
            <Image x:Uid="Image_2" Source="Images\down.png" />
          </Button>
        </StackPanel>
      </Grid>
    </GroupBox>
    <UniformGrid Grid.Row="1" Columns="2" HorizontalAlignment="Center">
      <Button Name="btnOK" x:Uid="btnOK" Content="{x:Static lp:WpfFindComponentResources.OK}" IsDefault="True" Margin="{StaticResource AspenHorizontalRelativeControlMargin}">
        <ButtonBase.Command>
          <Binding Path="OKCommand" />
        </ButtonBase.Command>
      </Button>
      <Button Name="btnClose" x:Uid="btnClose" Content="{x:Static lp:WpfFindComponentResources.Cancel}" IsCancel="True" HorizontalAlignment="Center">
        <ButtonBase.Command>
          <Binding Path="CancelCommand" />
        </ButtonBase.Command>
      </Button>
    </UniformGrid>
  </Grid>
</Window>
