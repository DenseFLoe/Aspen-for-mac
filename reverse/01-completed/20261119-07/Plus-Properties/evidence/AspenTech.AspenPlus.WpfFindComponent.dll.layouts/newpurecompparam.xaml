<?xml version='1.0' encoding='utf-8'?>
<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:mm="http://schemas.aspentech.com/xaml/presentation/aspenplus" xmlns:local="clr-namespace:AspenTech.AspenPlus.WpfFindComponent" xmlns:res="clr-namespace:AspenTech.AspenPlus.Localization;assembly=AspenTech.AspenPlus.Localization" xmlns:atSupport="http://schemas.aspentech.com/xaml/presentation/visualisation/support" Name="newPureCompParamWindow" x:Uid="newPureCompParamWindow" mm:MMHelp.HelpFile="pp-param.chm" mm:MMHelp.HelpId="1" Title="{x:Static res:WpfFindComponentResources.NewPureComPara}" ShowInTaskbar="False" Height="510" SizeToContent="Width" MinWidth="450" WindowStartupLocation="CenterOwner" ResizeMode="NoResize" Style="{StaticResource MMDialogStyle}" x:Class="AspenTech.AspenPlus.WpfFindComponent.NewPureCompParam">
  <FrameworkElement.Resources>
    <ResourceDictionary x:Uid="ResourceDictionary_1">
      <ResourceDictionary.MergedDictionaries>
        <atSupport:AspenCommonResources />
        <atSupport:AspenCommonProperties x:Uid="atSupport_AspenCommonProperties_1" />
        <atSupport:AspenCommonStyles />
        <atSupport:AspenDefaultStyles />
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </FrameworkElement.Resources>
  <Grid x:Uid="Grid_1" Margin="{StaticResource AspenDialogOuterMargin}">
    <Grid.RowDefinitions>
      <RowDefinition x:Uid="RowDefinition_1" Height="Auto" />
      <RowDefinition x:Uid="RowDefinition_2" Height="Auto" />
      <RowDefinition x:Uid="RowDefinition_3" Height="Auto" />
    </Grid.RowDefinitions>
    <GroupBox Name="grpSelectType1" x:Uid="grpSelectType1" Header="{x:Static res:WpfFindComponentResources.SelTypePureComPara}" Margin="{StaticResource AspenVerticalIrrelativeControlMargin}" MinHeight="250" Grid.Row="0">
      <StackPanel x:Uid="StackPanel_1">
        <RadioButton Name="radioScalar" x:Uid="radioScalar" GroupName="R1" Margin="{StaticResource AspenVerticalRelativeControlMargin}" Content="{x:Static res:WpfFindComponentResources.Scalar}">
          <ToggleButton.IsChecked>
            <Binding Path="IsScalarChecked" />
          </ToggleButton.IsChecked>
        </RadioButton>
        <RadioButton Name="radioCorrelation" x:Uid="radioCorrelation" GroupName="R1" Margin="{StaticResource AspenVerticalRelativeControlMargin}" Content="{x:Static res:WpfFindComponentResources.TDependent}">
          <ToggleButton.IsChecked>
            <Binding Path="IsCorrelationChecked" />
          </ToggleButton.IsChecked>
        </RadioButton>
        <RadioButton Name="radioNonconventional" x:Uid="radioNonconventional" GroupName="R1" Margin="{StaticResource AspenVerticalRelativeControlMargin}" Content="{x:Static res:WpfFindComponentResources.Nonconventional}">
          <ToggleButton.IsChecked>
            <Binding Path="IsNonconvChecked" />
          </ToggleButton.IsChecked>
        </RadioButton>
        <local:TreeViewEx Name="treeParameter" x:Uid="treeParameter" Height="200" Margin="{StaticResource AspenVerticalRelativeControlMargin}">
          <ItemsControl.ItemsSource>
            <Binding Path="TreeNodeList" />
          </ItemsControl.ItemsSource>
          <local:TreeViewEx.BindableSelectedItem>
            <Binding Path="SelectedTreeNode" Mode="TwoWay" />
          </local:TreeViewEx.BindableSelectedItem>
          <ItemsControl.ItemTemplate>
            <HierarchicalDataTemplate x:Uid="HierarchicalDataTemplate_1" DataType="{x:Type local:TreeNode}">
              <HierarchicalDataTemplate.ItemsSource>
                <Binding Path="Nodes" />
              </HierarchicalDataTemplate.ItemsSource>
              <StackPanel x:Uid="StackPanel_2" Orientation="Horizontal">
                <TextBlock x:Uid="TextBlock_1">
                  <TextBlock.Text>
                    <Binding Path="Text" />
                  </TextBlock.Text>
                </TextBlock>
              </StackPanel>
            </HierarchicalDataTemplate>
          </ItemsControl.ItemTemplate>
        </local:TreeViewEx>
        <TextBox Name="txtPrompt" x:Uid="txtPrompt" Height="70" MaxWidth="400" TextWrapping="Wrap" IsReadOnly="True">
          <TextBox.Text>
            <Binding Path="Prompt" />
          </TextBox.Text>
        </TextBox>
      </StackPanel>
    </GroupBox>
    <StackPanel x:Uid="StackPanel_3" Orientation="Horizontal" HorizontalAlignment="Center" Grid.Row="1" Margin="{StaticResource AspenVerticalIrrelativeControlMargin}">
      <Label Name="lblDefault" x:Uid="lblDefault" HorizontalAlignment="Right" Content="{x:Static res:WpfFindComponentResources.EnterNewName}">
        <UIElement.Visibility>
          <Binding Path="LabelDefaultVisible" />
        </UIElement.Visibility>
      </Label>
      <Label Name="lblTDependent" x:Uid="lblTDependent" HorizontalAlignment="Right" Content="{x:Static res:WpfFindComponentResources.DefaultName}">
        <UIElement.Visibility>
          <Binding Path="LabelTDependentVisible" />
        </UIElement.Visibility>
      </Label>
      <TextBox Name="txtNewOrDefault" x:Uid="txtNewOrDefault" Width="80" MaxLength="8" CharacterCasing="Upper">
        <TextBoxBase.IsReadOnly>
          <Binding Path="IsParamReadonly" />
        </TextBoxBase.IsReadOnly>
        <TextBox.Text>
          <Binding Path="Param" UpdateSourceTrigger="PropertyChanged" />
        </TextBox.Text>
      </TextBox>
    </StackPanel>
    <UniformGrid x:Uid="UniformGrid_1" Grid.Row="2" HorizontalAlignment="Center">
      <Button Name="btnOK" x:Uid="btnOK" Content="{x:Static res:WpfFindComponentResources.OK}" IsDefault="True" Margin="{StaticResource AspenHorizontalRelativeControlMargin}">
        <ButtonBase.Command>
          <Binding Path="CommandOnOK" />
        </ButtonBase.Command>
        <ButtonBase.CommandParameter>
          <Binding ElementName="newPureCompParamWindow" />
        </ButtonBase.CommandParameter>
      </Button>
      <Button Name="btnCancel" x:Uid="btnCancel" Content="{x:Static res:WpfFindComponentResources.Cancel}" IsCancel="True">
        <ButtonBase.Command>
          <Binding Path="CommandOnCancel" />
        </ButtonBase.Command>
        <ButtonBase.CommandParameter>
          <Binding ElementName="newPureCompParamWindow" />
        </ButtonBase.CommandParameter>
      </Button>
    </UniformGrid>
  </Grid>
</Window>
