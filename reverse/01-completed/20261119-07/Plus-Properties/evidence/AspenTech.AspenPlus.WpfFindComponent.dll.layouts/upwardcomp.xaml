              <TextBlock Name="txtNewDataBankInstead" x:Uid="TextBlock_2" TextWrapping="Wrap" />
            </CheckBox>
            <CheckBox Name="chkNew2" x:Uid="chkNew2" MinWidth="0" IsChecked="True" IsEnabled="False" Margin="{StaticResource AspenVerticalRelativeControlMargin}">
              <TextBlock x:Uid="TextBlock_5" TextWrapping="Wrap" Text="{x:Static lp:WpfFindComponentResources.NewPropM}" />
            </CheckBox>
            <CheckBox Name="chkNew3" x:Uid="chkNew3" MinWidth="0" IsChecked="True" IsEnabled="False" Margin="{StaticResource AspenVerticalRelativeControlMargin}">
              <TextBlock x:Uid="TextBlock_6" TextWrapping="Wrap" Text="{x:Static lp:WpfFindComponentResources.NewBulitInPara}" />
            </CheckBox>
            <CheckBox Name="chkNew4" x:Uid="chkNew4" MinWidth="0" IsChecked="True" IsEnabled="False" Margin="{StaticResource AspenVerticalRelativeControlMargin}">
              <TextBlock x:Uid="TextBlock_7" TextWrapping="Wrap" Text="{x:Static lp:WpfFindComponentResources.NewProcedures}" />
            </CheckBox>
            <CheckBox Name="chkNew5" x:Uid="chkNew5" MinWidth="0" IsChecked="True" IsEnabled="False" Margin="{StaticResource AspenVerticalRelativeControlMargin}">
              <TextBlock x:Uid="TextBlock_8" TextWrapping="Wrap" Text="{x:Static lp:WpfFindComponentResources.CalcMoleWeight}" />
            </CheckBox>
          </StackPanel>
        </local:RadioButtonHeaderGroupBox>
      </StackPanel>
    </Border>
    <UniformGrid x:Uid="UniformGrid_1" Columns="3" HorizontalAlignment="Center">
      <Button Click="btnOK_Click" Name="btnOK" x:Uid="btnOK" Content="{x:Static lp:WpfFindComponentResources.OK}" IsDefault="True" Margin="{StaticResource AspenHorizontalRelativeControlMargin}" />
      <Button Click="btnCancel_Click" Name="btnCancel" x:Uid="btnCancel" Content="{x:Static lp:WpfFindComponentResources.Cancel}" Margin="{StaticResource AspenHorizontalRelativeControlMargin}" />
      <Button Name="btnHelp" x:Uid="btnHelp" Content="{x:Static lp:WpfFindComponentResources.Help}" Command="ApplicationCommands.Help" Margin="{StaticResource AspenHorizontalRelativeControlMargin}" />
    </UniformGrid>
  </StackPanel>
</Window>
