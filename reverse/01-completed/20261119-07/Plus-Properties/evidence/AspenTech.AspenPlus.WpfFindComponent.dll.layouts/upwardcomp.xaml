        </RadioButton>
        <local:RadioButtonHeaderGroupBox x:Uid="local_RadioButtonHeaderGroupBox_1">
          <HeaderedContentControl.Header>
            <RadioButton Checked="radioFollow_Checked" Name="radioFollow" x:Uid="radioFollow" GroupName="R1" Margin="{StaticResource AspenVerticalRelativeControlMargin}">
              <TextBlock x:Uid="TextBlock_4" TextWrapping="Wrap" Text="{x:Static lp:WpfFindComponentResources.UseNewFeature}" />
            </RadioButton>
          </HeaderedContentControl.Header>
          <StackPanel Name="pnlNewFeatures" x:Uid="pnlNewFeatures" Margin="3">
