<?xml version='1.0' encoding='utf-8'?>
<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:lp="clr-namespace:AspenTech.AspenPlus.Localization;assembly=AspenTech.AspenPlus.Localization" xmlns:mm="http://schemas.aspentech.com/xaml/presentation/aspenplus" xmlns:local="clr-namespace:AspenTech.AspenPlus.WpfFindComponent" x:Uid="Window_1" mm:MMHelp.HelpFile="userguide1.chm" mm:MMHelp.HelpId="1326" Width="500" Title="{x:Static lp:WpfFindComponentResources.UpwardComp1Title}" ResizeMode="NoResize" SizeToContent="Height" Style="{StaticResource MMDialogStyle}" x:Class="AspenTech.AspenPlus.WpfFindComponent.UpwardComp">
  <StackPanel x:Uid="StackPanel_1" Margin="{StaticResource AspenDialogOuterMargin}">
    <Border x:Uid="Border_1" BorderBrush="#FF000000" BorderThickness="0,0,0,2" Margin="{StaticResource AspenVerticalIrrelativeControlMargin}">
      <StackPanel x:Uid="StackPanel_2" Margin="{StaticResource AspenVerticalIrrelativeControlMargin}">
        <GroupBox x:Uid="GroupBox_1" Margin="{StaticResource AspenVerticalIrrelativeControlMargin}">
          <StackPanel x:Uid="StackPanel_3">
            <TextBlock x:Uid="TextBlock_1" TextWrapping="Wrap" LineHeight="20" Text="{x:Static lp:WpfFindComponentResources.UpwardCompInfo}" />
            <TextBlock Name="lblComp" x:Uid="lblComp" TextWrapping="Wrap" LineHeight="20" />
