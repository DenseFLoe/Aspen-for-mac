<?xml version='1.0' encoding='utf-8'?>
<mlc:WizardControlItem xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:mm="clr-namespace:AspenTech.AspenPlus.MMControls;assembly=AspenTech.AspenPlus.MMControls" xmlns:lp="clr-namespace:AspenTech.AspenPlus.Localization;assembly=AspenTech.AspenPlus.Localization" xmlns:mlc="clr-namespace:AspenTech.AspenPlus.ModelLibrary.Controls;assembly=AspenTech.AspenPlus.ModelLibrary.Controls" x:Uid="mlc_WizardControlItem_1" mm:MMHelp.HelpFile="cmpnts.chm" mm:MMHelp.HelpId="139" UseScrollViewerInside="True" Title="{x:Static lp:WpfFindComponentResources.Form11Title}" x:Class="AspenTech.AspenPlus.WpfFindComponent.ElectrolyteForm11">
  <Grid x:Uid="Grid_1">
    <Grid.RowDefinitions>
      <RowDefinition x:Uid="RowDefinition_1" Height="Auto" />
      <RowDefinition x:Uid="RowDefinition_2" Height="*" />
    </Grid.RowDefinitions>
    <Grid x:Uid="Grid_2" Grid.Row="0" Margin="{DynamicResource AspenDialogOuterMargin}">
      <Grid.RowDefinitions>
        <RowDefinition x:Uid="RowDefinition_3" Height="Auto" />
        <RowDefinition x:Uid="RowDefinition_4" Height="Auto" />
      </Grid.RowDefinitions>
      <GroupBox x:Uid="GroupBox_1" Header="{x:Static lp:WpfFindComponentResources.SelBaseCom}" Grid.Row="0" Margin="{DynamicResource AspenVerticalIrrelativeControlMargin}">
        <StackPanel x:Uid="StackPanel_1" Orientation="Horizontal">
          <GroupBox x:Uid="GroupBox_2" Header="{x:Static lp:WpfFindComponentResources.AvailableComponents}" Margin="{DynamicResource AspenHorizontalIrrelativeControlMargin}">
            <ListBox MouseDoubleClick="lstAvailableComp_MouseDoubleClick" Name="lstAvailableComp" x:Uid="lstAvailableComp" SelectionMode="Extended" MinWidth="130" Height="110" ScrollViewer.VerticalScrollBarVisibility="Auto" />
          </GroupBox>
          <StackPanel x:Uid="StackPanel_2" Orientation="Vertical" VerticalAlignment="Center" Margin="{DynamicResource AspenHorizontalIrrelativeControlMargin}">
            <Button Click="btnMove_Click" Name="btnMove" x:Uid="btnMove" Content="&gt;" MinWidth="40" Margin="{DynamicResource AspenVerticalRelativeControlMargin}" />
            <Button Click="btnMoveAll_Click" Name="btnMoveAll" x:Uid="btnMoveAll" Content="&gt;&gt;" MinWidth="40" Margin="{DynamicResource AspenVerticalRelativeControlMargin}" />
            <Button Click="btnRemove_Click" Name="btnRemove" x:Uid="btnRemove" Content="&lt;" MinWidth="40" Margin="{DynamicResource AspenVerticalRelativeControlMargin}" />
            <Button Click="btnClearAll_Click" Name="btnClearAll" x:Uid="btnClearAll" Content="&lt;&lt;" MinWidth="40" Margin="{DynamicResource AspenVerticalRelativeControlMargin}" />
          </StackPanel>
          <GroupBox x:Uid="GroupBox_3" Header="{x:Static lp:WpfFindComponentResources.SelectedComponents}">
            <ListBox MouseDoubleClick="lstSelectedComp_MouseDoubleClick" Name="lstSelectedComp" x:Uid="lstSelectedComp" SelectionMode="Extended" MinWidth="130" Height="110" ScrollViewer.VerticalScrollBarVisibility="Auto" />
          </GroupBox>
        </StackPanel>
      </GroupBox>
      <Grid x:Uid="Grid_3" Grid.Row="1">
        <Grid.ColumnDefinitions>
          <ColumnDefinition x:Uid="ColumnDefinition_1" Width="*" />
          <ColumnDefinition x:Uid="ColumnDefinition_2" Width="*" />
        </Grid.ColumnDefinitions>
        <GroupBox x:Uid="GroupBox_4" Header="{x:Static lp:WpfFindComponentResources.HydrogenIonType}" Grid.Column="0" Margin="{DynamicResource AspenHorizontalIrrelativeControlMargin}">
          <StackPanel x:Uid="StackPanel_3" Orientation="Vertical">
            <RadioButton Click="radioHydroniumIon_Click" Name="radioHydroniumIon" x:Uid="radioHydroniumIon" GroupName="RG1" Margin="{DynamicResource AspenVerticalRelativeControlMargin}" Content="{x:Static lp:WpfFindComponentResources.HydroniumIonH3O}" />
            <RadioButton Click="radioHydrogenIon_Click" Name="radioHydrogenIon" x:Uid="radioHydrogenIon" GroupName="RG1" Content="{x:Static lp:WpfFindComponentResources.HydrogenIonH}" />
          </StackPanel>
        </GroupBox>
        <GroupBox x:Uid="GroupBox_5" Header="{x:Static lp:WpfFindComponentResources.Options}" Grid.Column="1">
          <StackPanel x:Uid="StackPanel_4" Orientation="Vertical">
            <CheckBox Click="chkSaltFormation_Click" Name="chkSaltFormation" x:Uid="chkSaltFormation" MinWidth="0" Margin="{DynamicResource AspenVerticalRelativeControlMargin}" Content="{x:Static lp:WpfFindComponentResources.IncludeSaltFor}" />
            <CheckBox Click="chkWaterDissociation_Click" Name="chkWaterDissociation" x:Uid="chkWaterDissociation" MinWidth="0" Margin="{DynamicResource AspenVerticalRelativeControlMargin}">
              <TextBlock TextWrapping="Wrap" Text="{x:Static lp:WpfFindComponentResources.IncludeWaterRea}" x:Uid="TextBlock_1" />
            </CheckBox>
            <CheckBox Click="chkIceFormation_Click" Name="chkIceFormation" x:Uid="chkIceFormation" MinWidth="0" Content="{x:Static lp:WpfFindComponentResources.IncludeIceFor}" />
          </StackPanel>
        </GroupBox>
      </Grid>
    </Grid>
    <Label x:Uid="Label_1" Grid.Row="1" VerticalAlignment="Bottom" Content="{x:Static lp:WpfFindComponentResources.NextToContinue}" />
  </Grid>
</mlc:WizardControlItem>
