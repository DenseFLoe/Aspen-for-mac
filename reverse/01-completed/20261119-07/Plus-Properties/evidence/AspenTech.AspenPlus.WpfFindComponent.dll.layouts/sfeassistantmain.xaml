<?xml version='1.0' encoding='utf-8'?>
<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:mm="clr-namespace:AspenTech.AspenPlus.MMControls;assembly=AspenTech.AspenPlus.MMControls" xmlns:mc="clr-namespace:AspenTech.AspenPlus.ModelLibrary.Controls;assembly=AspenTech.AspenPlus.ModelLibrary.Controls" xmlns:local="clr-namespace:AspenTech.AspenPlus.WpfFindComponent" xmlns:res="clr-namespace:AspenTech.AspenPlus.Localization;assembly=AspenTech.AspenPlus.Localization" xmlns:lp="clr-namespace:AspenTech.AspenPlus.Localization;assembly=AspenTech.AspenPlus.Localization" mm:MMHelp.HelpFile="cmpnts.chm" mm:MMHelp.HelpId="300" ResizeMode="NoResize" ShowInTaskbar="False" SizeToContent="WidthAndHeight" WindowStartupLocation="CenterOwner" Title="{x:Static lp:WpfFindComponentResources.SFEAssistantTitle}" Style="{StaticResource MMDialogStyle}" x:Class="AspenTech.AspenPlus.WpfFindComponent.SFEAssistantMain">
  <FrameworkElement.Resources>
    <ResourceDictionary>
      <Style x:Key="{x:Type ListBoxItem}" TargetType="{x:Type ListBoxItem}">
        <Setter Property="FrameworkElement.HorizontalAlignment" Value="Stretch" />
        <Setter Property="Control.HorizontalContentAlignment" Value="Stretch" />
      </Style>
    </ResourceDictionary>
  </FrameworkElement.Resources>
  <Grid x:Uid="Grid_1" Margin="{DynamicResource AspenDialogOuterMargin}">
    <Grid.RowDefinitions>
      <RowDefinition x:Uid="RowDefinition_1" Height="Auto" />
      <RowDefinition x:Uid="RowDefinition_2" Height="{DynamicResource AspenVerticalRelativeLength}" />
      <RowDefinition x:Uid="RowDefinition_3" Height="Auto" />
      <RowDefinition x:Uid="RowDefinition_4" Height="{DynamicResource AspenVerticalRelativeLength}" />
      <RowDefinition x:Uid="RowDefinition_5" Height="*" />
      <RowDefinition x:Uid="RowDefinition_6" Height="{DynamicResource AspenVerticalRelativeLength}" />
      <RowDefinition x:Uid="RowDefinition_7" Height="Auto" />
      <RowDefinition x:Uid="RowDefinition_8" Height="{DynamicResource AspenVerticalRelativeLength}" />
      <RowDefinition x:Uid="RowDefinition_9" Height="Auto" />
    </Grid.RowDefinitions>
    <Border x:Uid="Border_1" Grid.Row="0">
      <Label x:Uid="Label_1" FontWeight="Medium">
        <ContentControl.Content>
          <Binding ElementName="theWizard" Path="CurrentItem.Title" Mode="OneWay" />
        </ContentControl.Content>
      </Label>
    </Border>
    <Border x:Uid="Border_2" Grid.Row="2" BorderBrush="#FF808080" Background="#00FFFFFF" BorderThickness="0,0,0,.8" />
    <Border x:Uid="Border_3" Grid.Row="4">
      <mc:WizardControl Finished="theWizard_Finished" Name="theWizard" x:Uid="theWizard" />
    </Border>
    <Border x:Uid="Border_4" Grid.Row="6" BorderBrush="#FF808080" Background="#00FFFFFF" BorderThickness="0,0,0,1" />
    <StackPanel x:Uid="StackPanel_1" Orientation="Horizontal" HorizontalAlignment="Center" Grid.Row="8">
      <Button Click="buttonCancel_Click" Name="buttonCancel" x:Uid="buttonCancel" IsCancel="True" Content="{x:Static lp:WpfFindComponentResources.Cancel}" />
      <Button Name="cmdBack" x:Uid="Button_1" Command="{x:Static mc:WizardControl.BackwardCommand}" Content="{x:Static lp:WpfFindComponentResources.Back}">
        <ButtonBase.CommandTarget>
          <Binding ElementName="theWizard" />
        </ButtonBase.CommandTarget>
      </Button>
      <Button Name="cmdForward" x:Uid="Button_2" Command="{x:Static mc:WizardControl.ForwardCommand}" Content="{x:Static lp:WpfFindComponentResources.Next}">
        <ButtonBase.CommandTarget>
          <Binding ElementName="theWizard" />
        </ButtonBase.CommandTarget>
      </Button>
      <StackPanel />
      <Button Name="cmdOK" x:Uid="Button_3" Command="{x:Static mc:WizardControl.FinishCommand}" Content="{x:Static lp:WpfFindComponentResources.Finish}">
        <ButtonBase.CommandTarget>
          <Binding ElementName="theWizard" />
        </ButtonBase.CommandTarget>
      </Button>
    </StackPanel>
  </Grid>
</Window>
