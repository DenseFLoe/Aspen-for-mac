<?xml version='1.0' encoding='utf-8'?>
<Window x:Class="AspenTech.Visualisation.CommonShell.RibbonTools.SaveWorkspaceLayoutDialog" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:igThemes="http://infragistics.com/Themes" xmlns:igEditors="http://infragistics.com/Editors" xmlns:atSupport="http://schemas.aspentech.com/xaml/presentation/visualisation/support" xmlns:atShell="http://schemas.aspentech.com/xaml/presentation/visualisation/commonshell" xmlns:my="clr-namespace:AspenTech.Visualisation.CommonShell.RibbonTools" Loaded="root_Loaded" x:Name="root" FocusManager.FocusedElement="{Binding ElementName=_layoutNameTextBox}" Title="{x:Static atShell:CommonShellResources.SaveLayout_DialogTitle}" Background="{DynamicResource AspenDialogBackgroundBrush}" ShowInTaskbar="False" ResizeMode="NoResize" WindowStartupLocation="CenterOwner" Width="320" SizeToContent="Height">
  <FrameworkElement.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <atSupport:AspenCommonResources />
        <atSupport:AspenCommonProperties />
        <atSupport:AspenCommonStyles />
        <atSupport:AspenDefaultStyles />
        <igThemes:EditorsOffice2010Blue />
      </ResourceDictionary.MergedDictionaries>
      <Style x:Key="GenericDropDownButtonStyle" TargetType="{x:Type ToggleButton}">
        <Setter Property="FrameworkElement.MinWidth" Value="0" />
        <Setter Property="FrameworkElement.MinHeight" Value="0" />
        <Setter Property="FrameworkElement.Width" Value="Auto" />
        <Setter Property="FrameworkElement.Height" Value="Auto" />
        <Setter Property="Panel.Background" Value="#FF008000" />
        <Setter Property="UIElement.Focusable" Value="False" />
        <Setter Property="ButtonBase.ClickMode" Value="Press" />
        <Setter Property="Control.Template">
          <Setter.Value>
            <ControlTemplate TargetType="{x:Type ToggleButton}">
              <Grid Background="{TemplateBinding Panel.Background}" SnapsToDevicePixels="True">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" SharedSizeGroup="ComboBoxButton" />
                </Grid.ColumnDefinitions>
                <Grid x:Name="ComboEditorDropdown" Grid.Column="1" HorizontalAlignment="Right" Background="#00FFFFFF" Width="15" Margin="0,1,1,1">
                  <Border x:Name="OuterBorder_Center" SnapsToDevicePixels="True" BorderBrush="{DynamicResource {x:Static igEditors:EditorsBrushKeys.DropdownBtnNormalOuterBorderFillKey}}" BorderThickness="1" Background="{DynamicResource {x:Static igEditors:EditorsBrushKeys.DropdownBtnNormalCenterFillKey}}" CornerRadius="2" />
                  <Border x:Name="InnerBorder" SnapsToDevicePixels="True" Margin="1,1,1,1" BorderBrush="{DynamicResource {x:Static igEditors:EditorsBrushKeys.DropdownBtnNormalInnerBorderFillKey}}" BorderThickness="1" CornerRadius="2" />
                </Grid>
                <Grid x:Name="glyphArrow" Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center" Width="9" Height="6" Margin="0,0,1,0">
                  <Path x:Name="glyph" HorizontalAlignment="Stretch" Width="6" RenderTransformOrigin="0,0" SnapsToDevicePixels="True" Fill="{DynamicResource {x:Static igEditors:EditorsBrushKeys.DropdownBtnGlyphNormalForegroundFillKey}}" Stretch="Fill" Data="M4,0L6,0 6,6 6,6 6,6 0,6 0,4 4,4 4,0z" Height="6" Margin="0,-5,-6,0">
                    <UIElement.RenderTransform>
                      <TransformGroup>
                        <ScaleTransform ScaleX="1" ScaleY="1" />
                        <SkewTransform AngleX="0" AngleY="0" />
                        <RotateTransform Angle="45" />
                        <TranslateTransform X="0" Y="0" />
                      </TransformGroup>
                    </UIElement.RenderTransform>
                  </Path>
                </Grid>
              </Grid>
              <ControlTemplate.Triggers>
                <Trigger Property="FrameworkElement.Tag" Value="MouseOverControlTrue">
                  <Setter TargetName="InnerBorder" Value="{DynamicResource {x:Static igEditors:EditorsBrushKeys.DropdownBtnHottrackInnerBorderFillKey}}" Property="Border.BorderBrush" />
                  <Setter TargetName="OuterBorder_Center" Value="{DynamicResource {x:Static igEditors:EditorsBrushKeys.DropdownBtnHottrackCenterFillKey}}" Property="Panel.Background" />
                  <Setter TargetName="OuterBorder_Center" Value="{DynamicResource {x:Static igEditors:EditorsBrushKeys.DropdownBtnHottrackOuterBorderFillKey}}" Property="Border.BorderBrush" />
                </Trigger>
                <Trigger Property="ToggleButton.IsChecked" Value="True">
                  <Setter TargetName="OuterBorder_Center" Value="{DynamicResource {x:Static igEditors:EditorsBrushKeys.DropdownBtnPressedOuterBorderFillKey}}" Property="Border.BorderBrush" />
                  <Setter TargetName="OuterBorder_Center" Value="{DynamicResource {x:Static igEditors:EditorsBrushKeys.DropdownBtnPressedCenterFillKey}}" Property="Panel.Background" />
                  <Setter TargetName="InnerBorder" Value="{DynamicResource {x:Static igEditors:EditorsBrushKeys.DropdownBtnPressedInnerBorderFillKey}}" Property="Border.BorderBrush" />
                </Trigger>
                <MultiTrigger>
                  <MultiTrigger.Conditions>
                    <Condition Property="ToggleButton.IsChecked" Value="False" />
                    <Condition Property="UIElement.IsMouseOver" Value="True" />
                  </MultiTrigger.Conditions>
                  <Setter TargetName="InnerBorder" Value="{DynamicResource {x:Static igEditors:EditorsBrushKeys.DropdownBtnHottrackInnerBorderFillKey}}" Property="Border.BorderBrush" />
                  <Setter TargetName="OuterBorder_Center" Value="{DynamicResource {x:Static igEditors:EditorsBrushKeys.DropdownBtnHottrackCenterFillKey}}" Property="Panel.Background" />
                  <Setter TargetName="OuterBorder_Center" Value="{DynamicResource {x:Static igEditors:EditorsBrushKeys.DropdownBtnHottrackOuterBorderFillKey}}" Property="Border.BorderBrush" />
                </MultiTrigger>
                <Trigger Property="UIElement.IsEnabled" Value="False">
                  <Setter TargetName="glyph" Property="UIElement.Opacity" Value="0.25" />
                </Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>
    </ResourceDictionary>
  </FrameworkElement.Resources>
  <Grid Margin="{StaticResource AspenDialogOuterMargin}">
    <Grid.RowDefinitions>
      <RowDefinition Height="auto" />
      <RowDefinition Height="{StaticResource AspenVerticalRelativeLength}" />
      <RowDefinition Height="auto" />
      <RowDefinition Height="{StaticResource AspenVerticalRelativeLength}" />
      <RowDefinition Height="auto" />
      <RowDefinition Height="auto" />
    </Grid.RowDefinitions>
    <TextBlock Grid.Row="0" Text="{x:Static atShell:CommonShellResources.SaveLayout_Help}" TextWrapping="WrapWithOverflow" />
    <Grid Grid.Row="2">
      <Grid.RowDefinitions>
        <RowDefinition Height="auto" />
        <RowDefinition Height="{StaticResource AspenVerticalRelativeLength}" />
        <RowDefinition Height="auto" />
      </Grid.RowDefinitions>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="auto" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>
      <igEditors:XamComboEditor Grid.Row="0" Grid.Column="1" Name="_layoutNameTextBox" TabIndex="1" IsEditable="True" VerticalAlignment="Center" IsAlwaysInEditMode="True" DropDownButtonDisplayMode="Always" DropDownButtonStyle="{StaticResource GenericDropDownButtonStyle}" ItemsSource="{Binding ExistingNames, ElementName=root}" />
      <CheckBox x:Name="_checkReplaceExisting" Grid.Row="2" Grid.Column="1" HorizontalAlignment="Left" VerticalAlignment="Center" TabIndex="2" IsChecked="{Binding ElementName=root, Path=CanReplaceExisting}">
        <AccessText TextWrapping="Wrap" Text="{x:Static atShell:CommonShellResources.SaveLayout_ReplaceExistingLabel}" />
      </CheckBox>
    </Grid>
    <Grid Grid.Row="4" HorizontalAlignment="Right">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>
      <Button Grid.Column="0" Name="_saveWorkspaceButton" TabIndex="3" IsDefault="True" Content="{x:Static atShell:CommonShellResources.SaveLayout_SaveButton}" IsEnabled="{Binding ElementName=root, Path=NameIsValid, Mode=OneWay}" />
      <Button Grid.Column="1" Name="_cancelSaveWorkspaceButton" TabIndex="4" Margin="0" IsCancel="True" Content="{x:Static atShell:CommonShellResources.SaveLayout_CancelButton}" />
    </Grid>
    <TextBlock x:Name="_errorText" Grid.Row="5" Margin="0,2" Foreground="#FFFF0000" FontStyle="Italic" Visibility="Collapsed" />
  </Grid>
</Window>
