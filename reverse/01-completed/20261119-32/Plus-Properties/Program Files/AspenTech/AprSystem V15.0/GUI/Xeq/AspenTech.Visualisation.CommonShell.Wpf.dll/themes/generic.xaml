                      </Border>
                    </Grid>
                  </Border>
                  <ControlTemplate.Triggers>
                    <Trigger Property="UIElement.IsEnabled" Value="false">
                      <Setter Value="{DynamicResource {x:Static igDock:DockManagerBrushKeys.GrayTextBrushKey}}" Property="TextElement.Foreground" />
                    </Trigger>
                    <Trigger Property="igWindows:TabItemEx.IsMouseOverTab" Value="true">
                      <Setter TargetName="nonSelectedOuterBorderSlice" Value="{DynamicResource {x:Static igDock:DockManagerBrushKeys.TabbedDocumentHottrackOuterBorderFillKey}}" Property="Shape.Fill" />
                      <Setter TargetName="nonSelectedInnerBorderSlice" Value="{DynamicResource {x:Static igDock:DockManagerBrushKeys.TabbedDocumentHottrackInnerBorderFillKey}}" Property="Shape.Fill" />
                      <Setter TargetName="HighlightBorder" Value="{DynamicResource {x:Static igDock:DockManagerBrushKeys.TabbedDocumentHottrackOuterBorderFillKey}}" Property="Border.BorderBrush" />
                      <Setter TargetName="HighlightBorder" Value="{DynamicResource {x:Static igDock:DockManagerBrushKeys.TabbedDocumentHottrackInnerBorderFillKey}}" Property="Panel.Background" />
                      <Setter Value="{DynamicResource {x:Static igDock:DockManagerBrushKeys.TabbedDocumentHottrackCenterFillKey}}" Property="Panel.Background" />
                    </Trigger>
                    <Trigger Property="TabItem.IsSelected" Value="true">
                      <Setter Property="Panel.ZIndex" Value="1" />
                      <Setter TargetName="activebrFiller" Property="UIElement.Visibility" Value="Visible" />
                      <Setter TargetName="selectedEnd" Property="UIElement.Visibility" Value="Visible" />
                      <Setter TargetName="nonSelectedEnd" Property="UIElement.Visibility" Value="Collapsed" />
                      <Setter TargetName="HighlightBorder" Value="{DynamicResource {x:Static igDock:DockManagerBrushKeys.TabbedDocumentActiveOuterBorderFillKey}}" Property="Border.BorderBrush" />
                      <Setter TargetName="HighlightBorder" Value="{DynamicResource {x:Static igDock:DockManagerBrushKeys.TabbedDocumentActiveInnerBorderFillKey}}" Property="Panel.Background" />
                      <Setter Value="{DynamicResource {x:Static igDock:DockManagerBrushKeys.TabbedDocumentActiveCenterFillKey}}" Property="Panel.Background" />
                      <Setter TargetName="HighlightBorder" Property="FrameworkElement.Margin" Value="-4,0,0,0" />
                      <Setter TargetName="Border" Property="FrameworkElement.Margin" Value="-4,1,2,-2" />
                    </Trigger>
                    <DataTrigger Value="True" Binding="{Binding Path=Pane.IsActiveDocument, RelativeSource={x:Static RelativeSource.Self}}">
                      <Setter TargetName="NormalContent" Property="UIElement.Visibility" Value="Hidden" />
                      <Setter TargetName="NormalContentBold" Property="UIElement.Visibility" Value="Visible" />
                    </DataTrigger>
                    <Trigger Property="TabItem.TabStripPlacement" Value="Bottom">
                      <Setter Property="FrameworkElement.LayoutTransform">
                        <Setter.Value>
                          <ScaleTransform ScaleY="-1" />
                        </Setter.Value>
                      </Setter>
                      <Setter TargetName="ContentDock" Property="FrameworkElement.LayoutTransform">
                        <Setter.Value>
                          <ScaleTransform ScaleY="-1" />
                        </Setter.Value>
                      </Setter>
                    </Trigger>
                    <Trigger Property="TabItem.TabStripPlacement" Value="Left">
                      <Setter Property="FrameworkElement.LayoutTransform">
                        <Setter.Value>
                          <RotateTransform Angle="-90" />
                        </Setter.Value>
                      </Setter>
                    </Trigger>
                    <Trigger Property="TabItem.TabStripPlacement" Value="Right">
                      <Setter Property="FrameworkElement.LayoutTransform">
                        <Setter.Value>
                          <RotateTransform Angle="90" />
                        </Setter.Value>
                      </Setter>
                    </Trigger>
                  </ControlTemplate.Triggers>
                </ControlTemplate>
                <ControlTemplate x:Key="{x:StaticExtension igDock:TabGroupPane.DocumentTabGroupTemplateKey}" TargetType="{x:Type igDock:TabGroupPane}">
                  <DockPanel KeyboardNavigation.TabNavigation="Local" ClipToBounds="True" SnapsToDevicePixels="True">
                    <DockPanel x:Name="PART_HeaderArea" Panel.ZIndex="1" DockPanel.Dock="{TemplateBinding TabControl.TabStripPlacement}">
                      <DockPanel>
                        <Button x:Name="closeBtn" DockPanel.Dock="Right" Command="{x:Static igDock:TabGroupPane.CloseSelectedItemCommand}" Style="{DynamicResource {x:Static igDock:TabGroupPane.DocumentCloseButtonStyleKey}}" Visibility="{x:Static atShell:CommonShellPreferences.CloseButtonOutsideTabVisibility}" />
                        <Menu x:Name="filesMenu" DockPanel.Dock="Right" Style="{StaticResource RootMenuStyle}">
                          <MenuItem x:Name="PART_FilesMenuItem" Style="{DynamicResource {x:Static igDock:TabGroupPane.DocumentFilesMenuItemStyleKey}}" />
                        </Menu>
                        <Button x:Name="showNavigatorButton" DockPanel.Dock="Right" Visibility="Collapsed" Command="{x:Static igDock:DockManagerCommands.ShowPaneNavigator}" CommandParameter="{TemplateBinding igDock:XamDockManager.DockManager}" Style="{DynamicResource {x:Static igDock:TabGroupPane.DocumentPaneNavigatorButtonStyleKey}}" />
                        <ItemsPresenter x:Name="PART_TabHeaderPanel" DockPanel.Dock="Left" KeyboardNavigation.TabIndex="1" Margin="5,2,10,0" />
                        <Button x:Name="newTabBtn" DockPanel.Dock="Left" Margin="3,0,0,1" HorizontalAlignment="Left" VerticalAlignment="Bottom" Style="{StaticResource OpenNewScreenButtonDockedLeftStyle}" Command="{x:Static local:ScreenManager.OpenNewScreenDocumentTabCommand}" CommandParameter="{Binding RelativeSource={x:Static RelativeSource.TemplatedParent}}" />
                      </DockPanel>
