                          <Path HorizontalAlignment="Center" VerticalAlignment="Center" Height="14" Width="14" Opacity="1" Data="M2,7L12,7 M7,2L7,12" Stroke="#FF000000" StrokeThickness="1" Fill="#FF000000" />
                        </Border>
                        <ControlTemplate.Triggers>
