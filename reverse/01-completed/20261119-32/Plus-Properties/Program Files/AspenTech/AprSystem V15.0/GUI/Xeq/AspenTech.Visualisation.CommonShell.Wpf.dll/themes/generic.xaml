                    <Grid x:Name="TabbedDocumentTab" VerticalAlignment="Stretch" HorizontalAlignment="Stretch">
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                      </Grid.ColumnDefinitions>
                      <Grid x:Name="nonSelectedEnd">
