                      <ControlTemplate TargetType="{x:Type Button}">
                        <Border Background="{TemplateBinding Panel.Background}" CornerRadius="{TemplateBinding Border.CornerRadius}" BorderBrush="{TemplateBinding Border.BorderBrush}" BorderThickness="{TemplateBinding Border.BorderThickness}" SnapsToDevicePixels="True">
                          <Path Margin="2,1,0,0" HorizontalAlignment="Left" VerticalAlignment="Top" Height="8" Width="8" Stretch="Fill" Opacity="1" Data="M1244,87C1244,87 1243,88 1243,88 1243,88 1246,91 1246,91 1246,91 1243,94 1243,94 1243,94 1244,95 1244,95 1244,95 1247,92 1247,92 1247,92 1250,95 1250,95 1250,95 1251,94 1251,94 1251,94 1248,91 1248,91 1248,91 1251,88 1251,88 1251,88 1250,87 1250,87 1250,87 1247,90 1247,90 1247,90 1244,87 1244,87z" Fill="{TemplateBinding TextElement.Foreground}" />
                        </Border>
