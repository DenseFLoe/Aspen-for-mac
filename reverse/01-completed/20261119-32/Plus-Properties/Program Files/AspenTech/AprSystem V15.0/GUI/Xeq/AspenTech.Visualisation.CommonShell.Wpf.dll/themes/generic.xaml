                        <Path x:Name="nonSelectedInnerBorderSlice" Margin="1,3,0,0" VerticalAlignment="Stretch" Height="Auto" Stretch="Fill" Opacity="1" Data="M619,52C619,52 617,52 617,52 609,52 607,55 607,55 607,55 596,66 596,66 596,66 619,66 619,66 619,66 619,52 619,52z" Fill="{DynamicResource {x:Static igDock:DockManagerBrushKeys.TabbedDocumentNotActiveInnerBorderFillKey}}" />
                        <Path x:Name="nonSelectedCenterSlice" Margin="2,3,0,0" VerticalAlignment="Stretch" Height="Auto" Stretch="Fill" Opacity="1" Data="M619,52C619,52 618,52 618,52 610,52 608,55 608,55 608,55 597,66 597,66 597,66 619,66 619,66 619,66 619,52 619,52z" Fill="{TemplateBinding Panel.Background}" />
