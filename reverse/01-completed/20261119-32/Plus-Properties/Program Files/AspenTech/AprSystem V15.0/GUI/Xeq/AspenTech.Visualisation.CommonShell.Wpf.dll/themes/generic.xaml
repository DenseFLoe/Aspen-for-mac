                        <Path x:Name="selectedInnerBorderSlice" Stretch="Fill" Data="M518,48C518,48 516,48 516,48 508,48 506,51 506,51 506,51 492,65 492,65 492,65 518,65 518,65 518,65 518,48 518,48z" Fill="{DynamicResource {x:Static igDock:DockManagerBrushKeys.TabbedDocumentActiveInnerBorderFillKey}}" SnapsToDevicePixels="True" Margin="1,1,-3,0" />
                        <Path x:Name="selectedCenterSlice" Stretch="Fill" Data="M492,66C492,66 518,66 518,66 518,66 518,48 518,48 518,48 517,48 517,48 509,48 507,51 507,51 507,51 492,66 492,66z" Fill="{TemplateBinding Panel.Background}" SnapsToDevicePixels="True" Margin="0,1,-2,-1" />
