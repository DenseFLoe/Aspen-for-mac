<?xml version='1.0' encoding='utf-8'?>
<Popup x:Class="AspenTech.AspenPlus.MMForms.GridForms.Controls.TreeViewPopupSelector" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:igEditors="http://infragistics.com/Editors" xmlns:localData="clr-namespace:AspenTech.AspenPlus.MMForms.GridForms.Controls.Data" xmlns:lp="clr-namespace:AspenTech.AspenPlus.Localization;assembly=AspenTech.AspenPlus.Localization" x:Uid="Popup_1" StaysOpen="False">
  <FrameworkElement.DataContext>
    <Binding>
      <Binding.RelativeSource>
        <RelativeSource Mode="Self" />
      </Binding.RelativeSource>
    </Binding>
  </FrameworkElement.DataContext>
  <Border x:Uid="Border_1" BorderBrush="{DynamicResource {x:Static igEditors:EditorsBrushKeys.EditorsNormalBorderFillKey}}" Background="{DynamicResource {x:Static SystemColors.WindowBrushKey}}" BorderThickness="1" Padding="2">
    <FrameworkElement.Width>
      <Binding Path="PopupWidth" Mode="OneWay" />
    </FrameworkElement.Width>
    <FrameworkElement.MaxHeight>
      <Binding Path="PopupHeight" Mode="OneWay" />
    </FrameworkElement.MaxHeight>
    <TreeView x:Uid="TreeView_1">
      <ItemsControl.ItemsSource>
        <Binding Path="Items" Mode="OneWay" />
      </ItemsControl.ItemsSource>
      <ItemsControl.ItemTemplate>
        <HierarchicalDataTemplate x:Uid="HierarchicalDataTemplate_1" DataType="{x:Type localData:TreeViewComboItem}">
          <HierarchicalDataTemplate.ItemsSource>
            <Binding Path="Children" Mode="OneWay" />
          </HierarchicalDataTemplate.ItemsSource>
          <StackPanel x:Uid="StackPanel_1" Orientation="Horizontal">
            <Image x:Name="PART_ItemImage" x:Uid="PART_ItemImage" Width="16" Height="16" VerticalAlignment="Center" Margin="0,0,2,0">
              <Image.Source>
                <Binding Path="HeaderImageSource" Mode="OneWay" />
              </Image.Source>
            </Image>
            <TextBlock x:Uid="TextBlock_1" VerticalAlignment="Center">
              <TextBlock.Text>
                <Binding Path="Title" Mode="OneWay" />
              </TextBlock.Text>
            </TextBlock>
          </StackPanel>
          <DataTemplate.Triggers>
            <DataTrigger x:Uid="DataTrigger_1" Value="True">
              <DataTrigger.Binding>
                <Binding Path="IsExpanded" Mode="OneWay" />
              </DataTrigger.Binding>
              <Setter x:Uid="Setter_1" TargetName="PART_ItemImage" Property="Image.Source">
                <Setter.Value>
                  <Binding Path="ExpandedHeaderImageSource" />
                </Setter.Value>
              </Setter>
            </DataTrigger>
          </DataTemplate.Triggers>
        </HierarchicalDataTemplate>
      </ItemsControl.ItemTemplate>
      <ItemsControl.ItemContainerStyle>
        <Style x:Uid="Style_1" TargetType="{x:Type TreeViewItem}">
          <Setter x:Uid="Setter_2" Property="TreeViewItem.IsSelected">
            <Setter.Value>
              <Binding Path="IsSelected" Mode="TwoWay" />
            </Setter.Value>
          </Setter>
          <Setter x:Uid="Setter_3" Property="TreeViewItem.IsExpanded">
            <Setter.Value>
              <Binding Path="IsExpanded" Mode="TwoWay" />
            </Setter.Value>
          </Setter>
          <Setter x:Uid="Setter_4" Property="Border.BorderBrush" Value="#00FFFFFF" />
          <Setter x:Uid="Setter_5" Property="Border.BorderThickness" Value="1" />
          <Style.Triggers>
            <Trigger x:Uid="Trigger_1" Property="UIElement.IsMouseOver" Value="True">
              <Setter x:Uid="Setter_6" Property="Border.BorderBrush" Value="{DynamicResource {x:Static igEditors:EditorsBrushKeys.EditorsNormalBorderFillKey}}" />
            </Trigger>
          </Style.Triggers>
        </Style>
      </ItemsControl.ItemContainerStyle>
    </TreeView>
  </Border>
</Popup>
