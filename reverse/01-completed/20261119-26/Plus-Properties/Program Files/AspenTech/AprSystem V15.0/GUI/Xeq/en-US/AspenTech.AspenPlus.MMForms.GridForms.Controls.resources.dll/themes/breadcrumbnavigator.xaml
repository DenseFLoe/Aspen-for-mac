<?xml version='1.0' encoding='utf-8'?>
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:AspenTech.AspenPlus.MMForms.GridForms.Controls" xmlns:localData="clr-namespace:AspenTech.AspenPlus.MMForms.GridForms.Controls.Data">
  <BooleanToVisibilityConverter x:Key="btvConverter" />
  <Style x:Key="triangleButtonStyle" TargetType="{x:Type Button}">
    <Setter Property="Control.Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type Button}">
          <Border x:Name="PART_Border" Background="#00FFFFFF" BorderBrush="#00FFFFFF" BorderThickness="1" Width="16" Height="16">
            <Path x:Name="PART_Path" Data="M0,0L5,5 0,10z" Stretch="None" Fill="#FF000000" Width="5" Height="10" VerticalAlignment="Center" HorizontalAlignment="Center" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="UIElement.IsMouseOver" Value="True">
              <Setter TargetName="PART_Border" Property="Border.BorderBrush" Value="#FF808080" />
              <Setter TargetName="PART_Border" Property="Panel.Background" Value="#FFFFFFE0" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style x:Key="{x:Type local:BreadCrumbNavigator}" TargetType="{x:Type local:BreadCrumbNavigator}">
    <Setter Property="Control.Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type local:BreadCrumbNavigator}">
          <Border Background="{TemplateBinding Panel.Background}" BorderBrush="{TemplateBinding Border.BorderBrush}" BorderThickness="{TemplateBinding Border.BorderThickness}">
            <StackPanel Orientation="Horizontal">
              <TextBlock Text="{TemplateBinding local:BreadCrumbNavigator.Header}" VerticalAlignment="Center" />
              <ItemsControl Margin="3,0,0,0" VerticalAlignment="Center" ItemsSource="{TemplateBinding local:BreadCrumbNavigator.TiledNodes}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate DataType="{x:Type local:BreadCrumbNode}">
                    <StackPanel Orientation="Horizontal">
                      <TextBlock Margin="3,0,0,0" VerticalAlignment="Center">
                        <Hyperlink Command="{x:Static local:BreadCrumbNavigator.NodeTextClickedCommand}">
                          <Hyperlink.CommandParameter>
                            <Binding />
                          </Hyperlink.CommandParameter>
                          <Run>
                            <Run.Text>
                              <Binding Path="Text" Mode="OneWay" />
                            </Run.Text>
                          </Run>
                        </Hyperlink>
                      </TextBlock>
                      <Button Margin="3,0,0,0" Style="{StaticResource triangleButtonStyle}" Command="{x:Static local:BreadCrumbNavigator.NodeDropDownClickedCommand}" VerticalAlignment="Center" Content="...">
                        <ButtonBase.CommandParameter>
                          <Binding />
                        </ButtonBase.CommandParameter>
                        <UIElement.Visibility>
                          <Binding Path="HasChildren" Converter="{StaticResource btvConverter}" Mode="OneWay" />
                        </UIElement.Visibility>
                      </Button>
                    </StackPanel>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate>
                    <StackPanel Orientation="Horizontal" />
                  </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
              </ItemsControl>
            </StackPanel>
          </Border>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
</ResourceDictionary>
