<?xml version='1.0' encoding='utf-8'?>
<Window x:Class="AspenTech.AspenPlus.MMForms.GridForms.Controls.SheetNameDialog" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:lp="clr-namespace:AspenTech.AspenPlus.Localization;assembly=AspenTech.AspenPlus.Localization" x:Uid="Window_1" Title="{x:Static lp:GridFormsResources.SheetNameDialog_Title}" SizeToContent="WidthAndHeight" ShowInTaskbar="False" ResizeMode="NoResize" WindowStartupLocation="CenterOwner" Background="{DynamicResource AspenDialogBackgroundBrush}">
  <StackPanel x:Uid="StackPanel_1" Orientation="Vertical" MinWidth="200" Margin="{DynamicResource AspenDialogOuterMargin}">
    <Label x:Uid="Label_1" Margin="{DynamicResource AspenVerticalRelativeControlMargin}" Content="{x:Static lp:GridFormsResources.SheetNameDialog_Label}" />
    <TextBox TextChanged="textboxName_TextChanged" x:Name="textboxName" x:Uid="textboxName" Margin="{DynamicResource AspenVerticalRelativeControlMargin}" MaxLength="21" />
    <StackPanel x:Uid="StackPanel_2" Orientation="Horizontal" HorizontalAlignment="Right">
      <Button Click="buttonOK_Click" x:Name="buttonOK" x:Uid="buttonOK" IsDefault="True" IsEnabled="False" Content="{x:Static lp:GridFormsResources.SheetNameDialog_Button_OK}" />
      <Button x:Name="buttonCancel" x:Uid="buttonCancel" Margin="0" IsCancel="True" Content="{x:Static lp:GridFormsResources.SheetNameDialog_Button_Cancel}" />
    </StackPanel>
  </StackPanel>
</Window>
