<?xml version='1.0' encoding='utf-8'?>
<Popup x:Class="AspenTech.AspenPlus.MMForms.GridForms.Controls.PopupSelector" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:data="clr-namespace:AspenTech.AspenPlus.MMForms.GridForms.Controls.Data" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:igEditors="http://infragistics.com/Editors" xmlns:lp="clr-namespace:AspenTech.AspenPlus.Localization;assembly=AspenTech.AspenPlus.Localization" x:Uid="Popup_1" StaysOpen="False">
  <FrameworkElement.DataContext>
    <Binding>
      <Binding.RelativeSource>
        <RelativeSource Mode="Self" />
      </Binding.RelativeSource>
    </Binding>
  </FrameworkElement.DataContext>
  <Border x:Uid="Border_1" Padding="2">
    <FrameworkElement.Width>
      <Binding Path="PopupWidth" Mode="OneWay" />
    </FrameworkElement.Width>
    <FrameworkElement.MaxHeight>
      <Binding Path="PopupHeight" Mode="OneWay" />
    </FrameworkElement.MaxHeight>
    <FrameworkElement.Style>
      <Style x:Uid="Style_1" TargetType="{x:Type Border}">
        <Setter x:Uid="Setter_1" Property="Panel.Background" Value="{DynamicResource {x:Static SystemColors.WindowBrushKey}}" />
        <Setter x:Uid="Setter_2" Property="Border.BorderBrush" Value="{DynamicResource {x:Static igEditors:EditorsBrushKeys.EditorsNormalBorderFillKey}}" />
        <Setter x:Uid="Setter_3" Property="Border.BorderThickness" Value="1" />
      </Style>
    </FrameworkElement.Style>
    <Grid x:Uid="Grid_1">
      <Grid.RowDefinitions>
        <RowDefinition x:Uid="RowDefinition_1" Height="*" />
        <RowDefinition x:Uid="RowDefinition_2" Height="1" />
        <RowDefinition x:Uid="RowDefinition_3" Height="Auto" />
      </Grid.RowDefinitions>
      <ListBox x:Name="theListBox" x:Uid="theListBox" Grid.Row="0" BorderThickness="0" SelectionMode="Single">
        <ItemsControl.ItemsSource>
          <Binding Path="Items" Mode="OneWay" />
        </ItemsControl.ItemsSource>
        <ItemsControl.ItemTemplate>
          <DataTemplate x:Uid="DataTemplate_1" DataType="{x:Type data:CheckableItem}">
            <CheckBox x:Uid="CheckBox_1" MinWidth="0">
              <ToggleButton.IsChecked>
                <Binding Path="IsChecked" Mode="TwoWay" UpdateSourceTrigger="PropertyChanged" />
              </ToggleButton.IsChecked>
              <ContentControl.Content>
                <Binding Path="Content" Mode="OneWay" />
              </ContentControl.Content>
            </CheckBox>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ListBox>
      <Border x:Uid="Border_2" Height="1" Grid.Row="1">
        <FrameworkElement.Style>
          <Style x:Uid="Style_2" TargetType="{x:Type Border}">
            <Setter x:Uid="Setter_4" Property="Panel.Background" Value="{DynamicResource {x:Static igEditors:EditorsBrushKeys.EditorsNormalBorderFillKey}}" />
          </Style>
        </FrameworkElement.Style>
      </Border>
      <CheckBox Click="checkBoxAll_Click" x:Name="checkBoxAll" x:Uid="checkBoxAll" Grid.Row="2" MinWidth="0" Margin="5,2,0,0" IsThreeState="True" Content="{x:Static lp:GridFormsResources.PopupSelector_CheckAll}" />
    </Grid>
  </Border>
</Popup>
