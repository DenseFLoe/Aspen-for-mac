<?xml version='1.0' encoding='utf-8'?>
<Window x:Class="AspenTech.AspenPlus.MMForms.GridForms.Controls.VariableQueryDialog" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:mm="clr-namespace:AspenTech.AspenPlus.MMControls;assembly=AspenTech.AspenPlus.MMControls" xmlns:lp="clr-namespace:AspenTech.AspenPlus.Localization;assembly=AspenTech.AspenPlus.Localization" xmlns:data="clr-namespace:AspenTech.AspenPlus.MMForms.GridForms.Controls.Data" xmlns:gc="clr-namespace:AspenTech.Engineering.GridControls;assembly=AspenTech.Engineering.GridControls" xmlns:local="clr-namespace:AspenTech.AspenPlus.MMForms.GridForms.Controls" xmlns:converters="clr-namespace:AspenTech.AspenPlus.MMForms.GridForms.Controls.Converters" x:Uid="Window_1" Title="{x:Static lp:GridFormsResources.VariableQueryDialog_Title}" mm:MMHelp.HelpFile="eoconf.chm" mm:MMHelp.HelpId="168" MinWidth="480" MinHeight="400" Width="600" Height="400" ShowInTaskbar="False" WindowStartupLocation="CenterOwner" Background="{DynamicResource AspenDialogBackgroundBrush}">
  <FrameworkElement.Resources>
    <ResourceDictionary>
      <converters:RadioButtonValueConverter x:Key="rbvConverter" x:Uid="converters_RadioButtonValueConverter_1" />
      <converters:ObjectEqualConverter x:Key="equalConverter" x:Uid="converters_ObjectEqualConverter_1" />
      <Style x:Key="{x:Type ComboBox}" x:Uid="Style_1" TargetType="{x:Type ComboBox}">
        <Setter x:Uid="Setter_1" Property="FrameworkElement.MinWidth" Value="100" />
      </Style>
    </ResourceDictionary>
  </FrameworkElement.Resources>
  <DockPanel x:Uid="DockPanel_1" Margin="{DynamicResource AspenDialogOuterMargin}" LastChildFill="True">
    <FrameworkElement.DataContext>
      <Binding>
        <Binding.RelativeSource>
          <RelativeSource Mode="FindAncestor" AncestorType="Window" />
        </Binding.RelativeSource>
      </Binding>
    </FrameworkElement.DataContext>
    <DockPanel DockPanel.Dock="Top">
      <mm:MMInContextGuidanceButton DockPanel.Dock="Right" VerticalAlignment="Top" Margin="2,-4,-4,0" />
      <GroupBox x:Uid="GroupBox_1" Header="{x:Static lp:GridFormsResources.VariableQueryDialog_Conditions_Header}" Margin="{DynamicResource AspenVerticalRelativeControlMargin}">
        <StackPanel x:Uid="StackPanel_1" Grid.IsSharedSizeScope="True">
          <RadioButton x:Uid="RadioButton_1" Margin="{DynamicResource AspenVerticalRelativeControlMargin}">
            <ToggleButton.IsChecked>
              <Binding Path="SelectedType" Mode="TwoWay" Converter="{StaticResource rbvConverter}" ConverterParameter="0" />
            </ToggleButton.IsChecked>
            <Grid x:Uid="Grid_1">
              <UIElement.IsEnabled>
                <Binding Path="IsChecked" Mode="OneWay">
                  <Binding.RelativeSource>
                    <RelativeSource Mode="FindAncestor" AncestorType="RadioButton" />
                  </Binding.RelativeSource>
                </Binding>
              </UIElement.IsEnabled>
              <Grid.ColumnDefinitions>
                <ColumnDefinition x:Uid="ColumnDefinition_1" SharedSizeGroup="C1" Width="Auto" />
                <ColumnDefinition x:Uid="ColumnDefinition_2" SharedSizeGroup="C2" Width="Auto" />
              </Grid.ColumnDefinitions>
              <StackPanel x:Uid="StackPanel_2" Orientation="Horizontal" HorizontalAlignment="Left" Grid.Column="0">
                <UIElement.IsEnabled>
                  <Binding Path="IsChecked" Mode="OneWay">
                    <Binding.RelativeSource>
                      <RelativeSource Mode="FindAncestor" AncestorType="RadioButton" />
                    </Binding.RelativeSource>
                  </Binding>
                </UIElement.IsEnabled>
                <ComboBox SelectionChanged="comboBoxVariable_SelectionChanged" x:Name="comboBoxVariable" x:Uid="comboBoxVariable" MinWidth="130" DisplayMemberPath="DisplayName" Margin="{DynamicResource AspenHorizontalRelativeControlMargin}">
                  <Selector.SelectedItem>
                    <Binding Path="SelectedField" Mode="TwoWay" />
                  </Selector.SelectedItem>
                  <ItemsControl.ItemsSource>
                    <Binding Path="Fields" Mode="OneWay" />
                  </ItemsControl.ItemsSource>
                </ComboBox>
                <ComboBox x:Name="comboBoxOperator" x:Uid="comboBoxOperator" Margin="{DynamicResource AspenHorizontalRelativeControlMargin}">
                  <Selector.SelectedItem>
                    <Binding Path="SelectedQueryOperator" Mode="TwoWay" />
                  </Selector.SelectedItem>
                  <ItemsControl.ItemsSource>
                    <Binding Path="QueryOperators" Mode="OneWay" />
                  </ItemsControl.ItemsSource>
                </ComboBox>
              </StackPanel>
              <Grid x:Uid="Grid_2" Grid.Column="1">
                <ComboBox x:Name="comboBoxOperatorRightBool" x:Uid="comboBoxOperatorRightBool" Visibility="Collapsed">
                  <Selector.SelectedItem>
                    <Binding Path="SelectedQueryRightBool" Mode="TwoWay" />
                  </Selector.SelectedItem>
                  <ItemsControl.ItemsSource>
                    <Binding Path="BooleanValues" Mode="OneWay" />
                  </ItemsControl.ItemsSource>
                </ComboBox>
                <ComboBox x:Name="comboBoxOperatorRightItem" x:Uid="comboBoxOperatorRightItem" Visibility="Collapsed">
                  <Selector.SelectedItem>
                    <Binding Path="SelectedQueryRightItem" Mode="TwoWay" />
                  </Selector.SelectedItem>
                  <ItemsControl.ItemsSource>
                    <Binding Path="SelectedField.ItemsSource" Mode="OneWay" />
                  </ItemsControl.ItemsSource>
                </ComboBox>
                <TextBox x:Name="textBoxRightText" x:Uid="textBoxRightText" Visibility="Visible" MinWidth="100">
                  <TextBox.Text>
                    <Binding Path="SelectedQueryRightText" Mode="TwoWay" UpdateSourceTrigger="PropertyChanged" />
                  </TextBox.Text>
                </TextBox>
              </Grid>
            </Grid>
          </RadioButton>
          <RadioButton x:Uid="RadioButton_2" Margin="{DynamicResource AspenVerticalRelativeControlMargin}">
            <ToggleButton.IsChecked>
              <Binding Path="SelectedType" Mode="TwoWay" Converter="{StaticResource rbvConverter}" ConverterParameter="1" />
            </ToggleButton.IsChecked>
            <UIElement.IsEnabled>
              <Binding Path="CanMatchWithModified" Mode="OneWay" />
            </UIElement.IsEnabled>
            <Grid x:Uid="Grid_3">
              <UIElement.IsEnabled>
                <Binding Path="IsChecked" Mode="OneWay">
                  <Binding.RelativeSource>
                    <RelativeSource Mode="FindAncestor" AncestorType="RadioButton" />
                  </Binding.RelativeSource>
                </Binding>
              </UIElement.IsEnabled>
              <Grid.ColumnDefinitions>
                <ColumnDefinition x:Uid="ColumnDefinition_3" SharedSizeGroup="C1" Width="Auto" />
                <ColumnDefinition x:Uid="ColumnDefinition_4" SharedSizeGroup="C2" Width="Auto" />
              </Grid.ColumnDefinitions>
              <Label x:Uid="Label_1" Content="{x:Static lp:GridFormsResources.VariableQueryDialog_Conditions_OptionLabel2}" Margin="{DynamicResource AspenHorizontalRelativeControlMargin}" Grid.Column="0" MinWidth="220">
                <Control.Foreground>
                  <Binding Path="Foreground" />
                </Control.Foreground>
              </Label>
              <ComboBox x:Name="comboBoxModifiedAttr" x:Uid="ComboBox_1" Grid.Column="1" DisplayMemberPath="DisplayName" MinWidth="130">
                <Selector.SelectedItem>
                  <Binding Path="SelectedModifiedField" Mode="TwoWay" />
                </Selector.SelectedItem>
                <ItemsControl.ItemsSource>
                  <Binding Path="ModifiableFields" Mode="OneWay" />
                </ItemsControl.ItemsSource>
              </ComboBox>
            </Grid>
          </RadioButton>
          <RadioButton x:Uid="RadioButton_3" Margin="{DynamicResource AspenVerticalRelativeControlMargin}">
            <ToggleButton.IsChecked>
              <Binding Path="SelectedType" Mode="TwoWay" Converter="{StaticResource rbvConverter}" ConverterParameter="2" />
            </ToggleButton.IsChecked>
            <UIElement.IsEnabled>
              <Binding Path="CanMatchInObjectiveFunction" Mode="OneWay" />
            </UIElement.IsEnabled>
            <Grid x:Uid="Grid_4">
              <UIElement.IsEnabled>
                <Binding Path="IsChecked" Mode="OneWay">
                  <Binding.RelativeSource>
                    <RelativeSource Mode="FindAncestor" AncestorType="RadioButton" />
                  </Binding.RelativeSource>
                </Binding>
              </UIElement.IsEnabled>
              <Grid.ColumnDefinitions>
                <ColumnDefinition x:Uid="ColumnDefinition_5" SharedSizeGroup="C1" Width="Auto" />
                <ColumnDefinition x:Uid="ColumnDefinition_6" SharedSizeGroup="C2" Width="Auto" />
              </Grid.ColumnDefinitions>
              <Label x:Uid="Label_2" Grid.Column="0" Content="{x:Static lp:GridFormsResources.VariableQueryDialog_Conditions_OptionLabel3}" Margin="{DynamicResource AspenHorizontalRelativeControlMargin}" MinWidth="220">
                <Control.Foreground>
                  <Binding Path="Foreground" />
                </Control.Foreground>
              </Label>
              <TextBox x:Name="textBoxObjFunc" x:Uid="TextBox_1" Grid.Column="1" MinWidth="100">
                <TextBox.Text>
                  <Binding Path="SelectedObjectiveFunction" Mode="TwoWay" UpdateSourceTrigger="PropertyChanged" />
                </TextBox.Text>
              </TextBox>
            </Grid>
          </RadioButton>
        </StackPanel>
      </GroupBox>
    </DockPanel>
    <StackPanel x:Uid="StackPanel_3" DockPanel.Dock="Top" Orientation="Horizontal" HorizontalAlignment="Right" Margin="{DynamicResource AspenVerticalRelativeControlMargin}">
      <Button x:Name="buttonAddCondition" x:Uid="buttonAddCondition" Command="{x:Static local:VariableQueryDialog.AddConditionCommand}" Content="{x:Static lp:GridFormsResources.VariableQueryDialog_Button_AddCondition}" />
      <Button x:Name="buttonClear" x:Uid="buttonClear" Margin="0" Command="{x:Static local:VariableQueryDialog.ClearCommand}" Content="{x:Static lp:GridFormsResources.VariableQueryDialog_Button_Clear}" />
    </StackPanel>
    <StackPanel x:Uid="StackPanel_4" DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right">
      <Button Click="buttonOK_Click" x:Name="buttonOK" x:Uid="buttonOK" IsDefault="True" Content="{x:Static lp:GridFormsResources.VariableQueryDialog_Button_OK}" />
      <Button Click="buttonCancel_Click" x:Name="buttonCancel" x:Uid="buttonCancel" IsCancel="True" Content="{x:Static lp:GridFormsResources.VariableQueryDialog_Button_Cancel}" />
      <Button x:Name="buttonHelp" x:Uid="buttonHelp" Margin="0" Command="ApplicationCommands.Help" Content="{x:Static lp:GridFormsResources.VariableQueryDialog_Button_Help}" />
    </StackPanel>
    <DockPanel x:Uid="DockPanel_2" Margin="{DynamicResource AspenVerticalRelativeControlMargin}">
      <StackPanel x:Uid="StackPanel_5" DockPanel.Dock="Left" Margin="{DynamicResource AspenHorizontalRelativeControlMargin}">
        <Button Click="buttonConditionAnd_Click" x:Name="buttonConditionAnd" x:Uid="buttonConditionAnd" MinWidth="30" Margin="{DynamicResource AspenVerticalRelativeControlMargin}" Content="{x:Static lp:GridFormsResources.VariableQueryDialog_Button_Condition_And}" />
        <Button Click="buttonConditionOr_Click" x:Name="buttonConditionOr" x:Uid="buttonConditionOr" MinWidth="30" Margin="{DynamicResource AspenVerticalRelativeControlMargin}" Content="{x:Static lp:GridFormsResources.VariableQueryDialog_Button_Condition_Or}" />
        <Button Click="buttonConditionNot_Click" x:Name="buttonConditionNot" x:Uid="buttonConditionNot" MinWidth="30" Margin="{DynamicResource AspenVerticalRelativeControlMargin}" Content="{x:Static lp:GridFormsResources.VariableQueryDialog_Button_Condition_Not}" />
        <Button Click="buttonConditionLeftBracket_Click" x:Name="buttonConditionLeftBracket" x:Uid="buttonConditionLeftBracket" MinWidth="30" Margin="{DynamicResource AspenVerticalRelativeControlMargin}" Content="{x:Static lp:GridFormsResources.VariableQueryDialog_Button_Condition_LeftBracket}" />
        <Button Click="buttonConditionRightBracket_Click" x:Name="buttonConditionRightBracket" x:Uid="buttonConditionRightBracket" Margin="0" MinWidth="30" Content="{x:Static lp:GridFormsResources.VariableQueryDialog_Button_Condition_RightBracket}" />
      </StackPanel>
      <TextBox x:Name="textBoxQuery" x:Uid="textBoxQuery" VerticalAlignment="Stretch" AcceptsReturn="True" VerticalScrollBarVisibility="Visible">
        <TextBox.Text>
          <Binding Path="QueryString" Mode="TwoWay" UpdateSourceTrigger="PropertyChanged" />
        </TextBox.Text>
      </TextBox>
    </DockPanel>
  </DockPanel>
</Window>
