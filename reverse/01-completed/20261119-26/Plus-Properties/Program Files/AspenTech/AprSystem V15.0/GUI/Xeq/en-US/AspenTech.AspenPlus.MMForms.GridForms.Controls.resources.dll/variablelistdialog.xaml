<?xml version='1.0' encoding='utf-8'?>
<Window x:Class="AspenTech.AspenPlus.MMForms.GridForms.Controls.VariableListDialog" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:lp="clr-namespace:AspenTech.AspenPlus.Localization;assembly=AspenTech.AspenPlus.Localization" xmlns:local="clr-namespace:AspenTech.AspenPlus.MMForms.GridForms.Controls" xmlns:localData="clr-namespace:AspenTech.AspenPlus.MMForms.GridForms.Controls.Data" xmlns:shellImages="http://schemas.aspentech.com/xaml/presentation/visualisation/commonimages" xmlns:shellSupport="http://schemas.aspentech.com/xaml/presentation/visualisation/support" xmlns:gc="clr-namespace:AspenTech.Engineering.GridControls;assembly=AspenTech.Engineering.GridControls" x:Uid="Window_1" Title="{x:Static lp:GridFormsResources.VariableListDialog_Title}" MinWidth="600" MinHeight="300" Width="840" Height="400" ShowInTaskbar="False" ResizeMode="CanResizeWithGrip" WindowStartupLocation="CenterOwner" Background="{DynamicResource AspenDialogBackgroundBrush}">
  <Grid Margin="7">
    <FrameworkElement.DataContext>
      <Binding>
        <Binding.RelativeSource>
          <RelativeSource Mode="FindAncestor" AncestorType="Window" />
        </Binding.RelativeSource>
      </Binding>
    </FrameworkElement.DataContext>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>
    <Grid Grid.Row="0" Margin="{DynamicResource AspenVerticalRelativeControlMargin}">
      <WrapPanel Orientation="Horizontal" Background="#FFF5F5F5" HorizontalAlignment="Stretch">
        <local:BreadCrumbNavigator x:Name="navigator" Header="{x:Static lp:GridFormsResources.VariableListDialog_Scope}" Margin="{DynamicResource AspenHorizontalRelativeControlMargin}">
          <local:BreadCrumbNavigator.SelectedNode>
            <Binding Path="SelectedBreadCrumbNode" Mode="TwoWay" />
          </local:BreadCrumbNavigator.SelectedNode>
        </local:BreadCrumbNavigator>
        <Border x:Name="border">
          <FrameworkElement.Height>
            <Binding ElementName="sp_filters" Path="ActualHeight" />
          </FrameworkElement.Height>
          <FrameworkElement.Width>
            <Binding ElementName="sp_filters" Path="ActualWidth" />
          </FrameworkElement.Width>
        </Border>
      </WrapPanel>
      <StackPanel x:Name="sp_filters" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Bottom">
        <Button x:Name="buttonChooseColumns" Margin="{DynamicResource AspenHorizontalRelativeControlMargin}" Content="{x:Static lp:GridFormsResources.VariableListDialog_ChooseColumns}" VerticalAlignment="Center">
          <ButtonBase.Command>
            <Binding Path="ChooseColumnsCommand" Mode="OneWay" />
          </ButtonBase.Command>
        </Button>
        <StackPanel Orientation="Horizontal">
          <Label Content="{x:Static lp:GridFormsResources.VariableListDialog_ShowOnly}" Margin="{DynamicResource AspenHorizontalRelativeControlMargin}" />
          <CheckBox x:Name="checkChanged" Content="{x:Static lp:GridFormsResources.VariableListDialog_ShowOnlyChanged}" Margin="{DynamicResource AspenHorizontalRelativeControlMargin}" VerticalAlignment="Center">
            <ToggleButton.IsChecked>
              <Binding Path="ShowOnlyChanged" Mode="TwoWay" />
            </ToggleButton.IsChecked>
          </CheckBox>
          <CheckBox x:Name="checkMarked" Content="{x:Static lp:GridFormsResources.VariableListDialog_ShowOnlyMarked}" Margin="{DynamicResource AspenHorizontalRelativeControlMargin}" VerticalAlignment="Center">
            <ToggleButton.IsChecked>
              <Binding Path="ShowOnlyMarked" Mode="TwoWay" />
            </ToggleButton.IsChecked>
          </CheckBox>
          <CheckBox x:Name="checkAtBounds" Content="{x:Static lp:GridFormsResources.VariableListDialog_ShowOnlyAtBounds}" VerticalAlignment="Center">
            <ToggleButton.IsChecked>
              <Binding Path="ShowOnlyAtBounds" Mode="TwoWay" />
            </ToggleButton.IsChecked>
          </CheckBox>
        </StackPanel>
      </StackPanel>
    </Grid>
    <gc:GridControl x:Name="theGridControl" x:Uid="theGridControl" Grid.Row="1" Margin="{DynamicResource AspenVerticalRelativeControlMargin}" AllowSelectAll="False" AllowSelectColumn="False" AllowColumnChooser="False" AllowRecordFiltering="True" SelectionUnit="FullRow">
      <gc:GridControl.SelectionMode>
        <Binding Path="SelectionMode" Mode="OneWay" />
      </gc:GridControl.SelectionMode>
      <gc:GridControl.DataSource>
        <Binding Path="DataSource.GridData" Mode="OneWay" />
      </gc:GridControl.DataSource>
    </gc:GridControl>
    <DockPanel x:Uid="DockPanel_2" Grid.Row="2" LastChildFill="True">
      <Button Click="buttonCancel_Click" x:Name="buttonCancel" x:Uid="buttonCancel" IsCancel="True" Margin="0" DockPanel.Dock="Right" Content="{x:Static lp:GridFormsResources.VariableListDialog_Button_Cancel}" />
      <Button x:Name="buttonQuery" x:Uid="buttonQuery" DockPanel.Dock="Right" Content="{x:Static lp:GridFormsResources.VariableListDialog_Button_Query}">
        <ButtonBase.Command>
          <Binding Path="QueryCommand" Mode="OneWay" />
        </ButtonBase.Command>
      </Button>
      <Button x:Name="buttonSelect" x:Uid="buttonSelect" IsDefault="True" DockPanel.Dock="Right" Content="{x:Static lp:GridFormsResources.VariableListDialog_Button_Select}">
        <ButtonBase.Command>
          <Binding Path="SelectCommand" Mode="OneWay" />
        </ButtonBase.Command>
      </Button>
      <TextBlock x:Uid="TextBlock_1" Margin="0,0,5,0">
        <TextBlock.Text>
          <Binding Path="StatusText" Mode="OneWay" />
        </TextBlock.Text>
      </TextBlock>
    </DockPanel>
  </Grid>
</Window>
