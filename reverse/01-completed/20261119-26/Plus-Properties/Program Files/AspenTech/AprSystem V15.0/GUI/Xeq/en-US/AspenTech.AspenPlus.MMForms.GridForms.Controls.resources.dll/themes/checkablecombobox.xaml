<?xml version='1.0' encoding='utf-8'?>
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:igEditors="http://infragistics.com/Editors" xmlns:local="clr-namespace:AspenTech.AspenPlus.MMForms.GridForms.Controls" xmlns:localData="clr-namespace:AspenTech.AspenPlus.MMForms.GridForms.Controls.Data" x:Uid="ResourceDictionary_2">
  <ResourceDictionary.MergedDictionaries>
    <ResourceDictionary Source="/AspenTech.AspenPlus.MMForms.GridForms.Controls;component/Themes/DropdownButtonStyle.xaml" x:Uid="ResourceDictionary_1" />
  </ResourceDictionary.MergedDictionaries>
  <Style x:Key="{x:Type local:CheckableComboBox}" TargetType="{x:Type local:CheckableComboBox}">
    <Setter Property="FrameworkElement.MinHeight" Value="21" />
    <Setter Property="Panel.Background" Value="{DynamicResource {x:Static SystemColors.WindowBrushKey}}" />
    <Setter Property="Border.BorderBrush" Value="{DynamicResource {x:Static igEditors:EditorsBrushKeys.EditorsNormalBorderFillKey}}" />
    <Setter Property="Border.BorderThickness" Value="1" />
    <Setter Property="Control.Padding" Value="2" />
    <Setter Property="local:CheckableComboBox.PopupWidth">
      <Setter.Value>
        <Binding Path="ActualWidth" Mode="OneWay">
          <Binding.RelativeSource>
            <RelativeSource Mode="Self" />
          </Binding.RelativeSource>
        </Binding>
      </Setter.Value>
    </Setter>
    <Setter Property="Control.Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type local:CheckableComboBox}">
          <Border Background="{TemplateBinding Panel.Background}" BorderBrush="{TemplateBinding Border.BorderBrush}" BorderThickness="{TemplateBinding Border.BorderThickness}">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <Border Grid.Column="0">
                <TextBox x:Name="PART_Content" IsReadOnly="True" BorderBrush="#00FFFFFF" BorderThickness="0" HorizontalContentAlignment="{TemplateBinding Control.HorizontalContentAlignment}" VerticalContentAlignment="{TemplateBinding Control.VerticalContentAlignment}" Padding="{TemplateBinding Control.Padding}" Text="{TemplateBinding local:CheckableComboBox.DisplayedText}" x:Uid="PART_Content">
                  <FrameworkElement.Style>
                    <x:Null />
                  </FrameworkElement.Style>
                </TextBox>
              </Border>
              <ToggleButton x:Name="PART_DropDownButton" Grid.Column="1" Width="{DynamicResource {x:Static SystemParameters.VerticalScrollBarWidthKey}}" IsEnabled="{TemplateBinding local:CheckableComboBox.IsPopupEnabled}" Style="{StaticResource LocalDropDownButtonStyle}" x:Uid="PART_DropDownButton">
                <ToggleButton.IsChecked>
                  <Binding Path="IsPopupOpen" Mode="TwoWay" UpdateSourceTrigger="PropertyChanged">
                    <Binding.RelativeSource>
                      <RelativeSource Mode="TemplatedParent" />
                    </Binding.RelativeSource>
                  </Binding>
                </ToggleButton.IsChecked>
              </ToggleButton>
            </Grid>
          </Border>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
</ResourceDictionary>
