<?xml version='1.0' encoding='utf-8'?>
<Window x:Class="AspenTech.AspenPlus.MMForms.GridForms.MethodParameters.DataReorderWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:mmres="clr-namespace:AspenTech.AspenPlus.MMControls.Properties;assembly=AspenTech.AspenPlus.MMControls" xmlns:images="http://schemas.aspentech.com/xaml/presentation/visualisation/commonimages" Title="{x:Static mmres:Resources.ReorderTitle}" Height="400" Width="350" WindowStartupLocation="CenterOwner">
  <FrameworkElement.Resources>
    <ResourceDictionary>
      <Style x:Key="imageButtonStyle" TargetType="{x:Type Button}" BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="FrameworkElement.MinWidth" Value="0" />
        <Setter Property="FrameworkElement.MinHeight" Value="0" />
        <Setter Property="FrameworkElement.Margin" Value="0" />
        <Style.Triggers>
          <Trigger Property="UIElement.IsEnabled" Value="False">
            <Setter Property="UIElement.Opacity" Value="0.5" />
          </Trigger>
        </Style.Triggers>
      </Style>
      <images:CommonImages x:Key="shellImages" />
    </ResourceDictionary>
  </FrameworkElement.Resources>
  <Grid Margin="5">
    <Grid.RowDefinitions>
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>
    <GroupBox Header="{x:Static mmres:Resources.ReorderHeader}" x:Uid="GroupBox_1">
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="*" />
          <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <ListBox x:Name="List" Margin="3" Grid.RowSpan="2" SelectionMode="Single" x:Uid="List">
          <Selector.SelectedIndex>
            <Binding Path="SelectedIndex" Mode="TwoWay">
              <Binding.RelativeSource>
                <RelativeSource Mode="FindAncestor" AncestorType="Window" />
              </Binding.RelativeSource>
            </Binding>
          </Selector.SelectedIndex>
          <ItemsControl.ItemsSource>
            <Binding Path="ItemsToReorder">
              <Binding.RelativeSource>
                <RelativeSource Mode="FindAncestor" AncestorType="Window" />
              </Binding.RelativeSource>
            </Binding>
          </ItemsControl.ItemsSource>
        </ListBox>
        <Button x:Name="buttonUp" x:Uid="buttonUp" VerticalAlignment="Bottom" Grid.Column="1" Margin="4,2" Style="{StaticResource imageButtonStyle}">
          <ButtonBase.Command>
            <Binding Path="MoveUpCommand">
              <Binding.RelativeSource>
                <RelativeSource AncestorType="Window" Mode="FindAncestor" />
              </Binding.RelativeSource>
            </Binding>
          </ButtonBase.Command>
          <Image Stretch="None">
            <Image.Source>
              <Binding Source="{StaticResource shellImages}" Path="MoveUp_16" />
            </Image.Source>
          </Image>
        </Button>
        <Button x:Name="buttonDown" x:Uid="buttonDown" Grid.Column="1" Grid.Row="1" VerticalAlignment="Top" Margin="4,2" Style="{StaticResource imageButtonStyle}">
          <ButtonBase.Command>
            <Binding Path="MoveDownCommand">
              <Binding.RelativeSource>
                <RelativeSource AncestorType="Window" Mode="FindAncestor" />
              </Binding.RelativeSource>
            </Binding>
          </ButtonBase.Command>
          <Image Stretch="None">
            <Image.Source>
              <Binding Source="{StaticResource shellImages}" Path="MoveDown_16" />
            </Image.Source>
          </Image>
        </Button>
      </Grid>
    </GroupBox>
    <Button x:Name="buttonClose" Content="{x:Static mmres:Resources.Close}" Margin="5" Padding="15,3" Grid.Row="1" HorizontalAlignment="Center" IsCancel="True" x:Uid="Button_1">
      <ButtonBase.Command>
        <Binding Path="CloseCommand">
          <Binding.RelativeSource>
            <RelativeSource AncestorType="Window" Mode="FindAncestor" />
          </Binding.RelativeSource>
        </Binding>
      </ButtonBase.Command>
    </Button>
  </Grid>
</Window>
