<?xml version='1.0' encoding='utf-8'?>
<Window x:Class="AspenTech.AspenPlus.MMForms.GridForms.Dialogs.SyncStreamGroupAndTemplateDialog" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:lp="clr-namespace:AspenTech.AspenPlus.Localization;assembly=AspenTech.AspenPlus.Localization" xmlns:converters="clr-namespace:AspenTech.AspenPlus.MMForms.GridForms.Controls.Converters;assembly=AspenTech.AspenPlus.MMForms.GridForms.Controls" x:Uid="Window_1" Title="{x:Static lp:ApwnResources.AspenPlus}" SizeToContent="WidthAndHeight" ResizeMode="NoResize" ShowInTaskbar="False" WindowStartupLocation="CenterOwner" Background="{DynamicResource AspenDialogBackgroundBrush}">
  <StackPanel x:Uid="StackPanel_1" Margin="{DynamicResource AspenDialogOuterMargin}">
    <GroupBox x:Uid="GroupBox_1" Header="{x:Static lp:ApwnResources.SaveFlowSheetStreamReport}" Margin="{DynamicResource AspenVerticalRelativeControlMargin}">
      <StackPanel x:Uid="StackPanel_2" Margin="0,8,0,0">
        <FrameworkElement.DataContext>
          <Binding>
            <Binding.RelativeSource>
              <RelativeSource Mode="FindAncestor" AncestorType="Window" />
            </Binding.RelativeSource>
          </Binding>
        </FrameworkElement.DataContext>
        <CheckBox Name="chkSyncStreamGroup" x:Uid="chkSyncStreamGroup" Content="{x:Static lp:GridFormsResources.SaveStreamGroupAndTemplateDialog_SaveStreamGroup}" IsChecked="True" Margin="{DynamicResource AspenVerticalRelativeControlMargin}" />
        <CheckBox Name="chkSyncTemplate" x:Uid="chkSyncTemplate" Content="{x:Static lp:GridFormsResources.SaveStreamGroupAndTemplateDialog_SaveTemplate}" IsChecked="True" Margin="{DynamicResource AspenVerticalRelativeControlMargin}" />
      </StackPanel>
    </GroupBox>
    <StackPanel x:Uid="StackPanel_3" Orientation="Horizontal" HorizontalAlignment="Right">
      <Button Click="buttonYes_Click" x:Name="buttonYes" x:Uid="buttonYes" IsDefault="True" Content="{x:Static lp:GridFormsResources.SaveStreamGroupAndTemplateDialog_ButtonYes}" />
      <Button Click="buttonNo_Click" x:Name="buttonNo" x:Uid="buttonNo" IsCancel="True" Margin="0" Content="{x:Static lp:GridFormsResources.SaveStreamGroupAndTemplateDialog_ButtonNo}" />
    </StackPanel>
  </StackPanel>
</Window>
