<?xml version='1.0' encoding='utf-8'?>
<MMTabPage x:Class="AspenTech.AspenPlus.MMForms.GridForms.EOVariableForm" xmlns="http://schemas.aspentech.com/xaml/presentation/aspenplus" xmlns:av="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:lp="clr-namespace:AspenTech.AspenPlus.Localization;assembly=AspenTech.AspenPlus.Localization" xmlns:igWindows="http://infragistics.com/Windows" xmlns:igRibbon="http://infragistics.com/Ribbon" xmlns:local="clr-namespace:AspenTech.AspenPlus.MMForms.GridForms" xmlns:controls="clr-namespace:AspenTech.Engineering.GridControls;assembly=AspenTech.Engineering.GridControls" xmlns:controlsInternal="clr-namespace:AspenTech.Engineering.GridControls.Internal;assembly=AspenTech.Engineering.GridControls" x:Uid="MMTabPage_1" MMHelp.HelpFile="eoconf" MMHelp.HelpId="11" SupressScrollViewerInTempalte="True" MMInContextGuidanceButton.StaysInIsolatedColumn="False" MMInContextGuidanceButton.MarginInTemplate="2,0,2,0">
  <local:MMGridControlPanel x:Name="thePanel" x:Uid="thePanel">
    <av:Control.Template>
      <av:ControlTemplate TargetType="{x:Type local:MMGridControlPanel}">
        <igWindows:XamTabControl x:Name="PART_TabControl" SelectionChanged="TabControl_SelectionChanged" Background="#00FFFFFF" PostTabItemContent="{av:TemplateBinding local:MMGridControlPanel.PostTabItem}" Theme="Aero" x:Uid="PART_TabControl">
          <igWindows:XamTabControl.PostTabItemContentTemplate>
            <av:DataTemplate>
              <av:StackPanel x:Uid="StackPanel_1" Margin="4,0" Orientation="Horizontal">
                <igRibbon:ButtonTool x:Name="Help_1" Click="Help_1_Click" x:Uid="Help_1" SmallImage="pack://application:,,,/ApwnShell;component/Images/MSHelp32.ico">
                  <av:UIElement.Visibility>
                    <av:Binding Path="HelpVisibility" />
                  </av:UIElement.Visibility>
                  <av:FrameworkElement.ToolTip>
                    <av:Binding Path="HelpToolTip" />
                  </av:FrameworkElement.ToolTip>
                </igRibbon:ButtonTool>
                <av:Image x:Uid="Image_2" Width="16" Height="16" Margin="4,0,6,0" VerticalAlignment="Center">
                  <av:Image.Source>
                    <av:Binding Path="PostTabItemImage" />
                  </av:Image.Source>
                  <av:FrameworkElement.ToolTip>
                    <av:Binding Path="PostTabItemImageToolTip" />
                  </av:FrameworkElement.ToolTip>
                </av:Image>
                <av:TextBlock x:Uid="TextBlock_2" VerticalAlignment="Center">
                  <av:TextBlock.Text>
                    <av:Binding Path="PostTabItemText" />
                  </av:TextBlock.Text>
                </av:TextBlock>
                <av:Border Width="26" Height="20" />
              </av:StackPanel>
            </av:DataTemplate>
          </igWindows:XamTabControl.PostTabItemContentTemplate>
        </igWindows:XamTabControl>
      </av:ControlTemplate>
    </av:Control.Template>
    <controls:GridControlPanel.HeaderContextMenu>
      <av:ContextMenu x:Uid="av_ContextMenu_1">
        <av:MenuItem x:Uid="av_MenuItem_1" Header="{x:Static lp:GridFormsResources._AddNew}" Command="{x:Static controls:GridControlPanel.AddNewGridCommand}">
          <av:MenuItem.Icon>
            <av:Image x:Uid="av_Image_1" Source="{x:Static controlsInternal:ImageSourceHelper.FileNew32}" Height="16" Width="16" />
          </av:MenuItem.Icon>
        </av:MenuItem>
        <av:MenuItem x:Uid="av_MenuItem_2" Header="{x:Static lp:GridFormsResources._Copy}" Command="{x:Static controls:GridControlPanel.CloneCurrentGridCommand}">
          <av:MenuItem.Icon>
            <av:Image x:Uid="av_Image_2" Source="{x:Static controlsInternal:ImageSourceHelper.Copy16}" Height="16" Width="16" />
          </av:MenuItem.Icon>
        </av:MenuItem>
        <av:MenuItem x:Uid="av_MenuItem_3" Header="{x:Static lp:GridFormsResources._Rename}" Command="{x:Static controls:GridControlPanel.RenameCurrentGridCommand}" />
        <av:MenuItem x:Uid="av_MenuItem_4" Header="{x:Static lp:GridFormsResources._Remove}" Command="{x:Static controls:GridControlPanel.RemoveCurrentGridCommand}" />
        <av:Separator x:Uid="av_Separator_1" />
        <av:MenuItem x:Uid="av_MenuItem_5" Header="{x:Static lp:GridFormsResources._Save}" Command="{x:Static local:EOVariableForm.SaveCommand}" />
        <av:MenuItem x:Uid="av_MenuItem_6" Header="{x:Static lp:GridFormsResources._AutoSave}" IsCheckable="True" Command="{x:Static local:EOVariableForm.AutoSaveCommand}">
          <av:MenuItem.CommandParameter>
            <av:Binding>
              <av:Binding.RelativeSource>
                <av:RelativeSource Mode="Self" />
              </av:Binding.RelativeSource>
            </av:Binding>
          </av:MenuItem.CommandParameter>
        </av:MenuItem>
        <av:Separator x:Uid="av_Separator_2" />
        <av:MenuItem x:Uid="av_MenuItem_7" Header="{x:Static lp:GridFormsResources._Default}" IsCheckable="True" Command="{x:Static local:EOVariableForm.DefaultCommand}">
          <av:MenuItem.CommandParameter>
            <av:Binding>
              <av:Binding.RelativeSource>
                <av:RelativeSource Mode="Self" />
              </av:Binding.RelativeSource>
            </av:Binding>
          </av:MenuItem.CommandParameter>
        </av:MenuItem>
        <av:MenuItem x:Uid="av_MenuItem_8" Header="{x:Static lp:GridFormsResources._ChangeType}" Command="{x:Static local:EOVariableForm.ChangeTypeCommand}" />
        <av:MenuItem x:Uid="av_MenuItem_9" Header="{x:Static lp:GridFormsResources._ChangeView}" Command="{x:Static local:EOVariableForm.ChangeViewCommand}" />
        <av:Separator x:Uid="av_Separator_3" />
        <av:MenuItem x:Uid="av_MenuItem_10" Header="{x:Static lp:GridFormsResources._EnterQuery}" Command="{x:Static local:EOVariableForm.EnterQueryCommand}" />
      </av:ContextMenu>
    </controls:GridControlPanel.HeaderContextMenu>
  </local:MMGridControlPanel>
</MMTabPage>
