<?xml version='1.0' encoding='utf-8'?>
<Window x:Class="AspenTech.AspenPlus.MMForms.GridForms.StreamReport.Template.ManageCssTemplatesWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:mmctrl="clr-namespace:AspenTech.AspenPlus.MMControls;assembly=AspenTech.AspenPlus.MMControls" xmlns:loc="clr-namespace:AspenTech.AspenPlus.Localization;assembly=AspenTech.AspenPlus.Localization" mmctrl:MMHelp.HelpFile="results.chm" mmctrl:MMHelp.HelpId="1000" MinWidth="400" MinHeight="300" ShowInTaskbar="False" SizeToContent="WidthAndHeight" WindowStartupLocation="CenterOwner" Background="{DynamicResource AspenDialogBackgroundBrush}" Title="{x:Static loc:GridFormsResources.ManageCssTemplatesWindow_Title}">
  <Grid Margin="7">
    <FrameworkElement.DataContext>
      <Binding Mode="OneWay">
        <Binding.RelativeSource>
          <RelativeSource Mode="FindAncestor" AncestorType="Window" />
        </Binding.RelativeSource>
      </Binding>
    </FrameworkElement.DataContext>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>
    <TextBlock Text="{x:Static loc:GridFormsResources.ManageCssTemplatesWindow_Label}" Margin="0,0,0,4" />
    <ListBox x:Name="listBoxTemplates" Grid.Row="1" DisplayMemberPath="LongName" SelectionMode="Extended" Margin="0,0,0,4">
      <ItemsControl.ItemsSource>
        <Binding Path="CssTemplates" Mode="OneWay" />
      </ItemsControl.ItemsSource>
    </ListBox>
    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
      <Button Content="{x:Static loc:GridFormsResources.ManageCssTemplatesWindow_View}" MinWidth="70" Margin="7,0,0,0">
        <ButtonBase.Command>
          <Binding Path="ViewCommand" Mode="OneWay" />
        </ButtonBase.Command>
      </Button>
      <Button Content="{x:Static loc:GridFormsResources.ManageCssTemplatesWindow_SaveAs}" MinWidth="70" Margin="7,0,0,0">
        <ButtonBase.Command>
          <Binding Path="SaveAsCommand" Mode="OneWay" />
        </ButtonBase.Command>
      </Button>
      <Button Content="{x:Static loc:GridFormsResources.ManageCssTemplatesWindow_Delete}" MinWidth="70" Margin="7,0,0,0">
        <ButtonBase.Command>
          <Binding Path="DeleteCommand" Mode="OneWay" />
        </ButtonBase.Command>
      </Button>
      <Button Content="{x:Static loc:GridFormsResources.ManageCssTemplatesWindow_Exit}" IsCancel="True" MinWidth="70" Margin="7,0,0,0">
        <ButtonBase.Command>
          <Binding Path="ExitCommand" Mode="OneWay" />
        </ButtonBase.Command>
      </Button>
    </StackPanel>
  </Grid>
</Window>
