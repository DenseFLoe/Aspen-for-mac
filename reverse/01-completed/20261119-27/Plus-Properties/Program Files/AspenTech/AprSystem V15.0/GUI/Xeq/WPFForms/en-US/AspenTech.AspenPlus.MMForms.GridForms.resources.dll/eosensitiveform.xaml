<?xml version='1.0' encoding='utf-8'?>
<MMTabPage x:Class="AspenTech.AspenPlus.MMForms.GridForms.EOSensitiveForm" xmlns="http://schemas.aspentech.com/xaml/presentation/aspenplus" xmlns:av="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:lp="clr-namespace:AspenTech.AspenPlus.Localization;assembly=AspenTech.AspenPlus.Localization" xmlns:local="clr-namespace:AspenTech.AspenPlus.MMForms.GridForms" xmlns:controls="clr-namespace:AspenTech.Engineering.GridControls;assembly=AspenTech.Engineering.GridControls" x:Uid="MMTabPage_1">
  <av:Grid x:Uid="av_Grid_1">
    <av:Grid.RowDefinitions>
      <av:RowDefinition x:Uid="av_RowDefinition_1" Height="*" />
      <av:RowDefinition x:Uid="av_RowDefinition_2" Height="{av:DynamicResource AspenVerticalRelativeLength}" />
      <av:RowDefinition x:Uid="av_RowDefinition_3" Height="Auto" />
    </av:Grid.RowDefinitions>
    <controls:GridControl x:Name="theSheet" x:Uid="theSheet" AllowRecordFiltering="False" AllowColumnReorder="False" AllowColumnChooser="False" av:Grid.Row="0" />
    <av:Button x:Uid="av_Button_1" Margin="0" av:Grid.Row="2" HorizontalAlignment="Center" Content="{x:Static lp:GridFormsResources.CalculateSensitivity}">
      <av:ButtonBase.Command>
        <av:Binding Path="CalculateSensitivityCommand" />
      </av:ButtonBase.Command>
    </av:Button>
  </av:Grid>
</MMTabPage>
