<?xml version='1.0' encoding='utf-8'?>
<Window x:Class="AspenTech.AspenPlus.MMForms.GridForms.StreamReport.Template.NewTemplateDialog" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:local="clr-namespace:AspenTech.AspenPlus.MMForms.GridForms.StreamReport.Template" xmlns:res="clr-namespace:AspenTech.AspenPlus.Localization;assembly=AspenTech.AspenPlus.Localization" xmlns:mmctrl="clr-namespace:AspenTech.AspenPlus.MMControls;assembly=AspenTech.AspenPlus.MMControls" Title="{x:Static res:GridFormsResources.NewTemplateDialog_Title}" SizeToContent="WidthAndHeight" ResizeMode="CanResize" MinWidth="312" MinHeight="140" WindowStartupLocation="CenterOwner" mmctrl:MMHelp.HelpFile="results.chm" mmctrl:MMHelp.HelpId="1000">
  <Grid Margin="7">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="7" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="7" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="Auto" />
      <ColumnDefinition Width="7" />
      <ColumnDefinition Width="*" />
    </Grid.ColumnDefinitions>
    <Label Content="{x:Static res:GridFormsResources.NewTemplateDialog_Name}" Grid.Row="0" Grid.Column="0" />
    <TextBox TextChanged="txtName_TextChanged" Name="txtName" MinWidth="200" Grid.Row="0" Grid.Column="3" HorizontalAlignment="Stretch" MaxLength="16" />
    <Label Content="{x:Static res:GridFormsResources.NewTemplateDialog_Description}" Grid.Row="2" Grid.Column="0" />
    <TextBox Name="txtDescription" MinWidth="200" Grid.Row="2" Grid.Column="3" HorizontalAlignment="Stretch" MaxLength="64" />
    <UniformGrid Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="3" Columns="2" HorizontalAlignment="Center">
      <Button Click="btnOK_Click" Name="btnOK" Content="{x:Static res:GridFormsResources.NewTemplateDialog_OK}" Margin="0,0,7,0" IsEnabled="False" IsDefault="True" />
      <Button Click="btnCancel_Click" Name="btnCancel" Content="{x:Static res:GridFormsResources.NewTemplateDialog_Cancel}" IsCancel="True" />
    </UniformGrid>
  </Grid>
</Window>
