<?xml version='1.0' encoding='utf-8'?>
<UserControl x:Class="AspenTech.AspenPlus.MMForms.GridForms.StreamReport.Template.EditorCalculationOptions" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:lp="clr-namespace:AspenTech.AspenPlus.Localization;assembly=AspenTech.AspenPlus.Localization" xmlns:template="clr-namespace:AspenTech.AspenPlus.MMForms.GridForms.StreamReport.Template" xmlns:controls="clr-namespace:AspenTech.AspenPlus.MMForms.GridForms.Controls;assembly=AspenTech.AspenPlus.MMForms.GridForms.Controls" xmlns:converters="clr-namespace:AspenTech.AspenPlus.MMForms.GridForms.Controls.Converters;assembly=AspenTech.AspenPlus.MMForms.GridForms.Controls" xmlns:system="clr-namespace:System;assembly=mscorlib">
  <FrameworkElement.Resources>
    <ResourceDictionary>
      <template:TemplatePropertyItemToForegroundConverter x:Key="tpiToForegroundConverter" />
      <Style x:Key="propertyItemStyle" TargetType="{x:Type ListBoxItem}">
        <Setter Property="template:TemplatePropertyTooltip.PropertyItem">
          <Setter.Value>
            <Binding Mode="OneWay" />
          </Setter.Value>
        </Setter>
        <Setter Property="TextElement.Foreground">
          <Setter.Value>
            <Binding Converter="{StaticResource tpiToForegroundConverter}" Mode="OneWay" />
          </Setter.Value>
        </Setter>
      </Style>
    </ResourceDictionary>
  </FrameworkElement.Resources>
  <Grid>
    <Grid.ColumnDefinitions>
      <ColumnDefinition x:Uid="ColumnDefinition_1" Width="35*" />
      <ColumnDefinition x:Uid="ColumnDefinition_2" Width="{DynamicResource AspenHorizontalRelativeLength}" />
      <ColumnDefinition x:Uid="ColumnDefinition_3" Width="65*" />
    </Grid.ColumnDefinitions>
    <GroupBox x:Uid="GroupBox_1" Grid.Column="0" Header="{x:Static lp:GridFormsResources.StreamSummaryTemplate_CalculationOptions_SelectedProperties}">
      <ListBox x:Name="listBoxSourceProperties" x:Uid="listBoxSourceProperties" MinHeight="100" SelectionMode="Single" DisplayMemberPath="DisplayName" ItemContainerStyle="{StaticResource propertyItemStyle}">
        <ItemsControl.ItemsSource>
          <Binding Path="UserAddedProperties" Mode="OneWay" />
        </ItemsControl.ItemsSource>
        <Selector.SelectedItem>
          <Binding Path="CurrentPropertyItem" Mode="TwoWay">
            <Binding.RelativeSource>
              <RelativeSource Mode="FindAncestor" AncestorType="UserControl" />
            </Binding.RelativeSource>
          </Binding>
        </Selector.SelectedItem>
      </ListBox>
    </GroupBox>
    <GroupBox x:Uid="GroupBox_2" Grid.Column="2" Header="{x:Static lp:GridFormsResources.StreamSummaryTemplate_CalculationOptions_Qualifiers}">
      <FrameworkElement.DataContext>
        <Binding Path="CurrentPropertyItem" Mode="OneWay">
          <Binding.RelativeSource>
            <RelativeSource Mode="FindAncestor" AncestorType="UserControl" />
          </Binding.RelativeSource>
        </Binding>
      </FrameworkElement.DataContext>
      <UIElement.IsEnabled>
        <Binding Path="IsEditable" Mode="OneWay">
          <Binding.RelativeSource>
            <RelativeSource Mode="FindAncestor" AncestorType="UserControl" />
          </Binding.RelativeSource>
        </Binding>
      </UIElement.IsEnabled>
      <Grid x:Name="gridQualifiers" x:Uid="Grid_2">
        <Grid.RowDefinitions>
          <RowDefinition x:Uid="RowDefinition_1" Height="Auto" />
          <RowDefinition x:Uid="RowDefinition_2" Height="{DynamicResource AspenVerticalRelativeLength}" />
          <RowDefinition x:Uid="RowDefinition_3" Height="Auto" />
          <RowDefinition x:Uid="RowDefinition_4" Height="{DynamicResource AspenVerticalRelativeLength}" />
          <RowDefinition x:Uid="RowDefinition_5" Height="Auto" />
          <RowDefinition x:Uid="RowDefinition_6" Height="{DynamicResource AspenVerticalRelativeLength}" />
          <RowDefinition x:Uid="RowDefinition_7" Height="Auto" />
          <RowDefinition x:Uid="RowDefinition_8" Height="{DynamicResource AspenVerticalRelativeLength}" />
          <RowDefinition x:Uid="RowDefinition_9" Height="Auto" />
          <RowDefinition x:Uid="RowDefinition_10" Height="{DynamicResource AspenVerticalRelativeLength}" />
          <RowDefinition x:Uid="RowDefinition_11" Height="Auto" />
          <RowDefinition x:Uid="RowDefinition_12" Height="{DynamicResource AspenVerticalRelativeLength}" />
          <RowDefinition x:Uid="RowDefinition_13" Height="*" />
          <RowDefinition x:Uid="RowDefinition_14" Height="{DynamicResource AspenVerticalRelativeLength}" />
          <RowDefinition x:Uid="RowDefinition_15" Height="Auto" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
          <ColumnDefinition x:Uid="ColumnDefinition_4" Width="Auto" />
          <ColumnDefinition x:Uid="ColumnDefinition_5" Width="{DynamicResource AspenHorizontalRelativeLength}" />
          <ColumnDefinition x:Uid="ColumnDefinition_6" Width="*" />
          <ColumnDefinition x:Uid="ColumnDefinition_7" Width="{DynamicResource AspenHorizontalRelativeLength}" />
          <ColumnDefinition x:Uid="ColumnDefinition_8" Width="Auto" />
        </Grid.ColumnDefinitions>
        <Label x:Uid="Label_1" Grid.Row="0" Grid.Column="0" Content="{x:Static lp:GridFormsResources.StreamSummaryTemplate_CalculationOptions_Components}" />
        <controls:CheckableComboBox SelectionChanged="comboBoxComponents_SelectionChanged" x:Name="comboBoxComponents" x:Uid="comboBoxComponents" ToolTip="{x:Static lp:GridFormsResources.StreamSummaryTemplate_CalculationOptions_Components_Tooltip}" Grid.Row="0" Grid.Column="2" Grid.ColumnSpan="3" VerticalAlignment="Center" />
        <Label x:Uid="Label_2" Grid.Row="2" Grid.Column="0" Content="{x:Static lp:GridFormsResources.StreamSummaryTemplate_CalculationOptions_Substreams}" />
        <controls:CheckableComboBox SelectionChanged="comboBoxSubstreams_SelectionChanged" x:Name="comboBoxSubstreams" x:Uid="comboBoxSubstreams" ToolTip="{x:Static lp:GridFormsResources.StreamSummaryTemplate_CalculationOptions_Substreams_Tooltip}" Grid.Row="2" Grid.Column="2" Grid.ColumnSpan="3" VerticalAlignment="Center" />
        <Label x:Uid="Label_3" Grid.Row="4" Grid.Column="0" Content="{x:Static lp:GridFormsResources.StreamSummaryTemplate_CalculationOptions_Phases}" />
        <controls:CheckableComboBox SelectionChanged="comboBoxPhases_SelectionChanged" x:Name="comboBoxPhases" x:Uid="comboBoxPhases" ToolTip="{x:Static lp:GridFormsResources.StreamSummaryTemplate_CalculationOptions_Phases_Tooltip}" Grid.Row="4" Grid.Column="2" Grid.ColumnSpan="3" VerticalAlignment="Center" />
        <Label x:Uid="Label_4" Grid.Row="6" Grid.Column="0" Content="{x:Static lp:GridFormsResources.StreamSummaryTemplate_CalculationOptions_WaterBasis}" />
        <controls:CheckableComboBox SelectionChanged="comboBoxWaterBasis_SelectionChanged" x:Name="comboBoxWaterBasis" x:Uid="comboBoxWaterBasis" ToolTip="{x:Static lp:GridFormsResources.StreamSummaryTemplate_CalculationOptions_WaterBasis_Tooltip}" Grid.Row="6" Grid.Column="2" Grid.ColumnSpan="3" VerticalAlignment="Center" />
        <Label x:Uid="Label_5" Grid.Row="8" Grid.Column="0" Content="{x:Static lp:GridFormsResources.StreamSummaryTemplate_CalculationOptions_BaseComponents}" />
        <controls:CheckableComboBox SelectionChanged="comboBoxBaseComponents_SelectionChanged" x:Name="comboBoxBaseComponents" x:Uid="comboBoxBaseComponents" ToolTip="{x:Static lp:GridFormsResources.StreamSummaryTemplate_CalculationOptions_BaseComponents_Tooltip}" Grid.Row="8" Grid.Column="2" Grid.ColumnSpan="3" VerticalAlignment="Center" />
        <Label x:Uid="Label_6" Grid.Row="10" Grid.Column="0" Content="{x:Static lp:GridFormsResources.StreamSummaryTemplate_CalculationOptions_SecondLiqKeyComps}" />
        <controls:CheckableComboBox SelectionChanged="comboBoxSecondLiquidKeyComponents_SelectionChanged" x:Name="comboBoxSecondLiquidKeyComponents" x:Uid="comboBoxSecondLiquidKeyComponents" ToolTip="{x:Static lp:GridFormsResources.StreamSummaryTemplate_CalculationOptions_SecondLiqKeyComps_Tooltip}" Grid.Row="10" Grid.Column="2" Grid.ColumnSpan="3" VerticalAlignment="Center" />
        <Grid x:Uid="Grid_3" Grid.Row="12" Grid.Column="0" Grid.ColumnSpan="5">
          <Grid.ColumnDefinitions>
            <ColumnDefinition x:Uid="ColumnDefinition_9" Width="50*" />
            <ColumnDefinition x:Uid="ColumnDefinition_10" Width="{DynamicResource AspenHorizontalRelativeLength}" />
            <ColumnDefinition x:Uid="ColumnDefinition_11" Width="50*" />
          </Grid.ColumnDefinitions>
          <GroupBox x:Uid="GroupBox_3" Grid.Column="0" Header="{x:Static lp:GridFormsResources.StreamSummaryTemplate_CalculationOptions_Temperature}" ToolTip="{x:Static lp:GridFormsResources.StreamSummaryTemplate_CalculationOptions_Temperature_Tooltip}">
            <DockPanel x:Uid="DockPanel_1">
              <ComboBox SelectionChanged="comboBoxTemperature_SelectionChanged" x:Name="comboBoxTemperature" x:Uid="comboBoxTemperature" HorizontalAlignment="Stretch" DockPanel.Dock="Top" Margin="{DynamicResource AspenVerticalRelativeControlMargin}" />
              <controls:EditableListBox ItemsAsStringChanged="listBoxTemperature_ItemsAsStringChanged" x:Name="listBoxTemperature" x:Uid="listBoxTemperature" EditAsType="{x:Type system:Double}" Mask="{x:Static template:EditorDisplayOptions.DoubleMask}" />
            </DockPanel>
          </GroupBox>
          <GroupBox x:Uid="GroupBox_4" Grid.Column="2" Header="{x:Static lp:GridFormsResources.StreamSummaryTemplate_CalculationOptions_Pressure}" ToolTip="{x:Static lp:GridFormsResources.StreamSummaryTemplate_CalculationOptions_Pressure_Tooltip}">
            <DockPanel x:Uid="DockPanel_2">
              <ComboBox SelectionChanged="comboBoxPressure_SelectionChanged" x:Name="comboBoxPressure" x:Uid="comboBoxPressure" HorizontalAlignment="Stretch" DockPanel.Dock="Top" Margin="{DynamicResource AspenVerticalRelativeControlMargin}" />
              <controls:EditableListBox ItemsAsStringChanged="listBoxPressure_ItemsAsStringChanged" x:Name="listBoxPressure" x:Uid="listBoxPressure" EditAsType="{x:Type system:Double}" Mask="{x:Static template:EditorDisplayOptions.DoubleMask}" />
            </DockPanel>
          </GroupBox>
        </Grid>
        <Button x:Name="buttonMore" x:Uid="buttonMore" Grid.Row="14" Grid.Column="0" Grid.ColumnSpan="5" Margin="0" HorizontalAlignment="Right" Content="{x:Static lp:GridFormsResources.StreamSummaryTemplate_CalculationOptions_MoreQualifiers}">
          <ButtonBase.Command>
            <Binding Path="MoreCommand" Mode="OneWay">
              <Binding.RelativeSource>
                <RelativeSource Mode="FindAncestor" AncestorType="UserControl" />
              </Binding.RelativeSource>
            </Binding>
          </ButtonBase.Command>
        </Button>
      </Grid>
    </GroupBox>
  </Grid>
</UserControl>
