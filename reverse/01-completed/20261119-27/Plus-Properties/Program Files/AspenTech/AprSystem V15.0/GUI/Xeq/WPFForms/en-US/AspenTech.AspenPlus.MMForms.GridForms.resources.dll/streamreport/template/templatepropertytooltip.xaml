<?xml version='1.0' encoding='utf-8'?>
<UserControl x:Class="AspenTech.AspenPlus.MMForms.GridForms.StreamReport.Template.TemplatePropertyTooltip" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Uid="UserControl_1" Background="#FFFFFFE0">
  <StackPanel>
    <FrameworkElement.DataContext>
      <Binding>
        <Binding.RelativeSource>
          <RelativeSource Mode="FindAncestor" AncestorType="UserControl" />
        </Binding.RelativeSource>
      </Binding>
    </FrameworkElement.DataContext>
    <TextBlock Margin="{DynamicResource AspenVerticalRelativeControlMargin}">
      <TextBlock.Text>
        <Binding Path="DisplayName" />
      </TextBlock.Text>
    </TextBlock>
    <Border Height="1" Background="#FFFF0000" Margin="{DynamicResource AspenVerticalRelativeControlMargin}" />
    <ItemsControl>
      <ItemsControl.ItemsSource>
        <Binding Path="Columns" Mode="OneWay" />
      </ItemsControl.ItemsSource>
      <ItemsControl.ItemsPanel>
        <ItemsPanelTemplate>
          <StackPanel Orientation="Vertical" />
        </ItemsPanelTemplate>
      </ItemsControl.ItemsPanel>
      <ItemsControl.ItemTemplate>
        <DataTemplate>
          <TextBlock Foreground="#FF00008B" Margin="{DynamicResource AspenVerticalRelativeControlMargin}">
            <TextBlock.Text>
              <Binding />
            </TextBlock.Text>
          </TextBlock>
        </DataTemplate>
      </ItemsControl.ItemTemplate>
    </ItemsControl>
  </StackPanel>
</UserControl>
