<?xml version='1.0' encoding='utf-8'?>
<UserControl x:Class="AspenTech.AspenPlus.MMForms.GridForms.StreamReport.Template.EditorDisplayOptions" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:lp="clr-namespace:AspenTech.AspenPlus.Localization;assembly=AspenTech.AspenPlus.Localization" xmlns:igEditors="http://infragistics.com/Editors" xmlns:aes="clr-namespace:AspenTech.WpfControls.Engineering;assembly=AspenTech.WpfControls.Engineering" xmlns:template="clr-namespace:AspenTech.AspenPlus.MMForms.GridForms.StreamReport.Template" xmlns:controls="clr-namespace:AspenTech.AspenPlus.MMForms.GridForms.Controls;assembly=AspenTech.AspenPlus.MMForms.GridForms.Controls" xmlns:converters="clr-namespace:AspenTech.AspenPlus.MMForms.GridForms.Controls.Converters;assembly=AspenTech.AspenPlus.MMForms.GridForms.Controls" xmlns:system="clr-namespace:System;assembly=mscorlib">
  <FrameworkElement.Resources>
    <ResourceDictionary>
      <converters:ValueExistingConverter x:Key="valueExistingConverter" x:Uid="converters_ValueExistingConverter_1" />
      <converters:YesNoToBooleanConverter x:Key="yesNoToBooleanConverter" x:Uid="converters_YesNoToBooleanConverter_1" />
      <template:TemplatePropertyItemToForegroundConverter x:Key="tpiToForegroundConverter" />
      <template:PropertiesFilterConverter x:Key="filterConverter" />
      <Style x:Key="propertyItemStyle" TargetType="{x:Type ListBoxItem}">
        <Setter Property="template:TemplatePropertyTooltip.PropertyItem">
          <Setter.Value>
            <Binding Mode="OneWay" />
          </Setter.Value>
        </Setter>
        <Setter Property="TextElement.Foreground">
          <Setter.Value>
            <Binding Converter="{StaticResource tpiToForegroundConverter}" Mode="OneWay" />
          </Setter.Value>
        </Setter>
      </Style>
    </ResourceDictionary>
  </FrameworkElement.Resources>
  <Grid x:Uid="Grid_1">
    <Grid.ColumnDefinitions>
      <ColumnDefinition x:Uid="ColumnDefinition_1" Width="35*" />
      <ColumnDefinition x:Uid="ColumnDefinition_2" Width="{DynamicResource AspenHorizontalRelativeLength}" />
      <ColumnDefinition x:Uid="ColumnDefinition_3" Width="65*" />
    </Grid.ColumnDefinitions>
    <GroupBox x:Uid="GroupBox_1" Grid.Row="0" Header="{x:Static lp:GridFormsResources.StreamSummaryTemplate_DisplayOptions_SelectedProperties}">
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <CheckBox Grid.Row="0" Grid.Column="0" Margin="0,0,0,4" Content="{x:Static lp:GridFormsResources.StreamSummaryTemplate_Editor_HideStateConditions}">
          <ToggleButton.IsChecked>
            <Binding Path="HideStateConditions" Mode="TwoWay">
              <Binding.RelativeSource>
                <RelativeSource AncestorType="UserControl" Mode="FindAncestor" />
              </Binding.RelativeSource>
            </Binding>
          </ToggleButton.IsChecked>
        </CheckBox>
        <ListBox x:Name="listBoxSourceProperties" x:Uid="listBoxSourceProperties" Grid.Row="1" MinHeight="100" SelectionMode="Single" DisplayMemberPath="DisplayName" ItemContainerStyle="{StaticResource propertyItemStyle}">
          <Selector.SelectedItem>
            <Binding Path="CurrentPropertyItem" Mode="TwoWay">
              <Binding.RelativeSource>
                <RelativeSource Mode="FindAncestor" AncestorType="UserControl" />
              </Binding.RelativeSource>
            </Binding>
          </Selector.SelectedItem>
          <ItemsControl.ItemsSource>
            <MultiBinding Converter="{StaticResource filterConverter}" Mode="OneWay">
              <Binding Path="Properties" />
              <Binding Path="UserAddedProperties" />
              <Binding Path="HideStateConditions">
                <Binding.RelativeSource>
                  <RelativeSource AncestorType="UserControl" Mode="FindAncestor" />
                </Binding.RelativeSource>
              </Binding>
            </MultiBinding>
          </ItemsControl.ItemsSource>
        </ListBox>
      </Grid>
    </GroupBox>
    <StackPanel x:Name="panelOptions" x:Uid="StackPanel_1" Grid.Column="2">
      <FrameworkElement.DataContext>
        <Binding Path="CurrentPropertyItem" Mode="OneWay">
          <Binding.RelativeSource>
            <RelativeSource Mode="FindAncestor" AncestorType="UserControl" />
          </Binding.RelativeSource>
        </Binding>
      </FrameworkElement.DataContext>
      <GroupBox x:Uid="GroupBox_2" Header="{x:Static lp:GridFormsResources.StreamSummaryTemplate_DisplayOptions_General}">
        <UIElement.IsEnabled>
          <Binding Path="IsEditable" Mode="OneWay">
            <Binding.RelativeSource>
              <RelativeSource Mode="FindAncestor" AncestorType="UserControl" />
            </Binding.RelativeSource>
          </Binding>
        </UIElement.IsEnabled>
        <Grid x:Uid="Grid_2">
          <Grid.RowDefinitions>
            <RowDefinition x:Uid="RowDefinition_1" Height="Auto" />
            <RowDefinition x:Uid="RowDefinition_2" Height="{DynamicResource AspenVerticalRelativeLength}" />
            <RowDefinition x:Uid="RowDefinition_3" Height="Auto" />
            <RowDefinition x:Uid="RowDefinition_4" Height="{DynamicResource AspenVerticalRelativeLength}" />
            <RowDefinition x:Uid="RowDefinition_5" Height="Auto" />
            <RowDefinition x:Uid="RowDefinition_6" Height="{DynamicResource AspenVerticalRelativeLength}" />
            <RowDefinition x:Uid="RowDefinition_7" Height="Auto" />
            <RowDefinition x:Uid="RowDefinition_8" Height="{DynamicResource AspenVerticalRelativeLength}" />
            <RowDefinition x:Uid="RowDefinition_9" Height="Auto" />
          </Grid.RowDefinitions>
          <Grid.ColumnDefinitions>
            <ColumnDefinition x:Uid="ColumnDefinition_4" Width="Auto" />
            <ColumnDefinition x:Uid="ColumnDefinition_5" Width="{DynamicResource AspenHorizontalRelativeLength}" />
            <ColumnDefinition x:Uid="ColumnDefinition_6" Width="50*" />
            <ColumnDefinition x:Uid="ColumnDefinition_7" Width="{DynamicResource AspenHorizontalRelativeLength}" />
            <ColumnDefinition x:Uid="ColumnDefinition_8" Width="Auto" />
            <ColumnDefinition x:Uid="ColumnDefinition_9" Width="{DynamicResource AspenHorizontalRelativeLength}" />
            <ColumnDefinition x:Uid="ColumnDefinition_10" Width="50*" />
          </Grid.ColumnDefinitions>
          <Label x:Uid="Label_1" Grid.Row="0" Grid.Column="0" Content="{x:Static lp:GridFormsResources.StreamSummaryTemplate_DisplayOptions_Label}" />
          <TextBox x:Name="textBoxLabel" x:Uid="textBoxLabel" Grid.Row="0" Grid.Column="2" Grid.ColumnSpan="5" Margin="0" VerticalAlignment="Center" ToolTip="{x:Static lp:GridFormsResources.StreamSummaryTemplate_DisplayOptions_Label_Tooltip}" IsReadOnly="False">
            <TextBox.Text>
              <Binding Path="DisplayName" Mode="TwoWay" UpdateSourceTrigger="PropertyChanged" />
            </TextBox.Text>
          </TextBox>
          <Label x:Uid="Label_2" Grid.Row="2" Grid.Column="0" Content="{x:Static lp:GridFormsResources.StreamSummaryTemplate_DisplayOptions_Format}" />
          <Grid x:Uid="Grid_3" Grid.Row="2" Grid.Column="2" Grid.ColumnSpan="5">
            <Grid.ColumnDefinitions>
              <ColumnDefinition x:Uid="ColumnDefinition_11" Width="*" />
              <ColumnDefinition x:Uid="ColumnDefinition_12" Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBox x:Name="textBoxFormat" x:Uid="textBoxFormat" Grid.Column="0" ToolTip="{x:Static lp:GridFormsResources.StreamSummaryTemplate_DisplayOptions_Format_Tooltip}" VerticalAlignment="Center">
              <TextBox.Text>
                <Binding Path="[Format]" Mode="TwoWay" UpdateSourceTrigger="PropertyChanged" />
              </TextBox.Text>
            </TextBox>
            <Button Click="buttonFormat_Click" x:Name="buttonFormat" x:Uid="buttonFormat" Grid.Column="1" Padding="2,0" Margin="2,0,2,0" MinWidth="0" VerticalAlignment="Center" VerticalContentAlignment="Center" Content="..." />
          </Grid>
          <Label x:Uid="Label_3" Grid.Row="4" Grid.Column="0" Content="{x:Static lp:GridFormsResources.StreamSummaryTemplate_DisplayOptions_Units}" />
          <DockPanel x:Uid="DockPanel_1" Grid.Row="4" Grid.Column="2" Grid.ColumnSpan="5">
            <controls:CheckableComboBox SelectionChanged="comboBoxUnits_SelectionChanged" x:Name="comboBoxUnits" x:Uid="comboBoxUnits" VerticalAlignment="Center" ToolTip="{x:Static lp:GridFormsResources.StreamSummaryTemplate_DisplayOptions_Units_Tooltip}" />
          </DockPanel>
          <Label x:Uid="Label_4" Grid.Row="6" Grid.Column="0" Content="{x:Static lp:GridFormsResources.StreamSummaryTemplate_DisplayOptions_Trace}" />
          <aes:AesXamValueEdit x:Name="textBoxTrace" x:Uid="textBoxTrace" Mask="Double" VerticalAlignment="Center" IsInnerValidationEnable="True" ValueType="{x:Type system:Double}" Margin="0" ToolTip="{x:Static lp:GridFormsResources.StreamSummaryTemplate_DisplayOptions_Trace_Tooltip}" Grid.Row="6" Grid.Column="2">
            <igEditors:ValueEditor.Text>
              <Binding Path="[Trace]" Mode="TwoWay" />
            </igEditors:ValueEditor.Text>
            <FrameworkElement.Height>
              <Binding ElementName="textBoxTraceLabel" Path="ActualHeight" />
            </FrameworkElement.Height>
          </aes:AesXamValueEdit>
          <Label x:Uid="Label_5" Grid.Row="6" Grid.Column="4" Content="{x:Static lp:GridFormsResources.StreamSummaryTemplate_DisplayOptions_TraceLabel}" />
          <TextBox x:Name="textBoxTraceLabel" x:Uid="textBoxTraceLabel" Margin="0" VerticalAlignment="Center" ToolTip="{x:Static lp:GridFormsResources.StreamSummaryTemplate_DisplayOptions_TraceLabel_Tooltip}" Grid.Row="6" Grid.Column="6">
            <TextBox.Text>
              <Binding Path="[Trace-Label]" Mode="TwoWay" UpdateSourceTrigger="PropertyChanged" />
            </TextBox.Text>
          </TextBox>
          <Label x:Uid="Label_6" Grid.Row="8" Grid.Column="0" Content="{x:Static lp:GridFormsResources.StreamSummaryTemplate_DisplayOptions_Scale}" />
          <aes:AesXamValueEdit x:Name="textBoxScale" x:Uid="textBoxScale" Mask="Double" VerticalAlignment="Center" IsInnerValidationEnable="True" ValueType="{x:Type system:Double}" Margin="0" ToolTip="{x:Static lp:GridFormsResources.StreamSummaryTemplate_DisplayOptions_Scale_Tooltip}" Grid.Row="8" Grid.Column="2">
            <igEditors:ValueEditor.Text>
              <Binding Path="[Scale]" Mode="TwoWay" />
            </igEditors:ValueEditor.Text>
            <FrameworkElement.Height>
              <Binding ElementName="textBoxScaleLabel" Path="ActualHeight" />
            </FrameworkElement.Height>
          </aes:AesXamValueEdit>
          <Label x:Uid="Label_7" Grid.Row="8" Grid.Column="4" Content="{x:Static lp:GridFormsResources.StreamSummaryTemplate_DisplayOptions_ScaleLabel}" />
          <TextBox x:Name="textBoxScaleLabel" x:Uid="textBoxScaleLabel" Margin="0" VerticalAlignment="Center" ToolTip="{x:Static lp:GridFormsResources.StreamSummaryTemplate_DisplayOptions_ScaleLabel_Tooltip}" Grid.Row="8" Grid.Column="6">
            <TextBox.Text>
              <Binding Path="[Scale-Label]" Mode="TwoWay" UpdateSourceTrigger="PropertyChanged" />
            </TextBox.Text>
          </TextBox>
        </Grid>
      </GroupBox>
      <Border x:Uid="Border_1" Margin="{DynamicResource AspenVerticalRelativeControlMargin}" />
      <GroupBox x:Uid="GroupBox_3" Header="{x:Static lp:GridFormsResources.StreamSummaryTemplate_DisplayOptions_ComponentsFractions}">
        <UIElement.IsEnabled>
          <Binding Path="IsEditable" Mode="OneWay">
            <Binding.RelativeSource>
              <RelativeSource Mode="FindAncestor" AncestorType="UserControl" />
            </Binding.RelativeSource>
          </Binding>
        </UIElement.IsEnabled>
        <StackPanel x:Uid="StackPanel_2" Orientation="Horizontal">
          <CheckBox x:Name="checkBoxNormolize" x:Uid="checkBoxNormolize" MinWidth="0" Content="{x:Static lp:GridFormsResources.StreamSummaryTemplate_DisplayOptions_Normalize}" ToolTip="{x:Static lp:GridFormsResources.StreamSummaryTemplate_DisplayOptions_Normalize_Tooltip}" Margin="{DynamicResource AspenHorizontalRelativeControlMargin}" VerticalAlignment="Top">
            <ToggleButton.IsChecked>
              <Binding Path="[Normalize]" Converter="{StaticResource yesNoToBooleanConverter}" Mode="TwoWay" />
            </ToggleButton.IsChecked>
          </CheckBox>
          <StackPanel x:Uid="StackPanel_3">
            <Grid x:Uid="Grid_4">
              <Grid.RowDefinitions>
                <RowDefinition x:Uid="RowDefinition_10" Height="Auto" />
                <RowDefinition x:Uid="RowDefinition_11" Height="{DynamicResource AspenVerticalRelativeLength}" />
                <RowDefinition x:Uid="RowDefinition_12" Height="Auto" />
              </Grid.RowDefinitions>
              <Grid.ColumnDefinitions>
                <ColumnDefinition x:Uid="ColumnDefinition_13" Width="Auto" />
                <ColumnDefinition x:Uid="ColumnDefinition_14" Width="{DynamicResource AspenHorizontalRelativeLength}" />
                <ColumnDefinition x:Uid="ColumnDefinition_15" Width="120" />
              </Grid.ColumnDefinitions>
              <Label x:Uid="Label_8" Grid.Row="0" Grid.Column="0" Content="{x:Static lp:GridFormsResources.StreamSummaryTemplate_DisplayOptions_PPM}" />
              <aes:AesXamValueEdit x:Name="textBoxPPM" x:Uid="textBoxPPM" Mask="Double" VerticalAlignment="Center" IsInnerValidationEnable="True" ValueType="{x:Type system:Double}" ToolTip="{x:Static lp:GridFormsResources.StreamSummaryTemplate_DisplayOptions_PPM_Tooltip}" Grid.Row="0" Grid.Column="2">
                <igEditors:ValueEditor.Text>
                  <Binding Path="[PPM]" Mode="TwoWay" />
                </igEditors:ValueEditor.Text>
                <FrameworkElement.Height>
                  <Binding ElementName="textBoxScaleLabel" Path="ActualHeight" />
                </FrameworkElement.Height>
              </aes:AesXamValueEdit>
              <Label x:Uid="Label_9" Grid.Row="2" Grid.Column="0" Content="{x:Static lp:GridFormsResources.StreamSummaryTemplate_DisplayOptions_PPB}" />
              <aes:AesXamValueEdit x:Name="textBoxPPB" x:Uid="textBoxPPB" Mask="Double" VerticalAlignment="Center" IsInnerValidationEnable="True" ValueType="{x:Type system:Double}" ToolTip="{x:Static lp:GridFormsResources.StreamSummaryTemplate_DisplayOptions_PPB_Tooltip}" Grid.Row="2" Grid.Column="2">
                <igEditors:ValueEditor.Text>
                  <Binding Path="[PPB]" Mode="TwoWay" />
                </igEditors:ValueEditor.Text>
                <FrameworkElement.Height>
                  <Binding ElementName="textBoxScaleLabel" Path="ActualHeight" />
                </FrameworkElement.Height>
              </aes:AesXamValueEdit>
            </Grid>
          </StackPanel>
        </StackPanel>
      </GroupBox>
    </StackPanel>
  </Grid>
</UserControl>
