<?xml version='1.0' encoding='utf-8'?>
<Window x:Class="AspenTech.AspenPlus.MMForms.GridForms.StreamReport.Template.TemplateEditor" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:lc="clr-namespace:AspenTech.AspenPlus.Localization;assembly=AspenTech.AspenPlus.Localization" xmlns:te="clr-namespace:AspenTech.AspenPlus.MMForms.GridForms.StreamReport.Template" xmlns:mmctrl="clr-namespace:AspenTech.AspenPlus.MMControls;assembly=AspenTech.AspenPlus.MMControls" Title="{x:Static lc:GridFormsResources.StreamSummaryTemplate_Title}" Width="900" MinWidth="900" Height="700" MinHeight="700" SizeToContent="Manual" ResizeMode="CanResizeWithGrip" ShowInTaskbar="False" WindowStartupLocation="CenterScreen" Background="{DynamicResource AspenDialogBackgroundBrush}" mmctrl:MMHelp.HelpFile="results.chm" mmctrl:MMHelp.HelpId="4">
  <Grid Margin="{DynamicResource AspenDialogOuterMargin}">
    <FrameworkElement.DataContext>
      <Binding>
        <Binding.RelativeSource>
          <RelativeSource AncestorType="Window" Mode="FindAncestor" />
        </Binding.RelativeSource>
      </Binding>
    </FrameworkElement.DataContext>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>
    <StackPanel Orientation="Horizontal" Margin="{DynamicResource AspenVerticalRelativeControlMargin}">
      <Label Content="{x:Static lc:GridFormsResources.StreamSummaryTemplate_Template}" />
      <ComboBox x:Name="comboTemplates" VerticalAlignment="Center" Width="160" DisplayMemberPath="LocalizedName" Margin="{DynamicResource AspenHorizontalRelativeControlMargin}">
        <ItemsControl.ItemsSource>
          <Binding Path="ReportTemplates" Mode="OneWay" />
        </ItemsControl.ItemsSource>
        <Selector.SelectedItem>
          <Binding Path="SelectedReportTemplate" Mode="TwoWay" />
        </Selector.SelectedItem>
      </ComboBox>
      <Button x:Name="buttonImport" VerticalAlignment="Center" Content="{x:Static lc:GridFormsResources.StreamSummaryTemplate_Import}" Margin="{DynamicResource AspenHorizontalRelativeControlMargin}">
        <ButtonBase.Command>
          <Binding Path="ImportCommand" Mode="OneWay" />
        </ButtonBase.Command>
      </Button>
      <Button x:Name="buttonExport" VerticalAlignment="Center" Content="{x:Static lc:GridFormsResources.StreamSummaryTemplate_Export}" Margin="{DynamicResource AspenHorizontalRelativeControlMargin}">
        <ButtonBase.Command>
          <Binding Path="ExportCommand" Mode="OneWay" />
        </ButtonBase.Command>
      </Button>
    </StackPanel>
    <TabControl x:Name="tabs" Grid.Row="1" Margin="{DynamicResource AspenVerticalRelativeControlMargin}">
      <FrameworkElement.DataContext>
        <Binding Path="SelectedReportTemplate.Settings" Mode="OneWay" />
      </FrameworkElement.DataContext>
      <TabItem x:Name="tabGeneral" Header="{x:Static lc:GridFormsResources.StreamSummaryTemplate_GeneralOptions_Caption}">
        <te:EditorGeneralOptions x:Name="generalOptionsEditor" Margin="10">
          <FrameworkElement.DataContext>
            <Binding Path="GeneralOptions" Mode="OneWay" />
          </FrameworkElement.DataContext>
        </te:EditorGeneralOptions>
      </TabItem>
      <TabItem x:Name="tabScope" Header="{x:Static lc:GridFormsResources.StreamSummaryTemplate_ScopeOptions_Caption}">
        <te:EditorScopeOptions x:Name="scopeOptionsEditor" Margin="10">
          <FrameworkElement.DataContext>
            <Binding Path="ScopeOptions" Mode="OneWay" />
          </FrameworkElement.DataContext>
        </te:EditorScopeOptions>
      </TabItem>
      <TabItem x:Name="tabSelectProperties" Header="{x:Static lc:GridFormsResources.StreamSummaryTemplate_SelectProperties_Caption}">
        <te:EditorSelectProperties x:Name="selectPropertiesEditor" Margin="10" />
      </TabItem>
      <TabItem x:Name="tabDisplayOptions" Header="{x:Static lc:GridFormsResources.StreamSummaryTemplate_DisplayOptions_Caption}">
        <te:EditorDisplayOptions x:Name="displayOptionsEditor" Margin="10" />
      </TabItem>
      <TabItem x:Name="tabCalculateOptions" Header="{x:Static lc:GridFormsResources.StreamSummaryTemplate_CalculationOptions_Caption}">
        <te:EditorCalculationOptions x:Name="calculationOptionsEditor" Margin="10" />
      </TabItem>
    </TabControl>
    <StackPanel Orientation="Horizontal" Grid.Row="2" HorizontalAlignment="Right">
      <Button x:Name="buttonApply" VerticalAlignment="Center" Content="{x:Static lc:GridFormsResources.StreamSummaryTemplate_Apply}" Margin="{DynamicResource AspenHorizontalRelativeControlMargin}">
        <ButtonBase.Command>
          <Binding Path="ApplyCommand" Mode="OneWay" />
        </ButtonBase.Command>
      </Button>
      <Button Click="buttonOK_Click" x:Name="buttonOK" IsDefault="True" VerticalAlignment="Center" Content="{x:Static lc:GridFormsResources.StreamSummaryTemplate_OK}" Margin="{DynamicResource AspenHorizontalRelativeControlMargin}" />
      <Button x:Name="buttonCancel" IsCancel="True" VerticalAlignment="Center" Content="{x:Static lc:GridFormsResources.StreamSummaryTemplate_Cancel}" />
    </StackPanel>
  </Grid>
</Window>
