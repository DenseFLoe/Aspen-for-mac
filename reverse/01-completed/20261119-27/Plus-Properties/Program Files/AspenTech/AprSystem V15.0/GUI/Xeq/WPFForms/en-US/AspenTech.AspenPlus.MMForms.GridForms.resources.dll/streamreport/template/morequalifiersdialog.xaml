<?xml version='1.0' encoding='utf-8'?>
<Window x:Class="AspenTech.AspenPlus.MMForms.GridForms.StreamReport.Template.MoreQualifiersDialog" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:lp="clr-namespace:AspenTech.AspenPlus.Localization;assembly=AspenTech.AspenPlus.Localization" xmlns:system="clr-namespace:System;assembly=mscorlib" xmlns:igEditors="http://infragistics.com/Editors" xmlns:template="clr-namespace:AspenTech.AspenPlus.MMForms.GridForms.StreamReport.Template" xmlns:controls="clr-namespace:AspenTech.AspenPlus.MMForms.GridForms.Controls;assembly=AspenTech.AspenPlus.MMForms.GridForms.Controls" xmlns:mmctrl="clr-namespace:AspenTech.AspenPlus.MMControls;assembly=AspenTech.AspenPlus.MMControls" x:Uid="Window_1" Title="{x:Static lp:GridFormsResources.MoreQualifiersDialog_Title}" MinWidth="500" SizeToContent="WidthAndHeight" ResizeMode="NoResize" ShowInTaskbar="False" WindowStartupLocation="CenterOwner" Background="{DynamicResource AspenDialogBackgroundBrush}" mmctrl:MMHelp.HelpFile="results.chm" mmctrl:MMHelp.HelpId="4">
  <FrameworkElement.Resources>
    <ResourceDictionary>
      <Style x:Key="{x:Type igEditors:XamMaskedEditor}" x:Uid="Style_1" TargetType="{x:Type igEditors:XamMaskedEditor}">
        <Setter x:Uid="Setter_1" Property="igEditors:XamMaskedEditor.DisplayMode" Value="Raw" />
        <Setter x:Uid="Setter_2" Property="igEditors:XamMaskedEditor.DataMode" Value="Raw" />
        <Setter x:Uid="Setter_3" Property="Control.HorizontalContentAlignment" Value="Left" />
        <Setter x:Uid="Setter_4" Property="igEditors:ValueEditor.ValueType" Value="{x:Type system:Double}" />
        <Setter x:Uid="Setter_5" Property="igEditors:XamMaskedEditor.Mask" Value="{x:Static template:EditorDisplayOptions.DoubleMask}" />
        <Setter x:Uid="Setter_6" Property="igEditors:XamMaskedEditor.PromptChar" Value="" />
        <Setter x:Uid="Setter_7" Property="Control.Padding" Value="4,2" />
      </Style>
    </ResourceDictionary>
  </FrameworkElement.Resources>
  <StackPanel x:Uid="StackPanel_1" Margin="{DynamicResource AspenDialogOuterMargin}" Grid.IsSharedSizeScope="True">
    <GroupBox x:Uid="GroupBox_1" Header="{x:Static lp:GridFormsResources.MoreQualifiersDialog_Group1_Header}" Margin="{DynamicResource AspenVerticalRelativeControlMargin}">
      <Grid x:Uid="Grid_1">
        <Grid.RowDefinitions>
          <RowDefinition x:Uid="RowDefinition_1" Height="Auto" />
          <RowDefinition x:Uid="RowDefinition_2" Height="{DynamicResource AspenVerticalRelativeLength}" />
          <RowDefinition x:Uid="RowDefinition_3" Height="Auto" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
          <ColumnDefinition x:Uid="ColumnDefinition_1" Width="Auto" SharedSizeGroup="inner1" />
          <ColumnDefinition x:Uid="ColumnDefinition_2" Width="70*" />
        </Grid.ColumnDefinitions>
        <Label x:Uid="Label_1" Grid.Row="0" Grid.Column="0" Content="{x:Static lp:GridFormsResources.MoreQualifiersDialog_Group1_Components}" Margin="{DynamicResource AspenHorizontalRelativeControlMargin}" />
        <controls:CheckableComboBox SelectionChanged="comboBoxComponents_SelectionChanged" x:Name="comboBoxComponents" x:Uid="comboBoxComponents" VerticalAlignment="Center" Grid.Row="0" Grid.Column="1" />
        <Label x:Uid="Label_2" Grid.Row="2" Grid.Column="0" Content="{x:Static lp:GridFormsResources.MoreQualifiersDialog_Group1_BaseComponents}" Margin="{DynamicResource AspenHorizontalRelativeControlMargin}" />
        <controls:CheckableComboBox SelectionChanged="comboBoxBaseComponents_SelectionChanged" x:Name="comboBoxBaseComponents" x:Uid="comboBoxBaseComponents" VerticalAlignment="Center" Grid.Row="2" Grid.Column="1" />
      </Grid>
    </GroupBox>
    <GroupBox x:Uid="GroupBox_2" Header="{x:Static lp:GridFormsResources.MoreQualifiersDialog_Group2_Header}" Margin="{DynamicResource AspenVerticalRelativeControlMargin}">
      <Grid x:Uid="Grid_2">
        <Grid.RowDefinitions>
          <RowDefinition x:Uid="RowDefinition_4" Height="Auto" />
          <RowDefinition x:Uid="RowDefinition_5" Height="{DynamicResource AspenVerticalRelativeLength}" />
          <RowDefinition x:Uid="RowDefinition_6" Height="Auto" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
          <ColumnDefinition x:Uid="ColumnDefinition_3" Width="Auto" SharedSizeGroup="inner1" />
          <ColumnDefinition x:Uid="ColumnDefinition_4" Width="35*" />
          <ColumnDefinition x:Uid="ColumnDefinition_5" Width="Auto" />
          <ColumnDefinition x:Uid="ColumnDefinition_6" Width="35*" />
        </Grid.ColumnDefinitions>
        <Label x:Uid="Label_3" Grid.Column="0" Content="{x:Static lp:GridFormsResources.MoreQualifiersDialog_Group2_Lower}" Margin="{DynamicResource AspenHorizontalRelativeControlMargin}" />
        <igEditors:XamMaskedEditor ValueChanged="textBoxLower_ValueChanged" x:Name="textBoxLower" x:Uid="textBoxLower" VerticalAlignment="Center" Grid.Column="1" />
        <Label x:Uid="Label_4" Grid.Column="2" Content="{x:Static lp:GridFormsResources.MoreQualifiersDialog_Group2_Upper}" Margin="5,0" />
        <igEditors:XamMaskedEditor ValueChanged="textBoxUpper_ValueChanged" x:Name="textBoxUpper" x:Uid="textBoxUpper" VerticalAlignment="Center" Grid.Column="3" />
        <Label x:Uid="Label_5" Grid.Row="2" Grid.Column="0" Content="{x:Static lp:GridFormsResources.MoreQualifiersDialog_Group2_BaseLower}" Margin="{DynamicResource AspenHorizontalRelativeControlMargin}" />
        <igEditors:XamMaskedEditor ValueChanged="textBoxBaseLower_ValueChanged" x:Name="textBoxBaseLower" x:Uid="textBoxBaseLower" VerticalAlignment="Center" Grid.Row="2" Grid.Column="1" />
        <Label x:Uid="Label_6" Grid.Row="2" Grid.Column="2" Content="{x:Static lp:GridFormsResources.MoreQualifiersDialog_Group2_BaseUpper}" Margin="5,0" />
        <igEditors:XamMaskedEditor ValueChanged="textBoxBaseUpper_ValueChanged" x:Name="textBoxBaseUpper" x:Uid="textBoxBaseUpper" VerticalAlignment="Center" Grid.Row="2" Grid.Column="3" />
      </Grid>
    </GroupBox>
    <GroupBox x:Uid="GroupBox_3" Header="{x:Static lp:GridFormsResources.MoreQualifiersDialog_Group3_Header}" Margin="{DynamicResource AspenVerticalRelativeControlMargin}">
      <controls:EditableListBox x:Name="listBoxLiquidOrWeight" x:Uid="listBoxLiquidOrWeight" EditAsType="{x:Type system:Double}" MinHeight="100" />
    </GroupBox>
    <StackPanel x:Uid="StackPanel_2" Orientation="Horizontal" HorizontalAlignment="Right">
      <Button Click="buttonOK_Click" x:Name="buttonOK" x:Uid="buttonOK" IsDefault="True" Content="{x:Static lp:GridFormsResources.MoreQualifiersDialog_Button_OK}" />
      <Button x:Name="buttonCancel" x:Uid="buttonCancel" IsCancel="True" Margin="0" Content="{x:Static lp:GridFormsResources.MoreQualifiersDialog_Button_Cancel}" />
    </StackPanel>
  </StackPanel>
</Window>
