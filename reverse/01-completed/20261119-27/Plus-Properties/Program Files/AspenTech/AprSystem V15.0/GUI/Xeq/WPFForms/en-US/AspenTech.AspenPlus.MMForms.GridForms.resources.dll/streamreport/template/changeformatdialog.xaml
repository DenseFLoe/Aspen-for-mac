<?xml version='1.0' encoding='utf-8'?>
<Window x:Class="AspenTech.AspenPlus.MMForms.GridForms.StreamReport.Template.ChangeFormatDialog" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:lp="clr-namespace:AspenTech.AspenPlus.Localization;assembly=AspenTech.AspenPlus.Localization" xmlns:system="clr-namespace:System;assembly=mscorlib" xmlns:igEditors="http://infragistics.com/Editors" xmlns:converters="clr-namespace:AspenTech.AspenPlus.MMForms.GridForms.Controls.Converters;assembly=AspenTech.AspenPlus.MMForms.GridForms.Controls" x:Uid="Window_1" Title="{x:Static lp:GridFormsResources.ChangeFormatDialog_Title}" SizeToContent="Height" MinWidth="400" Width="500" ResizeMode="NoResize" ShowInTaskbar="False" WindowStartupLocation="CenterOwner" Background="{DynamicResource AspenDialogBackgroundBrush}">
  <FrameworkElement.Resources>
    <ResourceDictionary>
      <converters:RadioButtonValueConverter x:Key="rbvConverter" x:Uid="converters_RadioButtonValueConverter_1" />
    </ResourceDictionary>
  </FrameworkElement.Resources>
  <StackPanel x:Uid="StackPanel_1" Margin="{DynamicResource AspenDialogOuterMargin}">
    <GroupBox x:Uid="GroupBox_1" Header="{x:Static lp:GridFormsResources.ChangeFormatDialog_GroupHeader}" Margin="{DynamicResource AspenVerticalRelativeControlMargin}">
      <StackPanel x:Uid="StackPanel_2">
        <FrameworkElement.DataContext>
          <Binding>
            <Binding.RelativeSource>
              <RelativeSource Mode="FindAncestor" AncestorType="Window" />
            </Binding.RelativeSource>
          </Binding>
        </FrameworkElement.DataContext>
        <RadioButton x:Uid="RadioButton_1" Content="{x:Static lp:GridFormsResources.ChangeFormatDialog_Option1}" Margin="{DynamicResource AspenVerticalRelativeControlMargin}">
          <ToggleButton.IsChecked>
            <Binding Path="SelectedOption" Mode="TwoWay" Converter="{StaticResource rbvConverter}" ConverterParameter="0" />
          </ToggleButton.IsChecked>
        </RadioButton>
        <RadioButton x:Uid="RadioButton_2" Content="{x:Static lp:GridFormsResources.ChangeFormatDialog_Option2}" Margin="{DynamicResource AspenVerticalRelativeControlMargin}">
          <ToggleButton.IsChecked>
            <Binding Path="SelectedOption" Mode="TwoWay" Converter="{StaticResource rbvConverter}" ConverterParameter="1" />
          </ToggleButton.IsChecked>
        </RadioButton>
        <RadioButton x:Uid="RadioButton_3" Content="{x:Static lp:GridFormsResources.ChangeFormatDialog_Option3}" Margin="{DynamicResource AspenVerticalRelativeControlMargin}">
          <ToggleButton.IsChecked>
            <Binding Path="SelectedOption" Mode="TwoWay" Converter="{StaticResource rbvConverter}" ConverterParameter="2" />
          </ToggleButton.IsChecked>
        </RadioButton>
        <StackPanel x:Uid="StackPanel_3" Orientation="Horizontal" HorizontalAlignment="Right">
          <Label x:Uid="Label_1" Content="{x:Static lp:GridFormsResources.ChangeFormatDialog_PrecisionLabel}" />
          <igEditors:XamNumericEditor ValueChanged="textBoxPrecision_ValueChanged" x:Name="textBoxPrecision" x:Uid="textBoxPrecision" Padding="4,2" Width="100" DataMode="Raw" DisplayMode="Raw" Mask="{}{number:0-20}" PromptChar="" ValueType="{x:Type system:Int32}">
            <igEditors:ValueEditor.Value>
              <Binding Path="Precision" Mode="TwoWay" UpdateSourceTrigger="PropertyChanged" ValidatesOnDataErrors="True" />
            </igEditors:ValueEditor.Value>
          </igEditors:XamNumericEditor>
        </StackPanel>
      </StackPanel>
    </GroupBox>
    <StackPanel x:Uid="StackPanel_4" Orientation="Horizontal" HorizontalAlignment="Right">
      <Button Click="buttonOK_Click" x:Name="buttonOK" x:Uid="buttonOK" IsDefault="True" Content="{x:Static lp:GridFormsResources.ChangeFormatDialog_ButtonOK}" />
      <Button Click="buttonCancel_Click" x:Name="buttonCancel" x:Uid="buttonCancel" IsCancel="True" Margin="0" Content="{x:Static lp:GridFormsResources.ChangeFormatDialog_ButtonCancel}" />
    </StackPanel>
  </StackPanel>
</Window>
