<?xml version='1.0' encoding='utf-8'?>
<Window x:Class="AspenTech.AspenPlus.MMForms.GridForms.StreamReport.Template.UserPropMessageBox" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:lc="clr-namespace:AspenTech.AspenPlus.Localization;assembly=AspenTech.AspenPlus.Localization" xmlns:mmctrl="clr-namespace:AspenTech.AspenPlus.MMControls;assembly=AspenTech.AspenPlus.MMControls" Title="{x:Static lc:GridFormsResources.UserPropMessageBox_Title}" Width="500" SizeToContent="Height" WindowStyle="SingleBorderWindow" WindowStartupLocation="CenterOwner" ResizeMode="NoResize" mmctrl:MMHelp.HelpFile="results.chm" mmctrl:MMHelp.HelpId="#4">
  <Grid>
    <Grid>
      <Panel.Background>
        <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0">
          <GradientStop Color="#FFDAEAFD" Offset="0" />
          <GradientStop Color="#FFDCF0FD" Offset="1" />
        </LinearGradientBrush>
      </Panel.Background>
      <Grid.RowDefinitions>
        <RowDefinition Height="*" />
        <RowDefinition Height="*" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>
      <Grid x:Name="Grid1" Grid.Row="0" Margin="8">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Label Height="25" Foreground="#FF008000" Content="{x:Static lc:GridFormsResources.UserPropMessageBox_AddLable}" Grid.Row="0" />
        <ListBox x:Name="ListBox1" Grid.Row="1" SelectionMode="Extended" MinHeight="180">
          <ItemsControl.ItemsSource>
            <Binding />
          </ItemsControl.ItemsSource>
          <UIElement.CommandBindings>
            <CommandBinding CanExecute="CopyCommandCanExecute" Executed="CopyCommandExecuted" Command="ApplicationCommands.Copy" />
          </UIElement.CommandBindings>
          <ItemsControl.ItemContainerStyle>
            <Style TargetType="{x:Type ListBoxItem}">
              <Setter Property="FrameworkElement.ContextMenu">
                <Setter.Value>
                  <ContextMenu>
                    <MenuItem Header="Copy" Command="ApplicationCommands.Copy" />
                  </ContextMenu>
                </Setter.Value>
              </Setter>
            </Style>
          </ItemsControl.ItemContainerStyle>
        </ListBox>
      </Grid>
      <Grid x:Name="Gird2" Grid.Row="1" Margin="8">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Label Height="25" Foreground="#FF0000FF" Content="{x:Static lc:GridFormsResources.UserPropMessageBox_ExistLable}" Grid.Row="0" />
        <ListBox x:Name="ListBox2" Grid.Row="1" SelectionMode="Extended" MinHeight="180">
          <ItemsControl.ItemsSource>
            <Binding />
          </ItemsControl.ItemsSource>
          <UIElement.CommandBindings>
            <CommandBinding CanExecute="CopyCommandCanExecute" Executed="CopyCommandExecuted" Command="ApplicationCommands.Copy" />
          </UIElement.CommandBindings>
          <ItemsControl.ItemContainerStyle>
            <Style TargetType="{x:Type ListBoxItem}">
              <Setter Property="FrameworkElement.ContextMenu">
                <Setter.Value>
                  <ContextMenu>
                    <MenuItem Header="{x:Static lc:GridFormsResources.UserPropMessageBox_Copy}" Command="ApplicationCommands.Copy" />
                  </ContextMenu>
                </Setter.Value>
              </Setter>
            </Style>
          </ItemsControl.ItemContainerStyle>
        </ListBox>
      </Grid>
      <Grid Grid.Row="2" Margin="0,0,0,5">
        <Button Click="Button1_Click" x:Name="Button1" Content="{x:Static lc:GridFormsResources.UserPropMessageBox_Close}" Grid.Row="4" Height="20" MinWidth="50" HorizontalAlignment="Center" />
      </Grid>
    </Grid>
  </Grid>
</Window>
