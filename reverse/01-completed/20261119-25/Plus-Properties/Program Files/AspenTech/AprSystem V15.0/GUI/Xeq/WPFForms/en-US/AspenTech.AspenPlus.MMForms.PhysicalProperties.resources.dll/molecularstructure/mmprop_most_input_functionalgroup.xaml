<?xml version='1.0' encoding='utf-8'?>
<MMTabPage x:Class="AspenTech.AspenPlus.MMForms.PhysicalProperties.MolecularStructure.MMProp_MoSt_Input_FunctionalGroup" xmlns="http://schemas.aspentech.com/xaml/presentation/aspenplus" xmlns:res="clr-namespace:AspenTech.AspenPlus.Localization;assembly=AspenTech.AspenPlus.Localization" xmlns:av="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:aes="http://schemas.aspentech.com/xaml/presentation/engineering" xmlns:ms="clr-namespace:AspenTech.AspenPlus.MMForms.PhysicalProperties.MolecularStructure" xmlns:gc="clr-namespace:AspenTech.Engineering.GridControls;assembly=AspenTech.Engineering.GridControls" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" MinWidth="520" MinHeight="340">
  <av:FrameworkElement.Resources>
    <av:ResourceDictionary>
      <ms:MolecularGroupItemToGroupConverter x:Key="groupItemConverter" />
    </av:ResourceDictionary>
  </av:FrameworkElement.Resources>
  <av:Grid Margin="8">
    <av:Grid.ColumnDefinitions>
      <av:ColumnDefinition Width="Auto" />
      <av:ColumnDefinition Width="*" />
    </av:Grid.ColumnDefinitions>
    <ms:GraphicalStructure VerticalAlignment="Top" av:Grid.Column="0" Margin="0,0,8,0">
      <ms:GraphicalStructure.ParentViewModel>
        <av:Binding />
      </ms:GraphicalStructure.ParentViewModel>
    </ms:GraphicalStructure>
    <av:GroupBox Header="{x:Static res:ApwnResources.PhysicalProperties_MoleculeStructure_StructureAndFuncGroup_FunctionalGroup}" av:Grid.Column="1">
      <av:Grid x:Uid="av_Grid_1" Margin="8">
        <av:Grid.ColumnDefinitions>
          <av:ColumnDefinition Width="*" />
        </av:Grid.ColumnDefinitions>
        <av:Grid.RowDefinitions>
          <av:RowDefinition Height="Auto" />
          <av:RowDefinition Height="*" />
        </av:Grid.RowDefinitions>
        <av:Grid x:Uid="av_Grid_2" av:Grid.Row="0">
          <av:Grid.ColumnDefinitions>
            <av:ColumnDefinition Width="Auto" />
            <av:ColumnDefinition Width="Auto" />
            <av:ColumnDefinition Width="*" MinWidth="300" />
          </av:Grid.ColumnDefinitions>
          <av:Grid.RowDefinitions>
            <av:RowDefinition Height="Auto" />
            <av:RowDefinition Height="8" MaxHeight="8" />
            <av:RowDefinition Height="Auto" />
            <av:RowDefinition Height="8" MaxHeight="8" />
            <av:RowDefinition Height="Auto" />
            <av:RowDefinition Height="8" MaxHeight="8" />
            <av:RowDefinition Height="*" />
          </av:Grid.RowDefinitions>
          <MMLabel Name="MMMenuButton1_label" x:Uid="MMLabel_1" TargetControl="MMMenuButton1" MinWidth="76" av:Grid.Column="0" av:Grid.Row="0" Content="{x:Static res:ApwnResources.MMProp_MoSt_Input_FuncGr_MMF_Content0}" />
          <MMAdvancedComboEdit Name="MMMenuButton1" x:Uid="MMAdvancedComboEdit_1" Mask="Integer" VariablePath="Methods_Var" Width="380" av:Grid.Column="1" av:Grid.Row="0">
            <MMHelp.HelpFile>
              <av:Binding Path="Variable.SelectedObject.HelpFile" Mode="OneWay" FallbackValue="PROPS.chm">
                <av:Binding.RelativeSource>
                  <av:RelativeSource Mode="Self" />
                </av:Binding.RelativeSource>
              </av:Binding>
            </MMHelp.HelpFile>
            <MMHelp.HelpId>
              <av:Binding Path="Variable.SelectedObject.HelpId" Mode="OneWay" FallbackValue="270">
                <av:Binding.RelativeSource>
                  <av:RelativeSource Mode="Self" />
                </av:Binding.RelativeSource>
              </av:Binding>
            </MMHelp.HelpId>
          </MMAdvancedComboEdit>
          <MMLabel Name="MMLabel_FunctionalGroupType" av:Grid.Row="2" Content="{x:Static res:ApwnResources.MMProp_MoSt_Input_FunctionalGroup_Label_GroupType}" />
          <MMComboBox Name="MMComboBox_GroupType" av:Grid.Row="2" av:Grid.Column="1" AutoBind="False" UpdateSourceWhenValueChanged="True" Width="380">
            <aes:AesComboEdit.ValueOptions>
              <av:Binding Path="GroupTypes" Mode="OneWay" />
            </aes:AesComboEdit.ValueOptions>
            <aes:AesComboEdit.Value>
              <av:Binding Path="SelectedGroupType" Mode="TwoWay" />
            </aes:AesComboEdit.Value>
          </MMComboBox>
          <MMLabel Name="MMLabel_Group" av:Grid.Row="4" Content="{x:Static res:ApwnResources.MMProp_MoSt_Input_FunctionalGroup_Label_Group}" />
          <MMComboBox Name="MMComboBox_Group" av:Grid.Row="4" av:Grid.Column="1" VerticalAlignment="Center" AutoBind="False" UpdateSourceWhenValueChanged="True" Width="380">
            <aes:AesComboEdit.ValueOptions>
              <av:Binding Path="GroupItems" Mode="OneWay" />
            </aes:AesComboEdit.ValueOptions>
            <aes:AesComboEdit.Value>
              <av:Binding Path="SelectedGroupItem" Mode="TwoWay" />
            </aes:AesComboEdit.Value>
            <aes:AesComboEdit.TooltipTemplate>
              <av:DataTemplate>
                <ms:FunctionalGroupTooltipBox>
                  <ms:FunctionalGroupTooltipBox.GroupName>
                    <av:Binding Path="TooltipTarget.DataContext.SelectedGroup" Mode="OneWay">
                      <av:Binding.RelativeSource>
                        <av:RelativeSource Mode="Self" />
                      </av:Binding.RelativeSource>
                    </av:Binding>
                  </ms:FunctionalGroupTooltipBox.GroupName>
                </ms:FunctionalGroupTooltipBox>
              </av:DataTemplate>
            </aes:AesComboEdit.TooltipTemplate>
            <aes:AesComboEdit.ItemTooltipTemplate>
              <av:DataTemplate>
                <ms:FunctionalGroupTooltipBox>
                  <ms:FunctionalGroupTooltipBox.GroupName>
                    <av:Binding Converter="{av:StaticResource groupItemConverter}" Mode="OneWay" />
                  </ms:FunctionalGroupTooltipBox.GroupName>
                </ms:FunctionalGroupTooltipBox>
              </av:DataTemplate>
            </aes:AesComboEdit.ItemTooltipTemplate>
          </MMComboBox>
          <MMCmdButton Name="MMCmdButton_Add" av:Grid.Row="6" av:Grid.Column="1" VerticalAlignment="Top" MinWidth="70" Content="{x:Static res:ApwnResources.MMProp_MoSt_Input_FunctionalGroup_Button_Add}">
            <aes:AesCmdButton.Command>
              <av:Binding Path="AddCommand" Mode="OneWay" />
            </aes:AesCmdButton.Command>
          </MMCmdButton>
          <av:Border av:Grid.Row="0" av:Grid.Column="2" av:Grid.RowSpan="7" Margin="8,0,0,0" HorizontalAlignment="Right" Height="182" Width="297">
            <av:Image Name="sampleImage" VerticalAlignment="Stretch" Stretch="Uniform">
              <av:Image.Source>
                <av:Binding Path="SampleImageSource" Mode="OneWay" />
              </av:Image.Source>
              <av:UIElement.Visibility>
                <av:Binding Path="SampleImageVisibility" Mode="OneWay" />
              </av:UIElement.Visibility>
            </av:Image>
          </av:Border>
        </av:Grid>
        <gc:GridControl Name="theGridControl" Margin="0,8,0,0" av:Grid.Row="1" AllowColumnChooser="False" AllowColumnFreeze="False" AllowColumnReorder="False" AllowRecordFiltering="False" AllowRowReorder="False" MinRowHeight="100" SortingMode="AllowSingleColumnSorting">
          <gc:GridControl.DataSource>
            <av:Binding Path="DataSource" Mode="OneWay" />
          </gc:GridControl.DataSource>
          <av:UIElement.CommandBindings>
            <av:CommandBinding Executed="DeleteCommand_Executed" CanExecute="DeleteCommand_CanExecute" Command="{x:Static av:ApplicationCommands.Delete}" />
          </av:UIElement.CommandBindings>
        </gc:GridControl>
      </av:Grid>
    </av:GroupBox>
  </av:Grid>
</MMTabPage>
