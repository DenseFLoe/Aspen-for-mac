<?xml version='1.0' encoding='utf-8'?>
<UserControl x:Class="AspenTech.AspenPlus.MMForms.PhysicalProperties.MolecularStructure.FunctionalGroupTooltipBox" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:AspenTech.AspenPlus.MMForms.PhysicalProperties.MolecularStructure">
  <Grid>
    <FrameworkElement.DataContext>
      <Binding>
        <Binding.RelativeSource>
          <RelativeSource Mode="FindAncestor" AncestorType="UserControl" />
        </Binding.RelativeSource>
      </Binding>
    </FrameworkElement.DataContext>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>
    <TextBlock TextWrapping="WrapWithOverflow">
      <TextBlock.Text>
        <Binding Path="HeaderLine" Mode="OneWay" />
      </TextBlock.Text>
      <UIElement.Visibility>
        <Binding Path="HeaderLineVisibility" Mode="OneWay" />
      </UIElement.Visibility>
    </TextBlock>
    <Image Name="theImage" Grid.Row="1" Stretch="UniformToFill" Height="93">
      <Image.Source>
        <Binding Path="Image" Mode="OneWay" />
      </Image.Source>
      <UIElement.Visibility>
        <Binding Path="ImageVisibility" Mode="OneWay" />
      </UIElement.Visibility>
    </Image>
  </Grid>
</UserControl>
