      <MMScrollAreaMS.MMFields>
        <MMScrollAreaReadOnlyValueField x:Uid="MMScrollAreaReadOnlyValueField_3" PropertyPath="Element" ColumnHeaderTemplate="{av:StaticResource labelHeaderTemplate}" Width="120" ColumnHeaderCopyValueBindingPath="FirstColumnHeader" />
        <MMScrollAreaFieldRepeater x:Uid="MMScrollAreaFieldRepeater_2" SecondLevelVectorProperty="inner">
          <MMScrollAreaReadOnlyValueField x:Uid="MMScrollAreaReadOnlyValueField_4" IsHeaderReadOnly="True" PropertyPath="inner[{index}].txtValue_var1" HeaderTypeProperty="value,value,value,value" HeaderUnitsProperty="grdParameters_GridData[0].inner[{index}].Component, grdParameters_GridData[0].inner[{index}].TemperatureUnits, grdParameters_GridData[0].inner[{index}].Source, grdParameters_GridData[0].inner[{index}].PropertyUnits" />
        </MMScrollAreaFieldRepeater>
