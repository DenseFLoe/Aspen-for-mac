      <MMLabel Name="txtOpsetName_label" av:Grid.Column="0" x:Uid="MMLabel_1" TargetControl="txtOpsetName" Content="{x:Static res:ApwnResources.MMProp_Spec_OpsetnameDB_MMF_Content0}" />
