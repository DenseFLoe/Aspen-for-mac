<?xml version='1.0' encoding='utf-8'?>
<MMTabPage x:Class="AspenTech.AspenPlus.MMForms.PhysicalProperties.Parameters.Results.Pure_Components.MMResults_PureSca" xmlns="http://schemas.aspentech.com/xaml/presentation/aspenplus" xmlns:res="clr-namespace:AspenTech.AspenPlus.Localization;assembly=AspenTech.AspenPlus.Localization" xmlns:av="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:aes="http://schemas.aspentech.com/xaml/presentation/engineering" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:converter="clr-namespace:AspenTech.AspenPlus.MMForms.PhysicalProperties.Parameters.Results.Converter" xmlns:legend="clr-namespace:AspenTech.AspenPlus.MMForms.PhysicalProperties.Parameters.Results.PublicComponent" x:Uid="MMTabPage_1" MinWidth="520" MinHeight="340">
  <av:FrameworkElement.Resources>
    <av:ResourceDictionary>
      <converter:ValueToColorConverter x:Key="colorConverter" />
    </av:ResourceDictionary>
  </av:FrameworkElement.Resources>
  <av:Grid x:Uid="av_Grid_1" Margin="8,8,0,0">
    <av:Grid.ColumnDefinitions>
      <av:ColumnDefinition x:Uid="av_ColumnDefinition_1" Width="*" />
    </av:Grid.ColumnDefinitions>
    <av:Grid.RowDefinitions>
      <av:RowDefinition x:Uid="av_RowDefinition_1" Height="Auto" />
      <av:RowDefinition x:Uid="av_RowDefinition_2" Height="*" />
      <av:RowDefinition x:Uid="av_RowDefinition_3" Height="Auto" />
    </av:Grid.RowDefinitions>
    <av:Grid x:Uid="av_Grid_2" av:Grid.Column="0" av:Grid.Row="0">
      <av:Grid.ColumnDefinitions>
        <av:ColumnDefinition x:Uid="av_ColumnDefinition_2" Width="Auto" />
        <av:ColumnDefinition x:Uid="av_ColumnDefinition_3" Width="Auto" />
        <av:ColumnDefinition x:Uid="av_ColumnDefinition_4" Width="Auto" />
      </av:Grid.ColumnDefinitions>
      <av:Grid.RowDefinitions>
        <av:RowDefinition x:Uid="av_RowDefinition_4" Height="Auto" />
      </av:Grid.RowDefinitions>
      <MMLabel Name="advView_label" x:Uid="MMLabel_1" TargetControl="advView" MinWidth="53" av:Grid.Column="0" av:Grid.Row="0" Content="{x:Static res:ApwnResources.MMResults_PureSca_MMF_Content0}" />
      <MMComboEdit Name="advView" x:Uid="MMComboEdit_1" Mask="Integer" VariablePath="advView_AdvCollection" Width="150" av:Grid.Column="1" av:Grid.Row="0" MMHelp.HelpId="275" />
      <MMCmdButton Name="cmdCopyParameter" x:Uid="MMCmdButton_1" av:Grid.Column="2" av:Grid.Row="0" MinWidth="100" Margin="10,0,0,0" Content="{x:Static res:ApwnResources.MMResults_PureTDep_Copy}">
        <aes:AesCmdButton.Command>
          <av:Binding Path="cmdCopyScalar_Command" />
        </aes:AesCmdButton.Command>
        <av:UIElement.Visibility>
          <av:Binding Path="grdParameters_Visible.Value" />
        </av:UIElement.Visibility>
      </MMCmdButton>
    </av:Grid>
    <av:Grid av:Grid.Column="0" av:Grid.Row="2">
      <av:UIElement.Visibility>
        <av:Binding Path="Status_Visible.Value" />
      </av:UIElement.Visibility>
      <legend:LegendBar Height="50" />
    </av:Grid>
    <MMScrollAreaMS Name="grdStatus" x:Uid="MMScrollAreaMS_1" DataProperty="grdStatus_GridData" AlternatingRowBackground="#FFFFFFFF" Margin="0,8,0,0" av:Grid.Column="0" av:Grid.Row="1">
      <av:UIElement.Visibility>
        <av:Binding Path="Status_Visible.Value" />
      </av:UIElement.Visibility>
      <MMScrollAreaMS.MMFields>
        <MMScrollAreaReadOnlyValueField x:Uid="MMScrollAreaReadOnlyValueField_1" Mask="None" CharacterCasing="Upper" PropertyPath="MMTextBox6_var1" Label="{x:Static res:ApwnResources.MMResults_PureSca_MMFLabel0}" IsFieldFixed="True" ColumnHeaderTextAlignment="Left" />
        <MMScrollAreaFieldRepeater x:Uid="MMScrollAreaFieldRepeater_1" SecondLevelVectorProperty="inner" KeyPath="grdStatus_GridData[0].inner[{0}].z.Value">
          <MMScrollAreaReadOnlyColorValueField x:Uid="MMScrollAreaReadOnlyValueField_2" Mask="None" CharacterCasing="Upper" PropertyPath="inner[{index}].MMTextBox2_var1" Label="{}{key}" LabelTextConverterBindingPath="LabelConverter" ValueToColorConverter="{av:StaticResource colorConverter}" />
        </MMScrollAreaFieldRepeater>
      </MMScrollAreaMS.MMFields>
    </MMScrollAreaMS>
    <MMScrollAreaMS Name="grdParameters" x:Uid="MMScrollAreaMS_2" DataProperty="grdParameters_GridData" av:Grid.Row="1" Margin="0,8,0,0">
      <av:UIElement.Visibility>
        <av:Binding Path="grdParameters_Visible.Value" />
      </av:UIElement.Visibility>
      <MMScrollAreaMS.MMFields>
        <MMScrollAreaReadOnlyValueField x:Uid="MMScrollAreaReadOnlyValueField_3" Mask="None" CharacterCasing="Upper" PropertyPath="txtParameters_var1" Width="80" Label="{x:Static res:ApwnResources.MMResults_PureSca_MMFLabel1}" IsFieldFixed="True" />
        <MMScrollAreaReadOnlyValueField x:Uid="MMScrollAreaReadOnlyValueField_4" Mask="None" CharacterCasing="Upper" PropertyPath="MMTextBox1_var1" Width="100" Label="{x:Static res:ApwnResources.MMResults_PureSca_MMFLabel2}" IsFieldFixed="True" />
        <MMScrollAreaReadOnlyValueField x:Uid="MMScrollAreaReadOnlyValueField_5" Mask="None" CharacterCasing="Upper" PropertyPath="txtDataSet_var1" Width="40" Label="{x:Static res:ApwnResources.MMResults_PureSca_MMFLabel3}" IsFieldFixed="True" />
        <MMScrollAreaFieldRepeater x:Uid="MMScrollAreaFieldRepeater_2" SecondLevelVectorProperty="inner" KeyPath="grdParameters_GridData[0].inner[{0}].z.Value">
          <MMScrollAreaReadOnlyValueField x:Uid="MMScrollAreaReadOnlyValueField_6" PropertyPath="inner[{index}].txtValue_var1" Width="100" Label="{}{key}" LabelTextConverterBindingPath="LabelConverter" />
        </MMScrollAreaFieldRepeater>
      </MMScrollAreaMS.MMFields>
    </MMScrollAreaMS>
  </av:Grid>
</MMTabPage>
