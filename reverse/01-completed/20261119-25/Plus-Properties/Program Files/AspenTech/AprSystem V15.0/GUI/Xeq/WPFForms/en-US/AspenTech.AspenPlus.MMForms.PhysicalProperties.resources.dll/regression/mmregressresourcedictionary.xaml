<?xml version='1.0' encoding='utf-8'?>
<ResourceDictionary x:Class="AspenTech.AspenPlus.MMForms.PhysicalProperties.Regression.MMRegressResourceDictionary" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:local="clr-namespace:AspenTech.AspenPlus.MMForms.PhysicalProperties.Regression" xmlns:localConverter="clr-namespace:AspenTech.Engineering.GridControls.Converters;assembly=AspenTech.Engineering.GridControls" xmlns:gc="clr-namespace:AspenTech.Engineering.GridControls;assembly=AspenTech.Engineering.GridControls">
  <localConverter:IndentToLeftMarginConverter x:Key="indentToMarginConverter" />
  <localConverter:GroupingStateToImageBrushConverter x:Key="gsToImageConverter" />
  <DataTemplate x:Key="groupingReadonlyHyperlinkCellTemplate">
    <Grid Margin="2,0,0,0">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>
      <Border Name="PART_GroupBorder" PreviewMouseLeftButtonDown="PART_GroupBorder_PreviewMouseLeftButtonDown" Width="10" Height="10" BorderBrush="#FF808080">
        <FrameworkElement.Margin>
          <Binding Path="Row.GroupingIndent" Converter="{StaticResource indentToMarginConverter}" Mode="OneWay" />
        </FrameworkElement.Margin>
        <Border.Background>
          <Binding Path="Row.GroupingState" Converter="{StaticResource gsToImageConverter}" Mode="OneWay" />
        </Border.Background>
      </Border>
      <TextBlock Margin="4,2,2,2" Grid.Column="1" VerticalAlignment="Center" TextTrimming="CharacterEllipsis">
        <Hyperlink Name="cellLink">
          <Hyperlink.Command>
            <Binding Path="Tag" />
          </Hyperlink.Command>
          <Hyperlink.CommandParameter>
            <Binding Path="Value" />
          </Hyperlink.CommandParameter>
          <Run>
            <Run.Text>
              <Binding Path="ValueAsString" Mode="OneWay" />
            </Run.Text>
          </Run>
        </Hyperlink>
      </TextBlock>
    </Grid>
    <DataTemplate.Triggers>
      <DataTrigger Value="True">
        <DataTrigger.Binding>
          <Binding ElementName="PART_GroupBorder" Path="IsMouseOver" />
        </DataTrigger.Binding>
        <Setter TargetName="PART_GroupBorder" Property="Border.BorderThickness" Value="1" />
      </DataTrigger>
    </DataTemplate.Triggers>
  </DataTemplate>
</ResourceDictionary>
