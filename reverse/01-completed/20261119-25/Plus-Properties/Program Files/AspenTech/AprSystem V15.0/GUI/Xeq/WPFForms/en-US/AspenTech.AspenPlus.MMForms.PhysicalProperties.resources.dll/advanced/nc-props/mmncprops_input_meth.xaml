<?xml version='1.0' encoding='utf-8'?>
<MMTabPage x:Class="AspenTech.AspenPlus.MMForms.PhysicalProperties.Advanced.NC_Props.MMNCProps_Input_Meth" xmlns="http://schemas.aspentech.com/xaml/presentation/aspenplus" xmlns:res="clr-namespace:AspenTech.AspenPlus.Localization;assembly=AspenTech.AspenPlus.Localization" xmlns:av="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:aes="http://schemas.aspentech.com/xaml/presentation/engineering" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Uid="MMTabPage_1" MinWidth="480" MinHeight="340">
  <av:Grid x:Uid="av_Grid_1" Margin="0,0,8,0">
    <av:Grid.ColumnDefinitions>
      <av:ColumnDefinition x:Uid="av_ColumnDefinition_1" Width="*" />
    </av:Grid.ColumnDefinitions>
    <av:Grid.RowDefinitions>
      <av:RowDefinition x:Uid="av_RowDefinition_1" Height="Auto" />
      <av:RowDefinition x:Uid="av_RowDefinition_2" Height="Auto" />
      <av:RowDefinition x:Uid="av_RowDefinition_3" Height="Auto" />
    </av:Grid.RowDefinitions>
    <av:Grid x:Uid="av_Grid_2" Margin="0,18,0,0" av:Grid.Column="0" av:Grid.Row="0">
      <av:Grid.ColumnDefinitions>
        <av:ColumnDefinition x:Uid="av_ColumnDefinition_2" Width="Auto" />
        <av:ColumnDefinition x:Uid="av_ColumnDefinition_3" Width="Auto" />
      </av:Grid.ColumnDefinitions>
      <av:Grid.RowDefinitions>
        <av:RowDefinition x:Uid="av_RowDefinition_4" Height="Auto" />
      </av:Grid.RowDefinitions>
      <MMLabel Name="mnuComponent_label" x:Uid="MMLabel_1" TargetControl="mnuComponent" MinWidth="93" Margin="8,0,0,0" av:Grid.Column="0" av:Grid.Row="0" Content="{x:Static res:ApwnResources.MMNCProps_Input_Meth_MMF_Content0}" />
      <MMAdvancedComboEdit Name="mnuComponent" x:Uid="MMAdvancedComboEdit_1" Mask="Integer" VariablePath="mnuComponent_var1" Width="118" av:Grid.Column="1" av:Grid.Row="0" />
    </av:Grid>
    <MMGroupBox Name="fraPropertyModels" x:Uid="MMGroupBox_1" Header="{x:Static res:ApwnResources.MMNCProps_Input_Meth_MMFHeader0}" VariablePath="fraPropertyModels_state" MinWidth="480" Margin="8,8,0,0" VerticalAlignment="Top" av:Grid.Column="0" av:Grid.Row="1">
      <av:Grid x:Uid="av_Grid_3">
        <av:Grid.ColumnDefinitions>
          <av:ColumnDefinition x:Uid="av_ColumnDefinition_4" Width="*" />
        </av:Grid.ColumnDefinitions>
        <av:Grid.RowDefinitions>
          <av:RowDefinition x:Uid="av_RowDefinition_5" Height="Auto" />
          <av:RowDefinition x:Uid="av_RowDefinition_6" Height="Auto" />
        </av:Grid.RowDefinitions>
        <av:Grid x:Uid="av_Grid_4" Margin="0,3,0,0" av:Grid.Column="0" av:Grid.Row="0">
          <av:Grid.ColumnDefinitions>
            <av:ColumnDefinition x:Uid="av_ColumnDefinition_5" Width="Auto" />
            <av:ColumnDefinition x:Uid="av_ColumnDefinition_6" Width="Auto" />
          </av:Grid.ColumnDefinitions>
          <av:Grid.RowDefinitions>
            <av:RowDefinition x:Uid="av_RowDefinition_7" Height="Auto" />
          </av:Grid.RowDefinitions>
          <MMLabel xml:space="preserve" Name="lblModelName" x:Uid="MMLabel_2" MinWidth="120" Margin="30,0,0,0" av:Grid.Column="0" HorizontalAlignment="Left" av:Grid.Row="0" Content="{x:Static res:ApwnResources.MMNCProps_Input_Meth_MMF_Content1}" />
          <MMLabel Name="lblOptionCodeValue" x:Uid="MMLabel_3" MinWidth="90" Margin="110,0,0,0" HorizontalAlignment="Left" av:Grid.Column="1" av:Grid.Row="0" Content="{x:Static res:ApwnResources.MMNCProps_Input_Meth_MMF_Content2}" />
        </av:Grid>
        <MMScrollAreaHorizontal Name="grdPropertyModels" x:Uid="MMScrollAreaHorizontal_1" DataProperty="grdPropertyModels_GridData" LabelWidth="235" FieldWidth="40" VerticalAlignment="Top" av:Grid.Column="0" av:Grid.Row="1">
          <av:FrameworkElement.Resources>
            <av:ResourceDictionary>
              <av:DataTemplate x:Key="EnthalpyHeaderTemplate" x:Uid="av_DataTemplate_1" DataType="LabelHeader">
                <av:DockPanel x:Uid="av_DockPanel_1" Margin="3">
                  <av:TextBlock x:Uid="av_TextBlock_1" Text="{x:Static res:ApwnResources.MMNCProps_Input_Meth_MMFText0}" VerticalAlignment="Center" />
                  <MMComboEdit Name="enthEdit" x:Uid="MMComboEdit_1" HorizontalAlignment="Right" VariableDataMember="Value" VariablePath="cboEnthalpyModelName_var1" Width="120">
                    <av:FrameworkElement.DataContext>
                      <av:Binding Path="DataContext">
                        <av:Binding.RelativeSource>
                          <av:RelativeSource Mode="FindAncestor" AncestorType="{x:Type MMScrollAreaBase}" />
                        </av:Binding.RelativeSource>
                      </av:Binding>
                    </av:FrameworkElement.DataContext>
                  </MMComboEdit>
                </av:DockPanel>
              </av:DataTemplate>
              <av:DataTemplate x:Key="DensityHeaderTemplate" x:Uid="av_DataTemplate_2" DataType="LabelHeader">
                <av:DockPanel x:Uid="av_DockPanel_2" Margin="3">
                  <av:TextBlock x:Uid="av_TextBlock_2" Text="{x:Static res:ApwnResources.MMNCProps_Input_Meth_MMFText1}" VerticalAlignment="Center" />
                  <MMComboEdit Name="densEdit" x:Uid="MMComboEdit_2" HorizontalAlignment="Right" VariableDataMember="Value" VariablePath="cboDensityModelName_var1" Width="120">
                    <av:FrameworkElement.DataContext>
                      <av:Binding Path="DataContext">
                        <av:Binding.RelativeSource>
                          <av:RelativeSource Mode="FindAncestor" AncestorType="{x:Type MMScrollAreaBase}" />
                        </av:Binding.RelativeSource>
                      </av:Binding>
                    </av:FrameworkElement.DataContext>
                  </MMComboEdit>
                </av:DockPanel>
              </av:DataTemplate>
            </av:ResourceDictionary>
          </av:FrameworkElement.Resources>
          <MMScrollAreaHorizontal.MMFields>
            <MMScrollAreaValueField x:Uid="MMScrollAreaValueField_1" MaxLength="2" Mask="Integer" PropertyPath="txtEnthalpyOptionCodeValue_var1" ColumnHeaderTemplate="{av:StaticResource EnthalpyHeaderTemplate}" ColumnHeaderTextAlignment="Left" />
            <MMScrollAreaValueField x:Uid="MMScrollAreaValueField_2" MaxLength="2" Mask="Integer" PropertyPath="txtDensityOptionCodeValue_var1" ColumnHeaderTemplate="{av:StaticResource DensityHeaderTemplate}" ColumnHeaderTextAlignment="Left" />
          </MMScrollAreaHorizontal.MMFields>
        </MMScrollAreaHorizontal>
      </av:Grid>
    </MMGroupBox>
    <MMGroupBox Name="fraRequiredComponentAttributes" x:Uid="MMGroupBox_2" Header="{x:Static res:ApwnResources.MMNCProps_Input_Meth_MMFHeader1}" VariablePath="fraRequiredComponentAttributes_state" MinWidth="480" Margin="8,8,0,0" VerticalAlignment="Top" av:Grid.Column="0" av:Grid.Row="2">
      <MMHorizontalListEdit Name="grdRequiredComponentAttributes" x:Uid="MMHorizontalListEdit_1" DataProperty="grdRequiredComponentAttributes_GridData" VerticalAlignment="Top">
        <MMScrollArea.MMFields>
          <MMScrollAreaComboValueField x:Uid="MMScrollAreaComboValueField_1" VariableDataMember="Value" PropertyPath="cboTypeList_var1" WidthMode="Auto" UseFieldHelp="True" />
        </MMScrollArea.MMFields>
      </MMHorizontalListEdit>
    </MMGroupBox>
  </av:Grid>
</MMTabPage>
