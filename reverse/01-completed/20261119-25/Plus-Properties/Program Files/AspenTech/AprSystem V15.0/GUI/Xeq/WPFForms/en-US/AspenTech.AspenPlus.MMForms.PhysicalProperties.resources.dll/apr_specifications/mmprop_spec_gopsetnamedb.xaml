<?xml version='1.0' encoding='utf-8'?>
<MMTabPage x:Class="AspenTech.AspenPlus.MMForms.PhysicalProperties.APr_Specifications.MMProp_Spec_GopsetNameDB" xmlns="http://schemas.aspentech.com/xaml/presentation/aspenplus" xmlns:res="clr-namespace:AspenTech.AspenPlus.Localization;assembly=AspenTech.AspenPlus.Localization" xmlns:av="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:aes="http://schemas.aspentech.com/xaml/presentation/engineering" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Uid="MMTabPage_1" MinWidth="320" MinHeight="80">
  <av:Grid x:Uid="av_Grid_1">
    <av:Grid.RowDefinitions>
      <av:RowDefinition x:Uid="av_RowDefinition_1" Height="*" />
      <av:RowDefinition x:Uid="av_RowDefinition_2" Height="8" />
      <av:RowDefinition x:Uid="av_RowDefinition_3" Height="Auto" />
    </av:Grid.RowDefinitions>
    <av:Grid.ColumnDefinitions>
      <av:ColumnDefinition x:Uid="av_ColumnDefinition_1" Width="*" />
    </av:Grid.ColumnDefinitions>
    <av:StackPanel x:Uid="av_StackPanel_1" Orientation="Horizontal">
      <MMLabel Name="txtOpsetName_label" x:Uid="MMLabel_1" TargetControl="txtOpsetName" Content="{x:Static res:ApwnResources.MMProp_Spec_GopsetNameDB_MMF_Content0}" />
      <MMVariableEdit Name="txtOpsetName" x:Uid="MMVariableEdit_1" Width="120" ValueWidth="*" ValueMask="Id" ValueCharacterCasing="Upper" UnitsVisibility="Collapsed" Orientation="Horizontal" MaxLength="8" VariablePath="txtOpsetName_newid" />
    </av:StackPanel>
    <av:Grid x:Uid="av_Grid_2" av:Grid.Row="2">
      <av:Grid.RowDefinitions>
        <av:RowDefinition x:Uid="av_RowDefinition_4" Height="Auto" />
      </av:Grid.RowDefinitions>
      <av:Grid.ColumnDefinitions>
        <av:ColumnDefinition x:Uid="av_ColumnDefinition_2" Width="*" />
        <av:ColumnDefinition x:Uid="av_ColumnDefinition_3" Width="8" />
        <av:ColumnDefinition x:Uid="av_ColumnDefinition_4" Width="*" />
      </av:Grid.ColumnDefinitions>
      <MMCmdButton Name="cmdOK" x:Uid="MMCmdButton_1" IsDefault="True" HorizontalAlignment="Right" av:Grid.Column="0" Content="{x:Static res:ApwnResources.MMProp_Spec_GopsetNameDB_MMF_Content1}">
        <aes:AesCmdButton.Command>
          <av:Binding Path="cmdOK_Command" />
        </aes:AesCmdButton.Command>
      </MMCmdButton>
      <MMCmdButton Name="cmdCancel" x:Uid="MMCmdButton_2" IsCancel="True" av:Grid.Column="2" Content="{x:Static res:ApwnResources.MMProp_Spec_GopsetNameDB_MMF_Content2}">
        <aes:AesCmdButton.Command>
          <av:Binding Path="cmdCancel_Command" />
        </aes:AesCmdButton.Command>
      </MMCmdButton>
    </av:Grid>
  </av:Grid>
</MMTabPage>
