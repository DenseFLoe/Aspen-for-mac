<Application x:Class="AspenPlus.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:atShell="http://schemas.aspentech.com/xaml/presentation/visualisation/commonshell"
             xmlns:atSupport="http://schemas.aspentech.com/xaml/presentation/visualisation/support"
             xmlns:igWindows="http://infragistics.com/Windows">
    <Application.Resources>
        <ResourceDictionary x:Uid="ResourceDictionary_1">
            <ResourceDictionary.MergedDictionaries>
                <atSupport:AspenCommonResources />
                <atSupport:AspenCommonProperties x:Uid="atSupport_AspenCommonProperties_1" />
                <atSupport:AspenCommonStyles />
                <atSupport:AspenDefaultStyles />
                <atShell:CommonShellAppResources />
                <ResourceDictionary Source="/AspenTech.AspenPlus.SpreadsheetCalculator;component/DevExpressStyle.xaml" />
                <ResourceDictionary x:Uid="ResourceDictionary_2" Source="/ApwnShell;component/DataGridStyle.xaml" />
                <ResourceDictionary x:Uid="ResourceDictionary_3">
                    <Style TargetType="{x:Type Separator}" x:Key="{x:Static MenuItem.SeparatorStyleKey}">
                        <Setter Property="Control.Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="{x:Type Separator}">
                                    <Grid Margin="0,1,0,1" SnapsToDevicePixels="True">
                                        <Rectangle x:Uid="Rectangle_1" Height="1" Margin="30,0,1,1" Fill="#FFE0E0E0" />
                                        <Rectangle x:Uid="Rectangle_2" Height="1" Margin="30,1,1,0" Fill="#FFFFFFFF" />
                                    </Grid>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                    <Style x:Key="MMDialogStyle" TargetType="{x:Type Window}">
                        <Setter Property="Panel.Background" Value="{DynamicResource {x:Static igWindows:PrimitivesBrushKeys.TabContentBackgroundFillKey}}" />
                        <Setter Property="TextElement.FontSize" Value="{StaticResource AspenDefaultFontSize}" />
                        <Setter Property="TextElement.FontFamily" Value="{StaticResource AspenDefaultFontFamily}" />
                    </Style>
                    <PopupAnimation x:Uid="PopupAnimation_1" x:Key="{x:Static SystemParameters.ComboBoxPopupAnimationKey}">None</PopupAnimation>
                    <PopupAnimation x:Uid="PopupAnimation_2" x:Key="{x:Static SystemParameters.MenuPopupAnimationKey}">None</PopupAnimation>
                </ResourceDictionary>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>
</Application>
